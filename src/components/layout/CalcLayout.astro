---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { PAGE_SEO, SITE } from '@/lib/constants/seo';
import { getCalcBySlug, getRelatedCalcs, getDomainGroup } from '@/lib/constants/calcs';
import '@/styles/global.css';
import AppHead from './AppHead.astro';
import { jsonLd } from '@/lib/utils/jsonld';
import AdSlot from '@/components/ads/AdSlot.astro';
import AdNative from '@/components/ads/AdNative.astro';
import AdRail from '@/components/ads/AdRail.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  slug: string;
  faqs?: Array<{ q: string; a: string }>;
  whatIs?: string;
  whyUse?: string;
  /** Respuesta directa de 1-2 frases. Es lo primero que lee un motor de respuesta. */
  answer?: string;
  /** Pasos propios para el schema HowTo. Si se omite se generan los del patrón estándar. */
  howTo?: string[];
  /** Fecha de última revisión del contenido (ISO YYYY-MM-DD). */
  dateModified?: string;
}

const {
  slug,
  faqs = [],
  whatIs = '',
  whyUse = '',
  answer = '',
  howTo,
  dateModified = SITE.dateModified,
} = Astro.props;

const seo     = PAGE_SEO[slug];
const calc    = getCalcBySlug(slug);
const related = getRelatedCalcs(slug);

const title       = seo?.title       ?? `${calc?.name ?? slug} — ${SITE.name}`;
const description = seo?.description ?? calc?.description ?? SITE.description;
const canonical   = seo?.canonical   ?? `${SITE.url}/${slug}`;
const calcName    = calc?.name ?? slug;
// Imagen OG propia por calculadora (generada por scripts/generate-og.mjs)
const ogImage     = calc ? `${SITE.url}/og/${slug}.jpg` : SITE.ogImage;

const group = calc ? getDomainGroup(calc.domain) : undefined;
const breadcrumb = [
  { name: SITE.name, href: '/' },
  ...(group ? [{ name: group.label, href: `/${group.slug}` }] : []),
  { name: calcName, href: canonical },
];

// Respuesta directa mostrada arriba del todo — extractable por motores de respuesta
const directAnswer = answer || calc?.longDescription || description;

const howToSteps = howTo ?? [
  'Introduce en el formulario los datos que pide la calculadora.',
  'Pulsa el botón de calcular para obtener el resultado al instante.',
  'Revisa el resultado y modifica los valores para comparar distintos supuestos.',
];

const orgSchema = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer support',
    availableLanguage: 'Spanish',
  },
};

const siteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'es',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const pageSchema = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'es',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@type': 'Thing', name: calcName },
  dateModified,
  datePublished: SITE.datePublished,
  breadcrumb: { '@id': `${canonical}#breadcrumb` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.aeo-answer'],
  },
};

const appSchema = {
  '@type': 'WebApplication',
  '@id': `${canonical}#app`,
  name: calcName,
  description,
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requiere JavaScript. Funciona en cualquier navegador moderno.',
  inLanguage: 'es',
  isAccessibleForFree: true,
  dateModified,
  publisher: { '@id': `${SITE.url}/#organization` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: breadcrumb.map(({ name, href }, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name,
    item: href.startsWith('http') ? href : `${SITE.url}${href === '/' ? '' : href}`,
  })),
};

const howToSchema = {
  '@type': 'HowTo',
  '@id': `${canonical}#howto`,
  name: `Cómo usar la ${calcName}`,
  description: `Pasos para calcular con la ${calcName} de ${SITE.name}.`,
  inLanguage: 'es',
  totalTime: 'PT1M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'EUR', value: '0' },
  step: howToSteps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `Paso ${i + 1}`,
    text,
    url: `${canonical}#paso-${i + 1}`,
  })),
};

const faqSchema = faqs.length > 0
  ? {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: 'es',
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

const graph = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    orgSchema,
    siteSchema,
    pageSchema,
    appSchema,
    breadcrumbSchema,
    howToSchema,
    ...(faqSchema ? [faqSchema] : []),
  ],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <AppHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={`${SITE.url}/llms.txt`} title="Índice para motores de respuesta (llms.txt)" />

    <!-- Indexación: permite fragmentos completos en resultados y respuestas generadas -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={SITE.name} />
    <meta name="last-modified" content={dateModified} />

    <!-- OpenGraph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name"   content={SITE.name} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:image"        content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={`${calcName} — ${SITE.name}`} />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content={`${calcName} — ${SITE.name}`} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={graph} />
  </head>

  <body>
    <Header />

    <main
      class="max-w-6xl mx-auto px-4 sm:px-6 pt-5 pb-10 sm:py-10"
      data-calc-slug={slug}
      data-calc-name={calcName}
      data-calc-group={group?.id ?? ''}
    >
      <!-- Breadcrumb (en móvil lo sustituye el botón "atrás" de la cabecera) -->
      <nav class="hidden sm:flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-8" aria-label="Ruta">
        {breadcrumb.map(({ name, href }, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {i < breadcrumb.length - 1
              ? <a href={href} class="hover:text-[var(--color-text)] transition-colors">{name}</a>
              : <span class="text-[var(--color-text-secondary)]">{name}</span>
            }
          </>
        ))}
      </nav>

      <!-- H1 + respuesta directa (bloque extractable por motores de respuesta) -->
      {calc && (
        <div class="mb-6 sm:mb-8">
          <h1 class="text-[1.75rem] sm:text-4xl font-extrabold text-[var(--color-text)] leading-tight">{calc.name}</h1>
          <p class="aeo-answer text-[var(--color-text-secondary)] mt-2 text-base sm:text-lg max-w-2xl">{directAnswer}</p>
          <p class="mt-3 text-xs text-[var(--color-text-muted)]">
            Cálculo gratuito, sin registro y realizado en tu navegador ·
            <span> Actualizado el <time datetime={dateModified}>{new Date(`${dateModified}T00:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
          </p>
        </div>
      )}

      <div class="xl:flex xl:items-start xl:gap-8">
        <div class="min-w-0 flex-1">
          <!-- Anuncio superior: por encima de la calculadora, sin taparla -->
          <AdSlot placement="horizontal" class="mb-6 sm:mb-8" />

          <!-- Componente React -->
          <slot />

          <!-- Anuncio nativo: justo bajo el resultado del cálculo -->
          <AdNative class="mt-10" />

          <!-- Contenido adicional de la página (tablas, ejemplos, guías) -->
          <slot name="extra" />

          <!-- ¿Qué es? -->
          {whatIs && (
            <section class="mt-8 p-5 bg-white rounded-xl border border-[var(--color-border)]" style="border-left: 4px solid var(--color-accent)">
              <h2 class="text-lg font-bold text-[var(--color-text)] mb-3">¿Qué es?</h2>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed" set:html={whatIs} />
            </section>
          )}

          <!-- ¿Para qué sirve? -->
          {whyUse && (
            <section class="mt-6 p-5 bg-white rounded-xl border border-[var(--color-border)]" style="border-left: 4px solid var(--color-accent)">
              <h2 class="text-lg font-bold text-[var(--color-text)] mb-3">¿Para qué sirve?</h2>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed" set:html={whyUse} />
            </section>
          )}

          <AdSlot placement="rectangle" class="mt-14" />

          <!-- Calculadoras relacionadas -->
          {related.length > 0 && (
            <section class="mt-12 sm:mt-20">
              <h2 class="text-xl font-bold text-[var(--color-text)] mb-4 sm:mb-5">Calculadoras relacionadas</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4">
                {related.map(r => (
                  <a
                    href={`/${r.slug}`}
                    class="app-press group flex items-center gap-3 rounded-2xl border border-[var(--color-calcs-border)] bg-[var(--color-surface)] p-4 transition-all hover:border-[var(--color-accent)] hover:shadow-sm sm:p-5"
                  >
                    <div class="min-w-0 flex-1 space-y-1.5 sm:space-y-3">
                      <h3 class="text-sm font-semibold text-[var(--color-text)] leading-snug">{r.name}</h3>
                      <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed line-clamp-1 sm:line-clamp-2">{r.description}</p>
                    </div>
                    <Icon name="chevron-right" size={18} class="text-[var(--color-text-muted)] sm:hidden" />
                  </a>
                ))}
              </div>
            </section>
          )}

          <AdSlot placement="horizontal" class="mt-12 sm:mt-16" />

          <!-- FAQs -->
          {faqs.length > 0 && (
            <section class="mt-12 sm:mt-16">
              <h2 class="text-2xl font-extrabold text-[var(--color-text)] mb-6">Preguntas frecuentes</h2>
              <dl class="space-y-4">
                {faqs.map(({ q, a }) => (
                  <div class="p-5 bg-white rounded-xl border border-[var(--color-border)]">
                    <dt class="font-bold text-[var(--color-text)] mb-2">{q}</dt>
                    <dd class="text-[var(--color-text-secondary)] text-sm leading-relaxed">{a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

        </div>

        <!-- Columna lateral de anuncios (>= 1280px) -->
        <AdRail />
      </div>

    </main>

    <Footer />
  </body>
</html>

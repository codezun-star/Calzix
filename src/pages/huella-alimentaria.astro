---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HuellaAlimentariaTool from '@/components/tools/HuellaAlimentariaTool';
---

<CalcLayout slug="huella-alimentaria"
  answer={"La huella de carbono de la dieta es la suma de los kilos de cada alimento por su factor de emisión: 0,5 kg de carne roja a la semana generan unos 13,5 kg de CO₂ (27 kg por kilo), mientras que 3 kg de frutas y verduras apenas 1,5 kg. Al año, la carne roja suele ser la mitad de la huella alimentaria de un español medio."}
  howTo={[
    "Introduce los kilos que consumes a la semana de carne roja, lácteos, pescado, cereales y frutas y verduras.",
    "Pulsa calcular para ver tu huella semanal, anual y diaria.",
    "Prueba a cambiar cantidades para ver cómo bajaría tu huella con otra dieta."
  ]}
  whatIs={"La calculadora de huella de carbono de la dieta estima los kilos de CO₂ equivalente que genera tu alimentación semanal y anual con factores de emisión medios por tipo de alimento, desde la producción hasta la venta."}
  whyUse={"Te ayuda a ver qué alimentos pesan más en tu huella y cómo reducirla sin renunciar a una dieta equilibrada, siguiendo el modelo de la dieta mediterránea."}
  faqs={[
    {
      q: "¿Qué alimentos tienen mayor huella de carbono?",
      a: "Por kilo, la carne de vacuno (entre 25 y 60 kg de CO₂ equivalente según el sistema de producción) y la de cordero son las que más emiten, seguidas del queso, el cerdo, el pollo y el pescado de arrastre. Las legumbres, los cereales, las frutas y las verduras emiten menos de 1-2 kg por kilo. Los productos de invernadero o transportados en avión aumentan su huella.",
    },
    {
      q: "¿Es sostenible la dieta mediterránea?",
      a: "La dieta mediterránea tradicional, basada en verduras, frutas, legumbres, cereales integrales, aceite de oliva y pescado, con poca carne roja, tiene una huella de carbono y de agua mucho menor que la dieta occidental actual. Los estudios señalan que volver a ella reduciría de forma notable las emisiones de la alimentación en España.",
    },
    {
      q: "¿Influye que un alimento sea de proximidad?",
      a: "El transporte supone de media menos del 10 % de la huella de un alimento, salvo los que viajan en avión (algunas frutas tropicales o el marisco fresco de lejos). Importa más qué comes que de dónde viene. Aun así, los productos de temporada y cercanos suelen necesitar menos energía para su conservación y transporte.",
    },
    {
      q: "¿Cuánto CO₂ genera el desperdicio de comida?",
      a: "En los hogares españoles se tiran más de 1.000 millones de kilos de comida al año, según el Ministerio de Agricultura, Pesca y Alimentación. Toda la energía y el agua usadas para producirla se pierden. La Ley 1/2025 de prevención de las pérdidas y el desperdicio alimentario obliga a empresas y restaurantes a planes de prevención y a facilitar que el cliente se lleve lo que no consume.",
    },
    {
      q: "¿Cómo reducir la huella de mi dieta?",
      a: "Reduce la carne roja a una o dos raciones semanales, aumenta las legumbres (la recomendación es de 2-4 raciones semanales), elige pescado de especies y artes de pesca sostenibles, compra fruta y verdura de temporada, cocina las cantidades justas y aprovecha las sobras.",
    },
    {
      q: "¿De dónde salen los factores de emisión?",
      a: "Son valores medios de análisis de ciclo de vida publicados en la literatura científica (como el estudio de Poore y Nemecek, 2018) y por organismos como la FAO, que incluyen la producción agrícola o ganadera, la transformación, el transporte y el envasado. Los valores concretos de cada producto pueden variar bastante.",
    },
  ]}
>
  <HuellaAlimentariaTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorNumeracionTool from '@/components/tools/ConversorNumeracionTool';
---

<CalcLayout slug="conversor-numeracion"
  answer={"Para convertir entre sistemas de numeración se usan las potencias de la base: 1010 en binario es 1×8 + 0×4 + 1×2 + 0×1 = 10 en decimal, A en hexadecimal y 12 en octal. Para pasar de decimal a binario se divide sucesivamente entre 2."}
  howTo={[
    "Introduce el número.",
    "Elige la base de origen y la de destino: binario, octal, decimal o hexadecimal.",
    "Pulsa convertir para ver el resultado."
  ]}
  whatIs={"El conversor de sistemas de numeración convierte números entre binario (base 2), octal (base 8), decimal (base 10) y hexadecimal (base 16)."}
  whyUse={"Sirve para Tecnología y Programación en la ESO y el Bachillerato, para ciclos formativos de informática y para programadores que trabajan con colores, direcciones de memoria o permisos de archivos."}
  faqs={[
    {
      q: "¿Por qué los ordenadores usan el sistema binario?",
      a: "Porque sus circuitos tienen dos estados (encendido y apagado), representados por 1 y 0. Cada dígito binario es un bit, y 8 bits forman un byte, que puede representar 256 valores (de 0 a 255).",
    },
    {
      q: "¿Para qué sirve el hexadecimal?",
      a: "Para escribir de forma compacta los números binarios: cada cifra hexadecimal equivale a 4 bits. Se usa en los colores web (#18A357), en las direcciones de memoria y en las direcciones MAC.",
    },
    {
      q: "¿Cómo paso de decimal a binario?",
      a: "Divide entre 2 repetidamente y anota los restos; el número binario son los restos leídos de abajo arriba. 13 → 6 resto 1 → 3 resto 0 → 1 resto 1 → 0 resto 1: 1101.",
    },
    {
      q: "¿Dónde se usa el octal?",
      a: "En los permisos de archivos de los sistemas Unix y Linux: 755 significa lectura, escritura y ejecución para el propietario y lectura y ejecución para el resto.",
    },
    {
      q: "¿Qué letras usa el hexadecimal?",
      a: "Las cifras del 0 al 9 y las letras de la A a la F, que valen de 10 a 15. FF en hexadecimal es 255 en decimal.",
    },
  ]}
>
  <ConversorNumeracionTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PinturaExteriorTool from '@/components/tools/PinturaExteriorTool';
---

<CalcLayout slug="pintura-exterior"
  answer={"Para pintar una fachada multiplica el perímetro por la altura, resta ventanas (unos 1,5 m² cada una) y puertas (2 m²), multiplica por el número de manos y divide entre el rendimiento: una fachada de 40 m de perímetro y 6 m de altura, con 4 ventanas y una puerta, son 232 m², unos 58 litros a dos manos con una pintura de 8 m²/L."}
  howTo={[
    "Introduce el perímetro exterior y la altura de la fachada en metros.",
    "Indica el número de ventanas y puertas para descontar su superficie.",
    "Escribe el rendimiento de la pintura y el número de manos y pulsa calcular."
  ]}
  whatIs={"La calculadora de pintura exterior calcula la superficie a pintar de una fachada o un muro exterior, descontando ventanas y puertas, y los litros de pintura necesarios."}
  whyUse={"Te ayuda a presupuestar la pintura de la fachada de una casa, un chalé o un muro de la parcela, y a comparar el precio de la pintura con el de un pintor."}
  faqs={[
    {
      q: "¿Qué pintura usar en una fachada?",
      a: "Pinturas específicas para exterior: pintura acrílica o pliolite (más resistente a la lluvia, ideal en zonas húmedas como el norte de España), pinturas de silicato para fachadas minerales y revestimientos elásticos para fachadas con fisuras. En zonas de costa conviene elegir productos resistentes al salitre.",
    },
    {
      q: "¿Necesito permiso para pintar la fachada?",
      a: "Sí, normalmente. Pintar una fachada suele requerir una comunicación previa o licencia de obra menor en el ayuntamiento, y en cascos históricos se exigen colores concretos. Si se coloca un andamio en la vía pública, hay que pagar la tasa de ocupación. En un edificio, la fachada es un elemento común y la decisión corresponde a la comunidad de propietarios.",
    },
    {
      q: "¿Cuándo es mejor pintar el exterior?",
      a: "En primavera o en otoño, con temperaturas entre 10 y 25 °C y sin previsión de lluvia en las 24 horas siguientes. Evita pintar a pleno sol en verano, sobre todo en el sur de España, porque la pintura se seca demasiado rápido y quedan marcas.",
    },
    {
      q: "¿Cuánto cuesta pintar una fachada?",
      a: "En España, pintar una fachada cuesta aproximadamente entre 10 y 25 € por m² según la altura, el estado del soporte, la necesidad de andamio y el tipo de pintura. Las reparaciones previas de grietas y desconchones se presupuestan aparte.",
    },
    {
      q: "¿Cuánto rinde la pintura de exterior?",
      a: "Entre 6 y 10 m² por litro y mano, menos en superficies rugosas como el monocapa o el ladrillo visto. Comprueba el rendimiento en el bote y añade un margen del 10 % para retoques.",
    },
  ]}
>
  <PinturaExteriorTool client:load />
</CalcLayout>

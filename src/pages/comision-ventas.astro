---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ComisionVentasTool from '@/components/tools/ComisionVentasTool';
---

<CalcLayout slug="comision-ventas"
  answer={"La comisión de ventas es el importe vendido por el porcentaje pactado: con 15.000 € de ventas y una comisión del 5 %, cobras 750 €, que se suman a tu salario fijo. Las comisiones forman parte del salario y cotizan y tributan en el IRPF como el resto de la nómina."}
  howTo={[
    "Introduce las ventas del periodo.",
    "Escribe el porcentaje de comisión.",
    "Añade el salario fijo, si lo tienes, y pulsa calcular para ver la comisión y la retribución total."
  ]}
  whatIs={"La calculadora de comisiones de ventas calcula la comisión que corresponde a unas ventas según el porcentaje pactado y la suma al salario base fijo para obtener la retribución total del periodo."}
  whyUse={"Sirve a comerciales, agentes y responsables de ventas para comprobar su nómina, simular objetivos y diseñar planes de incentivos."}
  faqs={[
    {
      q: "¿Las comisiones forman parte del salario?",
      a: "Sí. Las comisiones son salario a todos los efectos: cotizan a la Seguridad Social, tributan en el IRPF, se tienen en cuenta para calcular las vacaciones retribuidas (según la jurisprudencia, la media de las comisiones habituales) y para la indemnización por despido.",
    },
    {
      q: "¿Las comisiones se calculan con o sin IVA?",
      a: "Normalmente sobre la base imponible, sin IVA, salvo que el contrato diga otra cosa. Revisa también si se calculan sobre ventas facturadas o cobradas, y qué ocurre con las devoluciones y los impagados.",
    },
    {
      q: "¿Qué es un agente comercial?",
      a: "Es un profesional independiente (autónomo) que promueve ventas por cuenta de una empresa a cambio de una comisión, regulado por la Ley 12/1992 del contrato de agencia. Factura sus comisiones con IVA y, al terminar el contrato, puede tener derecho a una indemnización por clientela.",
    },
    {
      q: "¿Cómo funcionan las comisiones escalonadas?",
      a: "El porcentaje aumenta al superar ciertos tramos de ventas: por ejemplo, un 3 % hasta 10.000 € y un 5 % por encima. Se calcula cada tramo por separado y se suman. Revisa en tu contrato si el porcentaje mayor se aplica solo al exceso o a todas las ventas.",
    },
    {
      q: "¿Se pagan comisiones durante las vacaciones?",
      a: "Las vacaciones deben retribuirse con la remuneración normal o media, lo que incluye las comisiones habituales, según el Tribunal Supremo y el Tribunal de Justicia de la Unión Europea. Por eso muchas empresas pagan en vacaciones la media de las comisiones de los meses anteriores.",
    },
  ]}
>
  <ComisionVentasTool client:load />
</CalcLayout>

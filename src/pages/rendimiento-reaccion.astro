---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import RendimientoReaccionTool from '@/components/tools/RendimientoReaccionTool';
---

<CalcLayout slug="rendimiento-reaccion"
  answer={"El rendimiento de una reacción es el producto obtenido realmente dividido entre el teórico, por 100: si en teoría deberías obtener 10 g y obtienes 8,2 g, el rendimiento es del 82 %."}
  howTo={[
    "Introduce la cantidad de producto obtenida realmente.",
    "Introduce la cantidad teórica calculada por estequiometría (en las mismas unidades).",
    "Pulsa calcular rendimiento para obtener el porcentaje."
  ]}
  whatIs={"La calculadora de rendimiento de una reacción química calcula el porcentaje de producto que se obtiene realmente frente al máximo teórico."}
  whyUse={"Sirve para los problemas de estequiometría de Física y Química de 1.º de Bachillerato y Química de 2.º, y para evaluar los resultados de las prácticas de laboratorio."}
  faqs={[
    {
      q: "¿Cómo se calcula el rendimiento?",
      a: "Rendimiento (%) = (cantidad real ÷ cantidad teórica) × 100. La cantidad teórica se obtiene con la estequiometría a partir del reactivo limitante. Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Por qué el rendimiento suele ser menor del 100 %?",
      a: "Por reacciones incompletas o reversibles, reacciones secundarias que generan otros productos, pérdidas al filtrar, trasvasar o purificar, e impurezas de los reactivos.",
    },
    {
      q: "¿Puede ser mayor del 100 %?",
      a: "En teoría no. Si te sale más del 100 %, probablemente el producto está húmedo o impuro, o hay un error en el cálculo de la cantidad teórica.",
    },
    {
      q: "¿Qué es el reactivo limitante?",
      a: "El reactivo que se agota primero y determina la cantidad máxima de producto. Hay que identificarlo antes de calcular la cantidad teórica.",
    },
    {
      q: "¿Cómo se usa el rendimiento en los problemas?",
      a: "Para calcular la cantidad real de producto (teórica × rendimiento / 100) o, al revés, la cantidad de reactivo necesaria para obtener una cantidad de producto con un rendimiento dado.",
    },
  ]}
>
  <RendimientoReaccionTool client:load />
</CalcLayout>

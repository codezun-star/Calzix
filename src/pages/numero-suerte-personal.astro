---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NumeroSuertePersonalTool from '@/components/tools/NumeroSuertePersonalTool';
---

<CalcLayout slug="numero-suerte-personal"
  answer={"El número de la suerte personal se calcula en numerología sumando las cifras de la fecha de nacimiento hasta reducirlas a una: 15/08/1992 → 1 + 5 + 0 + 8 + 1 + 9 + 9 + 2 = 35 → 3 + 5 = 8. Es un entretenimiento sin base científica: úsalo para pasar un buen rato, no para tomar decisiones importantes."}
  howTo={[
    "Introduce tu fecha de nacimiento.",
    "Pulsa calcular mi número.",
    "Consulta tu número de la suerte y su significado tradicional."
  ]}
  whatIs={"La calculadora del número de la suerte personal obtiene, según la numerología, un número del 1 al 9 a partir de tu fecha de nacimiento."}
  whyUse={"Es un juego para elegir un número para la lotería, una rifa o simplemente por curiosidad, y para comparar con amigos y familia."}
  faqs={[
    {
      q: "¿Aumenta mis posibilidades en la lotería?",
      a: "No. En un sorteo justo todos los números tienen la misma probabilidad. Jugar tu número de la suerte no te hace ganar más, aunque tampoco menos.",
    },
    {
      q: "¿Qué números se consideran de suerte en España?",
      a: "Por tradición, el 7 tiene fama de número afortunado y el 13 de gafe, sobre todo el martes 13. En la Lotería de Navidad, la terminación más premiada históricamente con el Gordo es el 5, pero eso no predice el próximo sorteo.",
    },
    {
      q: "¿Tiene base científica?",
      a: "No. Es un entretenimiento sin base científica: úsalo para pasar un buen rato, no para tomar decisiones importantes.",
    },
    {
      q: "¿Cambia si uso otro método?",
      a: "Sí: cada tradición numerológica usa su método (fecha completa, solo el día, el nombre…). Esta calculadora usa la reducción de la fecha completa.",
    },
    {
      q: "¿Se guarda mi fecha?",
      a: "No. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor.",
    },
  ]}
>
  <NumeroSuertePersonalTool client:load />
</CalcLayout>

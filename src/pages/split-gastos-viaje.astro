---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import SplitGastosViajeTool from '@/components/tools/SplitGastosViajeTool';
---

<CalcLayout slug="split-gastos-viaje"
  answer={"Para dividir los gastos de un viaje suma lo que ha pagado cada uno, divide entre las personas y compara: si 4 amigos han pagado 120, 0, 60 y 220 €, el total es 400 € y la cuota, 100 € cada uno; la segunda persona debe 100 € y la tercera, 40 €, a quien pagó 220 €."}
  howTo={[
    "Escribe lo que ha pagado cada persona, separado por comas (0 si no ha pagado nada).",
    "Pulsa dividir gastos.",
    "Consulta la cuota por persona y quién debe pagar a quién."
  ]}
  whatIs={"La calculadora para dividir gastos de viaje calcula cuánto debe aportar cada persona de un grupo y las transferencias necesarias para que todos paguen lo mismo, con el mínimo de pagos."}
  whyUse={"Es perfecta para viajes con amigos, casas rurales, despedidas, viajes de fin de curso o pisos compartidos: cerráis las cuentas en un momento y con unos pocos Bizums."}
  faqs={[
    {
      q: "¿Cómo se calcula quién debe a quién?",
      a: "Se suma el total, se divide entre las personas para obtener la cuota y se calcula el saldo de cada una (lo que pagó menos la cuota). Los que tienen saldo negativo pagan a los que lo tienen positivo, empezando por los importes mayores para reducir el número de transferencias.",
    },
    {
      q: "¿Y si alguien no participó en un gasto?",
      a: "Calcula ese gasto aparte, dividiéndolo solo entre quienes participaron, y suma o resta el resultado a sus saldos. Por ejemplo, una excursión a la que solo fueron tres personas.",
    },
    {
      q: "¿Cómo pagamos entre nosotros?",
      a: "Lo más habitual en España es el Bizum, inmediato y sin comisiones entre particulares en la mayoría de bancos. Para viajes largos, una cuenta o tarjeta compartida o una aplicación de gastos compartidos facilitan llevar el registro.",
    },
    {
      q: "¿Cómo evitar discusiones?",
      a: "Acordad antes del viaje el presupuesto y qué gastos son comunes, apuntad cada gasto en el momento y cerrad las cuentas el último día, cuando todo está fresco.",
    },
    {
      q: "¿Sirve para pisos compartidos?",
      a: "Sí. Introduce lo que ha pagado cada compañero de piso en el mes (alquiler, luz, agua, internet, compra común) y la calculadora te dice cómo equilibrar las cuentas.",
    },
  ]}
>
  <SplitGastosViajeTool client:load />
</CalcLayout>

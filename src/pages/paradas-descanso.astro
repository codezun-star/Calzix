---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ParadasDescansoTool from '@/components/tools/ParadasDescansoTool';
---

<CalcLayout slug="paradas-descanso"
  answer={"La DGT recomienda parar a descansar al menos 20 minutos cada 2 horas o 200 km: un viaje de 7 horas de conducción necesita 3 paradas, que añaden 1 hora al trayecto."}
  howTo={[
    "Introduce las horas de conducción del viaje.",
    "Ajusta cada cuántas horas quieres descansar (2 por defecto).",
    "Indica la duración de cada parada y pulsa calcular para ver las paradas y el tiempo total."
  ]}
  whatIs={"La calculadora de paradas de descanso calcula cuántas paradas debes hacer en un viaje largo en coche y cuánto tiempo añaden al trayecto, según las recomendaciones de la DGT."}
  whyUse={"Te ayuda a planificar la operación salida, los viajes de vacaciones y los desplazamientos largos sin conducir con fatiga, una de las causas de accidente más frecuentes."}
  faqs={[
    {
      q: "¿Cada cuánto hay que parar al conducir?",
      a: "La DGT recomienda parar al menos 20 minutos cada 2 horas o cada 200 km, y antes si notas cansancio. En los descansos conviene salir del coche, caminar, estirarse e hidratarse.",
    },
    {
      q: "¿Qué dice la ley para los conductores profesionales?",
      a: "El Reglamento europeo 561/2006 obliga a los conductores de camiones y autobuses a hacer una pausa de 45 minutos después de 4 horas y media de conducción, que puede dividirse en una de 15 y otra de 30 minutos. La conducción diaria no puede superar 9 horas (10 dos veces por semana).",
    },
    {
      q: "¿Cuáles son las señales de fatiga?",
      a: "Bostezos frecuentes, parpadeo, picor de ojos, dificultad para mantener la velocidad o el carril, no recordar los últimos kilómetros o cabezadas. Ante cualquiera de ellas, para en un lugar seguro. Una siesta de 15-20 minutos ayuda.",
    },
    {
      q: "¿Qué hago si viajo de noche?",
      a: "Evita conducir entre las 2 y las 6 de la madrugada, cuando el cuerpo tiende al sueño. Si no puedes evitarlo, descansa antes de salir, haz paradas más frecuentes y, si es posible, alterna la conducción con otra persona.",
    },
    {
      q: "¿Cuánto tiempo añaden las paradas?",
      a: "Con paradas de 20 minutos cada 2 horas, unos 10 minutos por hora de conducción. Para un Madrid-Cádiz de unas 6 horas y media, cuenta con unos 3 descansos, una hora más de viaje.",
    },
  ]}
>
  <ParadasDescansoTool client:load />
</CalcLayout>

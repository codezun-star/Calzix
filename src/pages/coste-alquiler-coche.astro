---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CosteAlquilerCocheTool from '@/components/tools/CosteAlquilerCocheTool';
---

<CalcLayout slug="coste-alquiler-coche"
  answer={"El coste total de alquilar un coche es (tarifa diaria + seguro diario) × días + extras: 7 días a 35 € más un seguro sin franquicia de 15 € al día y 30 € de extras suman 380 €, sin contar el combustible."}
  howTo={[
    "Introduce la tarifa por día y los días de alquiler.",
    "Añade el seguro adicional por día, si lo contratas.",
    "Suma los extras de pago único (silla infantil, segundo conductor) y pulsa calcular."
  ]}
  whatIs={"La calculadora de coste de alquiler de coche suma la tarifa diaria, el seguro adicional y los extras para obtener el precio real de un alquiler y el coste por día."}
  whyUse={"Te ayuda a comparar ofertas de alquiler en tus vacaciones en Canarias, Baleares o la península, y a no llevarte sorpresas al recoger el coche."}
  faqs={[
    {
      q: "¿Qué es la franquicia?",
      a: "Es la cantidad que pagas tú en caso de daños o robo, aunque el coche tenga seguro: puede ser de 1.000 a 3.000 €. La empresa bloquea esa cantidad (o una fianza) en tu tarjeta de crédito. El seguro «sin franquicia» o a todo riesgo la elimina, a cambio de un coste diario.",
    },
    {
      q: "¿Qué política de combustible conviene?",
      a: "La de «lleno/lleno»: recoges el coche con el depósito lleno y lo devuelves lleno. Las políticas de «lleno/vacío» suelen cobrar el depósito completo a un precio superior al de la gasolinera y no devuelven lo que sobra.",
    },
    {
      q: "¿Qué necesito para alquilar un coche en España?",
      a: "El carné de conducir en vigor (algunas empresas exigen 1 o 2 años de antigüedad), el DNI o pasaporte y una tarjeta de crédito a nombre del conductor principal. Los menores de 25 años suelen pagar un suplemento por conductor joven.",
    },
    {
      q: "¿Qué extras suelen cobrarse?",
      a: "Segundo conductor, silla infantil (obligatoria para niños de hasta 135 cm), GPS, entrega fuera de horario, recogida en aeropuerto o estación, kilometraje ilimitado si no está incluido y la devolución en otra oficina.",
    },
    {
      q: "¿Qué hago si hay un problema con la empresa de alquiler?",
      a: "Revisa el coche y haz fotos al recogerlo y al devolverlo. Si te cobran cargos indebidos, reclama por escrito a la empresa y pide la hoja de reclamaciones; también puedes acudir a la oficina de consumo de tu comunidad o a una junta arbitral de consumo.",
    },
  ]}
>
  <CosteAlquilerCocheTool client:load />
</CalcLayout>

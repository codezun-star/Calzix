---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HuellaVueloTool from '@/components/tools/HuellaVueloTool';
---

<CalcLayout slug="huella-vuelo"
  answer={"Volar en clase turista emite del orden de 0,15 kg de CO₂ por kilómetro y pasajero: un viaje de ida y vuelta Madrid-Barcelona (unos 1.000 km en total) supone unos 150 kg de CO₂, y uno a Nueva York (11.500 km), más de 1.700 kg. En business, la huella por pasajero es varias veces mayor."}
  howTo={[
    "Introduce la distancia del vuelo de ida en kilómetros.",
    "Elige si es solo ida o ida y vuelta.",
    "Elige la clase y pulsa calcular para ver el CO₂ y los árboles necesarios para compensarlo."
  ]}
  whatIs={"La calculadora de huella de carbono de un vuelo estima las emisiones de CO₂ por pasajero de un viaje en avión según la distancia, el trayecto y la clase."}
  whyUse={"Te ayuda a conocer el impacto climático de tus viajes, comparar el avión con el tren en los trayectos nacionales y decidir si compensar las emisiones."}
  faqs={[
    {
      q: "¿Es mejor el tren que el avión en España?",
      a: "En trayectos como Madrid-Barcelona, Madrid-Sevilla, Madrid-Valencia o Madrid-Málaga, el AVE emite una pequeña fracción del CO₂ del avión por pasajero y es competitivo en tiempo de puerta a puerta. La alta velocidad española es una de las más extensas del mundo.",
    },
    {
      q: "¿Por qué los vuelos cortos contaminan más por kilómetro?",
      a: "Porque el despegue y el ascenso consumen mucho combustible, y en un vuelo corto suponen una parte mayor del trayecto. Además, los aviones emiten óxidos de nitrógeno y estelas a gran altitud que aumentan su efecto sobre el clima.",
    },
    {
      q: "¿Por qué la clase business tiene más huella?",
      a: "Porque las emisiones del avión se reparten según el espacio que ocupa cada pasajero. Un asiento en business ocupa el espacio de dos o tres en turista, así que su huella es proporcionalmente mayor.",
    },
    {
      q: "¿Cómo puedo compensar mi vuelo?",
      a: "Financiando proyectos certificados de absorción o reducción de emisiones, como repoblaciones forestales o energías renovables. El Ministerio para la Transición Ecológica mantiene un registro de proyectos de absorción en España. Compensar no sustituye a volar menos.",
    },
    {
      q: "¿Cuánto CO₂ emite una persona al año en España?",
      a: "Las emisiones de gases de efecto invernadero por habitante en España rondan las 5-6 toneladas de CO₂ equivalente al año. Un solo vuelo transatlántico de ida y vuelta puede suponer cerca de un tercio de esa cifra.",
    },
  ]}
>
  <HuellaVueloTool client:load />
</CalcLayout>

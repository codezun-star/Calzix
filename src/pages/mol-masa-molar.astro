---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import MolMasaTool from '@/components/tools/MolMasaTool';
---

<CalcLayout slug="mol-masa-molar"
  answer={"Los moles son la masa dividida entre la masa molar: n = m / M. 36,03 g de agua (18,015 g/mol) son 2 moles, y 2 moles de agua contienen 2 × 6,022 × 10²³ = 1,2 × 10²⁴ moléculas. Al revés, masa = moles × masa molar."}
  howTo={[
    "Elige si quieres pasar de moles a masa o de masa a moles.",
    "Introduce la masa molar del compuesto y la cantidad conocida.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de moles y masa molar convierte entre gramos y moles de una sustancia con la relación n = m / M."}
  whyUse={"Es la operación básica de la estequiometría: sirve para todos los problemas de reacciones químicas, disoluciones y gases de Física y Química de la ESO, el Bachillerato y la PAU."}
  faqs={[
    {
      q: "¿Qué es un mol?",
      a: "Es la unidad de cantidad de sustancia del Sistema Internacional. Desde 2019 se define como exactamente 6,02214076 × 10²³ entidades elementales (átomos, moléculas, iones), el número de Avogadro. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Qué es la masa molar?",
      a: "Es la masa de un mol de una sustancia, en g/mol. Numéricamente coincide con la masa atómica o molecular en unidades de masa atómica: el carbono tiene 12,011 u y su masa molar es 12,011 g/mol.",
    },
    {
      q: "¿Cómo calculo cuántas moléculas hay?",
      a: "Multiplica los moles por el número de Avogadro: N = n × 6,022 × 10²³. Un vaso de agua de 250 g contiene unos 13,9 mol, es decir, unas 8,4 × 10²⁴ moléculas.",
    },
    {
      q: "¿Qué masa molar tienen los compuestos más usados?",
      a: "Agua (H₂O), 18,015 g/mol; dióxido de carbono (CO₂), 44,01; cloruro de sodio (NaCl), 58,44; glucosa (C₆H₁₂O₆), 180,16; ácido sulfúrico (H₂SO₄), 98,08; amoniaco (NH₃), 17,03.",
    },
    {
      q: "¿Qué errores son habituales?",
      a: "Confundir la masa molar del elemento con la de la molécula (el oxígeno gas es O₂, 32 g/mol, no 16), olvidar los subíndices de la fórmula y mezclar gramos y kilogramos.",
    },
  ]}
>
  <MolMasaTool client:load />
</CalcLayout>

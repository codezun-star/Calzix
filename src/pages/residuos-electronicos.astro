---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ResiduosElectronicosTool from '@/components/tools/ResiduosElectronicosTool';
---

<CalcLayout slug="residuos-electronicos"
  answer={"Un móvil contiene unos 15 g de cobre, 0,03 g de oro y una batería de litio de unos 30-40 g; un portátil, alrededor de 100-200 g de cobre y aluminio. En España, los aparatos eléctricos y electrónicos usados (RAEE) se llevan al punto limpio o se entregan en la tienda al comprar uno nuevo, de forma gratuita."}
  howTo={[
    "Elige el tipo de dispositivo (móvil, portátil, tableta, nevera, lavadora…).",
    "Introduce el número de unidades.",
    "Pulsa calcular para ver el peso total y los materiales recuperables."
  ]}
  whatIs={"La calculadora de residuos electrónicos estima el peso y los materiales valiosos recuperables (cobre, aluminio, oro, plata, litio) de los aparatos eléctricos y electrónicos que llevas a reciclar."}
  whyUse={"Ayuda a entender por qué no hay que tirar los aparatos a la basura, organizar campañas de recogida de móviles en colegios y empresas y conocer dónde entregar los RAEE en España."}
  faqs={[
    {
      q: "¿Dónde se reciclan los aparatos electrónicos en España?",
      a: "En los puntos limpios municipales, en las tiendas al comprar un aparato nuevo equivalente (obligación de recogida «uno por uno» del Real Decreto 110/2015) y, en las tiendas con más de 400 m² dedicados a electrónica, también los aparatos pequeños de menos de 25 cm sin necesidad de comprar nada («uno por cero»). Muchos ayuntamientos tienen además recogida a domicilio de electrodomésticos grandes.",
    },
    {
      q: "¿Qué son los RAEE?",
      a: "Son los residuos de aparatos eléctricos y electrónicos: desde neveras, lavadoras y televisores hasta móviles, cargadores, juguetes con pilas, bombillas LED y herramientas. Contienen materiales valiosos (cobre, aluminio, oro, tierras raras) y sustancias peligrosas (gases refrigerantes, mercurio, plomo), por lo que deben gestionarse en plantas autorizadas.",
    },
    {
      q: "¿Cuántos residuos electrónicos se generan en España?",
      a: "España recoge cada año cientos de miles de toneladas de RAEE, pero todavía por debajo del objetivo europeo de recogida del 65 % de los aparatos puestos en el mercado. Una parte importante sigue acabando en la basura, en chatarrerías no autorizadas o guardada en los cajones de los hogares.",
    },
    {
      q: "¿Qué hago con un móvil viejo?",
      a: "Si funciona, puedes donarlo, venderlo de segunda mano o entregarlo en programas de reutilización. Antes, haz copia de seguridad, cierra sesión en tus cuentas y restablece los valores de fábrica. Si no funciona, llévalo al punto limpio, a la tienda o a los contenedores de recogida de móviles de operadoras y comercios.",
    },
    {
      q: "¿Qué pasa con las baterías de litio?",
      a: "Las baterías de litio de móviles, portátiles y patinetes no deben tirarse nunca a la basura ni al contenedor amarillo: pueden provocar incendios en los camiones y las plantas de residuos. Se entregan en el punto limpio o en los contenedores de pilas y baterías de las tiendas.",
    },
    {
      q: "¿Qué es el índice de reparabilidad y el derecho a reparar?",
      a: "La Unión Europea ha aprobado normas de diseño ecológico y el derecho a reparar, que obligan a los fabricantes a ofrecer piezas de recambio y reparación durante varios años para móviles, tabletas y electrodomésticos, y a indicar su reparabilidad. Reparar y alargar la vida de los aparatos es la mejor forma de reducir los RAEE.",
    },
  ]}
>
  <ResiduosElectronicosTool client:load />
</CalcLayout>

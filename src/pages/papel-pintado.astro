---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PapelPintadoTool from '@/components/tools/PapelPintadoTool';
---

<CalcLayout slug="papel-pintado"
  answer={"Para saber cuántos rollos de papel pintado necesitas divide el perímetro a empapelar entre el ancho del rollo (tiras) y calcula cuántas tiras salen de cada rollo según la altura: con 16 m de perímetro, 2,5 m de altura y rollos estándar de 10 × 0,53 m, necesitas 31 tiras; como de cada rollo salen 3 tiras con margen de corte, unos 11 rollos."}
  howTo={[
    "Introduce el perímetro de las paredes que vas a empapelar.",
    "Indica la altura de las paredes.",
    "Comprueba el largo y el ancho del rollo (10 × 0,53 m es el estándar europeo) y pulsa calcular."
  ]}
  whatIs={"La calculadora de papel pintado calcula cuántas tiras y rollos de papel necesitas para empapelar una habitación según el perímetro, la altura de las paredes y las medidas del rollo."}
  whyUse={"Te ayuda a comprar la cantidad justa de rollos del mismo lote, evitar quedarte corto a mitad del trabajo y presupuestar la decoración."}
  faqs={[
    {
      q: "¿Qué medidas tiene un rollo de papel pintado?",
      a: "El rollo estándar en España y Europa mide unos 10 m de largo por 0,53 m de ancho, aproximadamente 5,3 m². También existen rollos anchos de 0,70 m y 1,06 m, habituales en papeles vinílicos y de tejido no tejido.",
    },
    {
      q: "¿Hay que descontar puertas y ventanas?",
      a: "Normalmente no se descuentan, o solo las grandes, porque los recortes alrededor generan desperdicio y conviene tener papel de sobra. Si la habitación tiene muchas ventanas grandes, puedes restar su ancho del perímetro.",
    },
    {
      q: "¿Qué es el rapport?",
      a: "Es la distancia vertical a la que se repite el dibujo del papel. Con dibujos grandes hay que casar el motivo entre tiras, lo que genera más desperdicio: añade un rollo más si el rapport es grande.",
    },
    {
      q: "¿Por qué comprar todos los rollos del mismo lote?",
      a: "Porque cada fabricación (lote o baño) puede tener ligeras diferencias de tono. El número de lote figura en la etiqueta del rollo. Compra uno de más para futuras reparaciones.",
    },
    {
      q: "¿Qué papel es mejor para baños o cocinas?",
      a: "Los papeles vinílicos son lavables y resisten mejor la humedad. Los de tejido no tejido (TNT) se colocan encolando la pared y se retiran en seco con facilidad, por eso son cada vez más usados.",
    },
  ]}
>
  <PapelPintadoTool client:load />
</CalcLayout>

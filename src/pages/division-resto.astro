---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DivisionRestoTool from '@/components/tools/DivisionRestoTool';
---

<CalcLayout slug="division-resto"
  answer={"En una división entera, dividendo = divisor × cociente + resto, con el resto menor que el divisor: 47 ÷ 5 da cociente 9 y resto 2, porque 5 × 9 + 2 = 47."}
  howTo={[
    "Introduce el dividendo.",
    "Introduce el divisor.",
    "Pulsa dividir para ver el cociente entero y el resto."
  ]}
  whatIs={"La calculadora de división con resto calcula el cociente entero y el resto de una división, y explica la prueba de la división."}
  whyUse={"Sirve para comprobar las divisiones de Primaria, entender la divisibilidad en la ESO y resolver repartos cotidianos en los que sobra algo."}
  faqs={[
    {
      q: "¿Cómo se hace la prueba de la división?",
      a: "Multiplica el divisor por el cociente y suma el resto: debe dar el dividendo. En 47 ÷ 5: 5 × 9 + 2 = 47. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Puede el resto ser mayor que el divisor?",
      a: "No. Si el resto es igual o mayor que el divisor, el cociente puede aumentar en al menos una unidad. El resto siempre está entre 0 y el divisor menos 1.",
    },
    {
      q: "¿Qué significa que el resto sea cero?",
      a: "Que la división es exacta: el dividendo es múltiplo del divisor y el divisor es divisor del dividendo.",
    },
    {
      q: "¿Para qué sirve el resto en la vida diaria?",
      a: "Para repartos: si repartes 47 caramelos entre 5 niños, cada uno recibe 9 y sobran 2. También para saber qué día de la semana será dentro de un número de días (resto de dividir entre 7).",
    },
    {
      q: "¿Qué es la operación módulo?",
      a: "Es el resto de la división entera, muy usado en programación (47 mod 5 = 2). Sirve para saber si un número es par, para ciclos o para comprobar dígitos de control.",
    },
  ]}
>
  <DivisionRestoTool client:load />
</CalcLayout>

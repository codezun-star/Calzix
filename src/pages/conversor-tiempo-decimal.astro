---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorTiempoDecimalTool from '@/components/tools/ConversorTiempoDecimalTool';
---

<CalcLayout slug="conversor-tiempo-decimal"
  answer={"Para pasar de horas y minutos a horas decimales divide los minutos entre 60: 2 horas y 30 minutos son 2,5 horas y 7 horas y 45 minutos, 7,75 horas. Al revés, multiplica los decimales por 60: 1,2 horas son 1 hora y 12 minutos."}
  howTo={[
    "Elige si quieres pasar de horas y minutos a decimal o al revés.",
    "Introduce las horas y los minutos, o las horas en decimal.",
    "Pulsa convertir para ver el resultado."
  ]}
  whatIs={"El conversor de tiempo decimal convierte entre horas y minutos y horas en formato decimal, el que usan las hojas de cálculo, las nóminas y la facturación por horas."}
  whyUse={"Te ayuda a sumar las horas del registro de jornada, calcular las horas extra, facturar por horas como autónomo y rellenar partes de trabajo sin errores."}
  faqs={[
    {
      q: "¿Por qué 1,5 horas no son 1 hora y 50 minutos?",
      a: "Porque una hora tiene 60 minutos, no 100: 0,5 horas son 30 minutos. 1 hora y 50 minutos son 1,83 horas.",
    },
    {
      q: "¿Cómo sumo horas del registro de jornada?",
      a: "Pasa cada jornada a horas decimales, súmalas y vuelve a convertir el total si lo necesitas. Desde 2019 todas las empresas deben llevar un registro diario de la jornada de cada trabajador y conservarlo 4 años.",
    },
    {
      q: "¿Cómo facturo horas con minutos?",
      a: "Convierte el tiempo a decimal y multiplícalo por tu tarifa: 3 horas y 20 minutos (3,333 h) a 40 €/h son 133,33 €, más IVA.",
    },
    {
      q: "¿Cómo convierto minutos en horas decimales?",
      a: "Divide entre 60: 15 min = 0,25 h; 20 min = 0,333 h; 45 min = 0,75 h.",
    },
    {
      q: "¿Y en una hoja de cálculo?",
      a: "En Excel o LibreOffice, las horas se guardan como fracción de día: multiplica la celda por 24 para obtener horas decimales.",
    },
  ]}
>
  <ConversorTiempoDecimalTool client:load />
</CalcLayout>

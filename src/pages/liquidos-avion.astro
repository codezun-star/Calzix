---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import LiquidosAvionTool from '@/components/tools/LiquidosAvionTool';
---

<CalcLayout slug="liquidos-avion"
  answer={"En el equipaje de mano, cada envase de líquido debe tener como máximo 100 ml y todos deben caber en una bolsa transparente con cierre de 1 litro, una por pasajero. Un envase de 150 ml no se permite aunque esté medio vacío."}
  howTo={[
    "Escribe la capacidad en ml de cada uno de tus envases, separados por comas.",
    "Pulsa comprobar líquidos.",
    "Consulta qué envases cumplen la regla de los 100 ml y si caben en la bolsa de 1 litro."
  ]}
  whatIs={"La calculadora de líquidos para el avión comprueba si tus envases cumplen la regla de los 100 ml del equipaje de mano y si en total caben en la bolsa de 1 litro que se exige en los controles de seguridad."}
  whyUse={"Te ayuda a preparar la maleta de cabina antes de ir al aeropuerto y a no perder tu perfume o tu crema en el control de seguridad."}
  faqs={[
    {
      q: "¿Qué líquidos puedo llevar en el equipaje de mano?",
      a: "En los aeropuertos de España y de la Unión Europea, envases de hasta 100 ml cada uno, dentro de una bolsa de plástico transparente con cierre y capacidad de 1 litro, una por pasajero. Cuentan como líquidos los geles, cremas, pastas, aerosoles, perfumes y alimentos untables.",
    },
    {
      q: "¿Hay excepciones?",
      a: "Sí: los medicamentos necesarios durante el viaje (conviene llevar la receta o un informe), la comida y la leche para bebés y los alimentos para dietas especiales, en la cantidad necesaria. Se presentan por separado en el control.",
    },
    {
      q: "¿Puedo llevar líquidos comprados en el aeropuerto?",
      a: "Sí, los comprados después del control de seguridad, en una bolsa precintada con el ticket visible. Si haces escala en otro aeropuerto, no abras la bolsa hasta tu destino final.",
    },
    {
      q: "¿Han cambiado las normas con los nuevos escáneres?",
      a: "Algunos aeropuertos europeos tienen escáneres que permiten dejar los líquidos en la maleta o llevar envases mayores, pero la norma varía según el aeropuerto y el control, y la UE volvió a limitar los envases a 100 ml en 2024 mientras revisaba estos equipos. Lo más seguro es seguir preparando la bolsa de 1 litro.",
    },
    {
      q: "¿Y en el equipaje facturado?",
      a: "En la maleta de bodega no hay límite de 100 ml para los líquidos de uso personal, aunque sí restricciones para productos inflamables o peligrosos. Si llevas botellas de vino o aceite, protégelas bien.",
    },
  ]}
>
  <LiquidosAvionTool client:load />
</CalcLayout>

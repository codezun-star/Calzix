---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CespedSemillasTool from '@/components/tools/CespedSemillasTool';
---

<CalcLayout slug="cesped-semillas"
  answer={"Para sembrar césped se usan entre 30 y 40 gramos de semilla por metro cuadrado: un jardín de 80 m² a 35 g/m² necesita 2,8 kg de semilla. Para resembrar zonas calvas basta con la mitad de dosis."}
  howTo={[
    "Introduce la superficie que vas a sembrar en m².",
    "Ajusta la dosis de semilla en gramos por m² (la que indica el envase).",
    "Pulsa calcular semilla para ver los kilos necesarios."
  ]}
  whatIs={"La calculadora de semillas de césped calcula la cantidad de semilla necesaria para sembrar o resembrar un césped según la superficie y la dosis recomendada."}
  whyUse={"Te ayuda a comprar la cantidad justa de semilla, presupuestar un jardín nuevo y elegir el momento y el tipo de césped adecuado al clima de tu zona."}
  faqs={[
    {
      q: "¿Cuándo se siembra el césped en España?",
      a: "Las mejores épocas son el otoño (septiembre-octubre) y la primavera (marzo-mayo), con temperaturas suaves. En las zonas de interior y del sur, el otoño es preferible para que el césped se asiente antes del calor del verano.",
    },
    {
      q: "¿Qué césped elegir para un clima caluroso y seco?",
      a: "Mezclas con festuca arundinacea, que resisten bien el calor y necesitan menos agua, o especies de clima cálido como la grama (cynodon) o el kikuyo, que toleran la sequía pero amarillean en invierno. Para zonas húmedas del norte, mezclas de ray-grass y poa.",
    },
    {
      q: "¿Cuánta agua necesita un césped?",
      a: "En verano, en el interior y el sur de España, un césped puede necesitar 5-7 litros por m² al día. Es uno de los jardines que más agua consume: en zonas con sequía frecuente, valora alternativas como plantas tapizantes o xerojardinería.",
    },
    {
      q: "¿Cómo se prepara el terreno?",
      a: "Retira piedras y malas hierbas, cava o labra los primeros 15-20 cm, añade sustrato o arena si el suelo es muy arcilloso, nivela con un rastrillo, siembra a voleo en dos pasadas cruzadas, cubre ligeramente con mantillo y pasa un rodillo. Riega a menudo y poco hasta que germine.",
    },
    {
      q: "¿Cuándo se corta por primera vez?",
      a: "Cuando alcance unos 8-10 cm de altura, normalmente a las 3-5 semanas de la siembra, cortando solo la parte superior (un tercio de la altura).",
    },
  ]}
>
  <CespedSemillasTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CompatibilidadTool from '@/components/tools/CompatibilidadTool';
---

<CalcLayout slug="test-compatibilidad"
  answer={"El test de compatibilidad por nombres calcula un porcentaje de afinidad entre dos personas a partir de las letras de sus nombres. Los mismos nombres dan siempre el mismo resultado. Es un juego para pasar el rato: no tiene base científica y no sirve para tomar decisiones importantes sobre tu relación."}
  howTo={[
    "Escribe el primer nombre.",
    "Escribe el segundo nombre.",
    "Pulsa calcular compatibilidad para ver el porcentaje y su descripción."
  ]}
  whatIs={"El test de compatibilidad es un juego que asigna un porcentaje de afinidad a dos nombres con una fórmula fija basada en sus letras."}
  whyUse={"Sirve para echar unas risas con amigos o en pareja, animar una fiesta de cumpleaños, una despedida o una cena de San Valentín."}
  faqs={[
    {
      q: "¿Cómo se calcula el porcentaje?",
      a: "La herramienta combina los valores de las letras de los dos nombres con una fórmula fija. No es aleatorio: los mismos nombres dan siempre el mismo porcentaje, aunque el orden en que los escribas no cambia el resultado.",
    },
    {
      q: "¿Es fiable?",
      a: "Es un juego para pasar el rato: no tiene base científica y no sirve para tomar decisiones importantes sobre tu relación.",
    },
    {
      q: "¿Qué hace que una pareja sea compatible de verdad?",
      a: "Según la psicología de las relaciones, influyen la comunicación, la confianza, el respeto, los valores y proyectos compartidos y la forma de resolver los conflictos. Ningún test de nombres puede medir eso.",
    },
    {
      q: "¿Puedo probar con apodos?",
      a: "Sí. Cada variante del nombre (completo, apodo, con apellido) da un resultado distinto. Muchos lo usan precisamente para comparar.",
    },
    {
      q: "¿Se guardan los nombres?",
      a: "No. El cálculo se hace en tu navegador y los nombres no se envían a ningún servidor.",
    },
  ]}
>
  <CompatibilidadTool client:load />
</CalcLayout>

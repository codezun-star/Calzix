---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConcentracionPpmTool from '@/components/tools/ConcentracionPpmTool';
---

<CalcLayout slug="concentracion-ppm"
  answer={"Las partes por millón (ppm) indican cuántas unidades de soluto hay por cada millón de unidades de disolución: 5 mg de una sustancia en 1 kg (1.000.000 mg) de disolución son 5 ppm. En disoluciones acuosas diluidas, 1 ppm equivale a 1 mg/L."}
  howTo={[
    "Introduce la masa de soluto en miligramos.",
    "Introduce la masa de la disolución en miligramos.",
    "Pulsa calcular ppm para obtener la concentración."
  ]}
  whatIs={"La calculadora de partes por millón calcula la concentración de una sustancia en ppm a partir de la masa de soluto y la masa de disolución."}
  whyUse={"Sirve para los problemas de disoluciones de Física y Química, para interpretar análisis de agua del grifo, de piscinas o de acuarios y para entender los límites de contaminantes."}
  faqs={[
    {
      q: "¿Qué significa 1 ppm?",
      a: "Una parte de soluto por cada millón de partes de disolución. En agua, como 1 litro pesa aproximadamente 1 kg, 1 ppm equivale a 1 mg/L. Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Qué límites marca la ley para el agua del grifo?",
      a: "El Real Decreto 3/2023 sobre la calidad del agua de consumo fija valores como 50 mg/L (50 ppm) de nitratos, 0,5 mg/L de nitritos en la red, 10 µg/L de plomo y 10 µg/L de arsénico.",
    },
    {
      q: "¿Cuánto cloro debe tener una piscina?",
      a: "Entre 0,5 y 2 mg/L (ppm) de cloro libre en las piscinas de uso público, según el Real Decreto 742/2013. En el agua del grifo, el cloro libre residual no debe superar 1 mg/L.",
    },
    {
      q: "¿Qué son las ppb?",
      a: "Partes por mil millones (billion en inglés): 1 ppm = 1.000 ppb. Se usan para contaminantes muy tóxicos a concentraciones muy bajas, como algunos metales pesados.",
    },
    {
      q: "¿Se usan las ppm para gases?",
      a: "Sí: la concentración de CO₂ en la atmósfera supera las 420 ppm, y en el interior de un aula mal ventilada puede pasar de 1.000-1.500 ppm. Los medidores de CO₂ se usan para comprobar la ventilación.",
    },
  ]}
>
  <ConcentracionPpmTool client:load />
</CalcLayout>

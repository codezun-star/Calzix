---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import MejorHoraLlamarTool from '@/components/tools/MejorHoraLlamarTool';
---

<CalcLayout slug="mejor-hora-llamar"
  answer={"Para llamar desde España a otro país en horario razonable, comprueba la diferencia horaria: si en Madrid son las 18:00, en Nueva York son las 12:00 y en Ciudad de México las 10:00 u 11:00 según la época, buena hora para llamar; en Tokio sería la 1:00 o las 2:00 de la madrugada."}
  howTo={[
    "Elige tu zona horaria en España (península y Baleares o Canarias).",
    "Elige el país o la ciudad a la que llamas.",
    "Indica la fecha y tu hora local y pulsa comprobar para ver la hora en destino y si es buen momento."
  ]}
  whatIs={"La calculadora de la mejor hora para llamar convierte tu hora en España a la hora del país al que llamas, con los cambios de horario de verano de ambos lugares, e indica si es un buen momento para llamar."}
  whyUse={"Te ayuda a llamar a familiares y amigos en el extranjero, programar videollamadas de trabajo con clientes de otros países y no despertar a nadie de madrugada."}
  faqs={[
    {
      q: "¿Cuál es la mejor hora para llamar a América desde España?",
      a: "Por la tarde en España: entre las 15:00 y las 20:00 de la península es por la mañana o mediodía en la costa este de Estados Unidos y en gran parte de Latinoamérica. Para la costa oeste de Estados Unidos, mejor a partir de las 18:00.",
    },
    {
      q: "¿Y para llamar a Asia?",
      a: "Por la mañana en España: a las 9:00 en Madrid son las 15:00 o 16:00 en China y las 16:00 o 17:00 en Japón, según la época del año.",
    },
    {
      q: "¿Tiene en cuenta el horario de verano?",
      a: "Sí. La calculadora usa las zonas horarias oficiales (IANA), que incluyen los cambios de hora de cada país. Como no todos cambian el mismo día, la diferencia puede variar unas semanas en marzo y octubre-noviembre.",
    },
    {
      q: "¿Qué hora es en Canarias?",
      a: "Una hora menos que en la península y Baleares durante todo el año. Si llamas desde Canarias, elige su zona horaria como origen.",
    },
    {
      q: "¿Qué horario se considera adecuado para llamar?",
      a: "Para llamadas personales, entre las 9:00 y las 21:00 hora local del destino; para llamadas de trabajo, en el horario laboral del país, que no siempre coincide con el español (en muchos países se come antes y se termina la jornada más temprano).",
    },
  ]}
>
  <MejorHoraLlamarTool client:load />
</CalcLayout>

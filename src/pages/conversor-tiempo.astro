---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvTiempoTool from '@/components/tools/ConvTiempoTool';
---

<CalcLayout slug="conversor-tiempo"
  answer={"Para convertir unidades de tiempo: 1 minuto = 60 segundos, 1 hora = 3.600 segundos, 1 día = 1.440 minutos, 1 semana = 168 horas y 1 año = 365,25 días de media (8.766 horas). Así, 1.760 horas de trabajo al año equivalen a 73,3 días completos."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 90 minutos o 1.760 horas).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de tiempo convierte entre milisegundos, segundos, minutos, horas, días, semanas, meses y años, usando duraciones medias para los meses y los años."}
  whyUse={"Te ayuda a pasar horas a días o minutos a horas, calcular la duración de un proyecto, las horas de trabajo de un año o un plazo, y resolver problemas de física con unidades de tiempo."}
  faqs={[
    {
      q: "¿Cuántas horas tiene un año?",
      a: "Un año de 365 días tiene 8.760 horas y uno bisiesto, 8.784. La calculadora usa 365,25 días de media (8.766 horas). El próximo año bisiesto es 2028.",
    },
    {
      q: "¿Cuántas horas se trabajan al año en España?",
      a: "Con una jornada de 40 horas semanales, la máxima legal, se trabajan unas 1.760 horas efectivas al año tras descontar 30 días naturales de vacaciones y los 14 festivos. Muchos convenios colectivos fijan jornadas anuales menores, entre 1.700 y 1.780 horas.",
    },
    {
      q: "¿Cuántos días tiene un mes?",
      a: "Entre 28 y 31. La calculadora usa la duración media de 30,44 días (365,25 / 12). Para calcular la diferencia exacta entre dos fechas, usa la calculadora de días entre fechas.",
    },
    {
      q: "¿Qué diferencia hay entre días hábiles y naturales?",
      a: "Los días naturales son todos los del calendario. En los plazos administrativos (Ley 39/2015), los días hábiles excluyen sábados, domingos y festivos. Los plazos en meses o años se cuentan de fecha a fecha.",
    },
    {
      q: "¿Cuántos segundos tiene un día?",
      a: "86.400 segundos (24 × 60 × 60). En física, el segundo se define con la frecuencia de un átomo de cesio-133, y es la unidad de tiempo del Sistema Internacional.",
    },
  ]}
>
  <ConvTiempoTool client:load />
</CalcLayout>

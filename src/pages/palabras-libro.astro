---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PalabrasLibroTool from '@/components/tools/PalabrasLibroTool';
---

<CalcLayout slug="palabras-libro"
  answer={"Un libro tiene aproximadamente sus páginas por las palabras por página: 350 páginas con 280 palabras son unas 98.000 palabras, y a 250 palabras por minuto se leen en unas 6 horas y media."}
  howTo={[
    "Introduce el número de páginas del libro.",
    "Ajusta las palabras por página (unas 250-300 en una novela).",
    "Indica tu velocidad de lectura y pulsa calcular para ver las palabras totales y el tiempo de lectura."
  ]}
  whatIs={"La calculadora de palabras de un libro estima el número total de palabras de un libro a partir de sus páginas y calcula el tiempo que tardarás en leerlo según tu velocidad."}
  whyUse={"Te ayuda a planificar tus lecturas, comparar la extensión de libros y, si escribes, saber cuántas palabras tiene tu manuscrito o cuántas páginas ocupará."}
  faqs={[
    {
      q: "¿Cuántas palabras tiene una novela?",
      a: "Una novela suele tener entre 60.000 y 120.000 palabras. Los concursos y premios literarios en España suelen fijar extensiones mínimas en páginas o palabras en sus bases, por ejemplo, para novela, en torno a las 150-200 páginas.",
    },
    {
      q: "¿Cuántas palabras tiene una página?",
      a: "Una página de novela en formato de bolsillo tiene unas 250-300 palabras; una página de manuscrito estándar a doble espacio, unas 250; y una página de libro técnico a doble columna, 400 o más.",
    },
    {
      q: "¿Cuánto se tarda en leer un libro?",
      a: "Un adulto lee en silencio entre 200 y 250 palabras por minuto en castellano. Una novela de 80.000 palabras se lee en unas 5-7 horas. Usa la calculadora de velocidad de lectura para conocer la tuya.",
    },
    {
      q: "¿Cuántas palabras tiene el Quijote?",
      a: "Las dos partes de «Don Quijote de la Mancha» suman más de 380.000 palabras, lo que supone unas 25-30 horas de lectura a velocidad media.",
    },
    {
      q: "¿Cómo cuento las palabras de mi manuscrito?",
      a: "Los procesadores de texto (Word, LibreOffice, Google Docs) muestran el recuento de palabras. Para estimar las páginas impresas de un libro, divide entre 250-300 palabras por página según el formato.",
    },
  ]}
>
  <PalabrasLibroTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import TiradaDadosTool from '@/components/tools/TiradaDadosTool';
---

<CalcLayout slug="tirada-dados"
  answer={"El tirador de dados lanza los dados que quieras, de cualquier número de caras, y suma un modificador: «2d6+3» son dos dados de 6 caras más 3, con un resultado entre 5 y 15. Se usa crypto.getRandomValues(), el generador aleatorio criptográfico del navegador, de modo que cada resultado tiene la misma probabilidad. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor."}
  howTo={[
    "Elige el número de dados.",
    "Elige las caras de cada dado (4, 6, 8, 10, 12, 20…).",
    "Añade el modificador, si lo hay, y pulsa tirar dados."
  ]}
  whatIs={"El tirador de dados lanza dados virtuales con la notación de los juegos de rol (NdX+M) y muestra el resultado de cada dado, el modificador y el total."}
  whyUse={"Es perfecto para partidas de rol como Dungeons & Dragons o La llamada de Cthulhu, juegos de mesa y wargames cuando no tienes los dados a mano."}
  faqs={[
    {
      q: "¿Qué significa 2d6+3?",
      a: "Lanzar 2 dados de 6 caras y sumar 3 al resultado. La «d» indica dado, el número anterior cuántos dados y el posterior, sus caras.",
    },
    {
      q: "¿Son justos los dados virtuales?",
      a: "Se usa crypto.getRandomValues(), el generador aleatorio criptográfico del navegador, de modo que cada resultado tiene la misma probabilidad. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor.",
    },
    {
      q: "¿Qué resultado es el más probable con 2d6?",
      a: "El 7, con 6 de 36 combinaciones (16,7 %). Los extremos, 2 y 12, tienen solo 1/36 (2,8 %). Al sumar varios dados, los resultados se concentran en el centro.",
    },
    {
      q: "¿Qué es una tirada con ventaja?",
      a: "En algunos juegos de rol, se lanzan dos d20 y se toma el mayor (ventaja) o el menor (desventaja). Puedes hacerlo lanzando 2 dados de 20 caras y eligiendo el resultado.",
    },
    {
      q: "¿Dónde se juega al rol en España?",
      a: "En asociaciones, tiendas especializadas y jornadas de rol de muchas ciudades, además de en partidas en línea. Los juegos de rol en castellano tienen una comunidad muy activa.",
    },
  ]}
>
  <TiradaDadosTool client:load />
</CalcLayout>

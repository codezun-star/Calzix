---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import VelocidadLecturaTool from '@/components/tools/VelocidadLecturaTool';
---

<CalcLayout slug="velocidad-lectura"
  answer={"La velocidad lectora es el número de palabras leídas dividido entre los minutos empleados: si lees 1.200 palabras en 5 minutos, tu velocidad es de 240 palabras por minuto, la media de un adulto en lectura silenciosa en castellano (entre 200 y 250 ppm)."}
  howTo={[
    "Elige si vas a introducir las palabras o las páginas leídas.",
    "Introduce la cantidad leída y el tiempo empleado en minutos.",
    "Pulsa calcular velocidad para ver tus palabras por minuto y tu nivel."
  ]}
  whatIs={"La calculadora de velocidad de lectura mide cuántas palabras lees por minuto y te compara con los valores de referencia para lectores en castellano."}
  whyUse={"Te ayuda a conocer tu ritmo para planificar el estudio, preparar oposiciones o la PAU, mejorar tu velocidad con práctica y seguir la evolución lectora de tus hijos o alumnos."}
  faqs={[
    {
      q: "¿Cuál es la velocidad lectora normal?",
      a: "En lectura silenciosa, un adulto lee entre 200 y 250 palabras por minuto con buena comprensión; un buen lector, entre 250 y 350; y por encima de 400 ppm suele bajar la comprensión. La lectura en voz alta es más lenta: unas 130-160 ppm.",
    },
    {
      q: "¿Qué velocidad lectora se espera en Primaria y ESO?",
      a: "Las referencias más usadas por los centros educativos españoles van, en lectura en voz alta, desde unas 60-80 palabras por minuto al final de 2.º de Primaria hasta 120-150 al terminar la Primaria. En la ESO se espera una lectura fluida y comprensiva, con velocidades en silencio de unas 180-220 ppm.",
    },
    {
      q: "¿Cómo está España en comprensión lectora?",
      a: "En el informe PISA 2022, los alumnos españoles de 15 años obtuvieron 474 puntos en lectura, en torno a la media de la OCDE (476). En PIRLS 2021, que evalúa a alumnos de 4.º de Primaria, España obtuvo 521 puntos, por encima de la media internacional.",
    },
    {
      q: "¿Sirve la lectura rápida?",
      a: "Las técnicas de lectura rápida que prometen más de 1.000 ppm reducen mucho la comprensión, según la investigación sobre lectura. Lo que sí funciona es leer mucho y con frecuencia, ampliar el vocabulario y hacer una lectura previa rápida (prelectura) de los textos de estudio antes de leerlos en profundidad.",
    },
    {
      q: "¿Cómo mido mi velocidad?",
      a: "Elige un texto de dificultad normal, cronometra 3-5 minutos de lectura en silencio y cuenta las palabras (o calcula páginas × palabras por página). Repite la prueba con distintos textos para obtener una media.",
    },
  ]}
>
  <VelocidadLecturaTool client:load />
</CalcLayout>

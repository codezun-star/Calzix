---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import BaldosasSueloTool from '@/components/tools/BaldosasSueloTool';
---

<CalcLayout slug="baldosas-suelo"
  answer={"Para saber cuántas baldosas necesitas divide la superficie del suelo entre la superficie de cada baldosa y añade un 10 % de merma: un suelo de 5 × 4 m (20 m²) con baldosas de 60 × 60 cm necesita 56 baldosas, y 62 con la merma."}
  howTo={[
    "Introduce el largo y el ancho del suelo en metros.",
    "Introduce el tamaño de la baldosa en metros (60 × 60 cm = 0,6 × 0,6).",
    "Indica la merma (10 % habitual, 15 % en diagonal) y pulsa calcular."
  ]}
  whatIs={"La calculadora de baldosas calcula cuántas baldosas, azulejos o piezas de gres necesitas para un suelo según sus dimensiones y el tamaño de la pieza, incluido un porcentaje de merma por cortes y roturas."}
  whyUse={"Te ayuda a pedir la cantidad correcta en la tienda o el almacén, comparar presupuestos de solado y evitar quedarte sin piezas del mismo lote de color."}
  faqs={[
    {
      q: "¿Cuánta merma hay que añadir?",
      a: "Un 10 % para una colocación recta normal, un 15 % si colocas las baldosas en diagonal o en espiga, y algo más en estancias con muchos recortes. Guarda algunas piezas sobrantes para futuras reparaciones: es difícil encontrar más adelante el mismo lote de color.",
    },
    {
      q: "¿Cómo se venden las baldosas?",
      a: "En España se venden normalmente por cajas que cubren un número de metros cuadrados indicado en el embalaje. Calcula los m² con merma y redondea al alza al número de cajas. Comprueba que todas las cajas sean del mismo lote y tono.",
    },
    {
      q: "¿Qué tipo de baldosa elegir?",
      a: "El gres porcelánico es el más resistente y apto para cualquier estancia, incluso exteriores si es antideslizante. El gres esmaltado es más económico para interiores con poco tránsito. En baños, cocinas y exteriores, el Código Técnico de la Edificación exige suelos con una resbaladicidad mínima (clase 2 en zonas húmedas interiores y clase 3 en exteriores y duchas).",
    },
    {
      q: "¿Cuánto cuesta poner un suelo de baldosas?",
      a: "La mano de obra de colocación suele costar entre 20 y 40 € por m² en España, más el material (desde unos 10 €/m² en gres básico hasta más de 50 €/m² en porcelánicos de gran formato). La retirada del suelo antiguo y la nivelación se presupuestan aparte.",
    },
    {
      q: "¿Qué separación dejar entre baldosas?",
      a: "Depende del formato y del tipo de pieza: entre 2 y 3 mm en piezas rectificadas y de 3 a 5 mm en piezas no rectificadas o rústicas. Usa crucetas o niveladores y deja también una junta perimetral junto a las paredes que quedará oculta por el rodapié.",
    },
  ]}
>
  <BaldosasSueloTool client:load />
</CalcLayout>

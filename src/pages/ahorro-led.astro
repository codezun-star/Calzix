---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AhorroLedTool from '@/components/tools/AhorroLedTool';
---

<CalcLayout slug="ahorro-led"
  answer={"Cambiar una bombilla incandescente de 60 W por un LED de 9 W ahorra el 85 % de su consumo: con 10 bombillas encendidas 5 horas al día, pasas de 1.095 kWh a 164 kWh al año y ahorras unos 140 € con la luz a 0,15 €/kWh."}
  howTo={[
    "Introduce el número de bombillas y las horas al día que están encendidas.",
    "Escribe la potencia de la bombilla antigua y la del LED.",
    "Indica el precio del kWh y pulsa calcular para ver el ahorro anual."
  ]}
  whatIs={"La calculadora de ahorro con bombillas LED compara el consumo y el coste de tus bombillas actuales con el de bombillas LED equivalentes y calcula el ahorro anual en kWh y en euros."}
  whyUse={"Te ayuda a decidir qué bombillas cambiar primero, calcular en cuánto tiempo recuperas la inversión y reducir la factura de la luz."}
  faqs={[
    {
      q: "¿Qué LED equivale a una bombilla de 60 W?",
      a: "Una bombilla LED de 8-10 W y unos 800 lúmenes da la misma luz que una incandescente de 60 W. Para comparar, fíjate en los lúmenes, no en los vatios: 450 lm equivalen a 40 W, 800 lm a 60 W y 1.500 lm a 100 W.",
    },
    {
      q: "¿Siguen vendiéndose bombillas incandescentes?",
      a: "No. La Unión Europea retiró progresivamente las incandescentes y halógenas, y desde 2023 tampoco se pueden comercializar la mayoría de fluorescentes compactos. Si aún tienes alguna, sustituirla por LED es lo que más ahorra.",
    },
    {
      q: "¿Cuánto dura una bombilla LED?",
      a: "Entre 15.000 y 25.000 horas, frente a las 1.000 de una incandescente. Con 3 horas diarias, una LED puede durar más de 15 años. Las de buena calidad mantienen el color y la intensidad durante más tiempo.",
    },
    {
      q: "¿Qué temperatura de color elijo?",
      a: "Luz cálida (2.700-3.000 K) para salones y dormitorios, neutra (4.000 K) para cocinas, baños y zonas de trabajo, y fría (5.000-6.500 K) para garajes o trasteros. La etiqueta energética de las bombillas va de la A a la G desde 2021.",
    },
    {
      q: "¿Dónde se reciclan las bombillas?",
      a: "Las LED, los fluorescentes y las de bajo consumo son residuos de aparatos eléctricos: llévalas a un punto limpio o a los contenedores de las tiendas que las venden, que están obligadas a recogerlas. No las tires al contenedor de vidrio.",
    },
  ]}
>
  <AhorroLedTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import SalarioPorHoraTool from '@/components/tools/SalarioPorHoraTool';
---

<CalcLayout slug="salario-por-hora"
  answer={"Para pasar de salario anual a salario por hora divide el bruto anual entre las horas trabajadas al año: con 30.000 € y 40 horas semanales durante 52 semanas (2.080 horas), son 14,42 € por hora; descontando vacaciones y festivos (unas 1.760 horas efectivas), son 17,05 € por hora."}
  howTo={[
    "Elige si quieres pasar de salario anual a salario por hora o al revés.",
    "Introduce el importe, las horas semanales y las semanas al año.",
    "Pulsa calcular para ver el resultado."
  ]}
  whatIs={"La calculadora de salario por hora convierte un salario anual en salario por hora, y viceversa, según la jornada semanal y las semanas trabajadas al año."}
  whyUse={"Te ayuda a comparar ofertas con distinta jornada, saber cuánto vale tu hora para valorar horas extra o un trabajo por cuenta propia y comprobar que cobras al menos el salario mínimo."}
  faqs={[
    {
      q: "¿Cuántas horas se trabajan al año en España?",
      a: "La jornada máxima legal es de 40 horas semanales de trabajo efectivo de promedio anual. Descontando 30 días naturales de vacaciones y 14 festivos, salen unas 1.760 horas efectivas al año. Muchos convenios fijan jornadas anuales algo menores, entre 1.700 y 1.780 horas.",
    },
    {
      q: "¿Cuál es el salario mínimo por hora?",
      a: "El salario mínimo de 2026 es de 1.221 € brutos al mes en 14 pagas (17.094 € al año). Para los empleados del hogar que trabajan por horas, el Real Decreto del SMI fija un salario mínimo por hora efectivamente trabajada, que en 2026 ronda los 9,5 € brutos.",
    },
    {
      q: "¿Debo usar 52 semanas o descontar las vacaciones?",
      a: "Si quieres saber cuánto te pagan por cada hora realmente trabajada, descuenta las vacaciones y los festivos (unas 44 semanas efectivas). Si quieres comparar con una tarifa de autónomo, usa las horas facturables reales, que suelen ser bastantes menos.",
    },
    {
      q: "¿Cómo se pagan las horas extra?",
      a: "Según el convenio o el contrato, con una cantidad que no puede ser inferior al valor de la hora ordinaria, o compensadas con descanso en los cuatro meses siguientes. El máximo legal es de 80 horas extra al año. Usa la calculadora de horas extra para el detalle.",
    },
    {
      q: "¿El salario por hora es bruto o neto?",
      a: "La calculadora trabaja con el bruto. Para conocer el neto, resta las cotizaciones del trabajador (6,50 % en 2026) y la retención del IRPF, o usa la calculadora de nómina.",
    },
  ]}
>
  <SalarioPorHoraTool client:load />
</CalcLayout>

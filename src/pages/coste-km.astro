---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CosteKmTool from '@/components/tools/CosteKmTool';
---

<CalcLayout slug="coste-km"
  answer={"El coste por kilómetro de un coche incluye el combustible y el mantenimiento: con un consumo de 6,5 L/100 km, la gasolina a 1,85 €/L y 0,05 € de mantenimiento por km, cada kilómetro cuesta 0,17 €, unos 17 € cada 100 km, sin contar seguro, impuestos ni depreciación."}
  howTo={[
    "Introduce el consumo de tu coche en L/100 km.",
    "Escribe el precio del combustible por litro.",
    "Añade el coste de mantenimiento por kilómetro y pulsa calcular."
  ]}
  whatIs={"La calculadora de coste por kilómetro calcula lo que te cuesta cada kilómetro de tu coche en combustible y mantenimiento, y el coste de cada 100 km."}
  whyUse={"Te ayuda a comparar el coche con el transporte público, repartir los gastos de un viaje compartido y comprobar si la compensación por kilometraje de tu empresa cubre tus costes."}
  faqs={[
    {
      q: "¿Cuánto cuesta realmente un coche por kilómetro?",
      a: "Solo en combustible y mantenimiento, entre 0,10 y 0,20 € por km. Si sumas el seguro, el impuesto de circulación, la ITV, el aparcamiento y la depreciación, el coste total suele estar entre 0,25 y 0,45 € por km para un turismo medio que hace 15.000 km al año.",
    },
    {
      q: "¿Cuánto paga Hacienda por kilómetro?",
      a: "La compensación por el uso del vehículo propio en desplazamientos de trabajo está exenta de IRPF hasta 0,26 € por kilómetro, más los gastos justificados de peaje y aparcamiento. Si la empresa paga más, el exceso tributa como salario.",
    },
    {
      q: "¿Cuánto cuesta el kilómetro en un coche eléctrico?",
      a: "Con un consumo de 15 kWh/100 km y la electricidad a 0,15 €/kWh cargando en casa, unos 2,25 € cada 100 km, alrededor de 0,02 € por km. En cargadores rápidos públicos puede costar tres o cuatro veces más.",
    },
    {
      q: "¿Cómo calculo el mantenimiento por kilómetro?",
      a: "Suma lo que gastas al año en revisiones, aceite, neumáticos, frenos y reparaciones y divídelo entre los kilómetros anuales. Para un turismo medio suele estar entre 0,03 y 0,06 € por km.",
    },
    {
      q: "¿Dónde consulto el precio del combustible?",
      a: "En el Geoportal de Gasolineras del Ministerio para la Transición Ecológica, que muestra el precio actualizado de todas las gasolineras de España. En octubre de 2026 la gasolina rondaba 1,85 €/L y el diésel 1,92 €/L de media.",
    },
  ]}
>
  <CosteKmTool client:load />
</CalcLayout>

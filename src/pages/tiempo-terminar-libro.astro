---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import TiempoLibroTool from '@/components/tools/TiempoLibroTool';
---

<CalcLayout slug="tiempo-terminar-libro"
  answer={"El tiempo para terminar un libro es el número de palabras (páginas × palabras por página) dividido entre tu velocidad lectora: un libro de 350 páginas con 250 palabras por página tiene 87.500 palabras; a 250 palabras por minuto, son unas 5 horas y 50 minutos, unos 12 días leyendo 30 minutos al día."}
  howTo={[
    "Introduce las páginas del libro y las palabras por página (unas 250-300 en una novela).",
    "Indica tu velocidad lectora en palabras por minuto.",
    "Escribe los minutos que lees al día y pulsa calcular."
  ]}
  whatIs={"La calculadora de tiempo para terminar un libro estima cuántas horas de lectura necesitas para leer un libro y cuántos días tardarás según el tiempo que le dedicas cada día."}
  whyUse={"Te ayuda a planificar tus lecturas, saber si te dará tiempo a terminar un libro antes de la reunión del club de lectura, de un viaje o de un examen, y a elegir qué leer en vacaciones."}
  faqs={[
    {
      q: "¿Cuántas palabras tiene una página?",
      a: "Una novela en formato de bolsillo tiene entre 250 y 300 palabras por página; un libro de tapa dura con letra grande, entre 200 y 250; y un libro técnico o una página de un manual a doble columna, 400 o más.",
    },
    {
      q: "¿Cuál es mi velocidad lectora?",
      a: "Un adulto lee en silencio entre 200 y 250 palabras por minuto en castellano con buena comprensión. Puedes medir la tuya con la calculadora de velocidad de lectura: lee durante unos minutos y cuenta las palabras.",
    },
    {
      q: "¿Cuánto se tarda en leer los libros más conocidos?",
      a: "Como referencia, a 250 palabras por minuto, una novela de unas 80.000 palabras se lee en unas 5 horas y media. Las dos partes de «Don Quijote», con más de 380.000 palabras, requieren unas 25-30 horas de lectura.",
    },
    {
      q: "¿Los audiolibros cuentan?",
      a: "Sí, son una forma de lectura cada vez más popular en España. Un narrador lee a unas 150-160 palabras por minuto, así que un audiolibro dura algo más que la lectura en silencio. Muchas apps permiten acelerar la reproducción a 1,25 o 1,5x.",
    },
    {
      q: "¿Cómo leer más sin perder comprensión?",
      a: "Lee en un lugar tranquilo y sin notificaciones, evita volver atrás sin motivo, amplía el vocabulario leyendo con frecuencia y elige textos adecuados a tu nivel. La práctica diaria aumenta la velocidad de forma natural.",
    },
  ]}
>
  <TiempoLibroTool client:load />
</CalcLayout>

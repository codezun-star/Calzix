---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvPresionTool from '@/components/tools/ConvPresionTool';
---

<CalcLayout slug="conversor-presion"
  answer={"Para convertir presiones usa estos factores: 1 bar = 100.000 Pa = 14,5 PSI, 1 atm = 1,013 bar = 760 mmHg y 1 hPa = 100 Pa. Unos neumáticos a 2,3 bar están a 33,4 PSI, y la presión atmosférica normal es de 1.013 hPa."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 2,3 bar o 35 PSI).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de presión convierte entre pascales, kilopascales, megapascales, bares, atmósferas, PSI y milímetros de mercurio con los factores exactos."}
  whyUse={"Sirve para inflar las ruedas con un compresor que marca PSI, interpretar la presión atmosférica de la AEMET en hectopascales, entender la tensión arterial en mmHg o la presión de una caldera o un depósito."}
  faqs={[
    {
      q: "¿A qué presión inflo las ruedas del coche?",
      a: "La presión recomendada figura en una etiqueta en el marco de la puerta del conductor, en la tapa del depósito o en el manual, y suele estar entre 2,2 y 2,5 bar (32-36 PSI) en turismos. Revísala en frío al menos una vez al mes; una presión baja aumenta el consumo y el desgaste.",
    },
    {
      q: "¿Qué presión debe tener una caldera de gas?",
      a: "Las calderas murales de calefacción suelen trabajar entre 1 y 1,5 bar en frío. Si baja de 1 bar, hay que rellenarla con la llave de llenado; si sube por encima de 2,5-3 bar, puede saltar la válvula de seguridad. Consulta el manual de tu caldera.",
    },
    {
      q: "¿Qué es la presión atmosférica normal?",
      a: "Al nivel del mar, 1.013,25 hPa = 1 atm = 760 mmHg. La AEMET expresa la presión en hectopascales: valores por encima de 1.020 hPa suelen indicar anticiclón y buen tiempo, y por debajo de 1.000 hPa, borrascas. En Madrid, a 650 m de altitud, la presión real es unos 75 hPa menor.",
    },
    {
      q: "¿Por qué la tensión arterial se mide en mmHg?",
      a: "Por tradición: los primeros tensiómetros eran de columna de mercurio. Una tensión de 12/8 significa 120/80 mmHg. Se considera hipertensión a partir de 140/90 mmHg en consulta.",
    },
    {
      q: "¿Cuántos PSI son 1 bar?",
      a: "1 bar = 14,504 PSI, y 1 PSI = 0,0689 bar. Los compresores y manómetros de origen estadounidense suelen marcar PSI.",
    },
  ]}
>
  <ConvPresionTool client:load />
</CalcLayout>

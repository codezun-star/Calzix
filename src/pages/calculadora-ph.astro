---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PhTool from '@/components/tools/PhTool';
---

<CalcLayout slug="calculadora-ph"
  answer={"El pH es el logaritmo negativo de la concentración de iones H⁺: pH = −log[H⁺]. Una disolución con [H⁺] = 0,001 mol/L tiene pH 3 (ácida), y a 25 °C se cumple pH + pOH = 14. El agua del grifo en España debe tener un pH entre 6,5 y 9,5."}
  howTo={[
    "Elige qué dato conoces: el pH, la concentración de H⁺ o el pOH.",
    "Introduce el valor.",
    "Pulsa calcular para obtener el pH, el pOH, las concentraciones de H⁺ y OH⁻ y si la disolución es ácida, neutra o básica."
  ]}
  whatIs={"La calculadora de pH convierte entre pH, pOH y concentraciones de iones H⁺ y OH⁻, y clasifica la disolución de ácido muy fuerte a base muy fuerte."}
  whyUse={"Sirve para los problemas de ácidos y bases de Química de 2.º de Bachillerato y la PAU, y para entender el pH del agua del grifo, de la piscina, del suelo del jardín o de los productos de limpieza."}
  faqs={[
    {
      q: "¿Qué pH tienen las sustancias habituales?",
      a: "Aproximadamente: zumo de limón, 2; vinagre, 3; café, 5; agua pura, 7; sangre, 7,4; agua de mar, 8,1; bicarbonato, 8,3; lejía, 12-13. Cada unidad de pH supone multiplicar por 10 la concentración de H⁺.",
    },
    {
      q: "¿Qué pH debe tener el agua del grifo?",
      a: "El Real Decreto 3/2023 sobre la calidad del agua de consumo humano fija un valor paramétrico de pH entre 6,5 y 9,5. En zonas de agua dura, como gran parte del Levante y el sur de España, el pH suele estar entre 7,5 y 8,5.",
    },
    {
      q: "¿Qué pH debe tener una piscina?",
      a: "Entre 7,2 y 8,0, según el Real Decreto 742/2013 sobre piscinas de uso público, y lo ideal es mantenerlo en torno a 7,2-7,6. Fuera de ese rango, el cloro pierde eficacia y el agua puede irritar los ojos y la piel.",
    },
    {
      q: "¿Qué es el pOH?",
      a: "Es el logaritmo negativo de la concentración de iones OH⁻. A 25 °C, el producto iónico del agua es 10⁻¹⁴, por lo que pH + pOH = 14. Una disolución con pH 3 tiene pOH 11.",
    },
    {
      q: "¿Qué pH necesita el suelo de un huerto?",
      a: "La mayoría de hortalizas prefieren un pH entre 6 y 7,5. Muchos suelos de la mitad sur y el este de España son calizos y básicos (pH 7,5-8,5), mientras que en Galicia y el norte abundan los suelos ácidos, buenos para hortensias, camelias o arándanos.",
    },
  ]}
>
  <PhTool client:load />
</CalcLayout>

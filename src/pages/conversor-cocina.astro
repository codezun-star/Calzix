---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorCocinaTool from '@/components/tools/ConversorCocinaTool';
---

<CalcLayout slug="conversor-cocina"
  answer={"En la cocina, una cucharada sopera equivale a unos 15 ml, una cucharadita de postre a 5 ml y una taza de las recetas americanas a unos 240 ml. Para ingredientes secos, el peso depende del ingrediente: una taza de harina pesa unos 120-125 g y una de azúcar, unos 200 g."}
  howTo={[
    "Introduce la cantidad.",
    "Elige la unidad de origen (taza, cucharada, cucharadita, mililitros…).",
    "Pulsa convertir para ver la equivalencia en las demás unidades."
  ]}
  whatIs={"El conversor de medidas de cocina convierte entre tazas, cucharadas, cucharaditas, mililitros y otras medidas de volumen para seguir recetas de cualquier país con las medidas que usamos en España."}
  whyUse={"Te ayuda a seguir recetas de blogs y libros en inglés que usan tazas y onzas, a cocinar sin báscula y a adaptar cantidades en repostería, donde la precisión importa."}
  faqs={[
    {
      q: "¿Cuántos ml tiene una cucharada?",
      a: "Una cucharada sopera tiene unos 15 ml y una cucharadita de postre o de café, unos 5 ml. En las recetas españolas «una cucharada» suele referirse a la sopera, rasa salvo que se indique «colmada».",
    },
    {
      q: "¿Cuántos gramos son una taza de harina?",
      a: "Una taza americana (240 ml) de harina de trigo pesa unos 120-125 g si se llena sin apretar. De azúcar, unos 200 g; de arroz, unos 185 g; de mantequilla, unos 225 g. Por eso en repostería es mejor pesar.",
    },
    {
      q: "¿Cuánto es un vaso en las recetas españolas?",
      a: "Un vaso de agua de los de toda la vida tiene unos 200-250 ml. Muchas recetas tradicionales usan el vaso como medida; con una báscula o una jarra medidora el resultado es más preciso.",
    },
    {
      q: "¿Cuánto es una onza?",
      a: "En peso, una onza son 28,35 g; en volumen, una onza líquida estadounidense son 29,57 ml. En España, «una onza de chocolate» es una de las porciones de la tableta, que varía según la marca.",
    },
    {
      q: "¿Cómo convierto grados Fahrenheit del horno?",
      a: "350 °F son unos 180 °C, 375 °F unos 190 °C y 400 °F unos 200 °C. Usa el conversor de temperatura para otras temperaturas.",
    },
  ]}
>
  <ConversorCocinaTool client:load />
</CalcLayout>

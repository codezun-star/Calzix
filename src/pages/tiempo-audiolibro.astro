---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import TiempoAudiolibroTool from '@/components/tools/TiempoAudiolibroTool';
---

<CalcLayout slug="tiempo-audiolibro"
  answer={"La duración de un audiolibro son las palabras del libro divididas entre la velocidad de narración: 320 páginas con 280 palabras (89.600 palabras) narradas a 150 palabras por minuto duran unas 10 horas; a velocidad 1,5×, unas 6 horas y 40 minutos."}
  howTo={[
    "Introduce las páginas del libro y las palabras por página.",
    "Ajusta la velocidad de narración (unas 150 palabras por minuto).",
    "Elige la velocidad de reproducción y pulsa calcular para ver la duración."
  ]}
  whatIs={"La calculadora de duración de audiolibros estima cuánto dura un audiolibro a partir de la extensión del libro y la velocidad de narración, y cuánto tiempo ahorras escuchándolo más rápido."}
  whyUse={"Te ayuda a planificar qué escuchar en tus trayectos al trabajo, viajes largos en coche o mientras haces deporte, y a decidir a qué velocidad escucharlo."}
  faqs={[
    {
      q: "¿A qué velocidad se narra un audiolibro?",
      a: "Los narradores profesionales leen a unas 150-160 palabras por minuto en castellano, algo más despacio que la lectura en silencio. Por eso un audiolibro suele durar más que lo que tardarías en leer el libro.",
    },
    {
      q: "¿Se entiende bien a 1,5×?",
      a: "Muchas personas comprenden bien a 1,25× o 1,5× tras acostumbrarse. Para textos complejos o en otro idioma, conviene una velocidad normal. Las aplicaciones permiten cambiarla en cualquier momento.",
    },
    {
      q: "¿Dónde escuchar audiolibros gratis?",
      a: "En eBiblio, el servicio de préstamo digital de las bibliotecas públicas españolas, que incluye audiolibros y se usa gratis con el carné de biblioteca de tu comunidad autónoma. Algunas comunidades tienen además su propia plataforma.",
    },
    {
      q: "¿Cuenta escuchar un audiolibro como leer?",
      a: "Para la comprensión de la historia, los estudios muestran resultados similares. El Barómetro de Hábitos de Lectura incluye los audiolibros como formato de lectura, cada vez más usado en España.",
    },
    {
      q: "¿Cuánto dura un audiolibro de media?",
      a: "Una novela de unas 300 páginas dura entre 8 y 12 horas de audio. Con 30 minutos al día de trayecto, la terminarías en unas tres semanas.",
    },
  ]}
>
  <TiempoAudiolibroTool client:load />
</CalcLayout>

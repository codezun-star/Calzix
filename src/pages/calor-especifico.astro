---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CalorEspecificoTool from '@/components/tools/CalorEspecificoTool';
---

<CalcLayout slug="calor-especifico"
  answer={"El calor necesario para calentar un cuerpo es Q = m · c · ΔT: calentar 1 litro de agua (1 kg, c = 4.184 J/kg·K) de 20 a 100 °C requiere 334.720 J, unos 335 kJ o 0,093 kWh. La calculadora despeja también la masa, el calor específico o la variación de temperatura."}
  howTo={[
    "Elige qué quieres calcular: el calor (Q), la masa, el calor específico o la variación de temperatura.",
    "Introduce los otros tres datos en las unidades indicadas.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de calor específico aplica la ecuación fundamental de la calorimetría, Q = m · c · ΔT, para calcular el calor absorbido o cedido por un cuerpo o cualquiera de las otras variables."}
  whyUse={"Sirve para los problemas de calorimetría de Física y Química, para estimar la energía (y el coste) de calentar agua en un termo o en la cocina y para entender por qué el agua regula el clima de las zonas costeras."}
  faqs={[
    {
      q: "¿Qué es el calor específico?",
      a: "Es la energía necesaria para elevar 1 °C (o 1 K) la temperatura de 1 kg de una sustancia. El agua tiene un calor específico muy alto, 4.184 J/(kg·K), frente a los 900 del aluminio, los 450 del hierro o unos 2.000 del aceite de oliva. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Cuánto cuesta calentar el agua de un termo?",
      a: "Un termo de 80 litros que calienta el agua de 15 a 60 °C necesita Q = 80 × 4.184 × 45 = 15,1 MJ, unos 4,2 kWh. Con la electricidad a unos 0,15 €/kWh, cada llenado completo cuesta unos 0,63 €, más las pérdidas de calor del depósito.",
    },
    {
      q: "¿Por qué el clima es más suave en la costa?",
      a: "Porque el mar, por el alto calor específico del agua, se calienta y se enfría muy despacio y suaviza las temperaturas. Por eso en ciudades como Málaga o Valencia la diferencia entre el día y la noche y entre el verano y el invierno es menor que en Madrid o Zaragoza.",
    },
    {
      q: "¿Cuál es la diferencia entre calor y temperatura?",
      a: "La temperatura mide el grado de agitación de las partículas; el calor es la energía que se transfiere entre cuerpos a distinta temperatura. Un cubo de agua templada puede contener más energía térmica que una chispa muy caliente.",
    },
    {
      q: "¿Qué pasa en un cambio de estado?",
      a: "Durante la fusión o la ebullición la temperatura no cambia aunque se aporte calor: la energía se usa para cambiar de estado (calor latente). Fundir 1 kg de hielo requiere 334 kJ y evaporar 1 kg de agua, unos 2.257 kJ. Q = m · c · ΔT no se aplica en esos tramos.",
    },
  ]}
>
  <CalorEspecificoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PorcentajeTool from '@/components/tools/PorcentajeTool';
---

<CalcLayout slug="calculadora-porcentaje"
  answer={"Para calcular un porcentaje multiplica la cantidad por el porcentaje y divide entre 100: el 21 % de 250 € son 52,50 €. Para saber qué porcentaje es un número de otro, divide la parte entre el total y multiplica por 100: 45 de 180 es el 25 %."}
  howTo={[
    "Elige el tipo de cálculo: porcentaje de una cantidad, qué porcentaje representa un valor o valor original.",
    "Introduce los números.",
    "Pulsa calcular para obtener el resultado al instante."
  ]}
  whatIs={"La calculadora de porcentajes resuelve los cálculos de porcentajes más habituales: el porcentaje de una cantidad, qué porcentaje representa un número sobre otro, los aumentos y disminuciones porcentuales y el valor original antes de un cambio."}
  whyUse={"Sirve para calcular el IVA, los descuentos de las rebajas, la subida de un sueldo o de un alquiler, la variación del IPC, la nota de un examen o la evolución de cualquier dato, sin errores."}
  faqs={[
    {
      q: "¿Cómo se calcula el porcentaje de una cantidad?",
      a: "Multiplica la cantidad por el porcentaje y divide entre 100: el 15 % de 80 = 80 × 15 / 100 = 12. Atajo mental: el 10 % se obtiene moviendo la coma un lugar a la izquierda (el 10 % de 80 es 8), el 5 % es la mitad del 10 % y el 50 %, la mitad.",
    },
    {
      q: "¿Cómo calculo qué porcentaje es un número de otro?",
      a: "Divide la parte entre el total y multiplica por 100: si has acertado 34 de 40 preguntas, has acertado el 34 / 40 × 100 = 85 %. Si en tu nómina te retienen 4.926 € de 30.000 €, tu retención es del 16,42 %.",
    },
    {
      q: "¿Cómo se calcula un aumento o una disminución porcentual?",
      a: "Variación (%) = (valor nuevo − valor anterior) ÷ valor anterior × 100. Si tu alquiler pasa de 800 a 832 €, ha subido un 4 %. Para aplicar un aumento: valor × (1 + %/100); para una disminución: valor × (1 − %/100).",
    },
    {
      q: "¿Cómo se calcula el IVA con porcentajes?",
      a: "Para añadir el IVA del 21 %, multiplica la base por 1,21: 200 € de base son 242 € con IVA. Para quitarlo de un precio final, divide entre 1,21: 242 / 1,21 = 200 €. No restes el 21 % al precio final, porque el 21 % se calcula sobre la base, no sobre el total. La calculadora de IVA lo hace directamente.",
    },
    {
      q: "¿Por qué subir un 10 % y luego bajar un 10 % no deja el mismo valor?",
      a: "Porque el segundo porcentaje se aplica sobre una cantidad distinta: 100 € + 10 % = 110 €; 110 € − 10 % = 99 €. Lo mismo ocurre con los descuentos sucesivos o con las subidas y bajadas de la bolsa: los porcentajes no se suman ni se restan directamente.",
    },
    {
      q: "¿Qué diferencia hay entre puntos porcentuales y porcentaje?",
      a: "Si el tipo de interés pasa del 3 % al 4 %, ha subido 1 punto porcentual, pero un 33 % en términos relativos. En noticias económicas (Euríbor, paro, IPC) se usan los puntos porcentuales para las diferencias entre dos porcentajes.",
    },
  ]}
>
  <PorcentajeTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DilucionesTool from '@/components/tools/DilucionesTool';
---

<CalcLayout slug="diluciones-quimica"
  answer={"En una dilución se conserva la cantidad de soluto, así que C₁ · V₁ = C₂ · V₂: para diluir 50 mL de una disolución 2 M hasta 0,5 M, el volumen final debe ser 50 × 2 / 0,5 = 200 mL, es decir, hay que añadir 150 mL de agua."}
  howTo={[
    "Elige la variable que quieres calcular: volumen final, concentración final, volumen inicial o concentración inicial.",
    "Introduce los otros tres datos.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de diluciones aplica la ecuación C₁ · V₁ = C₂ · V₂ para calcular el volumen o la concentración de una disolución antes o después de diluirla."}
  whyUse={"Sirve para preparar disoluciones en el laboratorio del instituto o la universidad, resolver problemas de Química y diluir correctamente productos concentrados de limpieza o de jardinería."}
  faqs={[
    {
      q: "¿Por qué funciona C₁V₁ = C₂V₂?",
      a: "Porque al añadir disolvente cambia el volumen, pero no la cantidad de soluto: los moles iniciales (C₁ · V₁) son iguales a los finales (C₂ · V₂). Se puede usar con cualquier unidad de concentración y de volumen, siempre que sean las mismas en ambos lados. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Cómo diluyo un ácido de forma segura?",
      a: "Añade siempre el ácido sobre el agua, poco a poco y removiendo, nunca al revés: al echar agua sobre un ácido concentrado, el calor desprendido puede provocar salpicaduras. Usa gafas y guantes y trabaja con ventilación.",
    },
    {
      q: "¿Cómo diluyo la lejía para desinfectar?",
      a: "Sigue las instrucciones de la etiqueta. Como referencia, el Ministerio de Sanidad recomendó para desinfectar superficies una dilución de unos 20 mL de lejía doméstica por litro de agua, preparada en el momento. Nunca la mezcles con amoniaco, vinagre ni otros productos: se desprenden gases tóxicos.",
    },
    {
      q: "¿Qué es un factor de dilución?",
      a: "Es la relación entre el volumen final y el inicial (V₂/V₁) o entre las concentraciones (C₁/C₂). Una dilución 1:10 significa una parte de disolución en un volumen total de 10 partes, es decir, la concentración se reduce a la décima parte.",
    },
    {
      q: "¿Cómo se hacen diluciones sucesivas?",
      a: "Se diluye varias veces seguidas con el mismo factor: tres diluciones 1:10 equivalen a una dilución 1:1.000. Se usan en microbiología y análisis clínicos cuando hace falta reducir mucho la concentración con precisión.",
    },
  ]}
>
  <DilucionesTool client:load />
</CalcLayout>

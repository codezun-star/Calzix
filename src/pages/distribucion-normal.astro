---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DistribucionNormalTool from '@/components/tools/DistribucionNormalTool';
---

<CalcLayout slug="distribucion-normal"
  answer={"Para calcular probabilidades en una normal N(μ, σ) se tipifica con z = (x − μ) / σ y se busca en la tabla de la N(0, 1). Si las notas de un examen siguen una N(6; 1,5), la probabilidad de sacar menos de un 5 es P(Z < −0,67) ≈ 25 %."}
  howTo={[
    "Introduce la media (μ) y la desviación típica (σ) de la distribución.",
    "Introduce el valor x.",
    "Pulsa calcular para obtener la puntuación z y las probabilidades acumuladas a la izquierda y a la derecha de x."
  ]}
  whatIs={"La calculadora de distribución normal tipifica un valor y calcula la probabilidad de que una variable normal sea menor o mayor que él, sin necesidad de consultar la tabla."}
  whyUse={"Sirve para los ejercicios de distribución normal de Matemáticas Aplicadas a las Ciencias Sociales II y Matemáticas II, y para interpretar datos como alturas, pesos, notas o resultados de tests."}
  faqs={[
    {
      q: "¿Qué es la distribución normal?",
      a: "Es una distribución de probabilidad con forma de campana, simétrica respecto a la media. Muchas variables naturales se aproximan a ella: la altura, la presión arterial o los errores de medida. Es materia de Matemáticas Aplicadas a las Ciencias Sociales de Bachillerato y uno de los bloques habituales del examen de la PAU.",
    },
    {
      q: "¿Qué es tipificar?",
      a: "Convertir una variable N(μ, σ) en la normal estándar N(0, 1) con z = (x − μ) / σ. La z indica a cuántas desviaciones típicas está el valor de la media. Así se puede usar una sola tabla para cualquier normal.",
    },
    {
      q: "¿Qué es la regla 68-95-99,7?",
      a: "En una normal, el 68,3 % de los valores está a menos de una desviación típica de la media, el 95,4 % a menos de dos y el 99,7 % a menos de tres. Es útil para estimar rápidamente si un dato es habitual o extremo.",
    },
    {
      q: "¿Cómo se usa en la PAU?",
      a: "Son habituales los ejercicios de calcular probabilidades en una normal, encontrar el valor que deja una determinada proporción por encima o por debajo, y la inferencia: intervalos de confianza para la media y tamaño de muestra, que usan los valores críticos de la normal (1,96 para el 95 %).",
    },
    {
      q: "¿Cómo se interpreta el cociente intelectual?",
      a: "Los tests de CI se diseñan para seguir una normal de media 100 y desviación típica 15. Un CI de 130 está dos desviaciones por encima de la media: solo alrededor del 2,3 % de la población lo supera.",
    },
  ]}
>
  <DistribucionNormalTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvPesoTool from '@/components/tools/ConvPesoTool';
---

<CalcLayout slug="conversor-peso"
  answer={"Para convertir pesos usa estos factores: 1 libra = 453,59 g, 1 onza = 28,35 g y 1 stone = 6,35 kg. Una maleta de 50 libras pesa 22,7 kg y una persona de 70 kg pesa unas 154 libras u 11 stones."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 50 libras o 250 gramos).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de peso o masa convierte entre gramos, kilogramos, miligramos, toneladas, libras, onzas y stones con los factores de conversión exactos."}
  whyUse={"Te ayuda a seguir recetas en inglés, comprobar el límite de peso del equipaje de una aerolínea extranjera, entender las básculas o las tallas de material deportivo en libras y convertir dosis en miligramos."}
  faqs={[
    {
      q: "¿Cuántos gramos tiene una libra?",
      a: "La libra internacional tiene exactamente 453,59237 g. En España existió la libra castellana, de unos 460 g, que todavía aparece en algunas recetas antiguas y refranes. Hoy, todos los productos se venden por kilos y gramos.",
    },
    {
      q: "¿Cuántos kilos son 50 libras?",
      a: "50 × 0,4536 = 22,68 kg. Es el límite de peso habitual del equipaje facturado en las aerolíneas estadounidenses, equivalente a los 23 kg que usan la mayoría de aerolíneas europeas en clase turista.",
    },
    {
      q: "¿Qué es una arroba?",
      a: "Es una medida tradicional española de unos 11,5 kg (25 libras castellanas), que todavía se usa en algunos mercados agrícolas, por ejemplo para la aceituna o la uva. El quintal castellano equivalía a 4 arrobas, unos 46 kg.",
    },
    {
      q: "¿Qué son los stones?",
      a: "Son una unidad de peso británica que equivale a 14 libras (6,35 kg). En Reino Unido e Irlanda se usa para expresar el peso de las personas: alguien de 70 kg pesa unos 11 stones.",
    },
    {
      q: "¿Qué diferencia hay entre peso y masa?",
      a: "La masa es la cantidad de materia y se mide en kilogramos; el peso es la fuerza con que la gravedad atrae esa masa y se mide en newtons. En la vida diaria decimos «peso» para referirnos a la masa. Una persona de 70 kg tiene la misma masa en la Luna, pero allí pesaría unas seis veces menos.",
    },
    {
      q: "¿Qué es la onza troy?",
      a: "Es la onza que se usa para metales preciosos: 31,1035 g, algo más que la onza común (28,35 g). El precio del oro y la plata se cotiza en dólares por onza troy.",
    },
  ]}
>
  <ConvPesoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NotacionCientificaTool from '@/components/tools/NotacionCientificaTool';
---

<CalcLayout slug="notacion-cientifica"
  answer={"La notación científica escribe un número como un valor entre 1 y 10 multiplicado por una potencia de 10: 6.500.000 = 6,5 × 10⁶ y 0,00000452 = 4,52 × 10⁻⁶. Se usa para números muy grandes o muy pequeños."}
  howTo={[
    "Escribe el número en forma decimal.",
    "Pulsa convertir a notación científica.",
    "Consulta la mantisa, el exponente y la expresión completa."
  ]}
  whatIs={"La calculadora de notación científica convierte cualquier número decimal a notación científica (mantisa entre 1 y 10 por una potencia de 10)."}
  whyUse={"Sirve para los ejercicios de potencias de 3.º de ESO, para Física y Química (masas atómicas, distancias astronómicas, constantes) y para entender los números que muestran las calculadoras científicas."}
  faqs={[
    {
      q: "¿Cómo se pasa un número a notación científica?",
      a: "Mueve la coma hasta dejar una sola cifra distinta de cero a la izquierda y cuenta los lugares: hacia la izquierda, el exponente es positivo; hacia la derecha, negativo. 6.500.000 → 6,5 × 10⁶. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se multiplican números en notación científica?",
      a: "Se multiplican las mantisas y se suman los exponentes: (2 × 10³) × (3 × 10⁴) = 6 × 10⁷. Para dividir, se dividen las mantisas y se restan los exponentes.",
    },
    {
      q: "¿Qué significa 1,5E-6 en la calculadora?",
      a: "Es la forma abreviada de 1,5 × 10⁻⁶, es decir, 0,0000015. La E (de exponente) la usan calculadoras, hojas de cálculo y lenguajes de programación.",
    },
    {
      q: "¿Qué son las cifras significativas?",
      a: "Son las cifras de la mantisa que tienen valor real según la precisión de la medida. 4,52 × 10⁻⁶ tiene tres cifras significativas.",
    },
    {
      q: "¿Dónde se usa en la vida real?",
      a: "En astronomía (la distancia de la Tierra al Sol es 1,496 × 10¹¹ m), en química (el número de Avogadro, 6,022 × 10²³) o en informática (un terabyte son 10¹² bytes).",
    },
  ]}
>
  <NotacionCientificaTool client:load />
</CalcLayout>

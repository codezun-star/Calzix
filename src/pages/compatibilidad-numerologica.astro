---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CompatibilidadNumerologicaTool from '@/components/tools/CompatibilidadNumerologicaTool';
---

<CalcLayout slug="compatibilidad-numerologica"
  answer={"La compatibilidad numerológica reduce cada fecha de nacimiento a un número del 1 al 9 (el número del camino de vida) y compara ambos según la numerología pitagórica. Es un juego para pasar el rato: no tiene base científica y no sirve para tomar decisiones importantes sobre tu relación."}
  howTo={[
    "Introduce la fecha de nacimiento de la primera persona.",
    "Introduce la fecha de nacimiento de la segunda persona.",
    "Pulsa calcular para ver vuestros números y su compatibilidad."
  ]}
  whatIs={"La calculadora de compatibilidad numerológica obtiene el número del camino de vida de dos personas a partir de su fecha de nacimiento y describe su afinidad según la tradición de la numerología."}
  whyUse={"Es un entretenimiento para parejas, amigos o compañeros curiosos por la numerología, para comentar en una cena o comparar con la compatibilidad zodiacal."}
  faqs={[
    {
      q: "¿Cómo se calcula el número del camino de vida?",
      a: "Se suman todos los dígitos de la fecha de nacimiento y se reducen hasta un solo dígito. Ejemplo: 14/02/1995 → 1+4+0+2+1+9+9+5 = 31 → 3+1 = 4. En la numerología tradicional, los números 11, 22 y 33 se consideran «maestros» y a veces no se reducen.",
    },
    {
      q: "¿Tiene base científica?",
      a: "No. La numerología es una creencia tradicional sin respaldo científico. Es un juego para pasar el rato: no tiene base científica y no sirve para tomar decisiones importantes sobre tu relación.",
    },
    {
      q: "¿Qué números se consideran más compatibles?",
      a: "Según la numerología popular, los números se agrupan por afinidad: 1, 5 y 7 (independencia), 2, 4 y 8 (estabilidad) y 3, 6 y 9 (creatividad y sensibilidad). Las parejas del mismo grupo se consideran más afines, pero las interpretaciones varían entre autores.",
    },
    {
      q: "¿Qué diferencia hay con la compatibilidad zodiacal?",
      a: "La compatibilidad numerológica usa la fecha completa reducida a un número; la zodiacal usa el signo del zodiaco según el día y el mes. Ambas son tradiciones de entretenimiento, y puedes comparar lo que dice cada una con nuestras calculadoras.",
    },
    {
      q: "¿Se guardan las fechas?",
      a: "No. El cálculo se hace en tu navegador y las fechas no se envían a ningún servidor.",
    },
  ]}
>
  <CompatibilidadNumerologicaTool client:load />
</CalcLayout>

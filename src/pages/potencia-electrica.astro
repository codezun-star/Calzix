---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PotenciaElectricaTool from '@/components/tools/PotenciaElectricaTool';
---

<CalcLayout slug="potencia-electrica"
  answer={"La potencia eléctrica es la tensión por la intensidad: P = V · I. Un hervidor de 2.000 W conectado a 230 V consume 2.000 / 230 = 8,7 A. Si funciona 5 minutos al día, gasta unos 5 kWh al mes, alrededor de 0,75 € con la luz a 0,15 €/kWh."}
  howTo={[
    "Elige qué quieres calcular: potencia (W), tensión (V) o intensidad (A).",
    "Introduce los otros dos valores.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de potencia eléctrica calcula la potencia, la tensión o la intensidad de un aparato o circuito con la fórmula P = V · I."}
  whyUse={"Te ayuda a saber cuántos amperios consume un electrodoméstico, si puedes conectar varios aparatos a la vez sin que salte el interruptor, qué potencia contratar y cuánto te cuesta cada aparato en la factura de la luz."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre potencia y energía?",
      a: "La potencia (vatios) es la rapidez con que se consume la energía; la energía (kWh) es la potencia por el tiempo de uso. Un horno de 2.000 W funcionando media hora consume 1 kWh. En la factura de la luz se paga por las dos cosas: la potencia contratada (kW) y la energía consumida (kWh).",
    },
    {
      q: "¿Qué potencia necesito contratar?",
      a: "Suma la potencia de los aparatos que suelen funcionar a la vez. Las potencias más habituales son 3,45 kW (unos 15 A), 4,6 kW (20 A) y 5,75 kW (25 A). Si te salta a menudo el interruptor de control de potencia (ICP), necesitas más; si nunca te acercas al límite, puedes bajarla y ahorrar.",
    },
    {
      q: "¿Cuántos aparatos puedo enchufar a la vez?",
      a: "Un enchufe normal de 16 A a 230 V admite hasta 3.680 W en teoría, pero no conviene superar los 3.000 W de forma continuada ni encadenar regletas. Aparatos como el horno, la vitrocerámica o la lavadora deben ir en su propio circuito.",
    },
    {
      q: "¿Cómo se calcula la potencia en trifásica?",
      a: "En un sistema trifásico equilibrado, P = √3 · V · I · cos φ, con V = 400 V entre fases. Se usa en locales, naves y viviendas con mucha potencia contratada. La calculadora trabaja con la fórmula monofásica.",
    },
    {
      q: "¿Qué consume más en casa?",
      a: "Los aparatos que producen calor: termo eléctrico, calefactores, horno, vitrocerámica, secadora y aire acondicionado. El frigorífico consume poca potencia, pero funciona todo el día. Usa la calculadora de consumo eléctrico para calcular el coste de cada uno.",
    },
  ]}
>
  <PotenciaElectricaTool client:load />
</CalcLayout>

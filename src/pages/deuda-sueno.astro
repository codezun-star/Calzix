---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DeudaSuenoTool from '@/components/tools/DeudaSuenoTool';
---

<CalcLayout slug="deuda-sueno"
  answer={"La deuda de sueño es la diferencia entre las horas que necesitas y las que duermes: si necesitas 8 horas y entre semana duermes 6,5, acumulas 7,5 horas de deuda de lunes a viernes. Se recupera poco a poco, durmiendo 1-2 horas más durante varios días, no con una sola noche larga."}
  howTo={[
    "Indica las horas de sueño que necesitas por noche.",
    "Introduce las horas que has dormido cada día de la semana.",
    "Pulsa calcular deuda para ver el déficit acumulado y cómo recuperarlo."
  ]}
  whatIs={"La calculadora de deuda de sueño suma la diferencia entre las horas que necesitas y las que has dormido cada día de la semana para mostrar cuánto sueño has acumulado como déficit."}
  whyUse={"Te ayuda a detectar si duermes menos de lo que necesitas, algo muy habitual con los horarios españoles, y a planificar cómo recuperar el descanso sin desajustar tu reloj interno."}
  faqs={[
    {
      q: "¿Qué es la deuda de sueño?",
      a: "Es el sueño acumulado que no has dormido respecto a lo que necesitas. Una deuda pequeña se nota en somnolencia y falta de concentración; una deuda crónica se asocia a problemas de salud como hipertensión, obesidad, diabetes y trastornos del ánimo.",
    },
    {
      q: "¿Se puede recuperar el sueño el fin de semana?",
      a: "Solo en parte. Dormir mucho más el sábado y el domingo desplaza tu reloj interno (el llamado jet lag social) y hace más difícil dormirse el domingo por la noche. Es mejor recuperar acostándose antes varios días y, como mucho, dormir una hora más el fin de semana.",
    },
    {
      q: "¿Por qué es tan común en España?",
      a: "Los horarios españoles son tardíos: se cena tarde, la televisión emite su programación principal hasta pasada la medianoche y el horario laboral empieza pronto. Además, España usa la hora de Europa central pese a estar geográficamente alineada con Reino Unido y Portugal, lo que retrasa la puesta de sol.",
    },
    {
      q: "¿Cuánto tiempo hace falta para recuperarse?",
      a: "Diversos estudios indican que recuperar una deuda de sueño importante puede llevar varios días o semanas de buen descanso. Lo más eficaz es mantener un horario regular y añadir 30-60 minutos de sueño cada noche hasta sentirte descansado.",
    },
    {
      q: "¿La siesta ayuda a pagar la deuda?",
      a: "Una siesta corta de 20-30 minutos después de comer mejora la alerta y reduce la somnolencia, pero no sustituye el sueño nocturno. Las siestas largas o tardías pueden dificultar dormirse por la noche.",
    },
    {
      q: "¿Es peligroso conducir con sueño?",
      a: "Sí. Según la DGT, la somnolencia está detrás de una parte importante de los accidentes de tráfico. Si notas bostezos, parpadeo frecuente o dificultad para mantener el carril, para a descansar: lo recomendable es hacer una parada cada 2 horas o 200 km.",
    },
  ]}
>
  <DeudaSuenoTool client:load />
</CalcLayout>

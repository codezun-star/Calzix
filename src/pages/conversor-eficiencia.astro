---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvEficienciaTool from '@/components/tools/ConvEficienciaTool';
---

<CalcLayout slug="conversor-eficiencia"
  answer={"Para pasar de km/L a L/100 km divide 100 entre el valor; para pasar de millas por galón (EE. UU.) a L/100 km divide 235,2 entre el valor. Un coche que hace 18 km/L consume 5,6 L/100 km, y uno americano de 30 mpg, 7,8 L/100 km."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 30 mpg o 6 L/100 km).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de eficiencia de combustible convierte el consumo entre litros a los 100 km (la unidad usada en España y en Europa), kilómetros por litro y millas por galón estadounidense y británico."}
  whyUse={"Te ayuda a comparar el consumo de coches de distintos mercados, entender reseñas y fichas en inglés y calcular el gasto en combustible de un viaje."}
  faqs={[
    {
      q: "¿Cómo se expresa el consumo de un coche en España?",
      a: "En litros a los 100 km (L/100 km), según el ciclo de homologación WLTP, que figura en la ficha técnica y en la etiqueta de consumo obligatoria en los concesionarios. Cuanto más bajo, más eficiente es el coche. El IDAE publica una guía con el consumo y las emisiones de todos los modelos a la venta.",
    },
    {
      q: "¿Por qué hay dos tipos de mpg?",
      a: "Porque el galón estadounidense (3,785 L) es menor que el británico (4,546 L). Por eso el mismo coche marca más mpg en Reino Unido: 30 mpg estadounidenses son 7,8 L/100 km, mientras que 30 mpg británicas son 9,4 L/100 km.",
    },
    {
      q: "¿Qué consumo es bueno para un coche?",
      a: "Como referencia, un utilitario de gasolina moderno consume entre 5 y 6,5 L/100 km, un diésel entre 4 y 5,5, y un híbrido entre 4 y 5 en uso mixto. En ciudad y con conducción agresiva, el consumo real suele superar el homologado en un 10-20 %.",
    },
    {
      q: "¿Cómo se mide el consumo de un coche eléctrico?",
      a: "En kWh a los 100 km. Un eléctrico eficiente consume entre 14 y 18 kWh/100 km. Con un precio de la electricidad de 0,15 €/kWh en casa, recorrer 100 km cuesta unos 2,1-2,7 €, frente a 9-11 € de un coche de gasolina.",
    },
    {
      q: "¿Cómo calculo cuánto gasto en combustible?",
      a: "Multiplica los kilómetros por el consumo y divide entre 100 para obtener los litros, y multiplícalos por el precio por litro. Un viaje de 600 km con un consumo de 6 L/100 km y la gasolina a 1,85 €/L cuesta unos 66,60 €. La calculadora de consumo de combustible lo hace por ti.",
    },
  ]}
>
  <ConvEficienciaTool client:load />
</CalcLayout>

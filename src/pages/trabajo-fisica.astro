---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import TrabajoFisicaTool from '@/components/tools/TrabajoFisicaTool';
---

<CalcLayout slug="trabajo-fisica"
  answer={"El trabajo mecánico es la fuerza por el desplazamiento por el coseno del ángulo entre ambos: W = F · d · cos α. Empujar con 50 N un carro durante 10 m en la dirección del movimiento es un trabajo de 500 J; si la fuerza forma 60° con el desplazamiento, solo 250 J."}
  howTo={[
    "Introduce la fuerza en newtons.",
    "Introduce la distancia recorrida en metros.",
    "Indica el ángulo entre la fuerza y el desplazamiento (0° si van en la misma dirección) y pulsa calcular."
  ]}
  whatIs={"La calculadora de trabajo mecánico calcula el trabajo realizado por una fuerza que desplaza un cuerpo, teniendo en cuenta el ángulo entre la fuerza y el desplazamiento."}
  whyUse={"Sirve para los problemas de trabajo, energía y potencia de Física y Química de 4.º de ESO y 1.º de Bachillerato."}
  faqs={[
    {
      q: "¿Qué es el trabajo en física?",
      a: "Es la energía transferida a un cuerpo cuando una fuerza lo desplaza: W = F · d · cos α, medido en julios (J). 1 J es el trabajo de una fuerza de 1 N a lo largo de 1 m. Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Puede ser cero el trabajo aunque haga fuerza?",
      a: "Sí: si no hay desplazamiento (sostener una maleta quieta) o si la fuerza es perpendicular al desplazamiento (llevar la maleta en horizontal, el peso no realiza trabajo).",
    },
    {
      q: "¿Qué es un trabajo negativo?",
      a: "El que realiza una fuerza opuesta al movimiento, como el rozamiento o los frenos: el ángulo es de 180° y el coseno vale −1. Quita energía al cuerpo.",
    },
    {
      q: "¿Qué relación hay entre trabajo y potencia?",
      a: "La potencia es el trabajo por unidad de tiempo: P = W / t, en vatios. Subir 500 J en 10 segundos supone 50 W.",
    },
    {
      q: "¿Qué es el teorema de las fuerzas vivas?",
      a: "El trabajo total realizado sobre un cuerpo es igual a la variación de su energía cinética: W = ΔEc. Permite resolver muchos problemas sin calcular aceleraciones.",
    },
  ]}
>
  <TrabajoFisicaTool client:load />
</CalcLayout>

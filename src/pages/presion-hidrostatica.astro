---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PresionHidrostaticaTool from '@/components/tools/PresionHidrostaticaTool';
---

<CalcLayout slug="presion-hidrostatica"
  answer={"La presión hidrostática es P = ρ · g · h: a 10 m de profundidad en agua dulce (1.000 kg/m³) la presión del agua es de 98.100 Pa, casi 1 bar, que se suma a la presión atmosférica. En el mar, con 1.025 kg/m³, es algo mayor: unos 100.550 Pa."}
  howTo={[
    "Introduce la densidad del fluido (1.000 kg/m³ para el agua dulce, 1.025 para el agua de mar).",
    "Introduce la profundidad en metros.",
    "Ajusta la gravedad si lo necesitas y pulsa calcular."
  ]}
  whatIs={"La calculadora de presión hidrostática calcula la presión que ejerce un fluido en reposo a una profundidad determinada, con la ecuación fundamental de la hidrostática P = ρ · g · h."}
  whyUse={"Sirve para los problemas de fluidos de Física y Química de 4.º de ESO y el Bachillerato, para el buceo, el diseño de depósitos y piscinas y para entender la presión del agua en las tuberías de un edificio."}
  faqs={[
    {
      q: "¿Cuánto aumenta la presión al bucear?",
      a: "Aproximadamente 1 bar (1 atm) por cada 10 m de profundidad en el mar. A 30 m, la presión total es de unos 4 bar: 1 de la atmósfera y 3 del agua. Por eso los buceadores deben compensar los oídos y respetar las paradas de descompresión.",
    },
    {
      q: "¿Qué es el principio fundamental de la hidrostática?",
      a: "La presión en un punto de un fluido en reposo depende solo de la densidad, la gravedad y la profundidad, no de la forma del recipiente. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Por qué los depósitos de agua están en lo alto?",
      a: "Para aprovechar la presión hidrostática: cada 10 m de altura del depósito sobre el grifo aporta aproximadamente 1 bar. Por eso los depósitos municipales se sitúan en colinas o torres y los edificios altos necesitan grupos de presión.",
    },
    {
      q: "¿Qué presión soporta una presa?",
      a: "La presión aumenta con la profundidad, por eso las presas son más gruesas en la base. En el fondo de un embalse de 100 m de profundidad, el agua ejerce unos 9,8 bar, casi 10 kg por centímetro cuadrado.",
    },
    {
      q: "¿Qué es la paradoja hidrostática?",
      a: "Es el hecho de que recipientes con distinta forma y cantidad de agua, pero con la misma altura de líquido, ejercen la misma presión en el fondo. Lo demostró Blaise Pascal en el siglo XVII.",
    },
  ]}
>
  <PresionHidrostaticaTool client:load />
</CalcLayout>

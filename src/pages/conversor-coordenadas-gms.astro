---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorCoordenadasGmsTool from '@/components/tools/ConversorCoordenadasGmsTool';
---

<CalcLayout slug="conversor-coordenadas-gms"
  answer={"Para pasar de grados decimales a grados, minutos y segundos, la parte entera son los grados y los decimales se multiplican por 60 para obtener los minutos y por 60 otra vez para los segundos: 40,4168° = 40° 25′ 0,5″, la latitud de la Puerta del Sol de Madrid."}
  howTo={[
    "Elige si quieres pasar de grados decimales a GMS o al revés.",
    "Introduce las coordenadas.",
    "Pulsa convertir para ver el resultado."
  ]}
  whatIs={"El conversor de coordenadas convierte latitudes y longitudes entre grados decimales (como en Google Maps) y grados, minutos y segundos (como en mapas topográficos y GPS antiguos)."}
  whyUse={"Te ayuda a usar coordenadas de mapas del Instituto Geográfico Nacional, del Catastro o del SIGPAC, rutas de senderismo, geocaching o navegación."}
  faqs={[
    {
      q: "¿Qué son los grados, minutos y segundos?",
      a: "Un grado se divide en 60 minutos (′) y cada minuto en 60 segundos (″), como las horas. 40° 25′ 0,5″ equivale a 40 + 25/60 + 0,5/3.600 = 40,4168°.",
    },
    {
      q: "¿Qué significan N, S, E y O?",
      a: "N y S indican latitud norte o sur del ecuador; E y O, longitud este u oeste del meridiano de Greenwich. En grados decimales, el sur y el oeste se escriben en negativo: Madrid está en 40,4168, −3,7038.",
    },
    {
      q: "¿Por dónde pasa el meridiano de Greenwich en España?",
      a: "El meridiano 0° cruza el este peninsular, por localidades de Aragón, Cataluña y la Comunidad Valenciana, como Castellón de la Plana. Por eso casi toda la península tiene longitudes oeste (negativas) y Cataluña y Baleares, longitudes este.",
    },
    {
      q: "¿Qué formato usa Google Maps?",
      a: "Grados decimales: al pulsar en un punto del mapa verás algo como 40.4168, -3.7038. También acepta coordenadas en GMS si las escribes con sus símbolos.",
    },
    {
      q: "¿Dónde consulto coordenadas oficiales?",
      a: "En el visor del Instituto Geográfico Nacional (IGN), en la Sede Electrónica del Catastro y en el visor SIGPAC para parcelas agrícolas, todos con coordenadas en distintos formatos.",
    },
  ]}
>
  <ConversorCoordenadasGmsTool client:load />
</CalcLayout>

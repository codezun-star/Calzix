---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NumeroExpresionTool from '@/components/tools/NumeroExpresionTool';
---

<CalcLayout slug="numero-expresion"
  answer={"El número de expresión de la numerología se obtiene asignando a cada letra del nombre completo un valor del 1 al 9 (A=1, B=2… I=9, J=1…) y reduciendo la suma a una cifra. En España se suele usar el nombre con los dos apellidos. Es un juego sin base científica."}
  howTo={[
    "Escribe tu nombre completo con los dos apellidos.",
    "Pulsa calcular.",
    "Consulta tu número de expresión y su interpretación tradicional."
  ]}
  whatIs={"La calculadora del número de expresión o destino convierte las letras de tu nombre completo en números según la tabla pitagórica y obtiene el número que, según la numerología, describe tus talentos."}
  whyUse={"Es un entretenimiento para curiosos de la numerología, para comparar con el número del camino de vida o para jugar con los nombres de amigos y familiares."}
  faqs={[
    {
      q: "¿Qué valor tiene cada letra?",
      a: "En la tabla pitagórica: A, J y S valen 1; B, K y T, 2; C, L y U, 3; D, M y V, 4; E, N y W, 5; F, O y X, 6; G, P e Y, 7; H, Q y Z, 8; I y R, 9. La Ñ suele tratarse como N, y las vocales con tilde como sin tilde.",
    },
    {
      q: "¿Uso el nombre con uno o dos apellidos?",
      a: "La numerología tradicional usa el nombre completo de nacimiento. En España, eso incluye los dos apellidos tal como figuran en el DNI. Si usas un nombre compuesto o un apodo, el número cambia.",
    },
    {
      q: "¿Qué diferencia hay con el número del camino de vida?",
      a: "El camino de vida se calcula con la fecha de nacimiento y, según la numerología, describe tu trayectoria. El número de expresión se calcula con el nombre y describiría tus capacidades. Ninguno tiene base científica.",
    },
    {
      q: "¿Tiene validez científica?",
      a: "No. Es una tradición esotérica: úsala solo como entretenimiento.",
    },
    {
      q: "¿Se guarda mi nombre?",
      a: "No. El cálculo se hace en tu navegador y el nombre no se envía a ningún servidor.",
    },
  ]}
>
  <NumeroExpresionTool client:load />
</CalcLayout>

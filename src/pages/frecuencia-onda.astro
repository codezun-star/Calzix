---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import FrecuenciaOndaTool from '@/components/tools/FrecuenciaOndaTool';
---

<CalcLayout slug="frecuencia-onda"
  answer={"La velocidad de una onda es su longitud de onda por su frecuencia: v = λ · f. Una emisora de FM en 100 MHz emite ondas de λ = 3 × 10⁸ / 10⁸ = 3 m, y la nota la (440 Hz) en el aire, a 343 m/s, tiene una longitud de onda de 0,78 m."}
  howTo={[
    "Elige qué quieres calcular: velocidad, frecuencia o longitud de onda.",
    "Introduce los otros dos valores en unidades del Sistema Internacional.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de frecuencia y longitud de onda relaciona la velocidad, la frecuencia y la longitud de onda de cualquier onda, sonora o electromagnética, con la ecuación v = λ · f."}
  whyUse={"Sirve para los problemas de ondas de Física de 4.º de ESO y de 2.º de Bachillerato, y para entender la radio, el wifi, el sonido o el espectro de la luz."}
  faqs={[
    {
      q: "¿Qué velocidad tienen las ondas?",
      a: "Las ondas electromagnéticas (luz, radio, wifi) viajan en el vacío a unos 300.000 km/s. El sonido viaja a unos 343 m/s en el aire a 20 °C, a unos 1.480 m/s en el agua y a más de 5.000 m/s en el acero. Se estudia en Física y Química de la ESO y en Física de 2.º de Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Qué longitud de onda tienen la radio y el wifi?",
      a: "La radio FM (87,5-108 MHz) tiene longitudes de onda de unos 3 metros; el wifi de 2,4 GHz, de unos 12,5 cm; y el de 5 GHz, de unos 6 cm. Por eso las antenas tienen tamaños proporcionales a esas longitudes.",
    },
    {
      q: "¿Cómo calculo la distancia de una tormenta?",
      a: "Cuenta los segundos entre el relámpago y el trueno y multiplica por 343 m/s, o divide entre 3 para obtener los kilómetros. Si pasan 9 segundos, la tormenta está a unos 3 km. La AEMET recomienda buscar refugio si el trueno llega en menos de 30 segundos.",
    },
    {
      q: "¿Qué es el periodo de una onda?",
      a: "Es el tiempo que tarda en completar una oscilación: T = 1 / f. Una onda de 50 Hz, como la corriente de la red eléctrica, tiene un periodo de 0,02 s.",
    },
    {
      q: "¿Qué frecuencias tiene la luz visible?",
      a: "Entre unos 400 THz (rojo, unos 750 nm de longitud de onda) y 750 THz (violeta, unos 400 nm). Por debajo están los infrarrojos y las microondas; por encima, los ultravioleta, cuyo índice UV publica la AEMET para prevenir quemaduras solares.",
    },
  ]}
>
  <FrecuenciaOndaTool client:load />
</CalcLayout>

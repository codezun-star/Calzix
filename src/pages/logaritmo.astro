---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import LogaritmoTool from '@/components/tools/LogaritmoTool';
---

<CalcLayout slug="logaritmo"
  answer={"El logaritmo en base b de un número x es el exponente al que hay que elevar b para obtener x: log₁₀ 1.000 = 3 porque 10³ = 1.000, y log₂ 8 = 3 porque 2³ = 8. El logaritmo neperiano usa la base e ≈ 2,718."}
  howTo={[
    "Introduce el número.",
    "Introduce la base (por ejemplo, 10 o 2); la calculadora muestra además el logaritmo neperiano y el decimal.",
    "Pulsa calcular logaritmo para obtener el resultado."
  ]}
  whatIs={"La calculadora de logaritmos calcula el logaritmo de un número en cualquier base: decimal, neperiano, binario o personalizada."}
  whyUse={"Sirve para los ejercicios de logaritmos de 4.º de ESO y 1.º de Bachillerato, y para cálculos de química (pH), física (decibelios), finanzas (tiempo de duplicación de una inversión) o informática."}
  faqs={[
    {
      q: "¿Cuáles son las propiedades de los logaritmos?",
      a: "log(a·b) = log a + log b; log(a/b) = log a − log b; log(aⁿ) = n · log a; log_b b = 1 y log_b 1 = 0. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo cambio de base?",
      a: "Con la fórmula log_b x = log x / log b, usando logaritmos decimales o neperianos: log₂ 100 = log 100 / log 2 = 2 / 0,301 = 6,64.",
    },
    {
      q: "¿Dónde se usan los logaritmos?",
      a: "En el pH (pH = −log[H⁺]), en los decibelios del sonido, en la magnitud de los terremotos, en el crecimiento de poblaciones y en el interés compuesto: el tiempo para duplicar una inversión es log 2 / log(1 + i).",
    },
    {
      q: "¿Tiene logaritmo un número negativo?",
      a: "No en los números reales: el argumento de un logaritmo debe ser positivo. La base también debe ser positiva y distinta de 1.",
    },
    {
      q: "¿Qué es el número e?",
      a: "Es una constante matemática irracional, aproximadamente 2,71828, base de los logaritmos neperianos y del crecimiento continuo. Aparece en el interés compuesto continuo y en muchos fenómenos naturales.",
    },
  ]}
>
  <LogaritmoTool client:load />
</CalcLayout>

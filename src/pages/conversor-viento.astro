---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorVientoTool from '@/components/tools/ConversorVientoTool';
---

<CalcLayout slug="conversor-viento"
  answer={"La escala de Beaufort clasifica el viento del 0 (calma) al 12 (huracán) según su velocidad: un viento de 45 km/h es fuerza 6 (viento fuerte), con olas grandes y dificultad para usar el paraguas. 45 km/h equivalen a unos 24 nudos."}
  howTo={[
    "Introduce la velocidad del viento en km/h.",
    "Pulsa calcular.",
    "Consulta el grado en la escala de Beaufort y la equivalencia en nudos y m/s."
  ]}
  whatIs={"El conversor de viento convierte la velocidad del viento en km/h a la escala de Beaufort, a nudos y a metros por segundo, con la denominación de cada grado."}
  whyUse={"Te ayuda a interpretar los partes de la AEMET, planificar una salida en barco, una jornada de surf o kitesurf, una ruta de montaña o una actividad al aire libre."}
  faqs={[
    {
      q: "¿Qué es la escala de Beaufort?",
      a: "Una escala de 13 grados creada por el almirante Francis Beaufort en 1805 para describir el viento por sus efectos en el mar, adaptada después a tierra. Va de 0 (calma, menos de 1 km/h) a 12 (huracán, más de 117 km/h).",
    },
    {
      q: "¿Cuándo emite avisos por viento la AEMET?",
      a: "La AEMET emite avisos amarillos, naranjas y rojos por rachas de viento con umbrales distintos para cada zona: lo que es habitual en el Estrecho o en el litoral gallego puede ser extraordinario en el interior. Consulta los avisos de tu provincia en su web o aplicación.",
    },
    {
      q: "¿Qué vientos típicos hay en España?",
      a: "El levante y el poniente en el Estrecho de Gibraltar, la tramontana en el Empordà y Baleares, el cierzo en el valle del Ebro, el mistral en el Mediterráneo norte y la calima en Canarias.",
    },
    {
      q: "¿Cómo paso de km/h a nudos?",
      a: "Divide entre 1,852: 45 km/h son 24,3 nudos. Los partes marítimos y la navegación usan nudos.",
    },
    {
      q: "¿A partir de qué viento es peligroso salir al mar?",
      a: "Para embarcaciones de recreo pequeñas, a partir de fuerza 5-6 (más de 30-40 km/h) la navegación se vuelve exigente. Consulta siempre el parte marítimo de la AEMET y Salvamento Marítimo antes de salir.",
    },
  ]}
>
  <ConversorVientoTool client:load />
</CalcLayout>

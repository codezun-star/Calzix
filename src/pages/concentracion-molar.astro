---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConcentracionMolarTool from '@/components/tools/ConcentracionMolarTool';
---

<CalcLayout slug="concentracion-molar"
  answer={"La concentración molar (molaridad) es M = n / V, con n = masa / masa molar: 58,44 g de NaCl son 1 mol, y disueltos hasta 2 litros dan una disolución 0,5 M. Para el agua, 18 g son prácticamente 1 mol (18,015 g/mol)."}
  howTo={[
    "Introduce la masa de soluto y su masa molar para calcular los moles.",
    "Introduce los moles y el volumen de la disolución en litros.",
    "Pulsa calcular concentración para obtener la molaridad."
  ]}
  whatIs={"La calculadora de concentración molar calcula los moles de soluto a partir de su masa y su masa molar, y la molaridad de una disolución a partir de los moles y el volumen."}
  whyUse={"Sirve para resolver los problemas de disoluciones de Física y Química de 4.º de ESO y del Bachillerato y para preparar disoluciones en el laboratorio."}
  faqs={[
    {
      q: "¿Qué es la molaridad?",
      a: "Es la cantidad de sustancia de soluto (en moles) por cada litro de disolución. Una disolución 1 M de NaCl tiene 58,44 g de sal por litro de disolución. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Cómo se calcula la masa molar?",
      a: "Sumando las masas atómicas de todos los átomos de la fórmula: H₂O = 2 × 1,008 + 15,999 = 18,015 g/mol; NaCl = 22,99 + 35,45 = 58,44 g/mol. Puedes usar la calculadora de masa molar.",
    },
    {
      q: "¿El volumen es del disolvente o de la disolución?",
      a: "De la disolución total. Para preparar una disolución 1 M no se disuelve 1 mol en 1 litro de agua, sino que se disuelve y se añade agua hasta completar 1 litro de disolución en un matraz aforado.",
    },
    {
      q: "¿Cómo se pasa de g/L a molaridad?",
      a: "Divide la concentración en g/L entre la masa molar. Una disolución de glucosa de 90 g/L tiene una molaridad de 90 / 180 = 0,5 M.",
    },
    {
      q: "¿Qué errores son frecuentes?",
      a: "Usar mililitros en lugar de litros (divide los mL entre 1.000), confundir la masa molar de una molécula con la de un átomo y olvidar el agua de cristalización en sales hidratadas como el CuSO₄·5H₂O.",
    },
  ]}
>
  <ConcentracionMolarTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DistanciaTool from '@/components/tools/DistanciaTool';
---

<CalcLayout slug="calculadora-distancia"
  answer={"El tiempo de viaje es la distancia dividida entre la velocidad media, más las paradas. Madrid-Barcelona por la A-2 son unos 620 km: a una media de 100 km/h son 6 horas y 12 minutos de conducción, y con dos paradas de 20 minutos, unas 6 horas y 50 minutos."}
  howTo={[
    "Introduce la distancia en kilómetros.",
    "Escribe la velocidad media que esperas mantener (en autovía, entre 95 y 110 km/h contando incorporaciones y tráfico).",
    "Añade el tiempo de paradas y pulsa calcular para ver la duración del viaje y la hora de llegada."
  ]}
  whatIs={"La calculadora de tiempo de viaje estima cuánto tardarás en recorrer una distancia según la velocidad media, sumando el tiempo de las paradas de descanso, para viajes en coche, moto, bicicleta o tren."}
  whyUse={"Sirve para planificar la hora de salida en las operaciones salida de verano, Semana Santa o puentes, calcular a qué hora llegarás y organizar las paradas que recomienda la DGT cada dos horas de conducción."}
  faqs={[
    {
      q: "¿Qué velocidad media debo usar para calcular un viaje por carretera?",
      a: "Aunque el límite en autovías y autopistas es de 120 km/h, la velocidad media real en un viaje largo suele estar entre 90 y 105 km/h por las incorporaciones, los tramos urbanos, las obras y el tráfico. En carreteras convencionales, con límite de 90 km/h, la media ronda los 65-75 km/h. En zonas de montaña o con muchas travesías, bastante menos.",
    },
    {
      q: "¿Cuánto se tarda en coche entre las principales ciudades españolas?",
      a: "Tiempos orientativos sin paradas: Madrid-Valencia (355 km), unas 3 h 30 min; Madrid-Barcelona (620 km), unas 6 h; Madrid-Sevilla (530 km), unas 5 h; Madrid-Bilbao (400 km), unas 4 h; Madrid-A Coruña (590 km), unas 5 h 45 min; Barcelona-Valencia (350 km), unas 3 h 30 min; Sevilla-Málaga (205 km), unas 2 h.",
    },
    {
      q: "¿Cada cuánto debo parar a descansar?",
      a: "La DGT recomienda parar al menos 20 minutos cada 2 horas o cada 200 km de conducción, y antes si notas cansancio. La fatiga y el sueño están detrás de muchos accidentes, especialmente en las primeras horas de la tarde y de madrugada. Los conductores profesionales tienen límites legales de conducción y descanso controlados por el tacógrafo.",
    },
    {
      q: "¿Cuáles son los límites de velocidad en España?",
      a: "Autopistas y autovías: 120 km/h para turismos y motocicletas, con límites inferiores para autobuses, camiones y vehículos con remolque. Carreteras convencionales: 90 km/h. Vías urbanas: 50 km/h con dos o más carriles por sentido, 30 km/h con un carril por sentido y 20 km/h en plataforma única.",
    },
    {
      q: "¿Cuándo hay más tráfico en las carreteras españolas?",
      a: "En las operaciones especiales de la DGT: los viernes por la tarde y domingos por la tarde de los puentes, la salida y la vuelta de Semana Santa, el primer y el último fin de semana de julio y agosto (operación salida y retorno) y las fiestas de Navidad. Consulta el estado del tráfico en la web y las redes de la DGT antes de salir.",
    },
    {
      q: "¿Sirve la calculadora para bicicleta o a pie?",
      a: "Sí: introduce la velocidad media correspondiente (unos 15-20 km/h en bicicleta y 4-5 km/h andando). Para estas actividades también puedes usar las calculadoras específicas de tiempo en bicicleta y de tiempo caminando, que estiman además las calorías.",
    },
  ]}
>
  <DistanciaTool client:load />
</CalcLayout>

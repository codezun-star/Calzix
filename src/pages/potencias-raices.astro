---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PotenciasRaicesTool from '@/components/tools/PotenciasRaicesTool';
---

<CalcLayout slug="potencias-raices"
  answer={"Una potencia multiplica la base por sí misma tantas veces como indica el exponente: 2¹⁰ = 1.024 y 10⁶ = 1.000.000. La raíz es la operación inversa: √144 = 12 y ∛27 = 3. Un exponente negativo indica la inversa (2⁻³ = 1/8) y uno fraccionario, una raíz (8^(1/3) = 2)."}
  howTo={[
    "Elige si quieres calcular una potencia o una raíz.",
    "Introduce la base y el exponente (o el índice de la raíz).",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de potencias y raíces calcula potencias con exponente entero, negativo o decimal, y raíces cuadradas, cúbicas o de cualquier índice."}
  whyUse={"Sirve para los ejercicios de potencias y radicales de la ESO, la notación científica de Física y Química y cálculos financieros como el interés compuesto."}
  faqs={[
    {
      q: "¿Cuáles son las propiedades de las potencias?",
      a: "Producto de igual base: aᵐ · aⁿ = aᵐ⁺ⁿ. Cociente: aᵐ / aⁿ = aᵐ⁻ⁿ. Potencia de potencia: (aᵐ)ⁿ = aᵐ·ⁿ. Cualquier número (salvo 0) elevado a 0 vale 1, y a⁻ⁿ = 1/aⁿ. Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Qué es la notación científica?",
      a: "Es una forma de escribir números muy grandes o muy pequeños como un número entre 1 y 10 multiplicado por una potencia de 10. El número de Avogadro es 6,022 × 10²³ y la masa de un electrón, 9,11 × 10⁻³¹ kg.",
    },
    {
      q: "¿Para qué sirven las potencias en finanzas?",
      a: "Para el interés compuesto: capital final = capital × (1 + interés)ⁿ. 10.000 € al 3 % anual durante 10 años se convierten en 10.000 × 1,03¹⁰ = 13.439 €. La calculadora de interés compuesto hace el cálculo completo.",
    },
    {
      q: "¿Tiene raíz cuadrada un número negativo?",
      a: "No en los números reales, porque ningún número real elevado al cuadrado da negativo. En los números complejos, que se estudian en Matemáticas I de Bachillerato, √−1 = i. Las raíces de índice impar sí existen: ∛−8 = −2.",
    },
    {
      q: "¿Cómo se simplifica un radical?",
      a: "Descomponiendo el radicando en factores primos y sacando los que tengan el exponente igual o mayor que el índice: √72 = √(2³ · 3²) = 2 · 3 · √2 = 6√2.",
    },
  ]}
>
  <PotenciasRaicesTool client:load />
</CalcLayout>

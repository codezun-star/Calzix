---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PercentilesCuartilesTool from '@/components/tools/PercentilesCuartilesTool';
---

<CalcLayout slug="percentiles-cuartiles"
  answer={"El percentil p es el valor por debajo del cual queda el p % de los datos ordenados; los cuartiles son los percentiles 25, 50 (la mediana) y 75. Si tu hijo está en el percentil 90 de altura, es más alto que el 90 % de los niños de su edad."}
  howTo={[
    "Escribe los datos separados por comas.",
    "Indica el percentil que quieres calcular (de 0 a 100).",
    "Pulsa calcular para ver el percentil, los cuartiles y el rango intercuartílico."
  ]}
  whatIs={"La calculadora de percentiles y cuartiles calcula cualquier percentil de un conjunto de datos, los tres cuartiles y el rango intercuartílico."}
  whyUse={"Sirve para los ejercicios de estadística de la ESO y el Bachillerato, para interpretar las tablas de crecimiento infantil, los resultados de pruebas estandarizadas o la distribución de salarios."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre percentil y porcentaje?",
      a: "El porcentaje indica una proporción de algo (has acertado el 80 % de las preguntas); el percentil, la posición respecto a los demás (has superado al 80 % de los participantes). Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Qué son los cuartiles?",
      a: "Los valores que dividen los datos ordenados en cuatro partes iguales: Q1 (percentil 25), Q2 (percentil 50, la mediana) y Q3 (percentil 75). El rango intercuartílico (Q3 − Q1) mide la dispersión del 50 % central.",
    },
    {
      q: "¿Cómo se interpretan los percentiles del pediatra?",
      a: "Las gráficas de crecimiento comparan el peso y la talla del niño con los de otros de su edad y sexo. Estar en el percentil 50 es la media; entre el 3 y el 97 se considera normal. Lo importante es que el niño siga una curva estable.",
    },
    {
      q: "¿Se usan percentiles con los salarios?",
      a: "Sí. El INE publica en la Encuesta Anual de Estructura Salarial la distribución de los salarios por percentiles, que muestra mejor la realidad que la media porque esta se ve afectada por los sueldos muy altos.",
    },
    {
      q: "¿Hay varios métodos para calcular percentiles?",
      a: "Sí, y pueden dar resultados ligeramente distintos con pocos datos (por ejemplo, con interpolación lineal o tomando el valor más cercano). Con muchos datos, las diferencias son mínimas.",
    },
  ]}
>
  <PercentilesCuartilesTool client:load />
</CalcLayout>

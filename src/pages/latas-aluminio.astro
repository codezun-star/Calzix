---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import LatasAluminioTool from '@/components/tools/LatasAluminioTool';
---

<CalcLayout slug="latas-aluminio"
  answer={"Cada lata de aluminio pesa unos 15 g y reciclarla ahorra alrededor del 95 % de la energía necesaria para fabricar aluminio nuevo: reciclar 10 latas a la semana son unas 520 latas y casi 8 kg de aluminio al año. En España, las latas van al contenedor amarillo."}
  howTo={[
    "Introduce cuántas latas reciclas.",
    "Indica cada cuántos días.",
    "Pulsa calcular impacto para ver los kilos de aluminio, la energía y el CO₂ que ahorras al año."
  ]}
  whatIs={"La calculadora de reciclaje de latas estima el aluminio, la energía y las emisiones de CO₂ que ahorras al año reciclando latas de bebidas y conservas."}
  whyUse={"Te ayuda a ver el efecto de un gesto cotidiano, motivar el reciclaje en casa, en la oficina o en el colegio y comprender el valor del aluminio como material reciclable."}
  faqs={[
    {
      q: "¿En qué contenedor van las latas?",
      a: "En el contenedor amarillo de envases, junto con los envases de plástico y los briks. No hace falta lavarlas, solo vaciarlas.",
    },
    {
      q: "¿Cuántas veces se puede reciclar el aluminio?",
      a: "Indefinidamente, sin perder calidad. Una lata reciclada puede volver a estar en el supermercado en pocas semanas.",
    },
    {
      q: "¿Habrá depósito por las latas en España?",
      a: "La Ley 7/2022 de residuos prevé implantar un sistema de depósito, devolución y retorno (SDDR) para envases de bebidas de un solo uso si no se alcanzan los objetivos de recogida separada. Con un SDDR, se paga un pequeño depósito al comprar la bebida que se recupera al devolver el envase.",
    },
    {
      q: "¿Cuánta energía ahorra reciclar una lata?",
      a: "Producir aluminio a partir de chatarra requiere alrededor de un 5 % de la energía necesaria para obtenerlo a partir de bauxita. Es uno de los materiales cuyo reciclaje más energía ahorra.",
    },
    {
      q: "¿Las tapas de las latas se separan?",
      a: "No hace falta: la anilla es del mismo material y se recicla con la lata. Las latas de conservas, los aerosoles vacíos y las bandejas de aluminio también van al contenedor amarillo.",
    },
  ]}
>
  <LatasAluminioTool client:load />
</CalcLayout>

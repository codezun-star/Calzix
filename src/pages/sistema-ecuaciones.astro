---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import SistemaEcuacionesTool from '@/components/tools/SistemaEcuacionesTool';
---

<CalcLayout slug="sistema-ecuaciones"
  answer={"Un sistema de dos ecuaciones lineales con dos incógnitas se resuelve por sustitución, igualación, reducción o con la regla de Cramer: x = (c₁b₂ − c₂b₁) / (a₁b₂ − a₂b₁) e y = (a₁c₂ − a₂c₁) / (a₁b₂ − a₂b₁). Para 3x + 2y = 8,5 y 5x + y = 9,5, la solución es x = 1,5 e y = 2."}
  howTo={[
    "Escribe cada ecuación en la forma ax + by = c.",
    "Introduce los coeficientes a, b y c de las dos ecuaciones.",
    "Pulsa resolver para obtener x e y."
  ]}
  whatIs={"La calculadora de sistemas de ecuaciones resuelve sistemas de dos ecuaciones lineales con dos incógnitas y avisa cuando el sistema no tiene solución única."}
  whyUse={"Sirve para comprobar los ejercicios de sistemas de 2.º y 3.º de ESO y del Bachillerato, y para resolver problemas con dos incógnitas, como precios, mezclas o edades."}
  faqs={[
    {
      q: "¿Cómo se plantea un problema con un sistema?",
      a: "Ejemplo: en una frutería, 3 kg de naranjas y 2 kg de manzanas cuestan 8,50 €, y 5 kg de naranjas y 1 kg de manzanas cuestan 9,50 €. Si x es el precio del kilo de naranjas e y el de manzanas: 3x + 2y = 8,5 y 5x + y = 9,5. La solución es x = 1,50 € e y = 2 €.",
    },
    {
      q: "¿Qué método es mejor?",
      a: "Sustitución, cuando una incógnita está despejada o tiene coeficiente 1; reducción, cuando los coeficientes se pueden igualar fácilmente; igualación, cuando ambas ecuaciones tienen la misma incógnita despejada. Todos dan la misma solución. Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Qué significa que un sistema sea incompatible?",
      a: "Que no tiene solución: las dos ecuaciones representan rectas paralelas que no se cortan. Si son la misma recta, el sistema es compatible indeterminado y tiene infinitas soluciones. En ambos casos, el determinante a₁b₂ − a₂b₁ vale cero.",
    },
    {
      q: "¿Qué es la regla de Cramer?",
      a: "Es un método que resuelve sistemas con determinantes. Se estudia en Matemáticas II de 2.º de Bachillerato, junto con el teorema de Rouché-Frobenius para discutir sistemas de tres ecuaciones, un ejercicio habitual en la PAU.",
    },
    {
      q: "¿Cómo compruebo la solución?",
      a: "Sustituye x e y en las dos ecuaciones originales: si se cumplen ambas igualdades, la solución es correcta. En el ejemplo, 3 × 1,5 + 2 × 2 = 8,5 y 5 × 1,5 + 2 = 9,5.",
    },
  ]}
>
  <SistemaEcuacionesTool client:load />
</CalcLayout>

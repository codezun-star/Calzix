---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import RepartoEquipajeTool from '@/components/tools/RepartoEquipajeTool';
---

<CalcLayout slug="reparto-equipaje"
  answer={"Para repartir el peso entre maletas divide el peso total entre el número de maletas y compáralo con el límite de la aerolínea: 40 kg en 2 maletas son 20 kg cada una, dentro del límite habitual de 23 kg de las aerolíneas tradicionales en clase turista."}
  howTo={[
    "Introduce el peso total de lo que quieres llevar.",
    "Indica el número de maletas.",
    "Escribe el límite de peso por maleta de tu billete y pulsa repartir peso."
  ]}
  whatIs={"La calculadora de reparto de equipaje reparte el peso total entre varias maletas, comprueba si alguna supera el límite de la aerolínea y calcula cuántas maletas necesitas como mínimo."}
  whyUse={"Te ayuda a evitar los cargos por exceso de peso en el aeropuerto, sobre todo en viajes en familia o en grupo con varias maletas facturadas."}
  faqs={[
    {
      q: "¿Cuál es el límite de peso del equipaje facturado?",
      a: "En las aerolíneas tradicionales (Iberia, Air Europa y la mayoría de aerolíneas europeas) suele ser de 23 kg por maleta en clase turista y de 32 kg en business. Las de bajo coste venden maletas de 20, 23 o 25 kg según la tarifa. Comprueba siempre tu billete.",
    },
    {
      q: "¿Cuánto cuesta el exceso de peso?",
      a: "Depende de la aerolínea y la ruta: en vuelos dentro de Europa suele costar entre 10 y 20 € por kilo extra, o una tarifa fija por maleta con sobrepeso. Casi siempre sale más barato añadir una segunda maleta al reservar.",
    },
    {
      q: "¿Cuánto puede pesar una maleta como máximo?",
      a: "Por seguridad laboral de los manipuladores, la mayoría de aerolíneas no aceptan maletas de más de 32 kg; lo que supere ese peso debe enviarse como carga.",
    },
    {
      q: "¿Cómo peso la maleta en casa?",
      a: "Con una báscula de equipaje de mano o pesándote con y sin la maleta en la báscula de baño y restando. Deja un margen de 1-2 kg por si la báscula del aeropuerto marca algo más.",
    },
    {
      q: "¿Puedo repartir el peso entre las maletas de varios pasajeros?",
      a: "En muchas aerolíneas el límite es por maleta, no por pasajero, así que una maleta con 26 kg paga exceso aunque otra lleve 18. Algunas permiten sumar los pesos de pasajeros de la misma reserva; consúltalo antes.",
    },
  ]}
>
  <RepartoEquipajeTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import SesionEstudioTool from '@/components/tools/SesionEstudioTool';
---

<CalcLayout slug="sesion-estudio"
  answer={"Una sesión de estudio eficaz alterna bloques de concentración con descansos: con 4 horas disponibles y bloques de concentración de hasta 2 horas, la calculadora reparte el tiempo en bloques de estudio separados por descansos de 15 minutos. Si te cuesta concentrarte, usa bloques más cortos, de 50 minutos."}
  howTo={[
    "Introduce las horas que tienes disponibles para estudiar.",
    "Indica cuántas horas puedes mantener la concentración seguida en cada bloque.",
    "Pulsa planificar sesión para ver los bloques de estudio y los descansos."
  ]}
  whatIs={"La calculadora de sesión de estudio organiza tu tiempo disponible en bloques de estudio y descansos para mantener la concentración sin agotarte."}
  whyUse={"Te ayuda a aprovechar las tardes de estudio, las semanas de exámenes de la universidad, la preparación de la PAU o las jornadas largas de oposiciones."}
  faqs={[
    {
      q: "¿Cuánto tiempo se puede estudiar seguido?",
      a: "La concentración intensa suele mantenerse entre 25 y 90 minutos, según la persona, la materia y la hora del día. Después, la atención baja. Por eso conviene hacer descansos cortos regulares en lugar de estudiar horas sin parar.",
    },
    {
      q: "¿Qué hacer en los descansos?",
      a: "Levantarte, moverte, beber agua y mirar lejos de la pantalla. Evita las redes sociales: dificultan volver a concentrarte. Un paseo corto o unos estiramientos ayudan a recuperar la atención.",
    },
    {
      q: "¿Es mejor estudiar por la mañana o por la tarde?",
      a: "Depende de tu cronotipo. Muchas personas rinden mejor por la mañana en tareas de memoria y razonamiento, pero los trasnochadores pueden concentrarse mejor por la tarde. Lo importante es estudiar a horas regulares y no recortar horas de sueño.",
    },
    {
      q: "¿Cuántas horas al día se puede estudiar?",
      a: "Un estudiante de Bachillerato o universidad puede rendir bien con 3-5 horas de estudio personal al día en época de exámenes; los opositores, con más práctica, llegan a 6-8 horas con descansos. Más allá, el rendimiento suele caer.",
    },
    {
      q: "¿Combina con la técnica Pomodoro?",
      a: "Sí. Si te cuesta concentrarte, usa bloques de 25 minutos con 5 de descanso (técnica Pomodoro). Si ya tienes práctica, bloques de 50 minutos con 10 de descanso funcionan bien para materias que requieren inmersión.",
    },
  ]}
>
  <SesionEstudioTool client:load />
</CalcLayout>

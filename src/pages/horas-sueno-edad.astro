---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HorasSuenoEdadTool from '@/components/tools/HorasSuenoEdadTool';
---

<CalcLayout slug="horas-sueno-edad"
  answer={"Los adultos necesitan entre 7 y 9 horas de sueño al día, los adolescentes de 8 a 10, los niños de 6 a 13 años de 9 a 11 y los mayores de 65 de 7 a 8, según las recomendaciones internacionales que recoge la Sociedad Española de Neurología."}
  howTo={[
    "Introduce tu edad o la de tu hijo.",
    "Pulsa ver recomendación.",
    "Consulta las horas de sueño recomendadas para esa edad."
  ]}
  whatIs={"La calculadora de horas de sueño por edad muestra cuántas horas al día se recomienda dormir en cada etapa de la vida, desde los recién nacidos hasta los mayores."}
  whyUse={"Te ayuda a comprobar si duermes lo suficiente, a organizar los horarios de sueño de los niños y a entender las necesidades de los adolescentes, que en España suelen dormir menos de lo recomendado."}
  faqs={[
    {
      q: "¿Cuántas horas debe dormir un bebé?",
      a: "Los recién nacidos (0-3 meses) duermen entre 14 y 17 horas al día, los bebés de 4 a 11 meses entre 12 y 15, y los niños de 1 a 2 años entre 11 y 14, incluidas las siestas. Tu pediatra es la mejor referencia.",
    },
    {
      q: "¿Por qué los adolescentes se acuestan tan tarde?",
      a: "En la adolescencia el reloj biológico se retrasa de forma natural, así que les cuesta dormirse pronto. Siguen necesitando 8-10 horas, difíciles de cumplir con clases a primera hora. Limitar las pantallas por la noche ayuda.",
    },
    {
      q: "¿Los mayores necesitan dormir menos?",
      a: "Algo menos, entre 7 y 8 horas, pero su sueño es más ligero y fragmentado. Dormir mucho menos o tener mucha somnolencia diurna no es normal a ninguna edad y conviene consultarlo con el médico.",
    },
    {
      q: "¿Dormimos poco en España?",
      a: "Según la Sociedad Española de Neurología, entre un 20 % y un 48 % de los adultos tiene en algún momento dificultades para dormir. Los horarios tardíos de cena y ocio y el uso de la hora de Europa central influyen en que nos acostemos tarde.",
    },
    {
      q: "¿Qué hacer si no duermo las horas recomendadas?",
      a: "Mantén horarios regulares, evita pantallas y cafeína por la tarde-noche y crea un ambiente oscuro y fresco. Si el problema dura más de tres meses, consulta con tu médico de atención primaria.",
    },
  ]}
>
  <HorasSuenoEdadTool client:load />
</CalcLayout>

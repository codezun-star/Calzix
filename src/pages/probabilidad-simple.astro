---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ProbabilidadTool from '@/components/tools/ProbabilidadTool';
---

<CalcLayout slug="probabilidad-simple"
  answer={"Según la regla de Laplace, la probabilidad es casos favorables ÷ casos posibles: sacar un número par con un dado es 3/6 = 0,5 (50 %). La probabilidad de que salga el Gordo de la Lotería de Navidad en tu número es de 1 entre 100.000 (0,001 %)."}
  howTo={[
    "Introduce el número de casos favorables.",
    "Introduce el número total de casos posibles.",
    "Pulsa calcular probabilidad para verla en fracción, decimal y porcentaje."
  ]}
  whatIs={"La calculadora de probabilidad simple aplica la regla de Laplace para calcular la probabilidad de un suceso cuando todos los resultados son igual de probables."}
  whyUse={"Sirve para los ejercicios de probabilidad de la ESO y el Bachillerato y para entender las probabilidades reales de juegos y sorteos, como los dados, las cartas o la lotería."}
  faqs={[
    {
      q: "¿Qué probabilidad hay de que me toque la Lotería de Navidad?",
      a: "El sorteo tiene 100.000 números, así que la probabilidad de que tu número sea el Gordo es de 1 entre 100.000. Contando todos los premios, incluido el reintegro (que tiene una probabilidad de 1 entre 10), alrededor del 15 % de los décimos recibe algún premio.",
    },
    {
      q: "¿Qué es la regla de Laplace?",
      a: "Dice que, si todos los resultados de un experimento son igual de probables, la probabilidad de un suceso es el número de casos favorables dividido entre el de casos posibles. Solo vale si los resultados son equiprobables. Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Qué es la probabilidad del suceso contrario?",
      a: "P(no A) = 1 − P(A). Es útil para calcular «al menos uno»: la probabilidad de sacar al menos un 6 en 4 tiradas es 1 − (5/6)⁴ = 51,8 %.",
    },
    {
      q: "¿Cómo se calcula la probabilidad de dos sucesos?",
      a: "Si son independientes, se multiplican: sacar cara dos veces seguidas es 1/2 × 1/2 = 1/4. Si son incompatibles (no pueden ocurrir a la vez), se suman: sacar un 1 o un 2 con un dado es 1/6 + 1/6 = 1/3.",
    },
    {
      q: "¿Qué probabilidad hay de sacar un oro en la baraja española?",
      a: "La baraja española tiene 40 cartas, 10 de cada palo, así que la probabilidad es 10/40 = 1/4 (25 %). La de sacar un as es 4/40 = 1/10.",
    },
  ]}
>
  <ProbabilidadTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import LenguajeAmorTool from '@/components/tools/LenguajeAmorTool';
---

<CalcLayout slug="lenguaje-amor"
  answer={"El test de los lenguajes del amor, basado en el libro de Gary Chapman, identifica cuál de las cinco formas de expresar afecto prefieres: palabras de afirmación, tiempo de calidad, regalos, actos de servicio o contacto físico. Es un entretenimiento sin base científica: úsalo para pasar un buen rato, no para tomar decisiones importantes."}
  howTo={[
    "Puntúa del 0 al 10 cuánto valoras cada forma de recibir afecto.",
    "Pulsa descubrir mi lenguaje.",
    "Lee tu lenguaje principal y comparte el resultado con tu pareja."
  ]}
  whatIs={"El test del lenguaje del amor identifica tu lenguaje del amor principal según la teoría de los cinco lenguajes del amor de Gary Chapman."}
  whyUse={"Es un punto de partida divertido para hablar con tu pareja, tu familia o tus amigos sobre cómo os gusta recibir y demostrar cariño."}
  faqs={[
    {
      q: "¿Cuáles son los cinco lenguajes del amor?",
      a: "Según Gary Chapman: palabras de afirmación (elogios, mensajes de cariño), tiempo de calidad (atención plena), regalos, actos de servicio (ayudar con tareas) y contacto físico (abrazos, caricias).",
    },
    {
      q: "¿Tiene base científica?",
      a: "Es una teoría popular de divulgación, publicada en 1992, con evidencia científica limitada. Aun así, muchas parejas la encuentran útil para hablar de sus necesidades afectivas. Es un entretenimiento sin base científica: úsalo para pasar un buen rato, no para tomar decisiones importantes.",
    },
    {
      q: "¿Puedo tener varios lenguajes?",
      a: "Sí. La mayoría de personas valoran varias formas de afecto, con una o dos preferidas. Las preferencias pueden cambiar con el tiempo y las circunstancias.",
    },
    {
      q: "¿Para qué sirve conocer el lenguaje de mi pareja?",
      a: "Para demostrar el cariño de la forma que la otra persona más valora: si su lenguaje es el tiempo de calidad, quizá aprecie más una tarde juntos sin móviles que un regalo.",
    },
    {
      q: "¿Se guardan mis respuestas?",
      a: "No. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor.",
    },
  ]}
>
  <LenguajeAmorTool client:load />
</CalcLayout>

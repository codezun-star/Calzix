---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NumeroAvogadroTool from '@/components/tools/NumeroAvogadroTool';
---

<CalcLayout slug="numero-avogadro"
  answer={"El número de Avogadro es exactamente 6,02214076 × 10²³ partículas por mol. Para pasar de moles a partículas se multiplica por él: 2 moles de agua contienen 1,2 × 10²⁴ moléculas; y para pasar de partículas a moles se divide."}
  howTo={[
    "Elige si quieres pasar de moles a partículas o de partículas a moles.",
    "Introduce la cantidad.",
    "Pulsa calcular para obtener el resultado en notación científica."
  ]}
  whatIs={"La calculadora del número de Avogadro convierte entre moles y número de partículas (átomos, moléculas o iones) con la constante de Avogadro."}
  whyUse={"Sirve para los problemas de cantidad de sustancia de Física y Química de 4.º de ESO y Bachillerato, y para manejar sin errores números tan grandes."}
  faqs={[
    {
      q: "¿Qué es el número de Avogadro?",
      a: "Es el número de entidades elementales que hay en un mol: 6,02214076 × 10²³. Desde la redefinición del Sistema Internacional de 2019 es un valor exacto que define el mol. Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Cómo calculo los átomos de una muestra?",
      a: "Pasa la masa a moles (n = m / M) y multiplica por el número de Avogadro. 12 g de carbono son 1 mol, es decir, 6,022 × 10²³ átomos.",
    },
    {
      q: "¿Por qué es tan grande?",
      a: "Porque los átomos son extraordinariamente pequeños. El mol permite pasar de la escala atómica a cantidades que se pueden pesar en el laboratorio.",
    },
    {
      q: "¿Cómo se escribe en notación científica?",
      a: "6,022 × 10²³ significa 6.022 seguido de 20 ceros. En la calculadora se introduce como 6.022E23. Usa la calculadora de notación científica para practicar.",
    },
    {
      q: "¿Quién fue Avogadro?",
      a: "Amedeo Avogadro, científico italiano que en 1811 propuso que volúmenes iguales de gases en las mismas condiciones contienen el mismo número de moléculas. La constante lleva su nombre en su honor.",
    },
  ]}
>
  <NumeroAvogadroTool client:load />
</CalcLayout>

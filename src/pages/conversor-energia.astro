---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvEnergiaTool from '@/components/tools/ConvEnergiaTool';
---

<CalcLayout slug="conversor-energia"
  answer={"Para convertir energía usa estos factores: 1 kWh = 3.600 kJ = 860 kcal, 1 kcal = 4,184 kJ y 1 BTU = 1,055 kJ. Así, un aparato que consume 1 kWh gasta tanta energía como 860 kilocalorías, y una barrita de 200 kcal tiene 837 kJ."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 1 kWh o 2.000 kcal).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de energía convierte entre julios, kilojulios, calorías, kilocalorías, vatios-hora, kilovatios-hora y BTU con los factores exactos."}
  whyUse={"Te ayuda a entender tu factura de la luz o del gas (en kWh), las kilocalorías y kilojulios del etiquetado nutricional, la potencia de un aire acondicionado en BTU y los problemas de física."}
  faqs={[
    {
      q: "¿Por qué las etiquetas de los alimentos muestran kJ y kcal?",
      a: "El Reglamento europeo 1169/2011 sobre información alimentaria obliga a indicar el valor energético en kilojulios y kilocalorías. 1 kcal = 4,184 kJ. Lo que coloquialmente llamamos «calorías» de un alimento son en realidad kilocalorías.",
    },
    {
      q: "¿Qué es un kWh?",
      a: "Es la energía que consume un aparato de 1.000 W funcionando durante una hora. Es la unidad con la que se factura la electricidad en España y también el gas natural. 1 kWh = 3,6 millones de julios.",
    },
    {
      q: "¿Qué son las frigorías y los BTU de un aire acondicionado?",
      a: "Son formas de expresar la potencia frigorífica. En España se usan mucho las frigorías por hora: 1 frigoría/h = 1,163 W, así que un equipo de 3.000 frigorías tiene unos 3,5 kW de potencia frigorífica. En otros países se usan BTU/h: 12.000 BTU/h son unos 3,5 kW.",
    },
    {
      q: "¿Cuánta energía consume un hogar en España?",
      a: "Un hogar medio consume entre 3.000 y 4.000 kWh de electricidad al año, más el gas o el gasóleo de la calefacción si la tiene. Para estimar el coste de un aparato, usa la calculadora de consumo eléctrico.",
    },
    {
      q: "¿Cuántas kcal gasta una persona al día?",
      a: "Las necesidades de energía de un adulto suelen estar entre 1.800 y 2.500 kcal diarias (7.500-10.500 kJ), según la edad, el sexo, el peso y la actividad física. Puedes calcularlas con la calculadora de calorías.",
    },
  ]}
>
  <ConvEnergiaTool client:load />
</CalcLayout>

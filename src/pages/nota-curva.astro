---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NotaCurvaTool from '@/components/tools/NotaCurvaTool';
---

<CalcLayout slug="nota-curva"
  answer={"Una curva lineal multiplica cada nota por la nota máxima posible dividida entre la nota más alta de la clase: si la mejor nota fue un 8 y tú sacaste un 6, con la curva tu nota sería 6 × 10 / 8 = 7,5."}
  howTo={[
    "Introduce tu nota.",
    "Escribe la nota más alta de la clase y la nota máxima posible.",
    "Pulsa aplicar curva para ver tu nota ajustada."
  ]}
  whatIs={"La calculadora de nota con curva aplica una curva lineal que reescala las notas de un examen para que la nota más alta del grupo pase a ser la máxima posible."}
  whyUse={"Sirve a docentes que quieren reescalar un examen que ha resultado demasiado difícil y a estudiantes que quieren saber cómo quedaría su nota con ese ajuste."}
  faqs={[
    {
      q: "¿Se usan las curvas en España?",
      a: "No son habituales. En España las notas se ponen normalmente sobre criterios fijos (la nota absoluta sobre 10), según la guía docente de cada asignatura o los criterios de evaluación de la LOMLOE en la ESO y el Bachillerato. Algunos docentes reescalan un examen concreto si ha sido excesivamente difícil.",
    },
    {
      q: "¿Cómo funciona la curva lineal?",
      a: "Se calcula el factor = nota máxima posible / nota más alta del grupo y se multiplica cada nota por ese factor, sin superar el máximo. Con una nota más alta de 8 sobre 10, el factor es 1,25.",
    },
    {
      q: "¿Hay otros tipos de curva?",
      a: "Sí: sumar los mismos puntos a todos (curva aditiva), ajustar las notas a una distribución normal o fijar porcentajes de aprobados. Cada método cambia de forma distinta las notas bajas y altas.",
    },
    {
      q: "¿Puedo reclamar una nota?",
      a: "Sí. En la universidad tienes derecho a la revisión del examen ante el profesor y, después, a recurrir ante la comisión que fije la normativa de evaluación de tu universidad. En la ESO y el Bachillerato, las familias pueden reclamar las calificaciones finales ante el centro y la Administración educativa.",
    },
    {
      q: "¿Qué calificación corresponde a cada nota?",
      a: "En la universidad: 0-4,9 suspenso, 5-6,9 aprobado, 7-8,9 notable y 9-10 sobresaliente, con la matrícula de honor para un máximo del 5 % de los alumnos con sobresaliente.",
    },
  ]}
>
  <NotaCurvaTool client:load />
</CalcLayout>

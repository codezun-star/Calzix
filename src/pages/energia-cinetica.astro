---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import EnergiaCineticaTool from '@/components/tools/EnergiaCineticaTool';
---

<CalcLayout slug="energia-cinetica"
  answer={"La energía cinética es Ec = ½ · m · v²: un coche de 1.200 kg a 90 km/h (25 m/s) tiene 375.000 J. Como depende del cuadrado de la velocidad, a 120 km/h su energía casi se duplica (667.000 J), y por eso la distancia de frenado aumenta tanto con la velocidad."}
  howTo={[
    "Introduce la masa del objeto en kilogramos.",
    "Introduce su velocidad en metros por segundo (divide los km/h entre 3,6).",
    "Pulsa calcular para obtener la energía cinética en julios."
  ]}
  whatIs={"La calculadora de energía cinética calcula la energía que tiene un cuerpo por estar en movimiento, con la fórmula Ec = ½ · m · v²."}
  whyUse={"Sirve para los problemas de energía de Física y Química de la ESO y el Bachillerato y para entender, con números, por qué la velocidad es tan determinante en la gravedad de los accidentes de tráfico."}
  faqs={[
    {
      q: "¿Por qué la velocidad influye tanto en un choque?",
      a: "Porque la energía cinética crece con el cuadrado de la velocidad: al duplicar la velocidad, la energía se multiplica por cuatro. Esa energía debe disiparse al frenar o en un impacto. Por eso la DGT insiste en que pequeñas reducciones de velocidad salvan vidas, y en ciudad se ha generalizado el límite de 30 km/h.",
    },
    {
      q: "¿Cómo afecta la velocidad a la distancia de frenado?",
      a: "La distancia de frenado es proporcional al cuadrado de la velocidad. Sobre asfalto seco, un turismo necesita unos 40 m para frenar desde 90 km/h y unos 70 m desde 120 km/h, sin contar la distancia recorrida durante el tiempo de reacción (unos 25-33 m a esas velocidades).",
    },
    {
      q: "¿Cómo se aprovecha la energía cinética del viento?",
      a: "Los aerogeneradores transforman la energía cinética del viento en electricidad. La potencia del viento depende del cubo de su velocidad, por eso los parques se instalan en zonas ventosas. España es uno de los países europeos con más potencia eólica instalada, y la eólica es una de sus principales fuentes de electricidad.",
    },
    {
      q: "¿Qué es el teorema de la energía cinética?",
      a: "Dice que el trabajo total realizado sobre un cuerpo es igual a la variación de su energía cinética: W = ΔEc. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Qué unidades se usan?",
      a: "En el Sistema Internacional, la masa en kilogramos, la velocidad en m/s y la energía en julios (J). 1 kJ = 1.000 J y 1 kWh = 3,6 millones de julios.",
    },
  ]}
>
  <EnergiaCineticaTool client:load />
</CalcLayout>

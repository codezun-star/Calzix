---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DuracionVueloTool from '@/components/tools/DuracionVueloTool';
---

<CalcLayout slug="duracion-vuelo"
  answer={"La duración de un vuelo es la distancia entre la velocidad de crucero (unos 850 km/h en un avión comercial) más el tiempo de despegue, aproximación y escalas. Madrid-Nueva York (5.770 km) dura unas 8 horas; Madrid-Tenerife (1.770 km), unas 2 horas y 40 minutos; y Madrid-Ciudad de México (9.070 km), unas 11-12 horas."}
  howTo={[
    "Introduce la distancia del vuelo en kilómetros.",
    "Ajusta la velocidad de crucero si lo necesitas (850 km/h es típico para reactores comerciales).",
    "Añade el tiempo de escala si lo hay y pulsa calcular para ver la duración total."
  ]}
  whatIs={"La calculadora de duración de un vuelo estima el tiempo de vuelo a partir de la distancia en kilómetros y la velocidad de crucero, sumando las escalas, para rutas nacionales e internacionales con salida desde los aeropuertos españoles."}
  whyUse={"Sirve para hacerte una idea de lo que durará un viaje antes de reservar, comparar un vuelo directo con uno con escala, calcular la hora de llegada junto con la calculadora de husos horarios y planificar el descanso para reducir el jet lag."}
  faqs={[
    {
      q: "¿Cuánto duran los vuelos más habituales desde España?",
      a: "Tiempos orientativos desde Madrid: Barcelona, 1 h 15 min; Palma, 1 h 15 min; Tenerife o Gran Canaria, 2 h 40 min; Londres, 2 h 20 min; París, 2 h; Roma, 2 h 30 min; Nueva York, 8 h; Miami, 9 h 30 min; Ciudad de México, 11-12 h; Bogotá, 10 h; Buenos Aires, 12-13 h; Tokio, 14 h. El regreso desde América suele ser más corto por los vientos del oeste.",
    },
    {
      q: "¿Por qué el vuelo de ida y el de vuelta duran distinto?",
      a: "Por las corrientes en chorro, vientos muy fuertes que soplan de oeste a este a la altura de crucero. Los vuelos de América a Europa los aprovechan y pueden ser una hora más cortos que los de Europa a América. Las aerolíneas ajustan cada día la ruta para aprovechar o evitar estos vientos.",
    },
    {
      q: "¿Por qué la distancia en avión no coincide con la de carretera?",
      a: "Los aviones vuelan siguiendo aproximadamente la ortodrómica, la línea más corta sobre la superficie esférica de la Tierra, por eso en el mapa plano las rutas transatlánticas parecen curvas. Además, las aerovías y los procedimientos de salida y llegada añaden algunos kilómetros respecto a la distancia en línea recta.",
    },
    {
      q: "¿Qué derechos tengo si mi vuelo se retrasa?",
      a: "El Reglamento (CE) 261/2004 te protege en vuelos que salen de la UE o que llegan a ella con una aerolínea europea. Si llegas a destino con más de 3 horas de retraso por causas imputables a la aerolínea, tienes derecho a una compensación de 250 € (vuelos de hasta 1.500 km), 400 € (de 1.500 a 3.500 km o intracomunitarios de más de 1.500 km) o 600 € (más de 3.500 km), además de asistencia (comida, bebida y alojamiento si es necesario).",
    },
    {
      q: "¿Cuánto tiempo de escala necesito?",
      a: "En un aeropuerto como Madrid-Barajas, la conexión mínima entre vuelos Schengen es de unos 45-50 minutos y con vuelos internacionales que exigen control de pasaportes, de 1 hora a 1 hora y 30 minutos. Si los vuelos van en billetes separados, deja al menos 3 horas, porque la aerolínea no se hace responsable si pierdes la conexión.",
    },
    {
      q: "¿Cómo reducir el jet lag en vuelos largos?",
      a: "Ajusta tus horas de sueño unos días antes hacia el horario del destino, bebe agua y evita el alcohol durante el vuelo, duerme si en destino es de noche y adáptate a la hora local nada más llegar, buscando luz natural por la mañana. La calculadora de jet lag estima cuántos días tardarás en adaptarte.",
    },
  ]}
>
  <DuracionVueloTool client:load />
</CalcLayout>

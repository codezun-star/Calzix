---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import SolucionConcentracionTool from '@/components/tools/SolucionConcentracionTool';
---

<CalcLayout slug="solucion-concentracion"
  answer={"La molaridad es moles de soluto entre litros de disolución: 5 g de NaCl (58,44 g/mol) son 0,0856 mol, y disueltos en 250 mL dan una concentración de 0,342 M. La misma disolución tiene 20.000 mg/L, es decir, 20.000 ppm."}
  howTo={[
    "Elige el tipo de concentración: molar (mol/L), porcentaje en masa (% m/m) o partes por millón (ppm).",
    "Introduce la masa de soluto, el volumen o la masa de la disolución y, para la molaridad, la masa molar del soluto.",
    "Pulsa calcular para obtener la concentración."
  ]}
  whatIs={"La calculadora de concentración de disoluciones calcula la molaridad, el porcentaje en masa y las partes por millón de una disolución a partir de la cantidad de soluto y de disolución."}
  whyUse={"Sirve para resolver los problemas de disoluciones de Física y Química, preparar disoluciones en el laboratorio y entender las concentraciones de productos del día a día, como el suero fisiológico o los análisis de agua."}
  faqs={[
    {
      q: "¿Qué formas hay de expresar la concentración?",
      a: "Las más usadas son la molaridad (mol de soluto por litro de disolución), el porcentaje en masa (gramos de soluto por 100 g de disolución), el porcentaje en volumen, la concentración en g/L y las partes por millón (mg/L en disoluciones acuosas diluidas). Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Qué concentración tiene el suero fisiológico?",
      a: "El suero fisiológico es una disolución de cloruro de sodio al 0,9 % (9 g por litro), que equivale a unos 0,154 M. Es isotónico con la sangre, por eso se usa para lavados nasales, heridas e infusiones intravenosas.",
    },
    {
      q: "¿Para qué se usan las ppm?",
      a: "Para concentraciones muy pequeñas, como los contaminantes del agua o del aire. En España, el Real Decreto 3/2023 sobre la calidad del agua de consumo fija, por ejemplo, un máximo de 50 mg/L (50 ppm) de nitratos en el agua del grifo.",
    },
    {
      q: "¿Qué diferencia hay entre molaridad y molalidad?",
      a: "La molaridad usa el volumen de la disolución (mol/L) y cambia ligeramente con la temperatura; la molalidad usa la masa del disolvente (mol/kg) y no depende de la temperatura, por eso se usa en propiedades coligativas como el descenso del punto de congelación.",
    },
    {
      q: "¿Cómo preparo una disolución de una molaridad concreta?",
      a: "Calcula la masa de soluto: masa = M × V (L) × masa molar. Para 500 mL de NaCl 0,1 M necesitas 0,1 × 0,5 × 58,44 = 2,92 g. Disuélvelos en algo menos de agua y enrasa a 500 mL en un matraz aforado.",
    },
  ]}
>
  <SolucionConcentracionTool client:load />
</CalcLayout>

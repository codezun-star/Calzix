---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvFrecuenciaTool from '@/components/tools/ConvFrecuenciaTool';
---

<CalcLayout slug="conversor-frecuencia"
  answer={"Para convertir frecuencias: 1 kHz = 1.000 Hz, 1 MHz = 1.000.000 Hz y 1 GHz = 1.000 MHz. Las revoluciones por minuto se pasan a hercios dividiendo entre 60: un motor a 3.000 rpm gira a 50 Hz, la misma frecuencia que la red eléctrica española."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 3.000 rpm o 2,4 GHz).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de frecuencia convierte entre hercios, kilohercios, megahercios, gigahercios, revoluciones por minuto y radianes por segundo."}
  whyUse={"Sirve para entender la frecuencia de la red eléctrica, las emisoras de radio, las bandas del wifi y el 5G, la velocidad de un procesador o las revoluciones de un motor, y para los problemas de física."}
  faqs={[
    {
      q: "¿Qué frecuencia tiene la red eléctrica en España?",
      a: "50 Hz, como en el resto de Europa, con una tensión de 230 V. En Estados Unidos y parte de América la red funciona a 60 Hz y 120 V, por lo que algunos aparatos importados necesitan un transformador.",
    },
    {
      q: "¿En qué frecuencias emiten la radio y el wifi?",
      a: "La radio FM emite entre 87,5 y 108 MHz; la onda media, entre 531 y 1.602 kHz. El wifi usa las bandas de 2,4 GHz, 5 GHz y, en los routers más nuevos, 6 GHz. El 5G en España se despliega principalmente en la banda de 3,5 GHz y en la de 700 MHz.",
    },
    {
      q: "¿Cómo paso de rpm a hercios?",
      a: "Divide entre 60: 6.000 rpm = 100 Hz. Para pasar a radianes por segundo, multiplica los hercios por 2π: 100 Hz = 628,3 rad/s.",
    },
    {
      q: "¿Qué significan los GHz de un procesador?",
      a: "Indican cuántos ciclos de reloj realiza por segundo: un procesador de 3,5 GHz realiza 3.500 millones de ciclos por segundo. No es la única medida de rendimiento: influyen el número de núcleos, la arquitectura y la memoria caché.",
    },
    {
      q: "¿Qué frecuencias puede oír el ser humano?",
      a: "Entre unos 20 Hz y 20 kHz en personas jóvenes; con la edad, se pierde la capacidad de oír las frecuencias más altas. La nota la musical de referencia (la4) vibra a 440 Hz.",
    },
  ]}
>
  <ConvFrecuenciaTool client:load />
</CalcLayout>

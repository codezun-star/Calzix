---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvPotenciaTool from '@/components/tools/ConvPotenciaTool';
---

<CalcLayout slug="conversor-potencia"
  answer={"Para convertir potencia usa estos factores: 1 CV (caballo de vapor) = 735,5 W, 1 hp (caballo de potencia anglosajón) = 745,7 W y 1 kW = 1,36 CV. Un coche de 110 kW tiene 150 CV, y un aire acondicionado de 3.000 frigorías/h, unos 3,5 kW."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 110 kW o 150 CV).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de potencia convierte entre vatios, kilovatios, megavatios, caballos de vapor (CV), caballos de potencia (hp), kilocalorías por hora y BTU por hora."}
  whyUse={"Te ayuda a entender la ficha técnica de un coche (kW y CV), la potencia de un electrodoméstico o un aire acondicionado, la potencia contratada de la luz y la de una instalación solar."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre CV y hp?",
      a: "El caballo de vapor (CV), usado en España y en Europa continental, equivale a 735,5 W. El horsepower (hp) anglosajón equivale a 745,7 W, un 1,4 % más. En la ficha técnica de los coches vendidos en España, la potencia oficial figura en kW, y los CV se indican como referencia.",
    },
    {
      q: "¿Cómo paso de kW a CV?",
      a: "Multiplica por 1,36. Un coche de 85 kW tiene unos 116 CV, y uno de 150 kW, unos 204 CV. Para pasar de CV a kW, divide entre 1,36 o multiplica por 0,7355.",
    },
    {
      q: "¿Qué son los caballos fiscales?",
      a: "Los caballos fiscales (CVF) no miden la potencia real: se calculan a partir de la cilindrada y el número de cilindros, y sirven para fijar el impuesto de circulación (IVTM) en los ayuntamientos. Por eso dos coches con la misma potencia pueden pagar distinto impuesto.",
    },
    {
      q: "¿Qué potencia de luz necesito contratar?",
      a: "Las potencias más habituales en viviendas son 3,45, 4,6 y 5,75 kW. Suma la potencia de los aparatos que suelen funcionar a la vez (horno, vitrocerámica, lavadora, aire acondicionado) para elegirla. Ajustarla bien ahorra en el término de potencia de la factura.",
    },
    {
      q: "¿Qué es una frigoría?",
      a: "Es una unidad de potencia frigorífica usada en España para los aires acondicionados: 1 frigoría/h = 1 kcal/h = 1,163 W. Como regla orientativa, se necesitan entre 100 y 150 frigorías/h por m² según el aislamiento y la orientación.",
    },
  ]}
>
  <ConvPotenciaTool client:load />
</CalcLayout>

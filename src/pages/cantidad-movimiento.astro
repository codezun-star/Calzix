---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CantidadMovimientoTool from '@/components/tools/CantidadMovimientoTool';
---

<CalcLayout slug="cantidad-movimiento"
  answer={"La cantidad de movimiento o momento lineal es la masa por la velocidad: p = m · v. Un coche de 1.200 kg a 25 m/s (90 km/h) tiene una cantidad de movimiento de 30.000 kg·m/s."}
  howTo={[
    "Elige qué quieres calcular: cantidad de movimiento, masa o velocidad.",
    "Introduce los otros dos datos.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de cantidad de movimiento calcula el momento lineal de un cuerpo, o su masa o su velocidad, con la relación p = m · v."}
  whyUse={"Sirve para los problemas de dinámica, choques y conservación del momento lineal de Física de 1.º de Bachillerato y para entender la física de los choques y la seguridad vial."}
  faqs={[
    {
      q: "¿Qué es la cantidad de movimiento?",
      a: "Es una magnitud vectorial que combina la masa y la velocidad de un cuerpo: p = m · v, medida en kg·m/s. Tiene la dirección y el sentido de la velocidad. Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Qué dice el principio de conservación?",
      a: "Si sobre un sistema no actúan fuerzas externas, la cantidad de movimiento total se conserva. Por eso, en un choque, la suma de los momentos antes y después es la misma, y un arma retrocede al disparar.",
    },
    {
      q: "¿Qué es el impulso?",
      a: "Es la fuerza por el tiempo que actúa (I = F · Δt) y es igual a la variación de la cantidad de movimiento. Los airbags y los cinturones aumentan el tiempo de frenado del cuerpo y reducen así la fuerza del impacto.",
    },
    {
      q: "¿Por qué un camión es más peligroso que un coche a la misma velocidad?",
      a: "Porque tiene mucha más masa y, por tanto, mucha más cantidad de movimiento y energía cinética: necesita más distancia para detenerse y transmite más energía en un choque.",
    },
    {
      q: "¿Qué diferencia hay entre momento lineal y energía cinética?",
      a: "El momento lineal es m · v (vectorial) y la energía cinética, ½ m v² (escalar). En los choques elásticos se conservan ambos; en los inelásticos, solo el momento lineal.",
    },
  ]}
>
  <CantidadMovimientoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CompostOrganicoTool from '@/components/tools/CompostOrganicoTool';
---

<CalcLayout slug="compost-organico"
  answer={"De los restos orgánicos se obtiene en compost alrededor del 30 % de su peso: con 3 kg de restos a la semana durante 12 semanas (36 kg) se obtienen unos 11 kg de compost. Compostar en casa o usar el contenedor marrón evita que la materia orgánica genere metano en el vertedero."}
  howTo={[
    "Introduce los kilos de residuos orgánicos que generas a la semana.",
    "Indica las semanas de compostaje.",
    "Pulsa calcular para ver el compost obtenido y el CO₂ evitado."
  ]}
  whatIs={"La calculadora de compost casero estima los kilos de compost que obtendrás con tus restos orgánicos de cocina y jardín en una compostera doméstica o comunitaria, y el CO₂ equivalente que evitas al no llevarlos al vertedero."}
  whyUse={"Te ayuda a dimensionar una compostera, a calcular el abono que tendrás para el huerto o las macetas y a ver el impacto de separar la materia orgánica, obligatorio en todos los municipios españoles con la Ley 7/2022."}
  faqs={[
    {
      q: "¿Qué se puede compostar en casa?",
      a: "Restos de fruta y verdura, posos de café e infusiones, cáscaras de huevo, servilletas de papel sin tinta, restos de poda triturados, hojas secas y césped cortado. Hay que equilibrar materiales «verdes» húmedos (restos de cocina, césped) con «marrones» secos (hojas, ramitas, cartón). No se deben compostar en casa carne, pescado, lácteos, aceites ni excrementos de mascotas.",
    },
    {
      q: "¿Cuánto tarda en hacerse el compost?",
      a: "Entre 3 y 6 meses en una compostera bien gestionada (con volteos y humedad adecuada), y más en invierno o en zonas frías. En el clima cálido de buena parte de España el proceso es más rápido, pero hay que vigilar que no se seque en verano. El compost está maduro cuando es oscuro, huele a tierra de bosque y no se reconocen los restos.",
    },
    {
      q: "¿Qué es el contenedor marrón?",
      a: "Es el contenedor de biorresiduos (materia orgánica) que la Ley 7/2022 de residuos obliga a implantar en todos los municipios. En él van los restos de comida, incluidos carne y pescado, y pequeños restos de jardín. La materia orgánica se convierte en compost o biogás en plantas industriales.",
    },
    {
      q: "¿Hay compostaje comunitario en España?",
      a: "Sí, cada vez más ayuntamientos instalan compostadoras comunitarias en parques y barrios, gestionadas por los vecinos con apoyo técnico, y reparten composteras domésticas gratuitas a quienes tienen jardín. Algunos municipios bonifican la tasa de basuras a quienes compostan en casa.",
    },
    {
      q: "¿Para qué sirve el compost?",
      a: "Es un abono orgánico excelente para el huerto, los frutales, las macetas y el césped: mejora la estructura del suelo, retiene la humedad (algo valioso en el clima español) y aporta nutrientes de forma lenta. Se aplican unos 2-5 kg por metro cuadrado al año en el huerto.",
    },
    {
      q: "¿Por qué compostar reduce las emisiones?",
      a: "En el vertedero, la materia orgánica se descompone sin oxígeno y genera metano, un gas con un efecto invernadero unas 28 veces mayor que el CO₂ a cien años. En el compostaje la descomposición es aeróbica y apenas se produce metano. Además, el compost sustituye a fertilizantes químicos cuya fabricación emite CO₂.",
    },
  ]}
>
  <CompostOrganicoTool client:load />
</CalcLayout>

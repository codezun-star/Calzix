---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DescuentoProntoPagoTool from '@/components/tools/DescuentoProntoPagoTool';
---

<CalcLayout slug="descuento-pronto-pago"
  answer={"El descuento por pronto pago reduce la factura si el cliente paga antes del vencimiento: un 2 % de descuento sobre 1.000 € por pagar 30 días antes ahorra 20 €, lo que equivale a una rentabilidad anual de alrededor del 24 % para quien paga y a un coste financiero similar para quien cobra."}
  howTo={[
    "Introduce el importe de la factura.",
    "Escribe el porcentaje de descuento ofrecido.",
    "Indica cuántos días se adelanta el pago y pulsa calcular para ver el ahorro y su rentabilidad anual equivalente."
  ]}
  whatIs={"La calculadora de descuento por pronto pago calcula el ahorro de pagar una factura por adelantado y su tipo de interés anual equivalente, para saber si compensa ofrecerlo o aceptarlo."}
  whyUse={"Ayuda a autónomos y empresas a decidir si les conviene ofrecer un descuento para cobrar antes (frente a pedir financiación al banco) y a los compradores a valorar si deben aprovecharlo."}
  faqs={[
    {
      q: "¿Cómo se calcula la rentabilidad anual del descuento?",
      a: "Divide el descuento entre el importe pagado y anualízalo según los días adelantados: 2 % por adelantar 30 días equivale aproximadamente a 2 / 98 × 365 / 30 ≈ 24,8 % anual. Si para pagar antes tuvieras que endeudarte a un tipo menor, te compensa aceptar el descuento.",
    },
    {
      q: "¿Cómo afecta al IVA?",
      a: "Si el descuento figura en la propia factura, reduce la base imponible y el IVA. Si se concede después de emitirla, al cobrar, hay que emitir una factura rectificativa para reducir la base y el IVA repercutido.",
    },
    {
      q: "¿Me compensa ofrecer descuento por pronto pago?",
      a: "Si necesitas liquidez y la alternativa es el descuento comercial, el confirming o un préstamo bancario, compara su coste con el del descuento. Un 2 % por cobrar 30 días antes es caro (más del 20 % anual); un 0,5-1 % suele ser más razonable.",
    },
    {
      q: "¿Qué plazo de pago es legal?",
      a: "Entre empresas, la Ley 3/2004 fija un máximo de 30 días, ampliable por pacto hasta 60. Pagar fuera de plazo genera intereses de demora (10,40 % en el segundo semestre de 2026) y 40 € de indemnización por factura.",
    },
    {
      q: "¿Cómo debe aparecer en la factura?",
      a: "Indica las condiciones: «2 % de descuento si se paga antes del día X». Si el cliente lo aplica, la factura definitiva o la rectificativa reflejará la base y el IVA reducidos.",
    },
  ]}
>
  <DescuentoProntoPagoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import MaterialesConstruccionTool from '@/components/tools/MaterialesConstruccionTool';
---

<CalcLayout slug="materiales-construccion"
  answer={"Para levantar un muro calcula su superficie (largo × alto) y multiplícala por las piezas por m²: una pared de 5 × 2,5 m (12,5 m²) con ladrillo estándar de 24 × 11,5 × 7 cm necesita unos 790 ladrillos, contando un 5 % de roturas, además de los sacos de cemento y arena para el mortero."}
  howTo={[
    "Introduce el largo y el alto de la pared en metros.",
    "Elige el tipo de pieza: ladrillo estándar, ladrillo perforado o bloque de hormigón.",
    "Pulsa calcular para ver el número de piezas y los sacos de cemento y arena."
  ]}
  whatIs={"La calculadora de materiales de construcción estima cuántos ladrillos o bloques necesitas para levantar una pared y los sacos de cemento y arena para el mortero de agarre."}
  whyUse={"Te ayuda a calcular materiales para una pared, un muro de jardín, una barbacoa o un cerramiento, comparar presupuestos y pedir la cantidad adecuada en el almacén."}
  faqs={[
    {
      q: "¿Cuántos ladrillos entran en un metro cuadrado?",
      a: "Depende del formato y del aparejo. Con el ladrillo de 24 × 11,5 × 7 cm y juntas de 1 cm se colocan unos 50-60 por m² en un muro de medio pie; con ladrillo perforado de 9 cm de altura, unos 45; y con bloque de hormigón de 40 × 20 cm, unas 12,5 piezas por m².",
    },
    {
      q: "¿Por qué se añade un 5 % de más?",
      a: "Para compensar las piezas que se rompen al transportarlas o al cortarlas para ajustar esquinas, huecos y remates. En trabajos con muchos cortes conviene un margen mayor.",
    },
    {
      q: "¿Qué ladrillo uso para cada trabajo?",
      a: "El ladrillo perforado se usa en muros de carga y fachadas para revestir; el hueco (doble o sencillo), en tabiques interiores; el macizo o caravista, en fachadas vistas y barbacoas; y el bloque de hormigón, en muros de cerramiento, naves y muros de jardín.",
    },
    {
      q: "¿Necesito permiso para levantar un muro?",
      a: "Normalmente sí. Un muro de cerramiento de una parcela o una construcción en el jardín suele requerir licencia o declaración responsable en el ayuntamiento, que además fija la altura máxima y los retranqueos. Los muros de carga y estructuras deben cumplir el Código Técnico de la Edificación.",
    },
    {
      q: "¿Cuánto cuesta levantar un tabique?",
      a: "En España, un tabique de ladrillo hueco con mano de obra cuesta aproximadamente entre 25 y 45 € por m², sin contar el enlucido y la pintura. Los tabiques de pladur suelen tener un precio similar y son más rápidos de montar.",
    },
  ]}
>
  <MaterialesConstruccionTool client:load />
</CalcLayout>

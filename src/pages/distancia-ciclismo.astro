---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DistanciaCiclismoTool from '@/components/tools/DistanciaCiclismoTool';
---

<CalcLayout slug="distancia-ciclismo"
  answer={"En bicicleta urbana a 15 km/h se tarda 4 minutos por kilómetro: 10 km son 40 minutos. Una persona de 70 kg quema unas 400-500 kcal por hora pedaleando a ritmo moderado (unos 20 km/h), y cada kilómetro que haces en bici en lugar de en coche evita unos 140 g de CO₂."}
  howTo={[
    "Introduce la distancia en kilómetros.",
    "Indica tu peso y tu velocidad media (15 km/h en ciudad, 20-25 km/h en carretera).",
    "Pulsa calcular para ver el tiempo, las calorías y el CO₂ evitado."
  ]}
  whatIs={"La calculadora de tiempo en bicicleta estima cuánto tardarás en recorrer una distancia según tu velocidad media, las calorías que quemarás según tu peso y el CO₂ que evitas frente a hacer el mismo trayecto en coche."}
  whyUse={"Sirve para planificar desplazamientos al trabajo en bici o en bicicleta compartida, salidas en carretera o en BTT y rutas por vías verdes, y para valorar el ahorro económico y ambiental de dejar el coche."}
  faqs={[
    {
      q: "¿A qué velocidad se va en bicicleta?",
      a: "En ciudad, entre 12 y 18 km/h de media contando semáforos; en bicicleta eléctrica, 18-22 km/h (la asistencia se corta a 25 km/h por ley); en carretera, un aficionado mantiene 22-28 km/h en llano; en BTT por caminos, 10-15 km/h. Las cuestas y el viento cambian mucho la media.",
    },
    {
      q: "¿Cuántas calorías se queman en bicicleta?",
      a: "A ritmo moderado (unos 20 km/h, 8 MET), una persona de 70 kg quema unas 500-560 kcal por hora; a ritmo suave de paseo (15 km/h, unos 6 MET), unas 400-420. En bicicleta eléctrica se queman menos, pero sigue siendo actividad física moderada.",
    },
    {
      q: "¿Qué normas debo cumplir al circular en bici en España?",
      a: "El casco es obligatorio en vías interurbanas (salvo en rampas prolongadas, por calor extremo o en ciclistas profesionales) y para los menores de 16 años en todas las vías. Debes llevar luces y elementos reflectantes de noche, no puedes circular por las aceras salvo que lo permita la ordenanza municipal y la tasa de alcohol permitida es la misma que para los conductores. Los coches deben dejar 1,5 metros al adelantar a un ciclista.",
    },
    {
      q: "¿Cuánto ahorro yendo al trabajo en bici?",
      a: "Si sustituyes 10 km diarios en coche (ida y vuelta) durante 220 días laborables, ahorras unos 2.200 km al año: con un coste por kilómetro de 0,25-0,35 € (combustible, mantenimiento, aparcamiento), entre 550 y 770 € al año, y unos 300 kg de CO₂. Muchas ciudades tienen bicicleta pública por menos de 50 € al año.",
    },
    {
      q: "¿Qué son las vías verdes?",
      a: "Son antiguos trazados ferroviarios en desuso reconvertidos en itinerarios para ciclistas y caminantes, con pendientes suaves y sin tráfico. En España hay más de 3.000 km de vías verdes, como la del Aceite (Jaén-Córdoba), la de la Sierra (Cádiz-Sevilla) o la del Carrilet (Girona). Son ideales para rutas familiares.",
    },
    {
      q: "¿Hay ayudas para comprar una bicicleta eléctrica?",
      a: "Algunas comunidades autónomas y ayuntamientos han convocado ayudas para la compra de bicicletas eléctricas y de carga dentro de sus planes de movilidad sostenible, normalmente por un porcentaje del precio con un tope. Consulta en la web de tu comunidad o ayuntamiento si hay convocatorias abiertas.",
    },
  ]}
>
  <DistanciaCiclismoTool client:load />
</CalcLayout>

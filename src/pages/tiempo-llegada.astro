---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import TiempoLlegadaTool from '@/components/tools/TiempoLlegadaTool';
---

<CalcLayout slug="tiempo-llegada"
  answer={"La hora de llegada es la hora de salida más la distancia dividida entre la velocidad media, más las paradas: saliendo a las 8:30 para recorrer 400 km a una media de 100 km/h con 30 minutos de paradas, llegarás a las 13:00."}
  howTo={[
    "Introduce la hora de salida.",
    "Escribe la distancia y la velocidad media prevista.",
    "Añade los minutos de paradas y pulsa calcular para ver la hora de llegada."
  ]}
  whatIs={"La calculadora de hora de llegada calcula a qué hora llegarás a tu destino a partir de la hora de salida, la distancia, la velocidad media y el tiempo de las paradas."}
  whyUse={"Te ayuda a planificar viajes en coche, avisar de tu hora de llegada, decidir a qué hora salir para evitar atascos y organizar las paradas."}
  faqs={[
    {
      q: "¿Qué velocidad media debo usar?",
      a: "Menor que el límite de la vía: en autovía, con tráfico y travesías, una media realista es de 90-105 km/h; en carreteras convencionales, de 60-75 km/h. Los navegadores calculan la media con datos de tráfico en tiempo real.",
    },
    {
      q: "¿Cuáles son los límites de velocidad en España?",
      a: "En autopistas y autovías, 120 km/h para turismos; en carreteras convencionales, 90 km/h; en ciudad, 50, 30 o 20 km/h según el tipo de vía.",
    },
    {
      q: "¿Cuándo hay más tráfico en las carreteras?",
      a: "En las operaciones salida y retorno de verano, Semana Santa, puentes y Navidad, la DGT publica previsiones y recomendaciones. Salir muy temprano o a mediodía del primer día suele evitar los peores atascos.",
    },
    {
      q: "¿Cuántas paradas debo prever?",
      a: "La DGT recomienda parar al menos 20 minutos cada 2 horas o 200 km. En un viaje de 400 km, una o dos paradas.",
    },
    {
      q: "¿Y si cambio de huso horario?",
      a: "Si viajas a Canarias o a Portugal (en avión o en barco), recuerda que allí es una hora menos que en la península. Para vuelos con cambio de zona horaria, usa la calculadora de hora de llegada con diferencia horaria.",
    },
  ]}
>
  <TiempoLlegadaTool client:load />
</CalcLayout>

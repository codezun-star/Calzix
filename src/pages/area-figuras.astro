---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AreaFigurasTool from '@/components/tools/AreaFigurasTool';
---

<CalcLayout slug="area-figuras"
  answer={"Las áreas más usadas son: cuadrado, lado²; rectángulo, base × altura; triángulo, base × altura ÷ 2; círculo, π × radio²; y trapecio, (base mayor + base menor) × altura ÷ 2. Una habitación de 4 × 3,5 m mide 14 m² y un círculo de 3 m de radio, 28,27 m²."}
  howTo={[
    "Elige la figura geométrica: cuadrado, rectángulo, círculo, triángulo o trapecio.",
    "Introduce sus medidas (lado, base, altura o radio) en la misma unidad.",
    "Pulsa calcular para obtener el área y, si lo eliges, el perímetro."
  ]}
  whatIs={"La calculadora de áreas calcula la superficie de las figuras planas más comunes (cuadrado, rectángulo, círculo, triángulo y trapecio) y su perímetro o circunferencia."}
  whyUse={"Sirve para los ejercicios de geometría de Primaria y la ESO, para medir los metros cuadrados de una habitación antes de comprar suelo o pintura, y para calcular la superficie de una parcela o un jardín."}
  faqs={[
    {
      q: "¿Cómo se calculan los metros cuadrados de una habitación?",
      a: "Multiplica el largo por el ancho: una habitación de 4 × 3,5 m tiene 14 m². Si tiene forma de L, divídela en dos rectángulos, calcula cada uno y súmalos. Para suelos, añade un 10 % de margen por cortes.",
    },
    {
      q: "¿Cómo se calcula el área de un círculo?",
      a: "Con A = π × r², donde r es el radio (la mitad del diámetro). Una mesa redonda de 1,2 m de diámetro tiene un radio de 0,6 m y un área de 3,1416 × 0,36 = 1,13 m².",
    },
    {
      q: "¿Cómo se calcula el área de un triángulo?",
      a: "Base por altura entre dos. La altura es la distancia perpendicular desde la base al vértice opuesto, no la longitud de un lado inclinado. Si solo conoces los tres lados, usa la fórmula de Herón.",
    },
    {
      q: "¿Qué diferencia hay entre área y perímetro?",
      a: "El área es la superficie que ocupa la figura (en m², cm²…) y el perímetro, la longitud de su contorno (en m, cm…). Para comprar suelo o pintura necesitas el área; para un rodapié o una valla, el perímetro. Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Qué superficie aparece en el Catastro?",
      a: "El Catastro y las escrituras suelen indicar la superficie construida, que incluye muros y, a veces, zonas comunes. La superficie útil, la que se puede pisar, suele ser entre un 15 % y un 25 % menor. Mide tú mismo cada estancia para conocer la útil.",
    },
  ]}
>
  <AreaFigurasTool client:load />
</CalcLayout>

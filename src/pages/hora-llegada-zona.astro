---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HoraLlegadaZonaTool from '@/components/tools/HoraLlegadaZonaTool';
---

<CalcLayout slug="hora-llegada-zona"
  answer={"Para calcular la hora local de llegada suma a la hora de salida la duración del vuelo y la diferencia horaria con el destino: un vuelo que sale de Madrid a las 14:00, dura 9,5 horas y llega a Nueva York (−6 horas) aterriza a las 17:30 hora local."}
  howTo={[
    "Introduce la hora de salida en la hora del lugar de origen.",
    "Escribe la duración del vuelo en horas.",
    "Indica la diferencia horaria con el destino (negativa si allí es más temprano) y pulsa calcular."
  ]}
  whatIs={"La calculadora de hora de llegada con cambio de zona horaria calcula la hora local a la que llegarás a tu destino teniendo en cuenta la duración del viaje y la diferencia horaria."}
  whyUse={"Te ayuda a organizar vuelos internacionales y a Canarias, las conexiones, el traslado desde el aeropuerto y la llegada al hotel."}
  faqs={[
    {
      q: "¿Qué diferencia horaria hay entre la península y Canarias?",
      a: "En Canarias es siempre una hora menos que en la península y Baleares. Un vuelo Madrid-Tenerife que sale a las 10:00 y dura 2 horas y 40 minutos llega a las 11:40 hora canaria.",
    },
    {
      q: "¿Qué diferencia horaria hay con los destinos más habituales?",
      a: "Con Reino Unido, Irlanda y Portugal, una hora menos. Con Nueva York, 6 horas menos (5 en algunas semanas de marzo y octubre-noviembre). Con Ciudad de México, 7 u 8 horas menos según la época. Con Tokio, 7 u 8 horas más.",
    },
    {
      q: "¿Cómo afecta el cambio de hora?",
      a: "España cambia la hora el último domingo de marzo y el último domingo de octubre (en 2026, el 25 de octubre). Otros países cambian en fechas distintas o no cambian, por lo que la diferencia horaria puede variar durante unas semanas. Usa la calculadora de diferencia horaria para fechas concretas.",
    },
    {
      q: "¿Las horas de los billetes son locales?",
      a: "Sí: la hora de salida está en la hora local del aeropuerto de origen y la de llegada, en la del aeropuerto de destino. Por eso un vuelo hacia el oeste parece durar menos y uno hacia el este, más.",
    },
    {
      q: "¿Cómo reducir el jet lag?",
      a: "Adapta tus horarios de sueño unos días antes, exponte a la luz natural en el destino, hidrátate y evita el alcohol en el vuelo. La calculadora de jet lag te ayuda a planificar la adaptación.",
    },
  ]}
>
  <HoraLlegadaZonaTool client:load />
</CalcLayout>

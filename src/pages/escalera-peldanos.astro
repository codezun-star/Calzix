---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import EscaleraPeldanosTool from '@/components/tools/EscaleraPeldanosTool';
---

<CalcLayout slug="escalera-peldanos"
  answer={"Para diseñar una escalera divide la altura total entre una contrahuella de unos 18 cm y aplica la regla de Blondel (2 × contrahuella + huella ≈ 63-64 cm): para salvar 280 cm, unos 16 peldaños de 17,5 cm de alto y 29 cm de huella."}
  howTo={[
    "Introduce la altura total que debe salvar la escalera en centímetros.",
    "Pulsa calcular escalera.",
    "Consulta el número de peldaños, la contrahuella, la huella y el largo total en planta."
  ]}
  whatIs={"La calculadora de escaleras calcula el número de peldaños y las dimensiones de la contrahuella y la huella para salvar una altura, según la regla de Blondel de comodidad."}
  whyUse={"Te ayuda a proyectar una escalera cómoda para una vivienda, un altillo o un jardín, comprobar las medidas de un presupuesto y respetar las limitaciones del Código Técnico de la Edificación."}
  faqs={[
    {
      q: "¿Qué medidas exige el Código Técnico de la Edificación?",
      a: "El CTE (documento básico de seguridad de utilización y accesibilidad) exige en escaleras de uso general una huella de al menos 28 cm y una contrahuella entre 13 y 17,5 cm, cumpliendo 54 cm ≤ 2C + H ≤ 70 cm. En las escaleras de uso restringido, como las interiores de una vivienda unifamiliar, se permiten contrahuellas de hasta 20 cm y huellas desde 22 cm.",
    },
    {
      q: "¿Qué es la regla de Blondel?",
      a: "Es una regla de comodidad que relaciona la contrahuella (C) y la huella (H) con la longitud media del paso humano: 2C + H ≈ 63-64 cm. Con una contrahuella de 17,5 cm, la huella ideal es de unos 29 cm.",
    },
    {
      q: "¿Todas las contrahuellas deben ser iguales?",
      a: "Sí. Una diferencia de altura entre peldaños provoca tropiezos. El CTE exige que en un mismo tramo todos los peldaños tengan la misma contrahuella y la misma huella.",
    },
    {
      q: "¿Cuántos peldaños puede tener un tramo?",
      a: "En escaleras de uso general, cada tramo debe salvar como máximo 3,20 m de altura y tener al menos 3 peldaños; entre tramos se coloca una meseta. Las escaleras deben tener pasamanos cuando salvan más de 55 cm.",
    },
    {
      q: "¿Cuánto espacio ocupa una escalera?",
      a: "El largo en planta es el número de huellas por el fondo de cada una: 15 huellas de 29 cm ocupan unos 4,35 m. Si no hay espacio, se puede hacer en L, en U o de caracol, aunque estas últimas son menos cómodas.",
    },
  ]}
>
  <EscaleraPeldanosTool client:load />
</CalcLayout>

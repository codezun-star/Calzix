---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AceleracionTool from '@/components/tools/AceleracionTool';
---

<CalcLayout slug="aceleracion"
  answer={"La aceleración es la variación de velocidad dividida entre el tiempo: a = (v − v₀) / t. Un coche que pasa de 0 a 100 km/h (27,8 m/s) en 10 segundos tiene una aceleración media de 2,78 m/s²."}
  howTo={[
    "Introduce la velocidad inicial y la final en m/s.",
    "Introduce el tiempo en segundos.",
    "Pulsa calcular aceleración para obtener el resultado en m/s²."
  ]}
  whatIs={"La calculadora de aceleración calcula la aceleración media de un cuerpo a partir de su velocidad inicial, su velocidad final y el tiempo transcurrido, según el movimiento rectilíneo uniformemente acelerado."}
  whyUse={"Sirve para los problemas de cinemática de Física y Química de 4.º de ESO y 1.º de Bachillerato y para interpretar datos reales como el 0-100 km/h de un coche."}
  faqs={[
    {
      q: "¿Cómo se calcula la aceleración?",
      a: "a = (v − v₀) / t. Si la velocidad disminuye, la aceleración es negativa (deceleración o frenada). Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Cómo paso de km/h a m/s?",
      a: "Divide entre 3,6: 100 km/h = 27,8 m/s; 120 km/h = 33,3 m/s. En los problemas conviene trabajar siempre en unidades del Sistema Internacional.",
    },
    {
      q: "¿Qué aceleración tiene un coche?",
      a: "Un utilitario acelera de 0 a 100 km/h en unos 10-12 segundos (2,3-2,8 m/s²); un deportivo o un eléctrico potente, en 3-5 segundos (más de 5,5 m/s²). En una frenada de emergencia, un coche puede decelerar a 8-10 m/s².",
    },
    {
      q: "¿Qué es la aceleración de la gravedad?",
      a: "Es la aceleración con la que caen los cuerpos cerca de la superficie terrestre sin rozamiento: g ≈ 9,81 m/s². Usa la calculadora de caída libre para problemas de este tipo.",
    },
    {
      q: "¿Qué relación tiene con la fuerza?",
      a: "Según la segunda ley de Newton, F = m · a: para acelerar un coche de 1.200 kg a 2,78 m/s² hace falta una fuerza neta de unos 3.340 N.",
    },
  ]}
>
  <AceleracionTool client:load />
</CalcLayout>

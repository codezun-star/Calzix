---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PermutacionesTool from '@/components/tools/PermutacionesTool';
---

<CalcLayout slug="permutaciones-combinaciones"
  answer={"Las variaciones (permutaciones de r elementos) cuentan grupos donde importa el orden: V(n, r) = n! / (n − r)!; las combinaciones, grupos donde no importa: C(n, r) = n! / (r! · (n − r)!). Con 10 personas, hay V(10, 3) = 720 formas de elegir presidente, secretario y tesorero, pero solo C(10, 3) = 120 comisiones de 3 personas."}
  howTo={[
    "Introduce el total de elementos (n).",
    "Introduce cuántos eliges (r).",
    "Pulsa calcular para obtener las variaciones (con orden) y las combinaciones (sin orden)."
  ]}
  whatIs={"La calculadora de permutaciones y combinaciones calcula cuántos grupos de r elementos se pueden formar a partir de n, teniendo en cuenta el orden (variaciones) o sin tenerlo (combinaciones)."}
  whyUse={"Sirve para los problemas de combinatoria de 4.º de ESO y Matemáticas de Bachillerato, para calcular probabilidades en loterías y juegos y para contar contraseñas o códigos posibles."}
  faqs={[
    {
      q: "¿Cómo sé si importa el orden?",
      a: "Pregúntate si cambiar el orden da un resultado distinto. En un podio (oro, plata, bronce) importa: son variaciones. En una mano de cartas o un boleto de lotería no importa: son combinaciones. Se estudia en Matemáticas de Bachillerato y entra en el examen de Matemáticas de la PAU.",
    },
    {
      q: "¿Cuántas combinaciones tiene La Primitiva?",
      a: "C(49, 6) = 13.983.816. Por eso la probabilidad de acertar los 6 números con una apuesta es de 1 entre casi 14 millones. En la Bonoloto, que también es 6 de 49, es la misma.",
    },
    {
      q: "¿Cuántos PIN de 4 cifras hay?",
      a: "10⁴ = 10.000, porque las cifras se pueden repetir y el orden importa (variaciones con repetición). Por eso los bancos bloquean la tarjeta tras tres intentos fallidos.",
    },
    {
      q: "¿Qué son las permutaciones?",
      a: "Son las ordenaciones de todos los elementos: Pₙ = n!. Las letras de la palabra AMOR se pueden ordenar de 4! = 24 formas. Si hay elementos repetidos, se divide entre el factorial de cada repetición.",
    },
    {
      q: "¿Qué son las combinaciones con repetición?",
      a: "Son grupos sin orden en los que un elemento puede elegirse varias veces, como elegir 3 bolas de helado entre 5 sabores pudiendo repetir: CR(5, 3) = C(7, 3) = 35.",
    },
  ]}
>
  <PermutacionesTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ReglaTresTool from '@/components/tools/ReglaTresTool';
---

<CalcLayout slug="regla-tres"
  answer={"En una regla de tres directa, X = C × B ÷ A: si 5 kg de naranjas cuestan 10 €, 8 kg cuestan 8 × 10 ÷ 5 = 16 €. En una inversa, X = A × B ÷ C: si 4 personas tardan 6 días en un trabajo, 3 personas tardarán 4 × 6 ÷ 3 = 8 días."}
  howTo={[
    "Elige si la proporción es directa o inversa.",
    "Introduce los dos valores conocidos (A y B) y el nuevo valor (C).",
    "Pulsa calcular X para obtener el resultado."
  ]}
  whatIs={"La calculadora de regla de tres resuelve proporciones directas e inversas: dados tres valores, calcula el cuarto."}
  whyUse={"Es útil a diario: adaptar recetas, calcular precios por kilo, convertir divisas, repartir gastos, calcular el IVA o los días de vacaciones proporcionales, y resolver los problemas de proporcionalidad de Primaria y ESO."}
  faqs={[
    {
      q: "¿Cuándo es directa y cuándo inversa?",
      a: "Es directa cuando al aumentar una magnitud aumenta la otra en la misma proporción (más kilos, más precio). Es inversa cuando al aumentar una disminuye la otra (más trabajadores, menos días; más velocidad, menos tiempo). Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se adapta una receta con regla de tres?",
      a: "Si una receta para 4 personas lleva 300 g de arroz, para 6 personas necesitas 300 × 6 ÷ 4 = 450 g. Aplica la misma proporción a todos los ingredientes, salvo la sal y las especias, que conviene ajustar al gusto.",
    },
    {
      q: "¿Cómo calculo un porcentaje con regla de tres?",
      a: "Si 100 es a 21 (el IVA), 250 € es a X: X = 250 × 21 ÷ 100 = 52,50 €. Para porcentajes es más rápido usar la calculadora de porcentajes, pero el razonamiento es el mismo.",
    },
    {
      q: "¿Qué es una regla de tres compuesta?",
      a: "La que relaciona más de dos magnitudes. Por ejemplo: si 4 personas pintan 3 pisos en 12 días, ¿cuántos días tardarán 6 personas en pintar 5 pisos? Se resuelve aplicando cada proporción (directa o inversa) por separado: 12 × (4/6) × (5/3) = 13,3 días.",
    },
    {
      q: "¿Sirve para calcular las vacaciones proporcionales?",
      a: "Sí. Si te corresponden 30 días naturales al año y has trabajado 4 meses, te corresponden 30 × 4 ÷ 12 = 10 días. Para un cálculo exacto por días trabajados, usa la calculadora de vacaciones proporcionales.",
    },
  ]}
>
  <ReglaTresTool client:load />
</CalcLayout>

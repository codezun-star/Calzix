---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PotenciaContratadaTool from '@/components/tools/PotenciaContratadaTool';
---

<CalcLayout slug="potencia-contratada"
  answer={"Para elegir la potencia de la luz suma la potencia de los aparatos que funcionan a la vez y aplica un factor de simultaneidad: 6.000 W instalados con un 60 % de simultaneidad son 3,6 kW, así que la potencia normalizada adecuada es 4,6 kW. Cada kW contratado cuesta unos 30-40 € al año."}
  howTo={[
    "Introduce la potencia total de los aparatos de tu vivienda en vatios.",
    "Ajusta el factor de simultaneidad (el porcentaje que suele funcionar a la vez).",
    "Pulsa calcular para ver la potencia recomendada entre las potencias normalizadas."
  ]}
  whatIs={"La calculadora de potencia contratada estima la potencia eléctrica que necesitas contratar a partir de la potencia de tus aparatos y de cuántos funcionan a la vez, y la redondea a las potencias normalizadas en España."}
  whyUse={"Te ayuda a no pagar de más por una potencia que no usas y a evitar que salte el interruptor de control de potencia, sobre todo al instalar aire acondicionado, placa de inducción, aerotermia o un cargador de coche eléctrico."}
  faqs={[
    {
      q: "¿Qué potencias se pueden contratar?",
      a: "En las viviendas con contador digital puedes contratar cualquier potencia, pero lo habitual son los valores normalizados de 2,3, 3,45, 4,6, 5,75, 6,9, 8,05 y 9,2 kW en monofásica. La mayoría de pisos tienen entre 3,45 y 5,75 kW.",
    },
    {
      q: "¿Cuánto cuesta cada kW de potencia?",
      a: "En la tarifa regulada (PVPC), el término de potencia cuesta alrededor de 30-40 € al año por kW con impuestos. Bajar de 5,75 a 4,6 kW puede ahorrar unos 40 € al año. Desde 2021 puedes contratar dos potencias distintas: una para las horas punta y llano y otra para el valle.",
    },
    {
      q: "¿Qué pasa si me quedo corto?",
      a: "Si encienden a la vez aparatos que superan la potencia contratada, salta el interruptor de control de potencia (ICP) o el contador corta el suministro unos segundos. Tendrás que apagar algún aparato. Si te ocurre a menudo, necesitas más potencia.",
    },
    {
      q: "¿Cuesta dinero cambiar la potencia?",
      a: "Subir la potencia tiene unos costes regulados (derechos de acceso y de extensión según los kW que aumentes y, a veces, derechos de enganche). Bajarla suele ser gratuito o muy barato. Puede que necesites un certificado de instalación eléctrica si la instalación no admite la nueva potencia.",
    },
    {
      q: "¿Qué potencia necesito con aerotermia o coche eléctrico?",
      a: "Una bomba de calor puede añadir 2-3 kW en los momentos de máximo consumo, y un cargador de coche eléctrico doméstico, entre 3,7 y 7,4 kW. Con una tarifa de dos potencias puedes contratar más en el periodo valle, cuando se suele cargar el coche, sin encarecer tanto la factura.",
    },
  ]}
>
  <PotenciaContratadaTool client:load />
</CalcLayout>

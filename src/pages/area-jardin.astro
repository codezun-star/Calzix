---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AreaJardinTool from '@/components/tools/AreaJardinTool';
---

<CalcLayout slug="area-jardin"
  answer={"La superficie de un jardín rectangular es el largo por el ancho (10 × 6 m = 60 m²); la de uno circular, π por el radio al cuadrado (radio de 4 m = 50,3 m²); y la de uno triangular, base por altura entre dos. Con la superficie calculas el césped, la tierra, la grava y el agua de riego que necesitas."}
  howTo={[
    "Elige la forma del jardín o de la zona: rectángulo, círculo o triángulo.",
    "Introduce sus medidas en metros.",
    "Pulsa calcular para ver la superficie y estimar el material y el riego."
  ]}
  whatIs={"La calculadora de área del jardín obtiene la superficie de una zona de jardín, huerto o terreno con forma rectangular, circular o triangular, y te ayuda a estimar el material necesario (césped en rollo, semillas, tierra vegetal, grava, acolchado) y el riego."}
  whyUse={"Sirve para presupuestar la instalación de césped natural o artificial, comprar la tierra o la grava justa, dimensionar el riego y planificar un huerto en el jardín o en una parcela."}
  faqs={[
    {
      q: "¿Cómo calculo la superficie de un jardín irregular?",
      a: "Divide el jardín en figuras sencillas (rectángulos, triángulos y círculos o semicírculos), calcula el área de cada una y súmalas. Para una forma muy irregular, puedes medirla sobre un plano o con herramientas de medición del visor del Catastro o de mapas en línea, que permiten trazar un polígono y obtener su área.",
    },
    {
      q: "¿Cuánta tierra vegetal necesito?",
      a: "Multiplica la superficie por el espesor: para sembrar césped se recomiendan unos 10-15 cm de tierra vegetal; para un huerto, 20-30 cm. En 60 m² con 10 cm necesitas 6 m³ de tierra. La tierra se vende a granel por metro cúbico o en sacos de 50 litros (20 sacos por m³).",
    },
    {
      q: "¿Cuánto cuesta poner césped en un jardín?",
      a: "El césped natural en rollo cuesta en España unos 4-8 €/m² más la instalación; sembrado, mucho menos (las semillas cuestan menos de 1 €/m²), pero tarda más en estar listo. El césped artificial cuesta entre 15 y 40 €/m² instalado y no necesita riego, aunque se calienta mucho al sol en verano.",
    },
    {
      q: "¿Cuánta grava o corteza necesito para cubrir el suelo?",
      a: "Multiplica la superficie por un espesor de 5-8 cm. Para 20 m² con 5 cm necesitas 1 m³ de grava (unos 1.500-1.700 kg) o de corteza de pino. El acolchado reduce la evaporación y las malas hierbas, muy útil en la xerojardinería.",
    },
    {
      q: "¿Cuántas plantas caben en mi jardín?",
      a: "Depende del tamaño adulto de cada especie: los arbustos medianos se plantan a 60-100 cm entre sí, las vivaces y aromáticas a 30-50 cm, los setos a 30-50 cm en línea y los árboles a 4-8 m. En un huerto, las tomateras se plantan a unos 50 cm y las lechugas a 25-30 cm.",
    },
    {
      q: "¿Necesito licencia para hacer obras en el jardín?",
      a: "Las labores de jardinería no necesitan licencia. Sí pueden necesitarla, según el ayuntamiento, construir una piscina, un muro, una caseta o una pérgola, pavimentar grandes superficies o talar árboles (en muchos municipios los árboles de cierto tamaño están protegidos incluso en terrenos privados). Consulta la ordenanza municipal.",
    },
  ]}
>
  <AreaJardinTool client:load />
</CalcLayout>

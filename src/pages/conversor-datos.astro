---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvDatosTool from '@/components/tools/ConvDatosTool';
---

<CalcLayout slug="conversor-datos"
  answer={"En el sistema decimal, 1 KB = 1.000 bytes, 1 MB = 1.000 KB y 1 GB = 1.000 MB; en el binario, 1 KiB = 1.024 bytes y 1 GiB = 1.073.741.824 bytes. Por eso un disco de 1 TB aparece en el ordenador como unos 931 GB. Y una fibra de 600 Mbps descarga, como mucho, unos 75 MB por segundo."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 1 TB o 4,7 GB).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de datos convierte entre bytes, kilobytes, megabytes, gigabytes y terabytes (sistema decimal) y kibibytes, mebibytes y gibibytes (sistema binario)."}
  whyUse={"Te ayuda a entender por qué tu disco duro o tu móvil tienen menos espacio del anunciado, cuántos GB de tu tarifa móvil gasta un vídeo y qué velocidad real ofrece tu fibra."}
  faqs={[
    {
      q: "¿Por qué mi disco de 1 TB marca 931 GB?",
      a: "Los fabricantes usan el sistema decimal (1 TB = 10¹² bytes) y algunos sistemas operativos, como Windows, muestran la capacidad en el sistema binario (GiB), aunque los llamen GB: 10¹² / 1.073.741.824 = 931 GiB. No falta espacio, solo cambia la unidad.",
    },
    {
      q: "¿Qué diferencia hay entre Mbps y MB/s?",
      a: "Las conexiones se anuncian en megabits por segundo (Mbps) y las descargas se muestran en megabytes por segundo (MB/s). Un byte tiene 8 bits, así que una fibra de 600 Mbps descarga como máximo unos 75 MB/s, y una de 1 Gbps, unos 125 MB/s.",
    },
    {
      q: "¿Cuántos datos móviles gasta ver vídeos?",
      a: "Como referencia, el vídeo en calidad estándar consume entre 0,5 y 1 GB por hora, en HD entre 1,5 y 3 GB por hora y en 4K, 7 GB por hora o más. La música en streaming gasta entre 50 y 150 MB por hora.",
    },
    {
      q: "¿Qué es un kibibyte?",
      a: "Es una unidad binaria definida por la Comisión Electrotécnica Internacional (IEC): 1 KiB = 1.024 bytes. Se creó para distinguirla del kilobyte decimal (1.000 bytes), aunque en la práctica muchos programas siguen usando KB para referirse a 1.024 bytes.",
    },
    {
      q: "¿Cuánto ocupa una foto o una canción?",
      a: "Una foto de móvil ocupa normalmente entre 2 y 5 MB, una canción en MP3 de 3 o 4 minutos unos 4-8 MB, y un minuto de vídeo en 4K, entre 300 y 400 MB.",
    },
  ]}
>
  <ConvDatosTool client:load />
</CalcLayout>

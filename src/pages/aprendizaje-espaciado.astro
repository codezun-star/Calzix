---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AprendizajeEspaciadoTool from '@/components/tools/AprendizajeEspaciadoTool';
---

<CalcLayout slug="aprendizaje-espaciado"
  answer={"La repetición espaciada consiste en repasar lo estudiado a intervalos crecientes: al día siguiente, a los 3 días, a la semana, a las 2 semanas, al mes, a los 2 meses y a los 4 meses. Si estudias un tema el 1 de octubre, repásalo el 2, el 4, el 8, el 15 y el 31 de octubre, el 30 de noviembre y el 29 de enero para fijarlo en la memoria a largo plazo."}
  howTo={[
    "Introduce la fecha en que estudiaste el tema por primera vez.",
    "Pulsa generar calendario de repaso.",
    "Apunta las fechas de repaso en tu agenda o calendario."
  ]}
  whatIs={"La calculadora de aprendizaje espaciado genera un calendario de repasos a intervalos crecientes a partir de la fecha en que estudiaste un tema, según el principio de la curva del olvido."}
  whyUse={"Te ayuda a recordar más estudiando menos horas, a preparar exámenes finales, la PAU, unas oposiciones o un idioma, y a evitar los atracones de estudio de última hora."}
  faqs={[
    {
      q: "¿Qué es la curva del olvido?",
      a: "Es la observación del psicólogo Hermann Ebbinghaus, a finales del siglo XIX, de que olvidamos rápidamente lo aprendido si no lo repasamos: buena parte de la información se pierde en los primeros días. Cada repaso hace que el olvido sea más lento, por eso los intervalos pueden ir alargándose.",
    },
    {
      q: "¿Funciona de verdad?",
      a: "Sí. La práctica espaciada y la práctica de recuperación (intentar recordar sin mirar) son dos de las técnicas de estudio con más evidencia científica. Funcionan mejor que releer o subrayar.",
    },
    {
      q: "¿Cómo repasar en cada fecha?",
      a: "Intenta recordar el contenido antes de mirar los apuntes: escribe un esquema de memoria, responde preguntas, explica el tema en voz alta o usa tarjetas (flashcards). Después, comprueba lo que has olvidado y céntrate en eso.",
    },
    {
      q: "¿Qué aplicaciones usan repetición espaciada?",
      a: "Aplicaciones de tarjetas como Anki, muy usada por estudiantes de Medicina y opositores, y muchas apps de idiomas programan automáticamente los repasos según tus aciertos y errores.",
    },
    {
      q: "¿Sirve para oposiciones con muchos temas?",
      a: "Sí, es especialmente útil. Programa los repasos de cada tema desde que lo terminas y combínalos con vueltas completas al temario. Así llegarás al examen habiendo repasado cada tema varias veces.",
    },
  ]}
>
  <AprendizajeEspaciadoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CosteEmpresaTrabajadorTool from '@/components/tools/CosteEmpresaTrabajadorTool';
---

<CalcLayout slug="coste-empresa-trabajador"
  answer={"Un trabajador cuesta a la empresa su salario bruto más alrededor de un 32 % de cotizaciones sociales en 2026: contingencias comunes 23,60 %, desempleo 5,50 % (6,70 % si es temporal), FOGASA 0,20 %, formación 0,60 %, MEI 0,75 % y accidentes de trabajo según la actividad. Un sueldo de 24.000 € brutos cuesta unos 31.700 € al año."}
  howTo={[
    "Introduce el salario bruto anual del trabajador.",
    "Elige el tipo de contrato (indefinido o temporal).",
    "Indica el tipo de accidentes de trabajo y enfermedades profesionales de la actividad y pulsa calcular."
  ]}
  whatIs={"La calculadora de coste de un trabajador para la empresa suma al salario bruto las cotizaciones a la Seguridad Social a cargo del empleador con los tipos de 2026, desglosadas por concepto, y calcula el coste total anual y mensual."}
  whyUse={"Es imprescindible para autónomos y pymes que van a contratar, para presupuestar una plantilla, fijar precios que cubran los costes de personal o comparar con la subcontratación."}
  faqs={[
    {
      q: "¿Cuánto cotiza la empresa por un trabajador en 2026?",
      a: "Por contingencias comunes, el 23,60 %; por desempleo, el 5,50 % en contratos indefinidos y el 6,70 % en temporales; por FOGASA, el 0,20 %; por formación profesional, el 0,60 %; y por el Mecanismo de Equidad Intergeneracional (MEI), el 0,75 %. Además paga la tarifa de accidentes de trabajo y enfermedades profesionales, que depende de la actividad (alrededor del 1,5 % en oficinas).",
    },
    {
      q: "¿Hay un límite de cotización?",
      a: "Sí. Las cotizaciones se calculan sobre la base de cotización, que en 2026 tiene un máximo de 5.101,20 € al mes. Por la parte del salario que supera la base máxima se aplica la cotización de solidaridad, introducida en 2025, con tipos crecientes en los próximos años.",
    },
    {
      q: "¿Qué otros costes tiene un trabajador?",
      a: "Además del salario y las cotizaciones: formación, equipos, prevención de riesgos laborales, seguros del convenio, dietas y desplazamientos, la parte de la indemnización que puede generar una extinción del contrato y los días de vacaciones y festivos retribuidos.",
    },
    {
      q: "¿Hay bonificaciones a la contratación?",
      a: "Sí. Existen bonificaciones y reducciones en las cotizaciones para la contratación de personas desempleadas de larga duración, con discapacidad, víctimas de violencia de género o jóvenes con garantía juvenil, entre otros colectivos, según la normativa vigente del SEPE. Consúltalas antes de contratar.",
    },
    {
      q: "¿Por qué hay tanta diferencia entre el coste y el neto?",
      a: "Porque al coste de la empresa se restan sus cotizaciones (unos 7.700 € en un sueldo de 24.000 €), y al bruto se restan las cotizaciones del trabajador (6,50 %) y la retención del IRPF. Un sueldo de 24.000 € brutos que cuesta 31.700 € a la empresa deja al trabajador unos 19.200 € netos.",
    },
  ]}
>
  <CosteEmpresaTrabajadorTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CableElectricoTool from '@/components/tools/CableElectricoTool';
---

<CalcLayout slug="cable-electrico"
  answer={"Para elegir la sección del cable calcula la intensidad (potencia ÷ tensión) y elige una sección que la soporte con margen: un aparato de 3.000 W a 230 V consume 13 A y necesita cable de cobre de 2,5 mm², con una caída de tensión de unos 3,6 V (1,6 %) en 20 m. El REBT fija mínimos de 1,5 mm² para alumbrado y 2,5 mm² para enchufes."}
  howTo={[
    "Introduce la potencia total del aparato o del circuito en vatios.",
    "Indica la tensión: 230 V en monofásica, la habitual en viviendas españolas.",
    "Escribe la longitud del cable y pulsa calcular para ver la intensidad, la sección recomendada y la caída de tensión."
  ]}
  whatIs={"La calculadora de sección de cable eléctrico calcula la intensidad que circulará por un circuito, la sección mínima de cable de cobre recomendada con un margen de seguridad y la caída de tensión según la longitud del tendido."}
  whyUse={"Te orienta al planificar un circuito, una toma para la placa de inducción, un punto de recarga de coche eléctrico o una instalación en un garaje o un taller. Las instalaciones nuevas o reformadas deben hacerlas un instalador autorizado."}
  faqs={[
    {
      q: "¿Qué sección de cable se usa en cada circuito de una vivienda?",
      a: "Según la ITC-BT-25 del Reglamento Electrotécnico para Baja Tensión (REBT), en una vivienda con electrificación básica: alumbrado (C1), 1,5 mm² con magnetotérmico de 10 A; tomas de uso general (C2), 2,5 mm² con 16 A; cocina y horno (C3), 6 mm² con 25 A; lavadora, lavavajillas y termo (C4), 4 mm² con 20 A; y tomas de baño y cocina (C5), 2,5 mm² con 16 A.",
    },
    {
      q: "¿Cuál es la caída de tensión máxima permitida?",
      a: "En las instalaciones interiores de viviendas, la caída de tensión máxima es del 3 % desde el origen de la instalación (unos 6,9 V a 230 V). Si el tendido es largo, por ejemplo hasta un garaje o un trastero, puede ser necesario aumentar la sección aunque la intensidad sea baja.",
    },
    {
      q: "¿Qué tensión hay en las viviendas españolas?",
      a: "La tensión normalizada es de 230 V en monofásica y 400 V entre fases en trifásica, a 50 Hz. La mayoría de viviendas tienen suministro monofásico; el trifásico es habitual en locales, naves y algunas casas con mucha potencia contratada.",
    },
    {
      q: "¿Qué potencia puedo conectar en un enchufe normal?",
      a: "Una toma de 16 A a 230 V admite en teoría hasta 3.680 W, pero no conviene conectar de forma continuada más de unos 3.000 W. Aparatos como el horno, la placa de inducción, el termo o un cargador de coche eléctrico deben ir en su propio circuito con la sección adecuada.",
    },
    {
      q: "¿Puedo hacer yo mismo la instalación eléctrica?",
      a: "Las pequeñas reparaciones (cambiar un enchufe o un interruptor) sí, siempre con el diferencial desconectado. Pero las instalaciones nuevas, las ampliaciones y las reformas deben hacerlas una empresa instaladora habilitada, que emite el certificado de instalación eléctrica (boletín), necesario para dar de alta o aumentar la potencia en la compañía.",
    },
    {
      q: "¿Por qué la calculadora usa un margen del 25 %?",
      a: "Para no trabajar con el cable al límite de su capacidad, ya que la intensidad admisible depende de la temperatura, del tipo de aislamiento y de cómo se instala (empotrado en tubo, al aire, agrupado con otros cables). El cálculo es orientativo; el instalador debe comprobarlo con las tablas de la ITC-BT-19.",
    },
  ]}
>
  <CableElectricoTool client:load />
</CalcLayout>

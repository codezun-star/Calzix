---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NumeroAleatorioTool from '@/components/tools/NumeroAleatorioTool';
---

<CalcLayout slug="numero-aleatorio"
  answer={"El generador de números aleatorios elige números al azar entre un mínimo y un máximo, con o sin repetición: por ejemplo, 5 números distintos entre 1 y 100. Se usa crypto.getRandomValues(), el generador aleatorio criptográfico del navegador, de modo que cada resultado tiene la misma probabilidad. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor."}
  howTo={[
    "Introduce el número mínimo y el máximo.",
    "Indica cuántos números quieres generar y si se pueden repetir.",
    "Pulsa generar para obtener los números aleatorios."
  ]}
  whatIs={"El generador de números aleatorios crea uno o varios números al azar dentro del rango que elijas, con un generador aleatorio criptográfico, sin repeticiones si lo necesitas."}
  whyUse={"Sirve para sorteos, rifas, elegir un ganador entre participantes numerados, juegos, dinámicas de clase o seleccionar muestras al azar."}
  faqs={[
    {
      q: "¿Son realmente aleatorios?",
      a: "Se usa crypto.getRandomValues(), el generador aleatorio criptográfico del navegador, de modo que cada resultado tiene la misma probabilidad. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor.",
    },
    {
      q: "¿Puedo usarlo para un sorteo?",
      a: "Sí, para sorteos entre amigos o en clase. Para sorteos promocionales de empresas en España, conviene publicar unas bases legales y recordar que los premios de más de 300 € llevan retención o ingreso a cuenta del IRPF.",
    },
    {
      q: "¿Qué diferencia hay entre con y sin repetición?",
      a: "Sin repetición, cada número solo puede salir una vez, como en un bombo de lotería. Con repetición, un mismo número puede aparecer varias veces, como al lanzar un dado.",
    },
    {
      q: "¿Sirve para la lotería?",
      a: "Sí, aunque para La Primitiva, la Bonoloto, Euromillones o El Gordo es más cómodo el generador de lotería, que ya tiene el formato de cada sorteo.",
    },
    {
      q: "¿Se guardan los resultados?",
      a: "No. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor. Si necesitas acreditar un sorteo, haz una captura de pantalla o grábalo.",
    },
  ]}
>
  <NumeroAleatorioTool client:load />
</CalcLayout>

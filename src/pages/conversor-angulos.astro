---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvAngulosTool from '@/components/tools/ConvAngulosTool';
---

<CalcLayout slug="conversor-angulos"
  answer={"Para convertir ángulos: 180° = π radianes = 200 gradianes = media vuelta. Para pasar de grados a radianes multiplica por π/180: 90° = π/2 ≈ 1,5708 rad, y 1 radián ≈ 57,30°."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 90 grados o 1,5 radianes).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de ángulos convierte entre grados sexagesimales, radianes, gradianes (o gon) y vueltas completas."}
  whyUse={"Sirve para los ejercicios de trigonometría de 4.º de ESO y Bachillerato, configurar la calculadora en el modo correcto (DEG, RAD o GRAD), programar y trabajar en topografía."}
  faqs={[
    {
      q: "¿Cómo paso de grados a radianes?",
      a: "Multiplica por π y divide entre 180: 45° = π/4 ≈ 0,785 rad; 60° = π/3 ≈ 1,047 rad; 360° = 2π ≈ 6,283 rad. Para pasar de radianes a grados, multiplica por 180/π.",
    },
    {
      q: "¿Qué son los gradianes?",
      a: "Son una unidad en la que el ángulo recto mide 100 gradianes (o gon) y la vuelta completa, 400. Se usan en topografía y en algunos aparatos de medición. El modo GRAD de las calculadoras corresponde a esta unidad.",
    },
    {
      q: "¿Por qué la calculadora da un resultado raro con el seno?",
      a: "Probablemente esté en un modo distinto al que necesitas: sen(30) en grados da 0,5, pero en radianes da −0,988. Comprueba que en la pantalla aparezca D o DEG si trabajas en grados.",
    },
    {
      q: "¿Cómo se expresa la pendiente de una carretera?",
      a: "En porcentaje: una pendiente del 10 % sube 10 m por cada 100 m en horizontal, lo que equivale a un ángulo de unos 5,7°. Las señales de pendiente peligrosa en España indican el porcentaje.",
    },
    {
      q: "¿Qué son los minutos y segundos de arco?",
      a: "Son subdivisiones del grado: 1° = 60′ (minutos) y 1′ = 60″ (segundos). Se usan en coordenadas geográficas: la Puerta del Sol de Madrid está aproximadamente en 40° 25′ N, 3° 42′ O.",
    },
  ]}
>
  <ConvAngulosTool client:load />
</CalcLayout>

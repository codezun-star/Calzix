---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ProductividadTool from '@/components/tools/ProductividadTool';
---

<CalcLayout slug="calculadora-productividad"
  answer={"La productividad personal se mide con indicadores simples: tasa de cumplimiento (tareas completadas ÷ planificadas), tareas por hora (completadas ÷ horas trabajadas) y tiempo medio por tarea. Si completas 18 de 24 tareas en 8 horas, tu cumplimiento es del 75 %, haces 2,25 tareas por hora y dedicas unos 27 minutos a cada una."}
  howTo={[
    "Introduce las tareas planificadas y las completadas.",
    "Indica las horas trabajadas.",
    "Pulsa calcular para ver tu tasa de cumplimiento, tareas por hora y tiempo medio por tarea."
  ]}
  whatIs={"La calculadora de productividad mide tu rendimiento con tres indicadores sencillos (tasa de cumplimiento, tareas por hora y tiempo medio por tarea) para comparar días o semanas y detectar mejoras, en la oficina o en el teletrabajo."}
  whyUse={"Sirve para planificar mejor la jornada, estimar plazos de forma realista, organizarte como autónomo y comparar tu rendimiento antes y después de aplicar técnicas como la Pomodoro o el bloqueo de tiempo."}
  faqs={[
    {
      q: "¿Cómo se mide la productividad personal?",
      a: "Con indicadores que comparen resultados con recursos: tareas completadas por hora, porcentaje de tareas planificadas que terminas o tiempo medio por tarea. Conviene agrupar tareas de tamaño parecido o ponderarlas por esfuerzo, porque no es lo mismo responder un correo que preparar un informe.",
    },
    {
      q: "¿Qué técnicas mejoran la productividad?",
      a: "La técnica Pomodoro (bloques de 25 minutos de trabajo y 5 de descanso), el bloqueo de tiempo en el calendario, la matriz de Eisenhower para priorizar lo importante sobre lo urgente, agrupar tareas similares, desactivar notificaciones y planificar el día la tarde anterior.",
    },
    {
      q: "¿Es más productivo el teletrabajo?",
      a: "Los estudios muestran resultados mixtos: menos interrupciones y ahorro de desplazamientos, pero más reuniones y riesgo de aislamiento. En España, el teletrabajo regular se regula por la Ley 10/2021 de trabajo a distancia, que exige un acuerdo por escrito, compensación de gastos y respeto a la desconexión digital.",
    },
    {
      q: "¿Cuántas horas al día se puede trabajar de forma productiva?",
      a: "La concentración profunda se mantiene unas 4-5 horas al día en tareas exigentes; el resto se dedica a tareas más ligeras. Por eso trabajar más horas no siempre significa producir más. La jornada máxima legal en España es de 40 horas semanales de trabajo efectivo en promedio anual.",
    },
    {
      q: "¿Cómo se mide la productividad de una empresa?",
      a: "Con indicadores como la facturación o el valor añadido por empleado o por hora trabajada. La productividad por hora trabajada en España está por debajo de la media de la zona euro según Eurostat, una diferencia ligada al tamaño de las empresas, la inversión en tecnología y la formación.",
    },
    {
      q: "¿Qué es el registro horario y cómo influye?",
      a: "Desde 2019, todas las empresas deben registrar diariamente el inicio y el fin de la jornada de cada trabajador y conservar los registros 4 años. Además de garantizar el pago de las horas extra, permite analizar cuánto tiempo se dedica realmente a cada actividad.",
    },
  ]}
>
  <ProductividadTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvDensidadTool from '@/components/tools/ConvDensidadTool';
---

<CalcLayout slug="conversor-densidad"
  answer={"Para convertir densidades: 1 g/cm³ = 1 kg/L = 1.000 kg/m³ = 1.000 g/L = 62,43 lb/ft³. El agua tiene una densidad de 1 g/cm³ a 4 °C, el aceite de oliva de unos 0,92 g/cm³ y la gasolina de unos 0,74 g/cm³."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 0,92 g/cm³ o 1.000 kg/m³).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de densidad convierte entre kg/m³, g/cm³, g/L, kg/L, libras por pie cúbico y libras por pulgada cúbica."}
  whyUse={"Sirve para resolver problemas de física y química, pasar de litros a kilos un líquido, comparar materiales o interpretar fichas técnicas de productos."}
  faqs={[
    {
      q: "¿Cómo paso de litros a kilos?",
      a: "Multiplica el volumen por la densidad: masa (kg) = volumen (L) × densidad (kg/L). Un litro de aceite de oliva, con una densidad de unos 0,92 kg/L, pesa 920 g. Por eso una garrafa de 5 litros de aceite pesa unos 4,6 kg más el envase.",
    },
    {
      q: "¿Cuál es la densidad del gasóleo y la gasolina?",
      a: "La gasolina tiene una densidad de unos 0,72-0,78 kg/L y el gasóleo, de 0,82-0,85 kg/L, según la temperatura. Por eso el combustible se vende por litros, pero a menudo se comercializa entre empresas por toneladas.",
    },
    {
      q: "¿Por qué el hielo flota?",
      a: "Porque el hielo (0,917 g/cm³) es menos denso que el agua líquida (1 g/cm³). El agua alcanza su densidad máxima a 4 °C, lo que permite que los lagos se congelen desde la superficie.",
    },
    {
      q: "¿Por qué se flota mejor en el mar?",
      a: "El agua de mar tiene una densidad de unos 1,025 g/cm³ por la sal disuelta, mayor que la del agua dulce, así que empuja más hacia arriba. En el mar Muerto, con muchísima más sal (1,24 g/cm³), se flota sin esfuerzo.",
    },
    {
      q: "¿Qué densidad tienen los materiales de construcción?",
      a: "Aproximadamente: hormigón, 2.300-2.400 kg/m³; acero, 7.850 kg/m³; madera de pino, 500-600 kg/m³; aluminio, 2.700 kg/m³; ladrillo macizo, 1.800 kg/m³.",
    },
  ]}
>
  <ConvDensidadTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorMahWhTool from '@/components/tools/ConversorMahWhTool';
---

<CalcLayout slug="conversor-mah-wh"
  answer={"Para pasar de mAh a Wh multiplica por el voltaje y divide entre 1.000: una batería externa de 20.000 mAh a 3,7 V almacena 74 Wh. Es el dato que miran las aerolíneas: hasta 100 Wh se puede llevar en cabina sin autorización."}
  howTo={[
    "Elige si quieres pasar de mAh a Wh o de Wh a mAh.",
    "Introduce la capacidad.",
    "Ajusta el voltaje (3,7 V en la mayoría de baterías de litio) y pulsa convertir."
  ]}
  whatIs={"El conversor de mAh a Wh convierte la capacidad de una batería entre miliamperios hora y vatios hora según su voltaje."}
  whyUse={"Te ayuda a comparar baterías externas, móviles, portátiles y patinetes, y a comprobar si puedes llevar una batería en el avión."}
  faqs={[
    {
      q: "¿Puedo llevar una batería externa en el avión?",
      a: "Sí, pero solo en el equipaje de mano, nunca en la maleta facturada. Según las normas de la IATA que aplican las aerolíneas, las baterías de hasta 100 Wh se llevan sin autorización; entre 100 y 160 Wh, con autorización de la aerolínea (máximo dos); y por encima de 160 Wh están prohibidas en aviones de pasajeros.",
    },
    {
      q: "¿Por qué Wh es mejor que mAh para comparar?",
      a: "Porque los vatios hora miden la energía real e incluyen el voltaje. Dos baterías con los mismos mAh pero distinto voltaje almacenan energías distintas.",
    },
    {
      q: "¿Cuántas cargas de móvil da una batería externa?",
      a: "Una batería de 10.000 mAh (37 Wh) da unas 2 cargas de un móvil con batería de 4.500 mAh, porque se pierde un 20-30 % de energía en la conversión de voltaje y el calor.",
    },
    {
      q: "¿Qué voltaje uso?",
      a: "La mayoría de baterías de iones de litio tienen un voltaje nominal de 3,6-3,7 V por celda. Las baterías de portátiles y patinetes agrupan celdas y tienen voltajes mayores (11,1 V, 36 V…).",
    },
    {
      q: "¿Dónde se reciclan las baterías de litio?",
      a: "En los puntos limpios y en las tiendas que venden aparatos electrónicos o pilas, que están obligadas a recogerlas. No las tires a la basura: pueden incendiarse en los camiones y plantas de residuos.",
    },
  ]}
>
  <ConversorMahWhTool client:load />
</CalcLayout>

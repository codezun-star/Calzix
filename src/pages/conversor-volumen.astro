---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvVolumenTool from '@/components/tools/ConvVolumenTool';
---

<CalcLayout slug="conversor-volumen"
  answer={"Para convertir volúmenes recuerda que 1 litro = 1.000 ml = 1 dm³ y que 1 m³ = 1.000 litros. Un galón estadounidense son 3,785 litros, una taza americana 236,6 ml y una onza líquida estadounidense 29,57 ml."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 2 galones o 750 mililitros).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de volumen convierte entre litros, mililitros, metros cúbicos, centímetros cúbicos y las unidades estadounidenses: galones, onzas líquidas, pintas y tazas."}
  whyUse={"Sirve para entender tu factura del agua (en m³), seguir recetas americanas, calcular la capacidad de un depósito, una piscina o un acuario y resolver problemas de física y química."}
  faqs={[
    {
      q: "¿Cuántos litros tiene un metro cúbico?",
      a: "1.000 litros. Las compañías de agua en España facturan el consumo en m³: si gastas 10 m³ al mes, has consumido 10.000 litros. El gas natural también se mide en m³ en el contador, aunque se factura en kWh.",
    },
    {
      q: "¿Cuántos litros tiene un galón?",
      a: "El galón estadounidense tiene 3,785 litros y el galón imperial británico, 4,546 litros. En Estados Unidos, la gasolina se vende por galones, así que un precio de 3,50 $/galón equivale a unos 0,92 $/litro.",
    },
    {
      q: "¿Qué capacidad tienen las bebidas en España?",
      a: "La botella de vino estándar es de 75 cl (750 ml); la lata de refresco o cerveza, de 33 cl; el tercio, de 33 cl; el quinto, de 20 cl; y la caña de cerveza suele servirse en vasos de entre 200 y 250 ml, aunque no hay una medida legal única.",
    },
    {
      q: "¿Qué son los centímetros cúbicos de una moto?",
      a: "Es la cilindrada del motor: la suma del volumen de sus cilindros. 1 cm³ = 1 ml. Con el carné B de coche y 3 años de antigüedad se pueden conducir en España motos de hasta 125 cm³ y 11 kW.",
    },
    {
      q: "¿Cuántos mililitros tiene una taza americana?",
      a: "La taza (cup) estadounidense tiene unos 236,6 ml, aunque en muchas recetas se redondea a 240 ml. La taza métrica usada en Australia o Canadá es de 250 ml. Para cocinar, usa el conversor de cocina, que tiene en cuenta las cucharadas y cucharaditas.",
    },
  ]}
>
  <ConvVolumenTool client:load />
</CalcLayout>

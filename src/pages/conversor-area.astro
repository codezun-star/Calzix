---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvAreaTool from '@/components/tools/ConvAreaTool';
---

<CalcLayout slug="conversor-area"
  answer={"Para convertir superficies recuerda que las unidades de área se elevan al cuadrado: 1 m² = 10.000 cm², 1 hectárea = 10.000 m² y 1 km² = 100 hectáreas. Un acre son 4.046,86 m² y un pie cuadrado, 0,0929 m², así que un piso anunciado con 1.000 ft² tiene unos 93 m²."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 1.000 pies cuadrados o 2,5 hectáreas).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de área convierte entre metros cuadrados, kilómetros cuadrados, centímetros y milímetros cuadrados, hectáreas, acres, pies cuadrados y pulgadas cuadradas."}
  whyUse={"Te ayuda a interpretar la superficie de un piso o una parcela, las hectáreas de una finca agrícola, los anuncios inmobiliarios en pies cuadrados del extranjero y los ejercicios de geometría."}
  faqs={[
    {
      q: "¿Cuántos metros cuadrados tiene una hectárea?",
      a: "Una hectárea tiene 10.000 m², el equivalente a un cuadrado de 100 × 100 m, más o menos un campo de fútbol y medio. Un área son 100 m² y un kilómetro cuadrado, 100 hectáreas.",
    },
    {
      q: "¿Qué es la fanega?",
      a: "Es una medida agraria tradicional española cuyo valor cambia según la región: la fanega de Castilla equivale a unos 6.440 m², pero en otras zonas varía bastante. En Valencia se usaba la hanegada (unos 831 m²) y en Cataluña la mojada. Hoy, el Catastro y el Registro de la Propiedad usan metros cuadrados y hectáreas.",
    },
    {
      q: "¿Qué diferencia hay entre superficie útil y construida?",
      a: "La superficie útil es la que se puede pisar dentro de la vivienda, sin contar muros ni tabiques. La construida incluye también los muros y tabiques, y la construida con zonas comunes añade la parte proporcional de portales, escaleras y otros espacios del edificio. Los anuncios suelen mostrar la construida, que puede ser un 15-25 % mayor que la útil.",
    },
    {
      q: "¿Cuántos m² tiene un acre?",
      a: "Un acre equivale a 4.046,86 m², unas 0,405 hectáreas. Se usa en Reino Unido y Estados Unidos para medir terrenos.",
    },
    {
      q: "¿Por qué al pasar de m a cm se multiplica por 100, pero de m² a cm² por 10.000?",
      a: "Porque la superficie tiene dos dimensiones: 1 m² es un cuadrado de 100 cm × 100 cm = 10.000 cm². Del mismo modo, 1 km² = 1.000 m × 1.000 m = 1.000.000 m².",
    },
  ]}
>
  <ConvAreaTool client:load />
</CalcLayout>

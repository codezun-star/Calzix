---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NombreAmorTool from '@/components/tools/NombreAmorTool';
---

<CalcLayout slug="nombre-amor"
  answer={"La calculadora del amor por nombres combina las letras de dos nombres para dar un porcentaje de compatibilidad, como el clásico juego de las letras compartidas. Es un juego para pasar el rato: no tiene base científica y no sirve para tomar decisiones importantes sobre tu relación."}
  howTo={[
    "Escribe tu nombre.",
    "Escribe el nombre de la otra persona.",
    "Pulsa calcular para ver vuestro porcentaje de compatibilidad."
  ]}
  whatIs={"La calculadora del amor por nombres es un juego que asigna un porcentaje de compatibilidad a dos nombres a partir de sus letras. Siempre da el mismo resultado para la misma pareja de nombres."}
  whyUse={"Es un pasatiempo para reírte con tu pareja o tus amigos, animar una fiesta, un cumpleaños o una cena de San Valentín, o romper el hielo."}
  faqs={[
    {
      q: "¿Cómo funciona la calculadora del amor?",
      a: "Analiza las letras de los dos nombres y las combina con una fórmula fija para obtener un porcentaje. Por eso los mismos nombres dan siempre el mismo resultado. Es una versión digital de los juegos de letras que muchos hemos hecho en el colegio.",
    },
    {
      q: "¿Tiene alguna validez?",
      a: "Es un juego para pasar el rato: no tiene base científica y no sirve para tomar decisiones importantes sobre tu relación. La compatibilidad real depende de la comunicación, los valores compartidos, el respeto y los proyectos en común, no de las letras de un nombre.",
    },
    {
      q: "¿Influyen las tildes o las mayúsculas?",
      a: "No. La calculadora normaliza los nombres: no distingue mayúsculas de minúsculas y trata las vocales con tilde como sin tilde. Puedes usar el nombre de pila, el apodo o el nombre completo: cada variante dará un resultado distinto.",
    },
    {
      q: "¿Cuándo se celebra el día de los enamorados en España?",
      a: "En casi toda España se celebra San Valentín el 14 de febrero. En Cataluña, además, el gran día de los enamorados es Sant Jordi, el 23 de abril, cuando es tradición regalar una rosa y un libro. En la Comunitat Valenciana se celebra también el 9 de octubre, Sant Dionís, con la «mocadorà».",
    },
    {
      q: "¿Se guardan los nombres que escribo?",
      a: "No. El cálculo se hace en tu navegador y los nombres no se envían ni se almacenan en ningún servidor.",
    },
  ]}
>
  <NombreAmorTool client:load />
</CalcLayout>

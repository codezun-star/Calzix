---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CorrelacionDatosTool from '@/components/tools/CorrelacionDatosTool';
---

<CalcLayout slug="correlacion-datos"
  answer={"El coeficiente de correlación de Pearson (r) mide la relación lineal entre dos variables y va de −1 a 1: cerca de 1, relación directa fuerte; cerca de −1, inversa fuerte; cerca de 0, sin relación lineal. Para X = 1, 2, 3, 4, 5 e Y = 2, 4, 5, 4, 5, r ≈ 0,77."}
  howTo={[
    "Introduce los valores de la serie X separados por comas.",
    "Introduce los valores de la serie Y en el mismo orden.",
    "Pulsa calcular correlación para obtener r y su interpretación."
  ]}
  whatIs={"La calculadora de correlación calcula el coeficiente de correlación de Pearson entre dos series de datos e indica si la relación es directa o inversa y su intensidad."}
  whyUse={"Sirve para los ejercicios de estadística bidimensional de 4.º de ESO y Bachillerato y para analizar datos reales: horas de estudio y notas, temperatura y consumo eléctrico, o publicidad y ventas."}
  faqs={[
    {
      q: "¿Cómo se interpreta el coeficiente r?",
      a: "La calculadora usa esta escala orientativa: |r| ≥ 0,9, correlación muy fuerte; de 0,7 a 0,9, fuerte; de 0,5 a 0,7, moderada; de 0,3 a 0,5, débil; por debajo de 0,3, muy débil o nula. El signo indica si la relación es directa (+) o inversa (−). Es materia de Matemáticas Aplicadas a las Ciencias Sociales de Bachillerato y uno de los bloques habituales del examen de la PAU.",
    },
    {
      q: "¿Correlación implica causalidad?",
      a: "No. Que dos variables estén correlacionadas no significa que una cause la otra. Las ventas de helados y las quemaduras solares están correlacionadas, pero ambas dependen de una tercera variable: el calor del verano.",
    },
    {
      q: "¿Qué es la recta de regresión?",
      a: "Es la recta que mejor se ajusta a la nube de puntos por mínimos cuadrados. Permite estimar Y a partir de X, pero solo es fiable si la correlación es fuerte y dentro del rango de los datos observados.",
    },
    {
      q: "¿Qué es el coeficiente de determinación R²?",
      a: "Es r al cuadrado e indica qué proporción de la variación de Y se explica por X. Con r = 0,77, R² ≈ 0,6: el 60 % de la variación de Y está asociada a X.",
    },
    {
      q: "¿Dónde encuentro datos reales para practicar?",
      a: "El Instituto Nacional de Estadística (INE), el Banco de España, la AEMET y los portales de datos abiertos de las comunidades autónomas y los ayuntamientos publican series que puedes descargar, por ejemplo, de temperaturas, precios o población.",
    },
  ]}
>
  <CorrelacionDatosTool client:load />
</CalcLayout>

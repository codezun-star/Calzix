---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DistanciaApieTool from '@/components/tools/DistanciaApieTool';
---

<CalcLayout slug="distancia-a-pie"
  answer={"Caminando a un ritmo normal de 5 km/h se tarda 12 minutos por kilómetro: 5 km son una hora. Una persona de 70 kg quema unas 250-300 kcal por hora andando a ese ritmo, y 10.000 pasos equivalen a unos 7-8 km."}
  howTo={[
    "Introduce la distancia en kilómetros.",
    "Indica tu peso y tu velocidad al caminar (4 km/h tranquilo, 5 km/h normal, 6 km/h rápido).",
    "Pulsa calcular para ver el tiempo, los pasos y las calorías."
  ]}
  whatIs={"La calculadora de tiempo caminando estima cuánto tardarás en recorrer una distancia a pie según tu ritmo, cuántos pasos darás y las calorías que quemarás según tu peso."}
  whyUse={"Sirve para planificar paseos y rutas urbanas, saber si te compensa ir andando al trabajo, prepararte para etapas del Camino de Santiago o alcanzar el objetivo de pasos diarios."}
  faqs={[
    {
      q: "¿Cuánto se tarda en andar un kilómetro?",
      a: "A paso tranquilo (4 km/h), 15 minutos; a paso normal (5 km/h), 12 minutos; a paso rápido (6 km/h), 10 minutos. En cuesta o con mochila el ritmo baja. En el Camino de Santiago, con mochila y desniveles, la media suele estar en 4-4,5 km/h.",
    },
    {
      q: "¿Cuántos pasos hay en un kilómetro?",
      a: "Entre 1.250 y 1.500 pasos, según la longitud de tu zancada (unos 65-80 cm en adultos). Los famosos 10.000 pasos diarios equivalen a unos 7-8 km. La OMS recomienda al menos 150 minutos semanales de actividad física moderada, como caminar a paso ligero.",
    },
    {
      q: "¿Cuántas calorías se queman caminando?",
      a: "Aproximadamente 3,5 MET a 5 km/h: una persona de 70 kg quema unas 250-280 kcal por hora, y una de 90 kg, unas 320-350. Caminar cuesta arriba o a paso rápido aumenta el gasto. Es una estimación: el gasto real depende de la edad, la forma física y el terreno.",
    },
    {
      q: "¿Cuántos kilómetros tiene el Camino de Santiago?",
      a: "El Camino Francés tiene unos 780 km desde Saint-Jean-Pied-de-Port, que se recorren en 30-35 etapas. Para obtener la Compostela hay que recorrer a pie al menos los últimos 100 km (desde Sarria, en el Francés, son unos 115 km en 5 etapas). Las etapas habituales tienen entre 20 y 30 km, unas 5-7 horas de marcha.",
    },
    {
      q: "¿Me compensa ir andando al trabajo?",
      a: "Si vives a menos de 2-3 km, caminar suele llevar 25-35 minutos, a menudo poco más que en coche o transporte público contando atascos y aparcamiento, y suma actividad física diaria. Muchas ciudades españolas están ampliando zonas peatonales y de bajas emisiones, lo que hace más atractivo desplazarse a pie.",
    },
    {
      q: "¿Qué calzado conviene para caminatas largas?",
      a: "Zapatillas de caminar o de trail con buena amortiguación y suela con agarre, usadas previamente para evitar rozaduras. Para el Camino de Santiago, muchos peregrinos prefieren zapatillas ligeras a botas pesadas en verano. Usa calcetines técnicos sin costuras y lleva tiritas para ampollas.",
    },
  ]}
>
  <DistanciaApieTool client:load />
</CalcLayout>

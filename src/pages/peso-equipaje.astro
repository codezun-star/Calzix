---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PesoEquipajeTool from '@/components/tools/PesoEquipajeTool';
---

<CalcLayout slug="peso-equipaje"
  answer={"Para saber si tu maleta cumple el límite, suma el peso de cada objeto más el de la maleta vacía (de 2 a 4 kg una de cabina y de 3 a 5 kg una grande) y compáralo con la franquicia: normalmente 10 kg en cabina y 20 o 23 kg en bodega en vuelos europeos."}
  howTo={[
    "Elige el límite de tu billete: cabina (10 kg) o facturado (20, 23 o 32 kg).",
    "Añade cada artículo de tu equipaje con su peso, incluida la propia maleta.",
    "Comprueba el peso total y el margen que te queda antes de llegar al aeropuerto."
  ]}
  whatIs={"La calculadora de peso del equipaje suma el peso de todo lo que vas a llevar y lo compara con el límite de tu aerolínea para saber cuánto margen tienes o cuántos kilos te sobran antes de llegar al aeropuerto."}
  whyUse={"Te ayuda a preparar la maleta sin sorpresas en el mostrador, a repartir el peso entre varias maletas y a decidir qué dejar en casa para no pagar exceso de equipaje."}
  faqs={[
    {
      q: "¿Cuánto pesa una maleta vacía?",
      a: "Una maleta de cabina rígida pesa entre 2 y 3,5 kg; una blanda, entre 1,5 y 2,5 kg; una maleta grande de bodega, entre 3,5 y 5 kg. Elegir una maleta ligera te deja más peso disponible para tus cosas, sobre todo en cabina, donde el límite suele ser de 10 kg.",
    },
    {
      q: "¿Cuánto equipaje de mano puedo llevar?",
      a: "En Iberia, Vueling, Air Europa o Ryanair (con la tarifa que la incluye), la maleta de cabina admitida suele ser de 10 kg y unos 55 × 40 × 20 cm, más un bolso o mochila bajo el asiento. En las tarifas básicas de las aerolíneas de bajo coste solo se incluye el bulto pequeño gratuito. Comprueba la calculadora de medidas de maleta.",
    },
    {
      q: "¿Qué límites de peso hay en la maleta facturada?",
      a: "Lo habitual en vuelos europeos es 20 o 23 kg por pieza, y en vuelos transatlánticos, 23 kg en clase turista y 32 kg en business. Ninguna pieza puede superar los 32 kg por las normas de seguridad laboral de los manipuladores de equipaje, por lo que, si llevas más, tendrás que facturar otra maleta.",
    },
    {
      q: "¿Cómo peso la maleta en casa sin báscula de equipaje?",
      a: "Súbete a una báscula de baño con la maleta en brazos, anota el peso y réstale tu propio peso. El margen de error de las básculas domésticas es de unos cientos de gramos, así que deja un margen de 0,5 kg por seguridad. Las básculas colgantes de equipaje cuestan menos de 15 € y son más precisas.",
    },
    {
      q: "¿Qué objetos pesan más en una maleta?",
      a: "El calzado (cada par puede pesar 0,8-1,5 kg), los vaqueros y abrigos, los neceseres con botes, los libros y los aparatos electrónicos. Lleva puestas en el avión las prendas y zapatos más pesados, usa envases de viaje para los productos de higiene y considera comprar en destino lo que sea fácil de encontrar.",
    },
    {
      q: "¿Puedo llevar alimentos en la maleta?",
      a: "Dentro de la UE puedes llevar casi cualquier alimento envasado. Al volar a terceros países hay restricciones: Estados Unidos, Canadá o Australia limitan o prohíben la carne, los lácteos, la fruta y las semillas. Al volver a España desde fuera de la UE no puedes traer carne ni productos lácteos para consumo personal, salvo excepciones como la leche infantil.",
    },
  ]}
>
  <PesoEquipajeTool client:load />
</CalcLayout>

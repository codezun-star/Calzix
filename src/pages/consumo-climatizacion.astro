---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConsumoClimatizacionTool from '@/components/tools/ConsumoClimatizacionTool';
---

<CalcLayout slug="consumo-climatizacion"
  answer={"El consumo de un aire acondicionado o una bomba de calor es su potencia eléctrica por las horas de uso: un equipo de 1.200 W funcionando 6 horas al día durante 3 meses consume unos 650 kWh, alrededor de 97 € con la luz a 0,15 €/kWh."}
  howTo={[
    "Introduce la potencia eléctrica del equipo en vatios (no la frigorífica).",
    "Indica las horas de uso al día y los meses de uso al año.",
    "Escribe el precio del kWh y pulsa calcular para ver el consumo y el coste."
  ]}
  whatIs={"La calculadora de consumo de climatización estima los kWh y el coste en euros de un aire acondicionado, una bomba de calor o un radiador eléctrico según su potencia y el tiempo de uso."}
  whyUse={"Te ayuda a prever el gasto del aire acondicionado en verano o de la calefacción eléctrica en invierno, comparar equipos y decidir si te compensa uno más eficiente."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre potencia frigorífica y eléctrica?",
      a: "La potencia frigorífica (en frigorías o kW de frío) es el frío que produce el equipo; la eléctrica, la que consume. Un aire acondicionado de 3.000 frigorías (3,5 kW de frío) con un SEER de 6 consume de media unos 600 W. Para calcular el gasto, usa la potencia eléctrica.",
    },
    {
      q: "¿A qué temperatura poner el aire acondicionado?",
      a: "Entre 25 y 27 °C en verano. Cada grado menos aumenta el consumo alrededor de un 7 %. En los establecimientos públicos y comerciales, la normativa de ahorro energético limita la temperatura de refrigeración a un mínimo de 27 °C.",
    },
    {
      q: "¿Qué son el SEER y el SCOP?",
      a: "Son los rendimientos estacionales en refrigeración (SEER) y calefacción (SCOP): cuántos kWh de frío o calor produce el equipo por cada kWh eléctrico a lo largo de la temporada. Aparecen en la etiqueta energética: cuanto más altos, menos consume.",
    },
    {
      q: "¿Cuándo es más barato usar el aire acondicionado?",
      a: "Con tarifas por tramos, en las horas valle y llano. En el PVPC, el precio suele ser más bajo a mediodía en los días soleados, por la energía solar. Un buen aislamiento, toldos y persianas bajadas en las horas de sol reducen mucho el consumo.",
    },
    {
      q: "¿Es más barato calentar con bomba de calor que con radiadores eléctricos?",
      a: "Sí. Un radiador eléctrico convierte 1 kWh de electricidad en 1 kWh de calor, mientras que una bomba de calor con un SCOP de 4 produce 4 kWh de calor con el mismo consumo, es decir, gasta unas cuatro veces menos.",
    },
  ]}
>
  <ConsumoClimatizacionTool client:load />
</CalcLayout>

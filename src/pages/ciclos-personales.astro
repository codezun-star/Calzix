---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CiclosPersonalesTool from '@/components/tools/CiclosPersonalesTool';
---

<CalcLayout slug="ciclos-personales"
  answer={"Los biorritmos son tres ciclos sinusoidales que comienzan el día del nacimiento: físico de 23 días, emocional de 28 e intelectual de 33. La calculadora muestra en qué punto de cada ciclo estás hoy. Es una teoría popular de principios del siglo XX que los estudios científicos no han confirmado."}
  howTo={[
    "Introduce tu fecha de nacimiento.",
    "Pulsa calcular biorritmos.",
    "Consulta el valor de tus ciclos físico, emocional e intelectual para hoy."
  ]}
  whatIs={"La calculadora de ciclos personales o biorritmos calcula el valor actual de los ciclos físico (23 días), emocional (28 días) e intelectual (33 días) a partir de los días transcurridos desde tu nacimiento."}
  whyUse={"Es un entretenimiento para curiosos de los biorritmos, que estuvieron de moda en España en los años 70 y 80, y una forma visual de entender las funciones periódicas (seno) que se estudian en Matemáticas."}
  faqs={[
    {
      q: "¿Cómo se calculan los biorritmos?",
      a: "Se cuentan los días vividos desde el nacimiento (d) y se calcula sen(2π·d/T) para cada ciclo, con T = 23, 28 o 33 días. El resultado va de −100 % a +100 %. Los días en que un ciclo cruza el cero se consideran «críticos» en la teoría de los biorritmos.",
    },
    {
      q: "¿Tienen base científica?",
      a: "No. Los estudios que han comparado los biorritmos con accidentes, rendimiento deportivo o resultados académicos no han encontrado ninguna relación. Úsalos como entretenimiento.",
    },
    {
      q: "¿Qué ciclos biológicos sí son reales?",
      a: "El ritmo circadiano de unas 24 horas (sueño-vigilia, temperatura corporal, melatonina) está bien demostrado y fue objeto del Premio Nobel de Medicina de 2017. También existen ritmos ultradianos, como los ciclos de sueño de unos 90 minutos. Para organizar tu descanso, usa la calculadora de ciclos de sueño.",
    },
    {
      q: "¿Por qué son ciclos de 23, 28 y 33 días?",
      a: "Son los periodos que propusieron a principios del siglo XX Wilhelm Fliess y Hermann Swoboda (23 y 28 días) y Alfred Teltscher (33 días), basándose en observaciones que no se han podido reproducir.",
    },
    {
      q: "¿Se guarda mi fecha de nacimiento?",
      a: "No. El cálculo se hace en tu navegador y la fecha no se envía a ningún servidor.",
    },
  ]}
>
  <CiclosPersonalesTool client:load />
</CalcLayout>

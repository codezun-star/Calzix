---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorEscalaMapaTool from '@/components/tools/ConversorEscalaMapaTool';
---

<CalcLayout slug="conversor-escala-mapa"
  answer={"Una escala 1:50.000 significa que 1 cm en el mapa equivale a 50.000 cm (500 m) en la realidad: 4 cm en el mapa son 2 km sobre el terreno. Para pasar de la realidad al mapa, se divide entre la escala."}
  howTo={[
    "Introduce la escala del mapa (por ejemplo, 50000 para 1:50.000).",
    "Elige si quieres pasar de distancia en el mapa a distancia real o al revés.",
    "Introduce la distancia y pulsa calcular."
  ]}
  whatIs={"El conversor de escalas de mapa convierte distancias medidas en un mapa o plano en distancias reales, y viceversa, según la escala numérica."}
  whyUse={"Te ayuda a planificar rutas de senderismo con los mapas topográficos del IGN, interpretar planos de viviendas y parcelas o resolver ejercicios de escalas de Geografía y Matemáticas."}
  faqs={[
    {
      q: "¿Qué escalas tienen los mapas topográficos de España?",
      a: "El Instituto Geográfico Nacional publica el Mapa Topográfico Nacional a escala 1:50.000 y 1:25.000. La escala 1:25.000 (1 cm = 250 m) es la más usada para senderismo y montaña.",
    },
    {
      q: "¿Qué escala es mayor, 1:25.000 o 1:50.000?",
      a: "La 1:25.000 es una escala mayor: muestra menos territorio con más detalle. Cuanto menor es el denominador, mayor es la escala y más detalle tiene el mapa.",
    },
    {
      q: "¿Qué escala tienen los planos de una vivienda?",
      a: "Los planos de arquitectura suelen dibujarse a 1:50 o 1:100: en un plano a 1:100, 1 cm equivale a 1 m. Los planos de situación de una parcela, a 1:500 o 1:1.000.",
    },
    {
      q: "¿Qué es la escala gráfica?",
      a: "Una barra dibujada en el mapa con distancias reales marcadas. Tiene la ventaja de que sigue siendo correcta aunque se amplíe o reduzca el mapa al imprimirlo.",
    },
    {
      q: "¿Cómo mido una ruta con curvas en el mapa?",
      a: "Con un hilo que sigas por el camino y midas después con una regla, o con un curvímetro. Las aplicaciones de mapas y los visores del IGN calculan la distancia automáticamente.",
    },
  ]}
>
  <ConversorEscalaMapaTool client:load />
</CalcLayout>

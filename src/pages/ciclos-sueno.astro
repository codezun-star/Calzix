---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CiclosSuenoTool from '@/components/tools/CiclosSuenoTool';
---

<CalcLayout slug="ciclos-sueno"
  answer={"Un ciclo de sueño dura unos 90 minutos y una noche completa tiene entre 4 y 6 ciclos. Si te duermes a las 23:30, lo ideal es despertarte a las 5:30 (4 ciclos), 7:00 (5 ciclos) o 8:30 (6 ciclos); si tardas unos 15 minutos en dormirte, súmalos."}
  howTo={[
    "Elige si quieres saber a qué hora despertar o a qué hora acostarte.",
    "Introduce la hora.",
    "Pulsa calcular para ver las horas que coinciden con el final de un ciclo de sueño."
  ]}
  whatIs={"La calculadora de ciclos de sueño calcula las horas a las que acostarte o levantarte para completar ciclos completos de unos 90 minutos y despertar en una fase de sueño ligero."}
  whyUse={"Sirve para planificar la noche antes de un examen, un viaje o un madrugón, para ajustar el horario de los niños y para entender por qué a veces dormir más no te deja más descansado."}
  faqs={[
    {
      q: "¿Qué fases tiene un ciclo de sueño?",
      a: "Cada ciclo tiene fases de sueño no REM (N1 de transición, N2 de sueño ligero y N3 de sueño profundo, el más reparador) y una fase REM, en la que se sueña más y se consolida la memoria. Al principio de la noche predomina el sueño profundo y al final, el REM.",
    },
    {
      q: "¿Por qué me despierto cansado aunque haya dormido 8 horas?",
      a: "Puede que te despiertes en pleno sueño profundo (inercia del sueño), que tu sueño sea fragmentado por ruido, luz o apneas, o que tus horarios sean irregulares. Si el cansancio es constante, conviene consultarlo con el médico.",
    },
    {
      q: "¿Todos los ciclos duran 90 minutos?",
      a: "No exactamente: varían entre 80 y 110 minutos según la persona y el momento de la noche. Los 90 minutos son una media útil. Si sueles despertarte justo antes de la alarma, tu ciclo puede ser algo más corto o largo; ajusta la hora unos 10-15 minutos.",
    },
    {
      q: "¿Cuántos ciclos necesito?",
      a: "La mayoría de adultos necesita 5 ciclos (7,5 horas) o 6 (9 horas). Con 4 ciclos (6 horas) se puede funcionar puntualmente, pero de forma continuada acumula deuda de sueño.",
    },
    {
      q: "¿Sirve para los niños?",
      a: "Los ciclos de los bebés y niños pequeños son más cortos (de 50 a 60 minutos) y necesitan muchas más horas de sueño, así que el cálculo no es aplicable. Para ellos, el pediatra es la mejor referencia.",
    },
  ]}
>
  <CiclosSuenoTool client:load />
</CalcLayout>

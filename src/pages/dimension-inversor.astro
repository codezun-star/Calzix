---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DimensionInversorTool from '@/components/tools/DimensionInversorTool';
---

<CalcLayout slug="dimension-inversor"
  answer={"El inversor de una instalación solar suele dimensionarse entre el 80 % y el 100 % de la potencia de los paneles: para 5 kWp, un inversor de unos 4,5 kW (ratio 0,9). Un inversor algo menor que los paneles es habitual y aprovecha mejor las horas de menos sol."}
  howTo={[
    "Introduce la potencia pico de los paneles en kWp.",
    "Ajusta la relación entre la potencia del inversor y la de los paneles (0,8-1,0).",
    "Pulsa dimensionar para ver la potencia recomendada del inversor."
  ]}
  whatIs={"La calculadora de dimensionado del inversor calcula la potencia de inversor recomendada para una instalación fotovoltaica a partir de la potencia pico de los paneles y una relación de dimensionado."}
  whyUse={"Te ayuda a revisar el presupuesto de una instalación de autoconsumo, elegir un inversor adecuado y entender por qué no hace falta que coincida con la potencia de los paneles."}
  faqs={[
    {
      q: "¿Por qué el inversor puede ser más pequeño que los paneles?",
      a: "Porque los paneles rara vez producen su potencia pico: la temperatura, la orientación, la suciedad y la hora del día reducen su rendimiento. Un inversor del 80-90 % de la potencia de los paneles casi nunca limita la producción y es más barato.",
    },
    {
      q: "¿Qué potencia de inversor necesita una vivienda?",
      a: "Las instalaciones domésticas en España suelen tener entre 3 y 6 kWp de paneles e inversores de 3 a 5 kW. Además, la potencia del inversor no debería superar mucho la potencia contratada si tu instalación vierte excedentes, según las condiciones de tu distribuidora.",
    },
    {
      q: "¿Inversor de string o microinversores?",
      a: "El inversor central (string) es más barato y adecuado para tejados sin sombras. Los microinversores u optimizadores, uno por panel, rinden mejor con sombras parciales u orientaciones distintas y permiten vigilar cada panel, a un precio mayor.",
    },
    {
      q: "¿Qué es un inversor híbrido?",
      a: "Es un inversor preparado para conectar baterías. Si piensas añadir almacenamiento más adelante, elegirlo desde el principio evita cambiar de equipo.",
    },
    {
      q: "¿Quién debe hacer la instalación?",
      a: "Una empresa instaladora habilitada, que dimensiona la instalación, la legaliza en la comunidad autónoma y emite el certificado de instalación eléctrica. Es necesario para registrar el autoconsumo y acogerte a la compensación de excedentes.",
    },
  ]}
>
  <DimensionInversorTool client:load />
</CalcLayout>

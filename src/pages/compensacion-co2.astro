---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CompensacionCo2Tool from '@/components/tools/CompensacionCo2Tool';
---

<CalcLayout slug="compensacion-co2"
  answer={"Para compensar 5 toneladas de CO₂ al año harían falta unos 250 árboles adultos, suponiendo que cada uno absorbe de media unos 20 kg de CO₂ al año. En la práctica, los proyectos de reforestación en España certificados por el MITECO calculan la absorción por hectárea durante décadas."}
  howTo={[
    "Introduce las emisiones que quieres compensar en kilos o toneladas de CO₂.",
    "Pulsa calcular para ver los árboles necesarios y la superficie de bosque equivalente.",
    "Usa el resultado como referencia antes de elegir un proyecto de compensación."
  ]}
  whatIs={"La calculadora de compensación de CO₂ estima cuántos árboles serían necesarios para absorber unas emisiones de CO₂ al año, con una absorción media de 20 kg por árbol adulto, y la superficie de bosque aproximada que supondría."}
  whyUse={"Te ayuda a dimensionar la compensación de tu huella personal, de un viaje o de un evento, y a valorar los proyectos de reforestación y las ofertas de compensación de las empresas."}
  faqs={[
    {
      q: "¿Cuánto CO₂ absorbe un árbol?",
      a: "Depende de la especie, la edad, el clima y el suelo. Como referencia, un árbol adulto absorbe entre 10 y 30 kg de CO₂ al año; esta calculadora usa 20 kg. Un árbol joven absorbe mucho menos los primeros años. En España, especies de crecimiento rápido como el pino o el chopo absorben más que las de crecimiento lento como la encina, que a cambio vive siglos.",
    },
    {
      q: "¿Cuántos árboles caben en una hectárea?",
      a: "En una repoblación forestal típica se plantan entre 400 y 1.600 árboles por hectárea, según la especie y el objetivo, y con el tiempo la densidad baja por la mortalidad natural y los aclareos. Los proyectos de absorción inscritos en el registro del MITECO calculan las toneladas de CO₂ que absorberá cada hectárea a lo largo de 30-50 años.",
    },
    {
      q: "¿Qué es el registro de huella de carbono, compensación y proyectos de absorción?",
      a: "Es un registro voluntario del Ministerio para la Transición Ecológica (Real Decreto 163/2014) donde se inscriben proyectos de reforestación y restauración forestal en España. Las empresas y los particulares pueden comprar absorciones de estos proyectos para compensar sus emisiones con garantía de que el CO₂ se absorbe realmente en territorio español.",
    },
    {
      q: "¿Es mejor compensar o reducir emisiones?",
      a: "Reducir. La compensación con árboles es lenta (un árbol tarda décadas en absorber lo que se emite en un vuelo), puede revertirse por incendios o talas y no hay superficie suficiente para compensar todas las emisiones. Lo recomendable es reducir primero (menos coche y avión, energía renovable, eficiencia, dieta) y compensar solo lo que no se pueda evitar.",
    },
    {
      q: "¿Cómo influyen los incendios forestales?",
      a: "Un incendio libera de golpe el carbono almacenado en el bosque. España sufre cada verano grandes incendios, por lo que los proyectos serios de compensación incluyen una reserva de garantía (absorciones que no se venden) y planes de prevención y gestión forestal para reducir el riesgo.",
    },
    {
      q: "¿Puedo plantar árboles por mi cuenta?",
      a: "Puedes participar en plantaciones organizadas por ayuntamientos, comunidades autónomas y organizaciones ambientales, normalmente en otoño e invierno, que es la época adecuada en el clima español. Plantar en terrenos ajenos o protegidos sin permiso no está permitido, y las especies deben ser autóctonas y adecuadas a la zona.",
    },
  ]}
>
  <CompensacionCo2Tool client:load />
</CalcLayout>

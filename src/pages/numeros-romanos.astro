---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NumerosRomanosTool from '@/components/tools/NumerosRomanosTool';
---

<CalcLayout slug="numeros-romanos"
  answer={"Los números romanos usan siete símbolos (I = 1, V = 5, X = 10, L = 50, C = 100, D = 500, M = 1.000) que se suman, salvo cuando uno menor va delante de otro mayor, que se resta: 2026 = MMXXVI y 1492 = MCDXCII."}
  howTo={[
    "Elige si quieres pasar de número arábigo a romano o de romano a arábigo.",
    "Introduce el número (del 1 al 3.999).",
    "Pulsa convertir para ver el resultado."
  ]}
  whatIs={"El conversor de números romanos pasa números arábigos del 1 al 3.999 a romanos y viceversa, siguiendo las reglas clásicas de suma y resta de los símbolos."}
  whyUse={"Sirve para los ejercicios de Primaria, para escribir siglos, nombres de reyes y papas, capítulos y tomos, y para entender fechas en monumentos, relojes y créditos de películas."}
  faqs={[
    {
      q: "¿Cuáles son las reglas de los números romanos?",
      a: "Los símbolos se suman de izquierda a derecha; un símbolo menor delante de uno mayor se resta (IV = 4, XC = 90); I, X y C solo restan delante de los dos símbolos inmediatamente superiores; y I, X, C y M pueden repetirse hasta tres veces.",
    },
    {
      q: "¿Cómo se escriben los siglos?",
      a: "En números romanos y, según la Real Academia Española, preferiblemente en versalitas o mayúsculas: siglo XXI, siglo XV. No se usan ordinales ni el punto: «siglo XXI», no «siglo XXIº».",
    },
    {
      q: "¿Por qué los relojes usan IIII en lugar de IV?",
      a: "Por tradición estética: muchos relojes de esfera usan IIII para equilibrar visualmente con el VIII del lado opuesto. Ambas formas se entienden.",
    },
    {
      q: "¿Cómo se escriben números mayores de 3.999?",
      a: "Con una raya horizontal encima del símbolo, que multiplica su valor por 1.000: V con raya es 5.000. Hoy se usa muy poco.",
    },
    {
      q: "¿Existe el cero en números romanos?",
      a: "No. El cero llegó a Europa con los números indoarábigos, en buena parte a través de Al-Ándalus, y se generalizó a partir de la Edad Media.",
    },
  ]}
>
  <NumerosRomanosTool client:load />
</CalcLayout>

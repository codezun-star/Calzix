---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvIluminacionTool from '@/components/tools/ConvIluminacionTool';
---

<CalcLayout slug="conversor-iluminacion"
  answer={"El lux (lx) mide la luz que llega a una superficie: 1 lux = 1 lumen por m². Un pie-candela equivale a 10,764 lux y un fot a 10.000 lux. Como referencia, un puesto de trabajo con ordenador necesita unos 500 lux, y la luz del sol directa supera los 100.000 lux."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 500 lux o 50 pies-candela).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de iluminación convierte entre lux, kilolux, pies-candela, fots y nox, las unidades que miden la iluminancia, es decir, la cantidad de luz que llega a una superficie."}
  whyUse={"Sirve para comprobar si la iluminación de una oficina, un aula o tu escritorio es adecuada, interpretar fichas técnicas de luminarias e iluminación de origen estadounidense y para fotografía y horticultura."}
  faqs={[
    {
      q: "¿Cuántos lux necesita un puesto de trabajo?",
      a: "El Real Decreto 486/1997 sobre lugares de trabajo fija mínimos de 100 lux para tareas con bajas exigencias visuales, 200 lux para exigencias moderadas, 500 lux para exigencias altas y 1.000 lux para exigencias muy altas. La norma UNE-EN 12464-1 recomienda unos 500 lux para tareas de oficina y lectura.",
    },
    {
      q: "¿Qué diferencia hay entre lux y lúmenes?",
      a: "Los lúmenes miden la luz total que emite una bombilla, y los lux, la luz que llega a cada metro cuadrado de una superficie. Una bombilla LED de 800 lúmenes (equivalente a una incandescente de 60 W) produce más o menos lux según la distancia y el tamaño de la habitación.",
    },
    {
      q: "¿Cuántos lux hay al aire libre?",
      a: "Un día soleado de verano en España puede superar los 100.000 lux; un día nublado, entre 1.000 y 20.000 lux; una oficina bien iluminada, unos 500 lux; y una calle con alumbrado público, entre 10 y 30 lux. Con luna llena hay menos de 1 lux.",
    },
    {
      q: "¿Qué es el pie-candela?",
      a: "Es la unidad de iluminancia del sistema anglosajón: un lumen por pie cuadrado, 10,764 lux. Aparece en fichas técnicas y manuales de iluminación estadounidenses.",
    },
    {
      q: "¿Cómo puedo medir los lux?",
      a: "Con un luxómetro, o de forma aproximada con una aplicación del móvil que use el sensor de luz ambiental. Para mediciones oficiales en un lugar de trabajo, el servicio de prevención de riesgos laborales usa luxómetros calibrados.",
    },
  ]}
>
  <ConvIluminacionTool client:load />
</CalcLayout>

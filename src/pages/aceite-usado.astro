---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AceiteUsadoTool from '@/components/tools/AceiteUsadoTool';
---

<CalcLayout slug="aceite-usado"
  answer={"Un solo litro de aceite de cocina usado vertido por el fregadero puede contaminar hasta 1.000 litros de agua. Si reciclas 1 litro al mes, evitas contaminar unos 12.000 litros al año; en España, el aceite usado se lleva al punto limpio o a los contenedores específicos de aceite."}
  howTo={[
    "Introduce los litros de aceite usado que reciclas.",
    "Indica cada cuántos días los reciclas.",
    "Pulsa calcular impacto para ver el agua que evitas contaminar al año y otras equivalencias."
  ]}
  whatIs={"La calculadora de aceite usado estima cuánta agua evitas contaminar y otros beneficios ambientales al reciclar el aceite de cocina en lugar de tirarlo por el desagüe."}
  whyUse={"Te ayuda a dimensionar el impacto de un hábito sencillo y a concienciar en casa, en el colegio o en tu comunidad de vecinos sobre la importancia de reciclar el aceite."}
  faqs={[
    {
      q: "¿Dónde se recicla el aceite de cocina en España?",
      a: "En los puntos limpios municipales y en los contenedores específicos de aceite usado (a menudo de color naranja) que hay en calles, mercados y supermercados de muchos municipios. Guárdalo frío en una botella de plástico cerrada y llévala entera.",
    },
    {
      q: "¿Por qué no se puede tirar por el fregadero?",
      a: "Porque forma una película en el agua que impide la oxigenación, obstruye las tuberías de casa y del alcantarillado y encarece mucho la depuración. Tampoco debe tirarse al cubo de restos ni al inodoro.",
    },
    {
      q: "¿Qué se hace con el aceite reciclado?",
      a: "Se transforma principalmente en biodiésel y también en jabones, lubricantes y otros productos industriales. Es un buen ejemplo de economía circular.",
    },
    {
      q: "¿Qué dice la ley sobre los residuos domésticos?",
      a: "La Ley 7/2022 de residuos y suelos contaminados para una economía circular obliga a los municipios a organizar la recogida separada de distintas fracciones de residuos, incluidos los aceites de cocina usados.",
    },
    {
      q: "¿Se puede reciclar el aceite del motor en el mismo contenedor?",
      a: "No. El aceite de motor es un residuo peligroso: se entrega en el taller o en el punto limpio, en recipientes separados. Los contenedores de la calle son solo para aceite vegetal de cocina.",
    },
  ]}
>
  <AceiteUsadoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import RaizCuadradaTool from '@/components/tools/RaizCuadradaTool';
---

<CalcLayout slug="raiz-cuadrada"
  answer={"La raíz cuadrada de un número es el valor que, multiplicado por sí mismo, da ese número: √144 = 12 y √2 ≈ 1,4142. La raíz de índice n es el número que elevado a n da el radicando: ∛27 = 3."}
  howTo={[
    "Introduce el número (radicando).",
    "Indica el índice de la raíz (2 para la cuadrada, 3 para la cúbica…).",
    "Pulsa calcular raíz para obtener el resultado."
  ]}
  whatIs={"La calculadora de raíces calcula la raíz cuadrada, cúbica o de cualquier índice de un número, con varios decimales de precisión."}
  whyUse={"Sirve para los ejercicios de radicales de la ESO, para aplicar el teorema de Pitágoras o la fórmula de la ecuación de segundo grado y para cálculos de áreas y volúmenes."}
  faqs={[
    {
      q: "¿Cuáles son los cuadrados perfectos?",
      a: "1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144, 169, 196, 225… Sus raíces cuadradas son números enteros. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Tiene raíz cuadrada un número negativo?",
      a: "No en los números reales. Las raíces de índice impar sí existen para negativos: ∛−8 = −2. En los números complejos, √−1 = i.",
    },
    {
      q: "¿Cómo se calcula una raíz a mano?",
      a: "Con el algoritmo de la raíz cuadrada que se enseñaba en la escuela o por aproximaciones: √50 está entre 7 (49) y 8 (64), cerca de 7, y 7,07² ≈ 50.",
    },
    {
      q: "¿Cómo se simplifica un radical?",
      a: "Sacando los factores cuyo exponente sea igual o mayor que el índice: √72 = √(36 × 2) = 6√2.",
    },
    {
      q: "¿Dónde se usan las raíces cuadradas?",
      a: "En el teorema de Pitágoras, la desviación típica, la fórmula de las ecuaciones de segundo grado o para obtener el lado de un cuadrado a partir de su área: una habitación cuadrada de 16 m² mide 4 m de lado.",
    },
  ]}
>
  <RaizCuadradaTool client:load />
</CalcLayout>

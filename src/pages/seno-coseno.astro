---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import SinCosTanTool from '@/components/tools/SinCosTanTool';
---

<CalcLayout slug="seno-coseno"
  answer={"En un triángulo rectángulo, seno = cateto opuesto ÷ hipotenusa, coseno = cateto contiguo ÷ hipotenusa y tangente = cateto opuesto ÷ cateto contiguo. Así, sen 30° = 0,5, cos 60° = 0,5 y tan 45° = 1."}
  howTo={[
    "Introduce el ángulo y elige si está en grados o en radianes.",
    "Elige la función: seno, coseno o tangente.",
    "Consulta el resultado al instante."
  ]}
  whatIs={"La calculadora de seno, coseno y tangente calcula las razones trigonométricas de cualquier ángulo en grados o radianes."}
  whyUse={"Sirve para los ejercicios de trigonometría de 4.º de ESO y Bachillerato, y para problemas prácticos como calcular la inclinación de un tejado, la pendiente de una rampa o la altura de un edificio a partir de su sombra."}
  faqs={[
    {
      q: "¿Cuáles son los valores de los ángulos notables?",
      a: "sen 0° = 0, sen 30° = 1/2, sen 45° = √2/2 ≈ 0,707, sen 60° = √3/2 ≈ 0,866, sen 90° = 1. El coseno toma los mismos valores en orden inverso. tan 30° = √3/3, tan 45° = 1 y tan 60° = √3. Forma parte del currículo de Matemáticas de 4.º de ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo calculo la pendiente de una rampa?",
      a: "La pendiente en porcentaje es tan(α) × 100. Una rampa de 5° tiene una pendiente del 8,7 %. El Código Técnico de la Edificación limita la pendiente de las rampas accesibles al 10 % en tramos de menos de 3 m, al 8 % en tramos de menos de 6 m y al 6 % en los demás.",
    },
    {
      q: "¿Cómo mido la altura de un edificio con su sombra?",
      a: "Mide la longitud de la sombra y el ángulo de elevación del sol (o la sombra de un palo de altura conocida). Altura = sombra × tan(ángulo). Si la sombra mide 20 m y el sol está a 40°, el edificio mide 20 × 0,839 = 16,8 m.",
    },
    {
      q: "¿Qué es el teorema del seno?",
      a: "Relaciona los lados de cualquier triángulo con los senos de los ángulos opuestos: a / sen A = b / sen B = c / sen C. Junto con el teorema del coseno, permite resolver triángulos que no son rectángulos.",
    },
    {
      q: "¿Por qué la calculadora da otro resultado?",
      a: "Comprueba si está en modo grados (DEG) o radianes (RAD). sen(30) vale 0,5 en grados, pero −0,988 si la calculadora interpreta 30 radianes.",
    },
  ]}
>
  <SinCosTanTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import RecargoMoraTool from '@/components/tools/RecargoMoraTool';
---

<CalcLayout slug="recargo-mora"
  answer={"Los intereses de demora se calculan como importe × tipo anual × días de retraso ÷ 365. En operaciones entre empresas, la Ley 3/2004 fija para el segundo semestre de 2026 un tipo del 10,40 % y una indemnización de 40 € por factura: 1.000 € pagados con 45 días de retraso generan 12,82 € de intereses más 40 €."}
  howTo={[
    "Introduce el importe de la factura o deuda.",
    "Elige el tipo: demora comercial (10,40 %), interés legal del dinero (3,25 %) u otro pactado.",
    "Escribe los días de retraso y pulsa calcular para ver los intereses y el total a reclamar."
  ]}
  whatIs={"La calculadora de recargo por mora calcula los intereses de demora de una factura o deuda pagada tarde con los tipos legales vigentes en España en 2026, y añade la indemnización de 40 € por costes de cobro de la Ley 3/2004."}
  whyUse={"Sirve a autónomos y empresas para reclamar con cifras exactas las facturas impagadas, y a cualquier persona para saber cuánto se acumula por un pago fuera de plazo."}
  faqs={[
    {
      q: "¿Qué tipo de interés de demora se aplica en 2026?",
      a: "En operaciones comerciales entre empresas o autónomos, el tipo legal es el del Banco Central Europeo más 8 puntos: 10,40 % en el segundo semestre de 2026. En deudas que no son operaciones comerciales se aplica el interés legal del dinero, 3,25 % en 2026, salvo que se haya pactado otro.",
    },
    {
      q: "¿Cuál es el plazo de pago legal entre empresas?",
      a: "La Ley 3/2004 de lucha contra la morosidad fija 30 días naturales desde la entrega o la prestación del servicio, ampliables por acuerdo hasta 60 días como máximo. A partir del vencimiento, los intereses se devengan automáticamente, sin necesidad de reclamarlos.",
    },
    {
      q: "¿Qué es la indemnización de 40 €?",
      a: "Es una compensación fija por costes de cobro que el acreedor puede reclamar por cada factura pagada con retraso en operaciones comerciales, además de los intereses y sin justificar gastos. Si los costes reales son mayores, se puede reclamar la diferencia acreditada.",
    },
    {
      q: "¿Desde cuándo se cuentan los días?",
      a: "Desde el día siguiente al vencimiento hasta el día del pago. Si la factura vencía el 30 de junio y se paga el 14 de agosto, hay 45 días de retraso. Conserva la factura y la prueba de la fecha de entrega para justificar el cálculo.",
    },
    {
      q: "¿Cómo reclamo una factura impagada?",
      a: "Primero, con un recordatorio y después con un burofax que reclame el principal, los intereses y los 40 €. Si no paga, el proceso monitorio permite reclamar deudas documentadas en el juzgado del domicilio del deudor, sin abogado ni procurador hasta 2.000 €.",
    },
  ]}
>
  <RecargoMoraTool client:load />
</CalcLayout>

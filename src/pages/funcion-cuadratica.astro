---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import FuncionCuadraticaTool from '@/components/tools/FuncionCuadraticaTool';
---

<CalcLayout slug="funcion-cuadratica"
  answer={"Las raíces de ax² + bx + c = 0 se calculan con x = (−b ± √(b² − 4ac)) / 2a y el vértice de la parábola está en x = −b / 2a. Para x² − 5x + 6 = 0, el discriminante es 1 y las soluciones son x = 2 y x = 3; el vértice está en (2,5; −0,25)."}
  howTo={[
    "Introduce los coeficientes a, b y c de la función f(x) = ax² + bx + c.",
    "Pulsa calcular.",
    "Consulta el discriminante, las raíces y el vértice de la parábola."
  ]}
  whatIs={"La calculadora de funciones cuadráticas resuelve ecuaciones de segundo grado y calcula el discriminante, las raíces y el vértice de la parábola."}
  whyUse={"Sirve para comprobar los ejercicios de ecuaciones de segundo grado y funciones de 3.º y 4.º de ESO y Bachillerato, y para problemas de optimización como el área máxima o el beneficio máximo."}
  faqs={[
    {
      q: "¿Qué indica el discriminante?",
      a: "El discriminante Δ = b² − 4ac indica cuántas soluciones reales hay: si es positivo, dos; si es cero, una doble (el vértice toca el eje X); si es negativo, ninguna real (la parábola no corta el eje X). Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se calcula el vértice?",
      a: "La coordenada x del vértice es −b / 2a y la y se obtiene sustituyendo ese valor en la función. Si a es positivo, la parábola se abre hacia arriba y el vértice es un mínimo; si es negativo, es un máximo.",
    },
    {
      q: "¿Dónde aparecen las parábolas en la vida real?",
      a: "En la trayectoria de un balón o un chorro de agua (tiro parabólico), en las antenas parabólicas, en los faros de los coches y en problemas económicos en los que el beneficio depende del precio de forma cuadrática.",
    },
    {
      q: "¿Cómo se resuelve una ecuación incompleta?",
      a: "Si falta c (ax² + bx = 0), saca factor común: x(ax + b) = 0, con soluciones x = 0 y x = −b/a. Si falta b (ax² + c = 0), despeja: x = ±√(−c/a). No hace falta la fórmula general.",
    },
    {
      q: "¿Qué relación hay entre las raíces y los coeficientes?",
      a: "La suma de las raíces es −b/a y su producto es c/a (fórmulas de Cardano-Vieta). En x² − 5x + 6 = 0, las raíces 2 y 3 suman 5 y su producto es 6.",
    },
  ]}
>
  <FuncionCuadraticaTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NumeroAngelTool from '@/components/tools/NumeroAngelTool';
---

<CalcLayout slug="numero-angel"
  answer={"En numerología, los «números ángel» son secuencias repetidas como 111, 222 o 1111 a las que se atribuye un mensaje simbólico: el 1111 se asocia a nuevos comienzos y el 222 al equilibrio. Es un entretenimiento sin base científica: úsalo para pasar un buen rato, no para tomar decisiones importantes."}
  howTo={[
    "Escribe el número repetido que has visto (por ejemplo, 1111).",
    "Pulsa ver significado.",
    "Lee la interpretación simbólica tradicional."
  ]}
  whatIs={"La calculadora de números ángel muestra el significado simbólico que la numerología popular atribuye a las secuencias de números repetidos."}
  whyUse={"Es un entretenimiento para curiosos de la numerología y las coincidencias, por ejemplo cuando ves la misma hora repetida en el reloj."}
  faqs={[
    {
      q: "¿Qué son los números ángel?",
      a: "Secuencias de cifras repetidas (111, 222, 333…) que, según la numerología popular, transmiten mensajes simbólicos. Es una creencia reciente y muy difundida en redes sociales.",
    },
    {
      q: "¿Por qué veo tanto el 11:11?",
      a: "Por un sesgo cognitivo llamado ilusión de frecuencia: cuando algo nos llama la atención, empezamos a notarlo más. La probabilidad de mirar el reloj a las 11:11 es la misma que a cualquier otra hora.",
    },
    {
      q: "¿Tienen base científica?",
      a: "No. Es un entretenimiento sin base científica: úsalo para pasar un buen rato, no para tomar decisiones importantes.",
    },
    {
      q: "¿Qué significa el 1111?",
      a: "En la numerología popular se asocia a nuevos comienzos, intuición y oportunidades. Otras interpretaciones habituales: 222, equilibrio; 333, creatividad; 444, estabilidad; 555, cambios.",
    },
    {
      q: "¿Se guarda lo que escribo?",
      a: "No. El cálculo se hace en tu navegador y los datos no se envían a ningún servidor.",
    },
  ]}
>
  <NumeroAngelTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvLongitudTool from '@/components/tools/ConvLongitudTool';
---

<CalcLayout slug="conversor-longitud"
  answer={"Para convertir longitudes usa los factores exactos: 1 pulgada = 2,54 cm, 1 pie = 30,48 cm, 1 yarda = 0,9144 m y 1 milla = 1,609344 km. Así, una televisión de 55 pulgadas mide 139,7 cm de diagonal y 10 millas son 16,09 km."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 55 pulgadas o 10 millas).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de longitud convierte entre metros, kilómetros, centímetros, milímetros, millas, yardas, pies y pulgadas con los factores de conversión exactos definidos internacionalmente."}
  whyUse={"Sirve para entender las pulgadas de un televisor, un móvil o las llantas del coche, las millas de un viaje a Reino Unido o Estados Unidos, los pies de altitud de un vuelo o las medidas de un mueble comprado en una web extranjera."}
  faqs={[
    {
      q: "¿Cuántos centímetros tiene una pulgada?",
      a: "Exactamente 2,54 cm. Las pulgadas se siguen usando en España para la diagonal de pantallas (televisores, monitores, móviles), el diámetro de las llantas y los neumáticos, las tuberías y racores de fontanería y algunas herramientas.",
    },
    {
      q: "¿Qué mide una televisión de 55 pulgadas?",
      a: "Su diagonal mide 55 × 2,54 = 139,7 cm. En formato 16:9, eso equivale a unos 122 cm de ancho y 68 cm de alto de pantalla. Una regla habitual es sentarse a una distancia de entre 1,2 y 1,5 veces la diagonal para resolución 4K.",
    },
    {
      q: "¿Cuántos kilómetros tiene una milla?",
      a: "Una milla terrestre tiene 1,609344 km. La milla náutica, que se usa en navegación marítima y aérea, mide 1,852 km. En Reino Unido las señales de tráfico indican distancias en millas y velocidades en millas por hora.",
    },
    {
      q: "¿Por qué los aviones usan pies?",
      a: "Por convenio internacional de la aviación, la altitud se expresa en pies: un vuelo de crucero entre Madrid y Canarias va a unos 36.000 pies, unos 11 km. 1 pie = 0,3048 m.",
    },
    {
      q: "¿Qué unidades de longitud son legales en España?",
      a: "En España, las unidades legales de medida son las del Sistema Internacional (SI), según el Real Decreto 2032/2009, y el sistema métrico decimal es obligatorio desde la Ley de Pesas y Medidas de 1849. Aun así, se usan unidades tradicionales como la vara castellana (unos 83,6 cm) en documentos antiguos y las pulgadas en productos concretos.",
    },
    {
      q: "¿Cuál es la unidad de longitud del Sistema Internacional?",
      a: "El metro, definido desde 1983 como la distancia que recorre la luz en el vacío en 1/299.792.458 de segundo. Sus múltiplos y submúltiplos (kilómetro, centímetro, milímetro) se obtienen multiplicando o dividiendo por potencias de 10.",
    },
  ]}
>
  <ConvLongitudTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import RedondeoTool from '@/components/tools/RedondeoTool';
---

<CalcLayout slug="redondeo"
  answer={"Para redondear a n decimales mira la cifra siguiente: si es 5 o mayor, se sube; si es menor, se deja: 3,14159 redondeado a 2 decimales es 3,14 y a 3 decimales, 3,142. Los céntimos de euro se redondean a 2 decimales."}
  howTo={[
    "Introduce el número.",
    "Indica a cuántos decimales quieres redondear.",
    "Pulsa redondear para ver el resultado."
  ]}
  whatIs={"La calculadora de redondeo redondea cualquier número al número de decimales que elijas, con la regla habitual del redondeo al más próximo."}
  whyUse={"Sirve para los ejercicios de aproximación de la ESO, para presentar resultados con las cifras adecuadas y para redondear importes a céntimos en facturas y presupuestos."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre redondear y truncar?",
      a: "Redondear aproxima al valor más cercano (3,148 → 3,15); truncar corta los decimales sobrantes sin más (3,148 → 3,14). Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se redondean los céntimos en España?",
      a: "Los importes en euros se expresan con dos decimales y se redondean al céntimo más próximo. Las monedas de 1 y 2 céntimos siguen siendo de curso legal; en algunos países de la zona euro se redondea el total en efectivo a 5 céntimos, pero en España no es obligatorio.",
    },
    {
      q: "¿Cómo afecta el redondeo al IVA de una factura?",
      a: "Lo correcto es calcular la cuota de IVA sobre la base imponible total y redondear al céntimo, no redondear línea a línea. Si se redondea cada línea, el total puede diferir en algunos céntimos.",
    },
    {
      q: "¿Qué es el redondeo del banquero?",
      a: "Una regla que redondea los casos exactos de 5 al número par más cercano (2,5 → 2 y 3,5 → 4) para evitar sesgos en grandes cantidades de datos. Se usa en estadística y en algunos programas informáticos.",
    },
    {
      q: "¿Qué son las cifras significativas?",
      a: "Las cifras de un número que aportan información sobre su precisión. En física y química, el resultado debe redondearse al número de cifras significativas del dato menos preciso.",
    },
  ]}
>
  <RedondeoTool client:load />
</CalcLayout>

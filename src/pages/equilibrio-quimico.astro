---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import EquilibrioQuimicoTool from '@/components/tools/EquilibrioQuimicoTool';
---

<CalcLayout slug="equilibrio-quimico"
  answer={"La constante de equilibrio Kc es el producto de las concentraciones de los productos dividido entre el de los reactivos, cada una elevada a su coeficiente: para aA + bB ⇌ cC + dD, Kc = [C]ᶜ[D]ᵈ / [A]ᵃ[B]ᵇ. Si Kc es mucho mayor que 1, el equilibrio está desplazado hacia los productos."}
  howTo={[
    "Introduce los coeficientes estequiométricos de reactivos y productos.",
    "Introduce las concentraciones en el equilibrio (mol/L).",
    "Pulsa calcular Kc para obtener la constante de equilibrio."
  ]}
  whatIs={"La calculadora de equilibrio químico calcula la constante de equilibrio Kc a partir de las concentraciones de reactivos y productos en el equilibrio y de los coeficientes de la reacción ajustada."}
  whyUse={"Sirve para los problemas de equilibrio químico de Química de 2.º de Bachillerato, uno de los bloques que más se repiten en el examen de Química de la PAU."}
  faqs={[
    {
      q: "¿Qué es el equilibrio químico?",
      a: "Es el estado de una reacción reversible en el que las velocidades de la reacción directa e inversa se igualan y las concentraciones dejan de variar, aunque la reacción continúa a nivel molecular (equilibrio dinámico).",
    },
    {
      q: "¿Qué indica el valor de Kc?",
      a: "Si Kc es mucho mayor que 1, en el equilibrio predominan los productos; si es mucho menor que 1, predominan los reactivos. Kc solo depende de la temperatura, no de las concentraciones iniciales.",
    },
    {
      q: "¿Qué es el principio de Le Châtelier?",
      a: "Dice que si se altera un sistema en equilibrio (cambiando concentraciones, presión o temperatura), este se desplaza en el sentido que contrarresta la perturbación. Es la base para optimizar procesos industriales como la síntesis del amoniaco (proceso Haber-Bosch).",
    },
    {
      q: "¿Qué diferencia hay entre Kc y Kp?",
      a: "Kc usa concentraciones molares y Kp, presiones parciales (en reacciones entre gases). Se relacionan con Kp = Kc · (RT)^Δn, donde Δn es la variación de moles gaseosos entre productos y reactivos.",
    },
    {
      q: "¿Se incluyen los sólidos y el agua líquida?",
      a: "No. Los sólidos y los líquidos puros no aparecen en la expresión de Kc porque su concentración es constante. Tampoco el agua cuando actúa como disolvente en disoluciones diluidas.",
    },
  ]}
>
  <EquilibrioQuimicoTool client:load />
</CalcLayout>

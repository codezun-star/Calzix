---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import CementoMorteroTool from '@/components/tools/CementoMorteroTool';
---

<CalcLayout slug="cemento-mortero"
  answer={"Para 1 m³ de mortero 1:3 necesitas unos 350 kg de cemento (14 sacos de 25 kg), 1.050 kg de arena y 175 litros de agua. Para 1 m³ de hormigón en masa 1:2:4, unos 300 kg de cemento (12 sacos), 600 kg de arena, 1.200 kg de grava y 150 litros de agua."}
  howTo={[
    "Elige si vas a preparar mortero 1:3 o hormigón 1:2:4.",
    "Introduce el volumen de mezcla que necesitas en m³.",
    "Pulsa calcular para ver los kilos de cemento, arena, grava y agua."
  ]}
  whatIs={"La calculadora de cemento y mortero calcula la cantidad de cemento, arena, grava y agua necesarias para preparar un volumen de mortero o de hormigón en masa con las proporciones más usadas en obra."}
  whyUse={"Te ayuda a comprar en el almacén de materiales la cantidad justa de sacos para levantar un muro, hacer una solera, enfoscar una pared o colocar baldosas, sin quedarte corto ni sobrar material."}
  faqs={[
    {
      q: "¿Cuántos sacos de cemento hay en un metro cúbico?",
      a: "Depende de la dosificación. En España los sacos de cemento suelen ser de 25 kg (también los hay de 35 kg). Un mortero 1:3 lleva unos 350 kg/m³ (14 sacos de 25 kg) y un hormigón en masa 1:2:4, unos 300 kg/m³ (12 sacos).",
    },
    {
      q: "¿Para qué se usa cada mezcla?",
      a: "El mortero 1:3 sirve para enfoscados, recibir ladrillos y bloques y colocar baldosas en capa gruesa. Para levantar tabiques se usan morteros más pobres (1:4 o 1:5). El hormigón 1:2:4 sirve para soleras, aceras, bases de casetas o pequeños muretes no estructurales.",
    },
    {
      q: "¿Puedo hacer hormigón estructural con esta calculadora?",
      a: "No. El hormigón para estructuras (cimentaciones, pilares, forjados) debe cumplir el Código Estructural (Real Decreto 470/2021), que exige resistencias mínimas, control de calidad y, normalmente, hormigón fabricado en central. La calculadora sirve para trabajos no estructurales.",
    },
    {
      q: "¿Cuánta agua lleva el mortero?",
      a: "Como referencia, la mitad del peso del cemento: unos 175 litros por m³ de mortero. Demasiada agua reduce la resistencia y provoca fisuras. Añádela poco a poco hasta conseguir una masa trabajable. Si usas mortero seco predosificado en saco, sigue las instrucciones del fabricante.",
    },
    {
      q: "¿Me compensa comprar mortero preparado?",
      a: "Para trabajos pequeños, sí: el mortero seco en saco (M-5, M-7,5) solo necesita agua y garantiza una dosificación correcta. Para volúmenes grandes de hormigón, suele salir mejor pedir hormigón preparado en camión hormigonera a una planta.",
    },
    {
      q: "¿Qué cemento comprar?",
      a: "El más usado en obra doméstica es el cemento gris CEM II/B-L 32,5 N, adecuado para morteros y hormigones en masa. Para trabajos decorativos o juntas claras se usa cemento blanco. Comprueba que lleve el marcado CE.",
    },
  ]}
>
  <CementoMorteroTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HuellaCarbonTool from '@/components/tools/HuellaCarbonTool';
---

<CalcLayout slug="huella-carbono"
  answer={"La huella de carbono personal suma las emisiones del transporte, la energía de casa y la alimentación. Con 15.000 km al año en un coche de gasolina (unas 2,7 t de CO₂), dos vuelos cortos, 250 kWh de luz al mes y una dieta omnívora, una persona en España emite unas 5 toneladas de CO₂ al año, cerca de la media nacional."}
  howTo={[
    "Introduce los kilómetros que haces en coche al año y su tipo de combustible.",
    "Indica los vuelos cortos y largos que haces al año y tu consumo eléctrico mensual.",
    "Elige tu tipo de dieta y pulsa calcular para ver tu huella anual y los árboles necesarios para compensarla."
  ]}
  whatIs={"La calculadora de huella de carbono personal estima las toneladas de CO₂ equivalente que generas al año por el coche, los vuelos, el consumo eléctrico del hogar (con el factor de emisión de la red española) y la dieta, y cuántos árboles harían falta para compensarlas."}
  whyUse={"Te ayuda a saber qué hábitos tienen más impacto, comparar tu huella con la media española y europea y priorizar cambios: menos coche y avión, energía renovable o una dieta con menos carne roja."}
  faqs={[
    {
      q: "¿Cuál es la huella de carbono media de un español?",
      a: "Las emisiones de gases de efecto invernadero de España rondan los 270 millones de toneladas de CO₂ equivalente al año, unas 5,5 toneladas por habitante, por debajo de la media de la UE (unas 7). Si se cuentan las emisiones de los productos importados que consumimos, la huella real por persona es algo mayor. Para cumplir el Acuerdo de París, la huella debería bajar a unas 2 toneladas por persona en 2050.",
    },
    {
      q: "¿Qué parte de la huella corresponde al transporte?",
      a: "En la mayoría de españoles, el transporte es la partida principal. Un coche de gasolina que gasta 6-7 l/100 km emite unos 150-180 g de CO₂ por km: 15.000 km al año suponen unas 2,5-2,7 toneladas. Un vuelo de ida y vuelta Madrid-Nueva York añade alrededor de 1,5-2 toneladas por pasajero, contando el efecto de las emisiones en altura.",
    },
    {
      q: "¿Cuánto CO₂ emite la luz en España?",
      a: "Gracias al peso de las renovables, la electricidad española es de las menos intensivas en carbono de Europa: en 2024 y 2025 la generación emitió alrededor de 0,10-0,13 kg de CO₂ por kWh. Un hogar que consume 3.000 kWh al año genera unos 360 kg de CO₂ por la luz. Si tienes calefacción de gas o gasóleo, su peso en la huella es mucho mayor.",
    },
    {
      q: "¿Cómo influye la dieta en la huella de carbono?",
      a: "Una dieta con mucha carne roja puede suponer más de 2,5 toneladas de CO₂ equivalente al año, mientras que una vegetariana ronda 1,2 y una vegana, menos de 1. Reducir la carne de vacuno y cordero, priorizar alimentos de temporada y de proximidad y no desperdiciar comida son las medidas más eficaces.",
    },
    {
      q: "¿Cómo reducir mi huella de carbono?",
      a: "Las medidas con más impacto: usar transporte público, bici o coche compartido; sustituir vuelos cortos por tren de alta velocidad; electrificar la calefacción con bomba de calor; contratar electricidad renovable o poner placas solares; mejorar el aislamiento de casa; y reducir la carne roja. Compensar las emisiones restantes con proyectos certificados es el último paso, no el primero.",
    },
    {
      q: "¿Qué es el registro de huella de carbono del MITECO?",
      a: "Es un registro voluntario del Ministerio para la Transición Ecológica en el que empresas y administraciones inscriben el cálculo de su huella, sus planes de reducción y sus compensaciones en proyectos de absorción forestal en España. Algunas empresas están obligadas a calcular y publicar su huella por la Ley 7/2021 de cambio climático.",
    },
  ]}
>
  <HuellaCarbonTool client:load />
</CalcLayout>

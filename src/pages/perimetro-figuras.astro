---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PerimetroFigurasTool from '@/components/tools/PerimetroFigurasTool';
---

<CalcLayout slug="perimetro-figuras"
  answer={"El perímetro es la suma de los lados: cuadrado, 4 × lado; rectángulo, 2 × (largo + ancho); triángulo, suma de sus tres lados; y circunferencia, 2 × π × radio. Una parcela rectangular de 25 × 18 m tiene 86 m de perímetro, los metros de valla que necesitas."}
  howTo={[
    "Elige la figura: círculo, cuadrado, rectángulo, triángulo, rombo o polígono regular.",
    "Introduce las medidas de sus lados o su radio.",
    "Pulsa calcular para obtener el perímetro."
  ]}
  whatIs={"La calculadora de perímetros calcula la longitud del contorno de las figuras planas más comunes, incluidos el círculo (longitud de la circunferencia) y los polígonos regulares."}
  whyUse={"Sirve para los ejercicios de geometría de Primaria y la ESO y para calcular los metros de valla de una parcela, de rodapié de una habitación, de cenefa o de tira LED."}
  faqs={[
    {
      q: "¿Cómo se calcula la longitud de una circunferencia?",
      a: "Con L = 2 × π × r o π × d. Una rueda de bicicleta de 70 cm de diámetro recorre 3,1416 × 0,7 = 2,2 m en cada vuelta.",
    },
    {
      q: "¿Cómo calculo los metros de rodapié de una habitación?",
      a: "Calcula el perímetro de la habitación y resta el ancho de las puertas. Una habitación de 4 × 3 m tiene 14 m de perímetro; con una puerta de 0,8 m, necesitas unos 13,2 m de rodapié, más un 10 % para cortes en las esquinas.",
    },
    {
      q: "¿Cómo se calcula el perímetro de un polígono regular?",
      a: "Multiplica el número de lados por la longitud de cada lado: un hexágono regular de 10 cm de lado tiene 60 cm de perímetro. Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Cuántos metros de valla necesito para mi parcela?",
      a: "Mide cada lindero y súmalos, restando el ancho de la puerta de acceso. Recuerda que los cerramientos de parcelas suelen requerir licencia o declaración responsable municipal, y las normas urbanísticas fijan su altura y materiales.",
    },
    {
      q: "¿Qué es el número π?",
      a: "Es la relación entre la longitud de una circunferencia y su diámetro, aproximadamente 3,14159. Es un número irracional: tiene infinitas cifras decimales sin periodo. El 14 de marzo (3/14) se celebra el Día de Pi.",
    },
  ]}
>
  <PerimetroFigurasTool client:load />
</CalcLayout>

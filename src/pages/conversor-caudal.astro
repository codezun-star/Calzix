---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvCaudalTool from '@/components/tools/ConvCaudalTool';
---

<CalcLayout slug="conversor-caudal"
  answer={"Para convertir caudales: 1 L/s = 60 L/min = 3,6 m³/h, y 1 m³/s = 1.000 L/s. Una ducha de 10 L/min equivale a 0,6 m³/h, y 1 galón estadounidense por minuto son 3,785 L/min."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 10 L/min o 3 m³/h).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de caudal convierte entre metros cúbicos por segundo, litros por segundo, metros cúbicos por hora, litros por minuto, galones estadounidenses por minuto y pies cúbicos por segundo."}
  whyUse={"Sirve para elegir una bomba de agua, un grifo o una alcachofa de ducha eficiente, dimensionar el riego del jardín o una piscina e interpretar el caudal de los ríos y embalses."}
  faqs={[
    {
      q: "¿Qué caudal tiene un grifo o una ducha?",
      a: "Un grifo de lavabo convencional da entre 8 y 12 L/min y uno con aireador, entre 4 y 6 L/min. Una ducha convencional da entre 12 y 20 L/min, y una alcachofa de bajo consumo, entre 6 y 9 L/min. El Código Técnico de la Edificación fija caudales mínimos de 0,10 L/s (6 L/min) en lavabos y 0,20 L/s (12 L/min) en duchas.",
    },
    {
      q: "¿Cómo mido el caudal de mi grifo?",
      a: "Llena un recipiente de volumen conocido (por ejemplo, un cubo de 10 litros) y cronometra el tiempo. Caudal = litros ÷ minutos: si tarda 30 segundos, el caudal es de 20 L/min.",
    },
    {
      q: "¿Qué caudal necesita la depuradora de una piscina?",
      a: "Como referencia, todo el volumen de una piscina privada debe pasar por el filtro al menos una vez cada 6-8 horas de funcionamiento. Una piscina de 50 m³ necesita una bomba de unos 6-8 m³/h, más en verano y con mucho uso.",
    },
    {
      q: "¿Cómo se mide el caudal de los ríos?",
      a: "En metros cúbicos por segundo (m³/s). Las confederaciones hidrográficas publican en tiempo real los caudales de los ríos y el nivel de los embalses en sus sistemas automáticos de información hidrológica (SAIH).",
    },
    {
      q: "¿Qué es un hectómetro cúbico?",
      a: "Es un millón de metros cúbicos (1 hm³ = 10⁹ litros). Es la unidad con la que se expresa la capacidad de los embalses españoles y la reserva hídrica que publica semanalmente el Ministerio para la Transición Ecológica.",
    },
  ]}
>
  <ConvCaudalTool client:load />
</CalcLayout>

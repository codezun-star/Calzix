---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import HomeCalcs from '@/components/ui/HomeCalcs';
import { PAGE_SEO, SITE } from '@/lib/constants/seo';
import { CALCS, CALC_GROUPS } from '@/lib/constants/calcs';
import '@/styles/global.css';
import AppHead from '@/components/layout/AppHead.astro';
import { jsonLd } from '@/lib/utils/jsonld';
import AdSlot from '@/components/ads/AdSlot.astro';
import AdNative from '@/components/ads/AdNative.astro';
import Icon from '@/components/ui/Icon.astro';

const seo = PAGE_SEO.home;

// Rejilla de categorías tipo "pantalla de inicio" (solo móvil)
const groupTiles = CALC_GROUPS.map((g) => {
  const ids = new Set(g.domains.map((d) => d.id));
  return {
    id: g.id,
    slug: g.slug,
    label: g.label,
    count: CALCS.filter((c) => ids.has(c.domain)).length,
  };
});

const homeGraph = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      email: SITE.email,
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'customer support',
        availableLanguage: 'Spanish',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      inLanguage: 'es',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/#webpage`,
      url: SITE.url,
      name: seo.title,
      description: seo.description,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE.url}/#website` },
      dateModified: SITE.dateModified,
      datePublished: SITE.datePublished,
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.aeo-answer'] },
      mainEntity: { '@id': `${SITE.url}/#catalogo` },
    },
    {
      '@type': 'WebApplication',
      '@id': `${SITE.url}/#app`,
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      inLanguage: 'es',
      isAccessibleForFree: true,
      publisher: { '@id': `${SITE.url}/#organization` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE.url}/#catalogo`,
      name: `Categorías de calculadoras de ${SITE.name}`,
      description: `${CALCS.length} calculadoras gratuitas agrupadas en ${CALC_GROUPS.length} categorías.`,
      numberOfItems: CALC_GROUPS.length,
      itemListElement: CALC_GROUPS.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: g.label,
        description: g.description,
        url: `${SITE.url}/${g.slug}`,
      })),
    },
  ],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <AppHead />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={`${SITE.url}/llms.txt`} title="Índice para motores de respuesta (llms.txt)" />

    <!-- Indexación: permite fragmentos completos en resultados y respuestas generadas -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={SITE.name} />

    <!-- OpenGraph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={seo.canonical} />
    <meta property="og:title"       content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:site_name"   content={SITE.name} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:image"        content={SITE.ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={`${SITE.name} — calculadoras online gratuitas`} />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image"       content={SITE.ogImage} />
    <meta name="twitter:image:alt"   content={`${SITE.name} — calculadoras online gratuitas`} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={homeGraph} />
  </head>

  <body>
    <Header />

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #0A1E14 0%, #0D2B1A 60%, #0F3820 100%);">
        <div class="absolute bottom-0 left-0 right-0 h-24" style="background: linear-gradient(to bottom, transparent, var(--color-bg))"></div>

        <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-7 pb-10 sm:py-28">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/15 border border-white/25 text-white text-xs sm:text-sm font-medium mb-4 sm:mb-6">
                100% gratis · Sin registro · Sin límites
              </div>
              <h1 class="text-[2rem] sm:text-5xl font-extrabold text-white leading-[1.1] tracking-tight">
                Calculadoras<br />
                <span style="color: #6EE09A;">online gratuitas</span>
              </h1>
              <p class="aeo-answer mt-3 sm:mt-5 text-base sm:text-lg text-white/80 leading-relaxed max-w-lg">
                {CALCS.length} calculadoras gratuitas de matemáticas, ciencias, conversión de unidades, hogar, trabajo, educación, viaje, naturaleza y ocio. Resultados al instante, sin registro y con el cálculo hecho en tu propio navegador.
              </p>
              <!-- Buscador (abre la hoja de búsqueda) -->
              <button
                type="button"
                data-app-open="search"
                aria-haspopup="dialog"
                class="app-press mt-6 sm:mt-8 flex w-full max-w-lg items-center gap-3 rounded-2xl bg-white px-4 h-[3.25rem] text-left shadow-lg cursor-pointer"
              >
                <Icon name="search" size={20} strokeWidth={2.25} class="text-[var(--color-accent)]" />
                <span class="flex-1 truncate text-[var(--color-text-muted)]">Buscar entre {CALCS.length} calculadoras</span>
                <kbd class="hidden xl:inline-flex items-center rounded-md border border-[var(--color-border)] px-1.5 py-0.5 text-xs font-sans text-[var(--color-text-muted)]">Ctrl K</kbd>
              </button>

              <div class="mt-6 hidden sm:flex flex-wrap gap-3">
                <a href="#matematicas" class="px-6 py-3 rounded-xl font-semibold text-white transition-colors shadow-lg" style="background: var(--color-accent);">
                  Ver calculadoras
                </a>
                <a href="/calculadora-hipoteca" class="px-6 py-3 rounded-xl border border-white/30 font-semibold text-white hover:bg-white/10 transition-colors">
                  Calculadora de hipoteca
                </a>
              </div>
            </div>

            <div class="hidden lg:flex items-center justify-center">
              <div class="relative w-full max-w-sm">
                <div class="absolute inset-0 bg-white/10 rounded-3xl rotate-3 border border-white/20"></div>
                <div class="relative bg-white rounded-2xl border border-white/50 p-6 shadow-2xl">
                  <div class="flex items-center gap-2 mb-4">
                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-400"></div>
                    <span class="ml-2 text-xs text-[var(--color-text-muted)] font-mono">calzix.com</span>
                  </div>
                  <div class="space-y-2">
                    {[
                      { label: 'Hipoteca 200.000 €', sub: 'Cuota: 891 €/mes' },
                      { label: 'IVA 21% sobre 500 €', sub: 'Total: 605,00 €' },
                      { label: 'IMC — 70 kg / 1,75 m', sub: 'IMC: 22,9 — Normal' },
                    ].map(item => (
                      <div class="flex items-center gap-3 p-2.5 bg-[var(--color-calcs-bg)] rounded-lg">
                        <div>
                          <p class="text-xs font-medium text-[var(--color-text)]">{item.label}</p>
                          <p class="text-xs text-[var(--color-text-secondary)]">{item.sub}</p>
                        </div>
                        <div class="ml-auto w-2 h-2 rounded-full bg-green-400"></div>
                      </div>
                    ))}
                  </div>
                  <div class="mt-4 p-2.5 rounded-lg border text-center" style="background: var(--color-accent-bg); border-color: var(--color-calcs-border);">
                    <p class="text-xs font-medium" style="color: var(--color-accent);">Cálculos al instante, sin registro</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Trust bar -->
      <div class="hidden sm:block border-y border-[var(--color-border)] bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
          <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-sm font-medium text-[var(--color-text-secondary)]">
            <span>Sin registro</span>
            <span>Resultados al instante</span>
            <span>Gratis para siempre</span>
          </div>
        </div>
      </div>

      <!-- Recientes: las rellena src/scripts/app-shell.ts desde localStorage -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-5 sm:pt-8" data-recent-section="chips" hidden>
        <h2 class="app-sheet-heading mx-0 mt-0"><Icon name="history" size={14} strokeWidth={2.25} /> Seguir calculando</h2>
        <ul class="app-chips" data-recent-list></ul>
      </section>

      <!-- Categorías tipo pantalla de inicio (móvil) -->
      <nav class="sm:hidden max-w-6xl mx-auto px-4 pt-5" aria-label="Categorías">
        <h2 class="app-sheet-heading mx-0 mt-0">Categorías</h2>
        <ul class="grid grid-cols-3 gap-2">
          {groupTiles.map((g) => (
            <li>
              <a href={`/${g.slug}`} class="app-tile app-press bg-white border-[var(--color-calcs-border)]">
                <span class="app-tile-icon bg-[var(--color-calcs-bg)] shadow-none"><Icon name={`g-${g.id}`} size={22} strokeWidth={1.8} /></span>
                <span class="app-tile-label">{g.label}</span>
                <span class="app-tile-count">{g.count} calculadoras</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Anuncio sobre el catálogo de calculadoras -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8">
        <AdSlot placement="horizontal" />
      </div>

      <!-- Calculadoras con tabs -->
      <div id="calculadoras">
        <HomeCalcs client:load />
      </div>

      <!-- Anuncio nativo tras el catálogo -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-12">
        <AdNative />
      </div>

      <!-- CTA bottom -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20 text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text)]">Todo gratis, para siempre</h2>
        <p class="mt-3 text-[var(--color-text-secondary)] max-w-md mx-auto">
          Sin descargas, sin registro. Resultados al instante directamente en tu navegador.
        </p>
        <a href="/calculadora-hipoteca" class="inline-flex items-center gap-2 mt-8 px-8 py-3.5 rounded-xl text-white font-semibold transition-colors" style="background: var(--color-accent);">
          Empezar a calcular
        </a>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const GROUPS = ['matematicas','ciencias','conversion','hogar','trabajo','educacion','viaje','naturaleza','ocio'];

      function scrollToCalcs() {
        const hash = location.hash.slice(1);
        if (GROUPS.includes(hash)) {
          const el = document.getElementById('calculadoras');
          if (el) {
            const top = el.getBoundingClientRect().top + window.scrollY - 80;
            window.scrollTo({ top, behavior: 'smooth' });
          }
        }
      }

      window.addEventListener('hashchange', scrollToCalcs);

      if (GROUPS.includes(location.hash.slice(1))) {
        window.addEventListener('load', () => setTimeout(scrollToCalcs, 120));
      }
    </script>
  </body>
</html>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorRitmoVelocidadTool from '@/components/tools/ConversorRitmoVelocidadTool';
---

<CalcLayout slug="conversor-ritmo-velocidad"
  answer={"Para pasar de ritmo (minutos por km) a velocidad divide 60 entre el ritmo en minutos: 5:00 min/km son 12 km/h y 4:30 min/km, 13,3 km/h. Un maratón a 5:00 min/km se termina en 3 horas y 31 minutos."}
  howTo={[
    "Elige si quieres pasar de ritmo a velocidad o al revés.",
    "Introduce los minutos y segundos por kilómetro, o la velocidad en km/h.",
    "Pulsa convertir para ver el resultado."
  ]}
  whatIs={"El conversor de ritmo y velocidad convierte el ritmo de carrera en minutos por kilómetro a velocidad en km/h, y viceversa."}
  whyUse={"Te ayuda a planificar entrenamientos, configurar la cinta de correr del gimnasio (que va en km/h) y fijar el ritmo objetivo para tu próxima carrera popular."}
  faqs={[
    {
      q: "¿Qué ritmo es bueno para correr?",
      a: "Depende del nivel: un corredor popular que empieza suele correr a 6:00-7:00 min/km; uno con experiencia, a 4:30-5:30 min/km; los atletas de élite corren el maratón por debajo de 3:00 min/km.",
    },
    {
      q: "¿Cuánto se tarda en correr un maratón?",
      a: "Con un ritmo de 5:00 min/km, unas 3 horas y 31 minutos; a 6:00 min/km, unas 4 horas y 13 minutos. Los maratones de Valencia, Sevilla y Madrid son de los más populares en España; el de Valencia es uno de los más rápidos del mundo.",
    },
    {
      q: "¿Cómo configuro la cinta de correr?",
      a: "Las cintas usan km/h: para correr a 6:00 min/km, ponla a 10 km/h; a 5:00 min/km, a 12 km/h. Una inclinación del 1 % compensa la falta de resistencia del aire.",
    },
    {
      q: "¿Qué es el ritmo por kilómetro?",
      a: "El tiempo que tardas en recorrer un kilómetro. Los corredores lo prefieren a la velocidad porque es más fácil de controlar con un reloj durante la carrera.",
    },
    {
      q: "¿Cómo calculo el ritmo de una carrera?",
      a: "Divide el tiempo total entre la distancia: 10 km en 55 minutos son 5:30 min/km.",
    },
  ]}
>
  <ConversorRitmoVelocidadTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HuellaHidricaTool from '@/components/tools/HuellaHidricaTool';
---

<CalcLayout slug="huella-hidrica"
  answer={"La huella hídrica de un alimento es el agua necesaria para producirlo: 1 kg de carne de vacuno requiere unos 15.400 litros, 1 kg de pollo unos 4.300, 1 kg de arroz unos 2.500 y 1 kg de patatas unos 290, según los datos de referencia de la Water Footprint Network."}
  howTo={[
    "Elige el alimento.",
    "Introduce la cantidad en kilos.",
    "Pulsa calcular para ver los litros de agua necesarios para producirlo."
  ]}
  whatIs={"La calculadora de huella hídrica de los alimentos calcula los litros de agua que se necesitan para producir una cantidad de un alimento, incluida el agua de lluvia, de riego y la necesaria para depurar la contaminación."}
  whyUse={"Te ayuda a entender el agua «oculta» en lo que comes, comparar alimentos y tomar decisiones de consumo más sostenibles en un país con escasez de agua como España."}
  faqs={[
    {
      q: "¿Qué es la huella hídrica?",
      a: "Es el volumen total de agua dulce usado para producir un bien: el agua de lluvia que usan los cultivos (verde), el agua de riego (azul) y el agua necesaria para diluir la contaminación (gris). El concepto lo desarrolló Arjen Hoekstra y la Water Footprint Network.",
    },
    {
      q: "¿Por qué la carne tiene tanta huella hídrica?",
      a: "Porque incluye el agua necesaria para producir el pienso y el forraje que consume el animal durante toda su vida, además del agua que bebe. Por eso los alimentos de origen vegetal suelen tener una huella mucho menor.",
    },
    {
      q: "¿Cuánta agua usa la agricultura en España?",
      a: "El regadío es con diferencia el mayor consumidor de agua en España, en torno a tres cuartas partes de los usos consuntivos. Productos como las frutas y hortalizas que España exporta llevan consigo una gran cantidad de agua virtual.",
    },
    {
      q: "¿Es lo mismo huella hídrica que consumo de agua en casa?",
      a: "No. En casa consumimos unos 128 litros por persona y día según el INE, pero la huella hídrica total de una persona, contando la alimentación y los productos que consume, es muchas veces mayor.",
    },
    {
      q: "¿Cómo reducir mi huella hídrica?",
      a: "Reducir el desperdicio de alimentos, moderar el consumo de carne, elegir productos de temporada y de proximidad, y ahorrar agua en casa. Tirar comida es también tirar el agua que se usó para producirla.",
    },
  ]}
>
  <HuellaHidricaTool client:load />
</CalcLayout>

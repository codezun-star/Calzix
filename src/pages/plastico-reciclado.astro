---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PlasticoRecicladoTool from '@/components/tools/PlasticoRecicladoTool';
---

<CalcLayout slug="plastico-reciclado"
  answer={"Reciclar 1 kg de botellas de PET ahorra unos 0,6 kg de petróleo, unos 1,5 kg de CO₂ y alrededor de 30 kWh de energía frente a fabricar plástico nuevo. En España, los envases de plástico se depositan en el contenedor amarillo junto con las latas y los briks."}
  howTo={[
    "Elige el tipo de plástico: PET, PEAD, PVC, PEBD, PP o PS.",
    "Introduce los kilos que reciclas.",
    "Pulsa calcular para ver el petróleo, el CO₂ y la energía ahorrados."
  ]}
  whatIs={"La calculadora de reciclaje de plástico estima el petróleo, la energía y el CO₂ que se ahorran al reciclar envases de plástico según su tipo (PET, PEAD, PVC, PEBD, PP o PS) en lugar de fabricar plástico virgen."}
  whyUse={"Sirve para concienciar sobre el reciclaje de envases, para actividades educativas y para medir el impacto de campañas de recogida en colegios, empresas o comunidades de vecinos."}
  faqs={[
    {
      q: "¿Qué plásticos van al contenedor amarillo?",
      a: "Solo los envases: botellas de agua y refrescos, envases de yogur, bandejas de corcho blanco, film de envolver, bolsas de plástico, tarrinas, botes de champú y detergente, junto con latas, briks y tapas. Los objetos de plástico que no son envases (juguetes, cubos, perchas, utensilios de cocina) van al punto limpio o al contenedor de resto.",
    },
    {
      q: "¿Qué significan los números del triángulo de reciclaje?",
      a: "1, PET (botellas de bebidas); 2, PEAD o HDPE (garrafas, botes de detergente); 3, PVC (algunos envases y tuberías); 4, PEBD o LDPE (bolsas, film); 5, PP (tapones, tarrinas, envases de comida); 6, PS (bandejas de corcho blanco, vasos); 7, otros. El PET y el PEAD son los que más y mejor se reciclan.",
    },
    {
      q: "¿Cuánto plástico se recicla en España?",
      a: "La recogida separada de botellas de plástico de bebidas se quedó en el 41 % en 2023, frente al 70 % que exigía la ley, lo que activa la obligación de implantar un sistema de depósito, devolución y retorno (SDDR) para botellas, latas y briks. El reciclaje del resto de envases de plástico es menor que el del papel, el vidrio o el metal.",
    },
    {
      q: "¿Qué normas limitan el plástico de un solo uso en España?",
      a: "La Ley 7/2022 de residuos prohíbe desde 2021-2022 productos como pajitas, cubiertos, platos y bastoncillos de plástico de un solo uso, obliga a cobrar las bolsas de plástico, exige que las botellas de bebida incorporen plástico reciclado (25 % desde 2025 y 30 % en 2030) y creó un impuesto especial sobre los envases de plástico no reutilizables.",
    },
    {
      q: "¿Hay que lavar los envases antes de reciclarlos?",
      a: "No es necesario lavarlos: basta con vaciarlos bien. Lavarlos gasta agua sin mejorar significativamente el reciclaje. Sí conviene aplastar las botellas para ocupar menos espacio y no meter unos envases dentro de otros, para que las plantas de selección puedan separarlos.",
    },
    {
      q: "¿Qué es mejor que reciclar el plástico?",
      a: "Reducir y reutilizar: usar botella reutilizable y agua del grifo, bolsas de tela, recipientes propios en la compra a granel y envases retornables cuando existan. El reciclaje es el último recurso dentro de la jerarquía de residuos de la Ley 7/2022.",
    },
  ]}
>
  <PlasticoRecicladoTool client:load />
</CalcLayout>

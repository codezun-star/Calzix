---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DescuentoSucesivoTool from '@/components/tools/DescuentoSucesivoTool';
---

<CalcLayout slug="descuento-sucesivo"
  answer={"Los descuentos sucesivos no se suman: un 20 % y después un 10 % sobre 100 € dejan el precio en 72 €, un descuento total del 28 %, no del 30 %. El descuento equivalente es 1 − (1 − d₁) × (1 − d₂)."}
  howTo={[
    "Introduce el precio original.",
    "Escribe el primer, el segundo y, si lo hay, el tercer descuento.",
    "Pulsa calcular para ver el precio final y el descuento real equivalente."
  ]}
  whatIs={"La calculadora de descuentos sucesivos aplica hasta tres descuentos encadenados sobre un precio y calcula el precio final y el porcentaje de descuento total equivalente."}
  whyUse={"Te ayuda a no dejarte engañar por las segundas rebajas («50 % + 20 % adicional») y los cupones, y a calcular precios con descuentos comerciales en cadena en tu negocio."}
  faqs={[
    {
      q: "¿Por qué un 20 % más un 10 % no es un 30 %?",
      a: "Porque el segundo descuento se aplica sobre el precio ya rebajado: 100 € − 20 % = 80 €, y 80 € − 10 % = 72 €. El descuento total es del 28 %.",
    },
    {
      q: "¿Importa el orden de los descuentos?",
      a: "No. Aplicar primero el 10 % y después el 20 % da el mismo resultado: 100 × 0,9 × 0,8 = 72 €. Lo que importa es si el segundo descuento se calcula sobre el precio original o sobre el rebajado.",
    },
    {
      q: "¿Cuánto es un 50 % más un 20 %?",
      a: "Un 60 % en total: 100 € pasan a 50 € y luego a 40 €. Es una de las combinaciones más habituales en las segundas rebajas de enero y julio.",
    },
    {
      q: "¿Qué dice la ley sobre los precios rebajados?",
      a: "En España, el precio anterior que se anuncia en una rebaja debe ser el más bajo que haya tenido el producto en los 30 días previos, según la Ley de Ordenación del Comercio Minorista. Los productos rebajados tienen la misma garantía que los demás.",
    },
    {
      q: "¿Se usan descuentos en cadena entre empresas?",
      a: "Sí: es habitual encadenar un descuento comercial, uno por volumen y otro por pronto pago. Calcula el equivalente para conocer el precio neto y el margen real. El IVA se aplica sobre el precio final ya descontado.",
    },
  ]}
>
  <DescuentoSucesivoTool client:load />
</CalcLayout>

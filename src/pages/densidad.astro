---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DensidadTool from '@/components/tools/DensidadTool';
---

<CalcLayout slug="densidad"
  answer={"La densidad es la masa dividida entre el volumen: ρ = m / V. Un objeto de 2 kg que ocupa 0,5 m³ tiene una densidad de 4 kg/m³. El agua tiene 1.000 kg/m³ (1 g/cm³), el aceite de oliva unos 920 y el hierro unos 7.870."}
  howTo={[
    "Elige qué quieres calcular: densidad, volumen o masa.",
    "Introduce los otros dos datos en unidades del Sistema Internacional.",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de densidad calcula la densidad, el volumen o la masa de un cuerpo con la relación ρ = m / V."}
  whyUse={"Sirve para los problemas de Física y Química de 2.º y 3.º de ESO, para saber si un objeto flota y para pasar de litros a kilos en la cocina o el taller."}
  faqs={[
    {
      q: "¿Cómo se calcula la densidad?",
      a: "Dividiendo la masa entre el volumen: ρ = m / V. En el Sistema Internacional se mide en kg/m³, aunque en el laboratorio se usa mucho g/cm³ (1 g/cm³ = 1.000 kg/m³). Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Por qué unos objetos flotan y otros no?",
      a: "Un objeto flota si su densidad media es menor que la del líquido. El hielo (917 kg/m³) flota en el agua; el hierro (7.870 kg/m³) se hunde, pero un barco de hierro flota porque su densidad media, con el aire del interior, es menor que la del agua.",
    },
    {
      q: "¿Cómo mido la densidad de un objeto irregular?",
      a: "Pésalo para obtener la masa y sumérgelo en una probeta con agua: el aumento de volumen es su volumen (principio de Arquímedes). Después divide la masa entre ese volumen.",
    },
    {
      q: "¿Qué densidad tienen los líquidos habituales?",
      a: "Agua, 1.000 kg/m³; agua de mar, unos 1.025; leche, unos 1.030; aceite de oliva, unos 920; gasolina, unos 740; gasóleo, unos 840; alcohol etílico, 789.",
    },
    {
      q: "¿Para qué sirve en la vida diaria?",
      a: "Para pasar de litros a kilos: 5 litros de aceite de oliva pesan unos 4,6 kg. También para calcular el peso de una carga de arena, grava u hormigón a partir de su volumen.",
    },
  ]}
>
  <DensidadTool client:load />
</CalcLayout>

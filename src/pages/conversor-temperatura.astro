---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvTemperaturaTool from '@/components/tools/ConvTemperaturaTool';
---

<CalcLayout slug="conversor-temperatura"
  answer={"Para pasar de grados Celsius a Fahrenheit multiplica por 1,8 y suma 32; para pasar a kelvin suma 273,15. Así, 180 °C de horno son 356 °F, 37 °C de temperatura corporal son 98,6 °F y 0 °C son 273,15 K."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 180 °C o 75 °F).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de temperatura convierte entre grados Celsius, Fahrenheit y kelvin con las fórmulas exactas, para el día a día, la cocina y la ciencia."}
  whyUse={"Sirve para seguir recetas americanas con el horno en °F, entender el parte meteorológico de Estados Unidos, configurar aparatos importados o hacer los ejercicios de física y química de la ESO y el Bachillerato."}
  faqs={[
    {
      q: "¿Cómo se pasa de Fahrenheit a Celsius?",
      a: "Resta 32 y divide entre 1,8: (°F − 32) / 1,8. Por ejemplo, 75 °F = (75 − 32) / 1,8 = 23,9 °C. Un truco aproximado: resta 30 y divide entre 2 (75 °F → 22,5 °C).",
    },
    {
      q: "¿A cuántos grados Fahrenheit pongo el horno?",
      a: "Las temperaturas más habituales son: 150 °C = 302 °F, 160 °C = 320 °F, 180 °C = 356 °F (las recetas americanas suelen usar 350 °F), 200 °C = 392 °F (400 °F) y 220 °C = 428 °F (425 °F).",
    },
    {
      q: "¿Cuál es la temperatura más alta registrada en España?",
      a: "El récord oficial de la AEMET es de 47,6 °C, registrado en La Rambla (Córdoba) el 14 de agosto de 2021, lo que equivale a 117,7 °F. Las temperaturas más bajas se registran en zonas de montaña y en el páramo de Castilla y León y Aragón.",
    },
    {
      q: "¿A partir de qué temperatura se considera fiebre?",
      a: "En general se habla de febrícula entre 37 y 37,9 °C y de fiebre a partir de 38 °C, medida en la axila (100,4 °F). Si la fiebre es muy alta o dura varios días, consulta al médico o llama al 112 en caso de urgencia.",
    },
    {
      q: "¿Qué es el kelvin?",
      a: "Es la unidad de temperatura del Sistema Internacional. Empieza en el cero absoluto (−273,15 °C), la temperatura más baja posible. Un aumento de 1 K equivale a un aumento de 1 °C. Se usa en física, química y en la temperatura de color de las bombillas (por ejemplo, 2.700 K es luz cálida).",
    },
  ]}
>
  <ConvTemperaturaTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import AhorroAguaGrifoTool from '@/components/tools/AhorroAguaGrifoTool';
---

<CalcLayout slug="ahorro-agua-grifo"
  answer={"Un aireador reduce el caudal del grifo sin perder sensación de presión: pasar de 8 a 5 litros por minuto con 10 minutos de uso al día y 2 personas ahorra 21.900 litros al año, unos 42 € con el agua a 1,92 €/m³, la media en España."}
  howTo={[
    "Introduce el caudal actual del grifo y el caudal con aireador.",
    "Indica los minutos de uso al día y las personas del hogar.",
    "Escribe el precio del agua por m³ y pulsa calcular para ver el ahorro anual."
  ]}
  whatIs={"La calculadora de ahorro de agua en el grifo compara el consumo de un grifo convencional con el de un grifo con aireador o perlizador y calcula el ahorro anual en litros y en euros."}
  whyUse={"Te ayuda a decidir si te compensa instalar aireadores (cuestan unos pocos euros), reducir tu factura del agua y contribuir al ahorro en un país con sequías frecuentes."}
  faqs={[
    {
      q: "¿Qué es un aireador?",
      a: "Es una pieza que se enrosca en la boca del grifo y mezcla aire con el agua, de modo que sale menos agua con la misma sensación de chorro. Reduce el caudal de 10-12 litros por minuto a 5-6, o menos en los modelos más eficientes.",
    },
    {
      q: "¿Cuánta agua se gasta en España por persona?",
      a: "Según el INE, el consumo doméstico medio es de unos 128 litros por habitante y día. El precio medio del agua, incluido el saneamiento, ronda los 1,92 €/m³, aunque varía mucho entre municipios.",
    },
    {
      q: "¿Cómo mido el caudal de mi grifo?",
      a: "Llena una jarra de 1 litro y cronometra el tiempo: si tarda 6 segundos, el caudal es de 10 litros por minuto. Repite la medición con el grifo abierto como lo usas normalmente.",
    },
    {
      q: "¿Qué otros cambios ahorran agua?",
      a: "Alcachofas de ducha de bajo consumo, cisternas de doble descarga, cerrar el grifo al lavarse los dientes, poner la lavadora y el lavavajillas llenos y reparar las fugas. Una cisterna que pierde agua puede desperdiciar más de 100 litros al día.",
    },
    {
      q: "¿Hay restricciones de agua en España?",
      a: "En episodios de sequía, las administraciones pueden fijar límites de consumo por habitante, prohibir el riego de jardines o el llenado de piscinas y reducir la presión. Consulta el estado de los embalses de tu cuenca en la confederación hidrográfica correspondiente.",
    },
  ]}
>
  <AhorroAguaGrifoTool client:load />
</CalcLayout>

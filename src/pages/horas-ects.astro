---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import HorasEctsTool from '@/components/tools/HorasEctsTool';
---

<CalcLayout slug="horas-ects"
  answer={"Las horas de una asignatura son sus créditos ECTS por las horas de cada crédito (entre 25 y 30): una asignatura de 6 ECTS a 27 horas por crédito supone 162 horas de trabajo, unas 10,8 horas semanales en un cuatrimestre de 15 semanas."}
  howTo={[
    "Introduce los créditos ECTS de la asignatura o del curso.",
    "Ajusta las horas por crédito que fija tu universidad (entre 25 y 30).",
    "Indica las semanas del periodo y pulsa calcular para ver las horas totales y semanales."
  ]}
  whatIs={"La calculadora de horas ECTS convierte los créditos europeos de una asignatura, un curso o un máster en horas totales de trabajo y en horas semanales de dedicación."}
  whyUse={"Te ayuda a organizar el cuatrimestre, decidir de cuántas asignaturas matricularte si trabajas y comprobar si tu carga de estudio es realista."}
  faqs={[
    {
      q: "¿Cuántas horas tiene un crédito ECTS?",
      a: "En las universidades españolas, cada crédito ECTS equivale a entre 25 y 30 horas de trabajo del estudiante (Real Decreto 1125/2003), incluidas clases, prácticas, tutorías, trabajos y estudio personal. Un curso completo son 60 ECTS y un grado, normalmente, 240. Cada universidad fija en sus guías docentes el número exacto, normalmente 25.",
    },
    {
      q: "¿Cuántas horas de clase tiene una asignatura de 6 ECTS?",
      a: "Entre 150 y 180 horas de trabajo en total, de las que suelen ser presenciales entre el 30 % y el 40 % (unas 45-60 horas de clase). El resto es trabajo autónomo: estudio, prácticas, trabajos y preparación de exámenes.",
    },
    {
      q: "¿Cuántos créditos me puedo matricular trabajando?",
      a: "Un curso completo (60 ECTS) supone una dedicación equivalente a una jornada completa. Si trabajas, muchas universidades permiten la matrícula a tiempo parcial (normalmente entre 24 y 36 ECTS al año). Calcula las horas semanales para decidir.",
    },
    {
      q: "¿Cuántos ECTS tiene un máster?",
      a: "Entre 60 y 120 ECTS, es decir, uno o dos cursos. Los másteres habilitantes, como el de profesorado de secundaria, tienen 60 ECTS.",
    },
    {
      q: "¿Para qué sirven los créditos ECTS?",
      a: "Son el sistema común del Espacio Europeo de Educación Superior: permiten reconocer asignaturas entre universidades, convalidar estudios en un Erasmus y comparar la carga de trabajo de títulos de distintos países europeos.",
    },
  ]}
>
  <HorasEctsTool client:load />
</CalcLayout>

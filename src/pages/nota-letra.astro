---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import NotaLetraTool from '@/components/tools/NotaLetraTool';
---

<CalcLayout slug="nota-letra"
  answer={"En España una nota de 0 a 4,9 es suspenso (insuficiente), de 5 a 5,9 suficiente o aprobado, de 6 a 6,9 bien, de 7 a 8,9 notable y de 9 a 10 sobresaliente. Un 7,5 es un notable, equivalente a una B en los sistemas de letras anglosajones."}
  howTo={[
    "Introduce tu nota numérica.",
    "Elige la escala en la que está (sobre 10, sobre 100…).",
    "Pulsa convertir para ver la calificación española y su equivalencia en letra."
  ]}
  whatIs={"La calculadora de nota a calificación convierte una nota numérica en su calificación en España (insuficiente, suficiente, bien, notable o sobresaliente) y en su equivalencia aproximada en el sistema de letras A-F."}
  whyUse={"Es útil para interpretar boletines y expedientes, preparar un currículum o una solicitud para estudiar en el extranjero y entender las notas de otros sistemas educativos."}
  faqs={[
    {
      q: "¿Qué calificaciones hay en la ESO y el Bachillerato?",
      a: "Con la LOMLOE, en la ESO las calificaciones se expresan como insuficiente (1-4), suficiente (5), bien (6), notable (7-8) y sobresaliente (9-10). En el Bachillerato se usan las notas numéricas de 0 a 10, y se considera aprobado a partir de 5.",
    },
    {
      q: "¿Y en la universidad?",
      a: "Según el Real Decreto 1125/2003: suspenso (0-4,9), aprobado (5-6,9), notable (7-8,9) y sobresaliente (9-10). La matrícula de honor puede concederse a alumnos con sobresaliente, con un máximo del 5 % de los matriculados en la asignatura.",
    },
    {
      q: "¿Cómo se convierte a letras para estudiar fuera?",
      a: "No hay una equivalencia oficial única: cada universidad extranjera usa su tabla. Como orientación, un sobresaliente equivale a una A, un notable a una B, un bien a una C, un aprobado a una D y un suspenso a una F. Para trámites oficiales, consulta la equivalencia de la universidad de destino.",
    },
    {
      q: "¿Cuánto vale una matrícula de honor en la nota media?",
      a: "En la nota media del expediente universitario, la matrícula de honor cuenta como 10. Además, muchas universidades bonifican la matrícula de una asignatura del curso siguiente por cada matrícula de honor.",
    },
    {
      q: "¿Cómo convierto una nota sobre 100 o sobre 20?",
      a: "Divide la nota entre la escala y multiplica por 10: 75 sobre 100 es un 7,5; 14 sobre 20 es un 7. La calculadora convierte automáticamente las notas sobre 100 y sobre 5; una nota sobre 20, divídela entre 2 e introdúcela sobre 10.",
    },
  ]}
>
  <NotaLetraTool client:load />
</CalcLayout>

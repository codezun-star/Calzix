---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ProgresionesTool from '@/components/tools/ProgresionesTool';
---

<CalcLayout slug="progresiones"
  answer={"En una progresión aritmética cada término se obtiene sumando la diferencia d: aₙ = a₁ + (n − 1)·d. En una geométrica, multiplicando por la razón r: aₙ = a₁ · rⁿ⁻¹. La progresión 2, 5, 8… tiene a₁₀ = 29 y sus 10 primeros términos suman 155."}
  howTo={[
    "Elige el tipo de progresión: aritmética o geométrica.",
    "Introduce el primer término, la diferencia o razón y el número de términos.",
    "Pulsa calcular para ver el término n-ésimo, la suma y los términos."
  ]}
  whatIs={"La calculadora de progresiones calcula el término general, cualquier término y la suma de los n primeros términos de una progresión aritmética o geométrica."}
  whyUse={"Sirve para los ejercicios de sucesiones y progresiones de 3.º de ESO y Bachillerato, y para modelizar ahorros periódicos, interés compuesto o crecimientos."}
  faqs={[
    {
      q: "¿Cómo se calcula la suma de una progresión aritmética?",
      a: "Sₙ = n · (a₁ + aₙ) / 2. Para 2, 5, 8… con 10 términos: a₁₀ = 29 y S₁₀ = 10 × (2 + 29) / 2 = 155. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Y la de una geométrica?",
      a: "Sₙ = a₁ · (rⁿ − 1) / (r − 1), con r distinta de 1. Si |r| < 1, la suma de infinitos términos es a₁ / (1 − r).",
    },
    {
      q: "¿Qué tiene que ver con el interés compuesto?",
      a: "El capital con interés compuesto crece en progresión geométrica de razón (1 + i): 1.000 € al 3 % anual se convierten en 1.000, 1.030, 1.060,90… euros.",
    },
    {
      q: "¿Cómo identifico el tipo de progresión?",
      a: "Si la diferencia entre términos consecutivos es constante, es aritmética; si lo es el cociente, es geométrica.",
    },
    {
      q: "¿Qué es la historia de Gauss y la suma del 1 al 100?",
      a: "Se cuenta que el matemático Gauss, de niño, sumó del 1 al 100 al instante emparejando términos: (1 + 100) × 50 = 5.050. Es la fórmula de la suma de una progresión aritmética.",
    },
  ]}
>
  <ProgresionesTool client:load />
</CalcLayout>

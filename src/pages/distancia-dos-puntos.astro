---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DistanciaDosPuntosTool from '@/components/tools/DistanciaDosPuntosTool';
---

<CalcLayout slug="distancia-dos-puntos"
  answer={"La distancia entre dos puntos del plano es d = √((x₂ − x₁)² + (y₂ − y₁)²), una aplicación del teorema de Pitágoras: entre (1, 2) y (4, 6), d = √(9 + 16) = 5."}
  howTo={[
    "Introduce las coordenadas x₁ e y₁ del primer punto.",
    "Introduce las coordenadas x₂ e y₂ del segundo punto.",
    "Pulsa calcular distancia para ver la distancia entre los dos puntos."
  ]}
  whatIs={"La calculadora de distancia entre dos puntos calcula la distancia euclídea entre dos puntos del plano cartesiano a partir de sus coordenadas."}
  whyUse={"Sirve para los ejercicios de geometría analítica de 4.º de ESO y 1.º de Bachillerato, y para problemas prácticos de planos, mapas o diseño."}
  faqs={[
    {
      q: "¿De dónde sale la fórmula?",
      a: "Del teorema de Pitágoras: las diferencias de coordenadas son los catetos de un triángulo rectángulo y la distancia es la hipotenusa. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se calcula el punto medio?",
      a: "Haciendo la media de las coordenadas: M = ((x₁ + x₂)/2, (y₁ + y₂)/2). Entre (1, 2) y (4, 6), el punto medio es (2,5; 4).",
    },
    {
      q: "¿Y en tres dimensiones?",
      a: "Se añade la tercera coordenada: d = √((x₂ − x₁)² + (y₂ − y₁)² + (z₂ − z₁)²).",
    },
    {
      q: "¿Sirve para distancias en un mapa?",
      a: "Para mapas a escala y distancias cortas, sí, multiplicando por la escala. Para distancias entre ciudades sobre la superficie terrestre se usa la fórmula del círculo máximo (haversine), que tiene en cuenta la curvatura de la Tierra.",
    },
    {
      q: "¿Puede salir negativa la distancia?",
      a: "No. Las diferencias se elevan al cuadrado, así que la distancia siempre es positiva o cero (si los puntos coinciden).",
    },
  ]}
>
  <DistanciaDosPuntosTool client:load />
</CalcLayout>

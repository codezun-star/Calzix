---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import FraccionesTool from '@/components/tools/FraccionesTool';
---

<CalcLayout slug="calculadora-fracciones"
  answer={"Para operar con fracciones: suma y resta con común denominador (1/4 + 1/6 = 3/12 + 2/12 = 5/12), multiplica numeradores y denominadores (2/3 × 4/5 = 8/15) y divide multiplicando por la inversa (3/4 ÷ 2/5 = 15/8). La calculadora da el resultado simplificado."}
  howTo={[
    "Escribe el numerador y el denominador de la primera fracción.",
    "Elige la operación: suma, resta, multiplicación o división.",
    "Escribe la segunda fracción y pulsa calcular para ver el resultado simplificado."
  ]}
  whatIs={"La calculadora de fracciones suma, resta, multiplica y divide fracciones y muestra el resultado simplificado al máximo."}
  whyUse={"Sirve para comprobar los ejercicios de fracciones de Primaria y la ESO, ayudar con los deberes y resolver cálculos cotidianos con fracciones en recetas o repartos."}
  faqs={[
    {
      q: "¿Cómo se suman fracciones con distinto denominador?",
      a: "Se busca el mínimo común múltiplo de los denominadores, se convierte cada fracción a ese denominador y se suman los numeradores. 1/4 + 1/6: MCM = 12, 3/12 + 2/12 = 5/12. Forma parte del currículo de Matemáticas de la ESO y el Bachillerato establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se simplifica una fracción?",
      a: "Dividiendo numerador y denominador entre su máximo común divisor: 18/24, con MCD 6, queda 3/4.",
    },
    {
      q: "¿Cómo se dividen fracciones?",
      a: "Multiplicando la primera por la inversa de la segunda: 3/4 ÷ 2/5 = 3/4 × 5/2 = 15/8, o «en cruz».",
    },
    {
      q: "¿Qué es un número mixto?",
      a: "Una forma de escribir una fracción impropia (numerador mayor que el denominador) como un entero más una fracción: 15/8 = 1 y 7/8.",
    },
    {
      q: "¿Cómo paso una fracción a decimal o porcentaje?",
      a: "Divide el numerador entre el denominador: 3/4 = 0,75, es decir, el 75 %. Algunas fracciones dan decimales periódicos, como 1/3 = 0,333…",
    },
  ]}
>
  <FraccionesTool client:load />
</CalcLayout>

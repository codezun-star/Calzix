---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvParMotorTool from '@/components/tools/ConvParMotorTool';
---

<CalcLayout slug="conversor-par-motor"
  answer={"Para convertir par motor: 1 kgf·m = 9,807 N·m, 1 lbf·ft = 1,356 N·m y 1 N·m = 0,738 lbf·ft. Un coche con 250 N·m de par tiene 25,5 kgf·m o 184 lbf·ft, y las ruedas de un turismo suelen apretarse a 110-120 N·m."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 250 N·m o 100 lbf·ft).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de par motor convierte entre newton-metro, kilonewton-metro, kilogramo-fuerza metro, kilogramo-fuerza centímetro, libra-fuerza pie y libra-fuerza pulgada."}
  whyUse={"Te ayuda a comparar fichas técnicas de coches y motos, usar una llave dinamométrica con la escala del manual y entender manuales de taller o de herramientas extranjeros."}
  faqs={[
    {
      q: "¿Qué es el par motor?",
      a: "Es la fuerza de giro que produce el motor, medida en newton-metro (N·m). Un par alto a bajas revoluciones da sensación de empuje al acelerar. La potencia es el par multiplicado por la velocidad de giro: P (kW) = par (N·m) × rpm / 9.549.",
    },
    {
      q: "¿A cuánto se aprietan las ruedas de un coche?",
      a: "La mayoría de turismos usan entre 100 y 140 N·m para los tornillos o tuercas de rueda; el valor exacto está en el manual. Usa una llave dinamométrica y aprieta en cruz. Después de cambiar una rueda, conviene revisar el apriete tras unos 50 km.",
    },
    {
      q: "¿Por qué los eléctricos tienen tanto par?",
      a: "Porque los motores eléctricos ofrecen su par máximo desde 0 rpm, mientras que los de combustión necesitan revolucionarse. Por eso aceleran con tanta rapidez desde parado.",
    },
    {
      q: "¿Qué es el kgf·m?",
      a: "Es el kilogramo-fuerza metro, una unidad antigua que aparecía en las fichas de coches en España hasta los años 90. 1 kgf·m = 9,807 N·m, así que un motor de 20 kgf·m tiene unos 196 N·m.",
    },
    {
      q: "¿Qué unidad usan las llaves dinamométricas?",
      a: "La mayoría marcan N·m y, a menudo, también lbf·ft o lbf·in. Las de bicicleta y las de precisión suelen trabajar entre 2 y 25 N·m.",
    },
  ]}
>
  <ConvParMotorTool client:load />
</CalcLayout>

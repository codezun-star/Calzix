---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import DistanciaRelacionTool from '@/components/tools/DistanciaRelacionTool';
---

<CalcLayout slug="distancia-relacion"
  answer={"La cuenta atrás para una relación a distancia calcula los días que faltan para el próximo reencuentro: si hoy es 14 de octubre y os veis el 23 de diciembre, quedan 70 días, 10 semanas y 10 fines de semana."}
  howTo={[
    "Introduce la fecha de vuestro próximo reencuentro.",
    "Pulsa contar los días.",
    "Consulta los días, semanas y fines de semana que faltan."
  ]}
  whatIs={"La calculadora para relaciones a distancia es una cuenta atrás que muestra los días, las semanas y los fines de semana que faltan para volver a ver a tu pareja, a tu familia o a tus amigos."}
  whyUse={"Es un pequeño impulso emocional para parejas que viven en distintas ciudades o países, estudiantes de Erasmus, trabajadores desplazados o familias separadas por la distancia."}
  faqs={[
    {
      q: "¿Cómo llevar mejor una relación a distancia?",
      a: "Comunicación frecuente y de calidad (no solo mensajes rápidos), tener siempre fecha para el próximo encuentro, compartir actividades a distancia (ver una serie a la vez, cocinar juntos por videollamada) y un plan a medio plazo para reducir la distancia.",
    },
    {
      q: "¿Cuántas personas tienen una relación a distancia?",
      a: "Es cada vez más frecuente por la movilidad laboral y académica: estudiantes Erasmus, trabajadores desplazados a otras comunidades o al extranjero y parejas que se conocen por internet.",
    },
    {
      q: "¿Cómo ahorrar en los viajes para veros?",
      a: "Reserva con antelación, compara tren y avión (el AVE y las compañías de alta velocidad de bajo coste han abaratado muchas rutas), aprovecha los descuentos para jóvenes y viaja fuera de los puentes y festivos.",
    },
    {
      q: "¿Se actualiza la cuenta atrás?",
      a: "Sí, cada vez que abres la calculadora cuenta desde el día de hoy. Puedes guardarla en la pantalla de inicio del móvil como aplicación.",
    },
    {
      q: "¿Se guarda la fecha?",
      a: "No. El cálculo se hace en tu navegador y la fecha no se envía a ningún servidor.",
    },
  ]}
>
  <DistanciaRelacionTool client:load />
</CalcLayout>

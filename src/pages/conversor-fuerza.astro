---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvFuerzaTool from '@/components/tools/ConvFuerzaTool';
---

<CalcLayout slug="conversor-fuerza"
  answer={"Para convertir fuerzas: 1 kilogramo-fuerza (kgf o kilopondio) = 9,80665 N, 1 libra-fuerza = 4,448 N y 1 kN = 1.000 N. Así, el peso de una persona de 70 kg es de unos 686 N, y una carga de 1.000 kgf equivale a 9,81 kN."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 100 kgf o 5 kN).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de fuerza convierte entre newtons, kilonewtons, meganewtons, kilogramos-fuerza, libras-fuerza y dinas."}
  whyUse={"Sirve para resolver problemas de física de la ESO y el Bachillerato, interpretar fichas técnicas de anclajes, eslingas, grúas o máquinas de gimnasio y comparar unidades antiguas y modernas."}
  faqs={[
    {
      q: "¿Qué es un newton?",
      a: "Es la unidad de fuerza del Sistema Internacional: la fuerza necesaria para acelerar 1 kg a 1 m/s². Una manzana de unos 100 g pesa aproximadamente 1 N.",
    },
    {
      q: "¿Qué es el kilopondio?",
      a: "Es otro nombre del kilogramo-fuerza (kgf o kp): el peso de una masa de 1 kg en la gravedad terrestre estándar, 9,80665 N. Era habitual en libros técnicos españoles antiguos y en algunas fichas de maquinaria.",
    },
    {
      q: "¿Por qué la báscula marca kilos y no newtons?",
      a: "Porque mide la fuerza del peso y la convierte en masa dividiéndola entre la gravedad. En la vida diaria se habla de kilos, pero en física el peso es una fuerza: P = m · g.",
    },
    {
      q: "¿Dónde se usan los kilonewtons?",
      a: "En construcción, ingeniería y escalada: la resistencia de anclajes, mosquetones y cuerdas se indica en kN. Un mosquetón de escalada suele aguantar unos 20-25 kN, el equivalente a más de dos toneladas.",
    },
    {
      q: "¿Qué es la dina?",
      a: "Es la unidad de fuerza del antiguo sistema CGS: 1 dina = 10⁻⁵ N. Hoy apenas se usa fuera de algunas ramas de la física, como la tensión superficial (dinas por centímetro).",
    },
  ]}
>
  <ConvFuerzaTool client:load />
</CalcLayout>

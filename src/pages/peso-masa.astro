---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PesoMasaTool from '@/components/tools/PesoMasaTool';
---

<CalcLayout slug="peso-masa"
  answer={"El peso es la masa por la gravedad: P = m · g. Una persona de 70 kg pesa 686,7 N en la Tierra (g = 9,81 m/s²), 113,4 N en la Luna (1,62 m/s²) y 259,7 N en Marte (3,71 m/s²), aunque su masa sigue siendo de 70 kg."}
  howTo={[
    "Introduce la masa en kilogramos.",
    "Elige el cuerpo celeste: Tierra, Luna, Marte, Venus, Júpiter o el Sol.",
    "Pulsa calcular peso para ver el peso en newtons."
  ]}
  whatIs={"La calculadora de peso y masa calcula el peso de un cuerpo en newtons en la Tierra y en otros cuerpos del sistema solar, y explica la diferencia entre masa y peso."}
  whyUse={"Sirve para los problemas de dinámica y gravitación de Física y Química de la ESO y el Bachillerato y para despertar la curiosidad sobre el sistema solar."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre masa y peso?",
      a: "La masa es la cantidad de materia de un cuerpo y se mide en kilogramos; no cambia. El peso es la fuerza con la que la gravedad atrae esa masa y se mide en newtons; depende del lugar. Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Por qué decimos que pesamos 70 kilos?",
      a: "Porque en el lenguaje cotidiano usamos «peso» para referirnos a la masa. Las básculas miden la fuerza del peso, pero la muestran en kilos dividiéndola entre la gravedad terrestre.",
    },
    {
      q: "¿Cuánto pesaría en la Luna?",
      a: "Aproximadamente una sexta parte que en la Tierra: una persona de 70 kg sentiría el peso que en la Tierra tendría alguien de unos 11,6 kg. Por eso los astronautas daban saltos tan largos.",
    },
    {
      q: "¿Es igual la gravedad en toda la Tierra?",
      a: "No: es algo mayor en los polos (9,83 m/s²) que en el ecuador (9,78 m/s²) y disminuye con la altitud. En España ronda los 9,80 m/s². En los problemas se usa 9,8 o 9,81 m/s².",
    },
    {
      q: "¿Qué es un newton?",
      a: "Es la fuerza necesaria para acelerar 1 kg a 1 m/s². Un objeto de unos 100 g, como una manzana pequeña, pesa aproximadamente 1 N.",
    },
  ]}
>
  <PesoMasaTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConvVelocidadTool from '@/components/tools/ConvVelocidadTool';
---

<CalcLayout slug="conversor-velocidad"
  answer={"Para pasar de km/h a m/s divide entre 3,6; para pasar de km/h a millas por hora divide entre 1,609. Así, 120 km/h (el límite en autopistas y autovías españolas) son 33,3 m/s o 74,6 mph, y 1 nudo equivale a 1,852 km/h."}
  howTo={[
    "Introduce el valor que quieres convertir (por ejemplo, 120 km/h o 70 mph).",
    "Elige la unidad de origen (De) y la unidad de destino (A).",
    "Consulta el resultado al instante; puedes cambiar las unidades sin volver a escribir el valor."
  ]}
  whatIs={"El conversor de velocidad convierte entre metros por segundo, kilómetros por hora, millas por hora, pies por segundo y nudos con los factores exactos."}
  whyUse={"Sirve para entender los límites de velocidad en millas al conducir en Reino Unido o Estados Unidos, la velocidad del viento en nudos de un parte marítimo, la velocidad de un tren o un avión y los problemas de física."}
  faqs={[
    {
      q: "¿Cuáles son los límites de velocidad en España?",
      a: "Turismos y motos: 120 km/h en autopistas y autovías y 90 km/h en carreteras convencionales. En ciudad, desde mayo de 2021, 50 km/h en vías con dos o más carriles por sentido, 30 km/h en vías de un carril por sentido y 20 km/h en calles de plataforma única. Pueden existir límites inferiores señalizados.",
    },
    {
      q: "¿Cuántos km/h son 70 mph?",
      a: "70 × 1,609344 = 112,7 km/h. Es el límite de las autopistas británicas. En Estados Unidos los límites varían por estado, normalmente entre 55 y 75 mph (88-121 km/h). Recuerda que en Reino Unido se conduce por la izquierda.",
    },
    {
      q: "¿Qué es un nudo?",
      a: "Es una milla náutica por hora: 1,852 km/h o 0,514 m/s. Se usa en navegación marítima y aérea y para la velocidad del viento en los partes marítimos de la AEMET. Un viento de 20 nudos son unos 37 km/h.",
    },
    {
      q: "¿Cómo paso de m/s a km/h?",
      a: "Multiplica por 3,6. Por ejemplo, un velocista que corre a 10 m/s va a 36 km/h. La conversión viene de que 1 km = 1.000 m y 1 h = 3.600 s.",
    },
    {
      q: "¿A qué velocidad va el AVE?",
      a: "Los trenes de alta velocidad en España circulan a una velocidad máxima de entre 300 y 310 km/h en las líneas preparadas para ello, es decir, unos 83-86 m/s o 186-193 mph.",
    },
  ]}
>
  <ConvVelocidadTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import EstequiometriaTool from '@/components/tools/EstequiometriaTool';
---

<CalcLayout slug="estequiometria"
  answer={"En estequiometría, los coeficientes de la reacción ajustada indican la proporción en moles. En 2 H₂ + O₂ → 2 H₂O, 4 g de hidrógeno (2 mol) producen 2 mol de agua, es decir, 2 × 18 = 36 g. El cálculo sigue siempre el camino gramos → moles → moles → gramos."}
  howTo={[
    "Introduce los coeficientes del reactivo y del producto en la ecuación ajustada.",
    "Introduce las masas molares de ambos.",
    "Escribe la cantidad de reactivo, elige si está en gramos o en moles y pulsa calcular."
  ]}
  whatIs={"La calculadora de estequiometría calcula la cantidad de producto que se obtiene a partir de una cantidad de reactivo, usando los coeficientes de la ecuación química ajustada y las masas molares."}
  whyUse={"Sirve para resolver los problemas de cálculos estequiométricos de Física y Química de 4.º de ESO, 1.º de Bachillerato y la PAU, y para preparar reacciones en el laboratorio."}
  faqs={[
    {
      q: "¿Qué es la estequiometría?",
      a: "Es el cálculo de las cantidades de reactivos y productos en una reacción química, basado en la ley de conservación de la masa de Lavoisier y en las proporciones fijas de la ecuación ajustada. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Por qué hay que ajustar la reacción?",
      a: "Porque los átomos no se crean ni se destruyen: debe haber el mismo número de átomos de cada elemento a ambos lados. Sin ajustar, la proporción en moles sería incorrecta y todos los cálculos fallarían.",
    },
    {
      q: "¿Qué es el reactivo limitante?",
      a: "Es el reactivo que se agota primero y determina la cantidad máxima de producto. Para encontrarlo, calcula cuánto producto daría cada reactivo por separado: el que dé menos es el limitante.",
    },
    {
      q: "¿Qué es el rendimiento de una reacción?",
      a: "Es el porcentaje de producto que se obtiene realmente frente al teórico: rendimiento = (real / teórico) × 100. En la práctica suele ser menor del 100 % por reacciones incompletas, pérdidas o reacciones secundarias.",
    },
    {
      q: "¿Y si hay gases o disoluciones?",
      a: "Convierte primero a moles: para gases, con PV = nRT (o 22,4 L/mol en condiciones normales); para disoluciones, con n = M × V. Después aplica la proporción estequiométrica.",
    },
  ]}
>
  <EstequiometriaTool client:load />
</CalcLayout>

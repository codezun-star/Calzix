---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PalabrasMinutoTool from '@/components/tools/PalabrasMinutoTool';
---

<CalcLayout slug="palabras-minuto"
  answer={"Las palabras por minuto (ppm) se calculan dividiendo las palabras leídas entre el tiempo en minutos: 500 palabras en 2 minutos son 250 ppm. En castellano, un adulto lee en silencio entre 200 y 250 ppm; la calculadora considera lector competente de 200 a 300 ppm y avanzado por encima de 300."}
  howTo={[
    "Introduce el número de palabras leídas.",
    "Introduce el tiempo de lectura en minutos.",
    "Pulsa calcular velocidad para ver tus ppm y tu nivel de lector."
  ]}
  whatIs={"La calculadora de palabras por minuto mide tu velocidad lectora y la clasifica en cinco niveles, de lector principiante a experto, según los valores de referencia en castellano."}
  whyUse={"Sirve para evaluar tu lectura antes de unas oposiciones o la PAU, seguir el progreso de un plan de lectura, preparar discursos (que se pronuncian a unas 130-150 ppm) y valorar la fluidez lectora en el aula."}
  faqs={[
    {
      q: "¿Qué niveles de velocidad lectora hay?",
      a: "Como referencia para adultos en lectura silenciosa: hasta 150 ppm, lector principiante; de 150 a 200 ppm, lector promedio; de 200 a 300 ppm, lector competente; de 300 a 400 ppm, lector avanzado; y más de 400 ppm, lector experto, normalmente con textos sencillos.",
    },
    {
      q: "¿Cuántas palabras por minuto se dicen en un discurso?",
      a: "Al hablar en público se pronuncian entre 120 y 150 palabras por minuto. Un discurso de 5 minutos tiene unas 650-750 palabras, y una exposición oral de 10 minutos en clase, unas 1.300-1.500.",
    },
    {
      q: "¿Influye el idioma?",
      a: "Sí. Las palabras en castellano son de media algo más largas que en inglés, por lo que las velocidades en ppm no son directamente comparables. Por eso conviene usar referencias de lectores en castellano.",
    },
    {
      q: "¿Cómo aumentar las palabras por minuto?",
      a: "Leyendo cada día textos variados, evitando la subvocalización excesiva (pronunciar mentalmente cada palabra), no retrocediendo innecesariamente y ampliando el vocabulario. La mejora es gradual: unas pocas semanas de lectura diaria ya se notan.",
    },
    {
      q: "¿Velocidad o comprensión?",
      a: "La comprensión es lo importante. Una velocidad alta con poca comprensión no sirve para estudiar. Combina esta calculadora con la de comprensión lectora para medir ambas cosas a la vez.",
    },
  ]}
>
  <PalabrasMinutoTool client:load />
</CalcLayout>

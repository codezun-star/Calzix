---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import VolumenSolidosTool from '@/components/tools/VolumenSolidosTool';
---

<CalcLayout slug="volumen-solidos"
  answer={"Los volúmenes más usados son: cubo, lado³; prisma rectangular, largo × ancho × alto; cilindro, π × r² × h; esfera, 4/3 × π × r³; cono, π × r² × h ÷ 3; y pirámide, base × altura ÷ 3. Una piscina de 8 × 4 × 1,5 m tiene 48 m³, es decir, 48.000 litros."}
  howTo={[
    "Elige el sólido: cubo, esfera, cilindro, cono, prisma rectangular o pirámide cuadrada.",
    "Introduce sus medidas en metros.",
    "Pulsa calcular para obtener el volumen en m³ y en litros."
  ]}
  whatIs={"La calculadora de volumen de sólidos calcula el volumen de los cuerpos geométricos más comunes y lo expresa en metros cúbicos y litros."}
  whyUse={"Sirve para los ejercicios de geometría de la ESO y para calcular la capacidad de una piscina, un depósito de gasóleo o de agua, un acuario, una maceta o el hormigón necesario para una solera."}
  faqs={[
    {
      q: "¿Cuántos litros tiene un metro cúbico?",
      a: "1.000 litros. 1 dm³ = 1 litro y 1 cm³ = 1 mililitro. Por eso, para pasar de m³ a litros, multiplica por 1.000.",
    },
    {
      q: "¿Cómo calculo los litros de un depósito cilíndrico?",
      a: "Volumen = π × r² × h. Un depósito de 1 m de diámetro (radio 0,5 m) y 1,3 m de altura tiene 3,1416 × 0,25 × 1,3 = 1,02 m³, unos 1.020 litros. Si está tumbado y quieres saber los litros según la altura del líquido, el cálculo es más complejo.",
    },
    {
      q: "¿Cuánta agua necesito para llenar una piscina?",
      a: "Multiplica largo × ancho × profundidad media. Una piscina de 8 × 4 m con una profundidad media de 1,5 m tiene 48 m³. Con el agua a unos 2 €/m³, llenarla cuesta alrededor de 100 €, aunque muchos municipios aplican tarifas especiales o restricciones en época de sequía.",
    },
    {
      q: "¿Por qué el cono tiene un tercio del volumen del cilindro?",
      a: "Porque un cono y un cilindro con la misma base y altura cumplen esa relación, igual que una pirámide respecto al prisma. Se puede comprobar llenando de agua un cono y vertiéndola en el cilindro: hacen falta tres conos. Forma parte del currículo de Matemáticas de la ESO establecido por la LOMLOE.",
    },
    {
      q: "¿Cómo se calcula el volumen de una esfera?",
      a: "Con V = 4/3 × π × r³. Un balón de fútbol de unos 22 cm de diámetro (radio 0,11 m) tiene un volumen de unos 5,6 litros.",
    },
  ]}
>
  <VolumenSolidosTool client:load />
</CalcLayout>

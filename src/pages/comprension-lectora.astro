---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ComprensionLectoraTool from '@/components/tools/ComprensionLectoraTool';
---

<CalcLayout slug="comprension-lectora"
  answer={"La comprensión lectora se mide con el porcentaje de preguntas acertadas tras leer un texto, y la lectura eficaz combina ese porcentaje con la velocidad: si lees 500 palabras en 2 minutos (250 ppm) y aciertas 8 de 10 preguntas (80 %), tu velocidad eficaz es de 200 palabras comprendidas por minuto."}
  howTo={[
    "Introduce las palabras leídas y el tiempo de lectura en minutos.",
    "Indica cuántas preguntas has acertado y el total de preguntas.",
    "Pulsa calcular comprensión para ver tu porcentaje, tu velocidad y tu velocidad eficaz."
  ]}
  whatIs={"La calculadora de comprensión lectora calcula tu porcentaje de comprensión, tu velocidad de lectura y tu velocidad eficaz (palabras comprendidas por minuto) a partir de un test de lectura."}
  whyUse={"Es útil para docentes que evalúan la competencia lectora, para estudiantes que preparan la PAU o unas oposiciones y para quien quiera mejorar su lectura sin sacrificar la comprensión."}
  faqs={[
    {
      q: "¿Qué porcentaje de comprensión es bueno?",
      a: "Por encima del 70-80 % se considera una buena comprensión de un texto de dificultad adecuada. Si baja del 60 %, conviene leer más despacio, releer las partes difíciles o elegir textos más sencillos.",
    },
    {
      q: "¿Qué es la velocidad eficaz?",
      a: "Es la velocidad lectora multiplicada por el porcentaje de comprensión: indica cuántas palabras comprendes realmente por minuto. Es una medida más útil que la velocidad sola, porque leer rápido sin entender no sirve.",
    },
    {
      q: "¿Qué evalúa PISA en lectura?",
      a: "La competencia lectora: localizar información, comprender el sentido de un texto y evaluar y reflexionar sobre él, con textos continuos (narrativos, expositivos) y discontinuos (gráficos, tablas). En PISA 2022, España obtuvo 474 puntos, cerca de la media de la OCDE.",
    },
    {
      q: "¿Cómo mejorar la comprensión lectora?",
      a: "Haz una prelectura (título, subtítulos, imágenes), subraya las ideas principales, resume cada párrafo con tus palabras, busca las palabras que no conoces y hazte preguntas sobre el texto. Leer variedad de géneros también ayuda.",
    },
    {
      q: "¿Cómo hacer un test de comprensión casero?",
      a: "Elige un texto de unas 500-1.000 palabras, léelo una vez cronometrando el tiempo y responde, sin volver al texto, a 5-10 preguntas sobre ideas principales, detalles y conclusiones. Muchas editoriales y consejerías de educación publican textos con preguntas para cada curso.",
    },
  ]}
>
  <ComprensionLectoraTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import ConversorPendienteTool from '@/components/tools/ConversorPendienteTool';
---

<CalcLayout slug="conversor-pendiente"
  answer={"Para pasar de pendiente en porcentaje a grados se usa el arcotangente: una pendiente del 10 % (sube 10 m por cada 100 m en horizontal) equivale a 5,71°, y una del 100 % a 45°. La DGT señaliza las pendientes en porcentaje."}
  howTo={[
    "Elige si quieres pasar de porcentaje a grados o de grados a porcentaje.",
    "Introduce el valor.",
    "Pulsa convertir para ver el resultado y la relación de desnivel."
  ]}
  whatIs={"El conversor de pendiente convierte una inclinación entre porcentaje, grados y relación de desnivel, para carreteras, rampas, tejados o rutas de montaña."}
  whyUse={"Te ayuda a interpretar las señales de pendiente, el perfil de una etapa ciclista o de una ruta, a diseñar una rampa accesible o a calcular la inclinación de un tejado."}
  faqs={[
    {
      q: "¿Qué significa una pendiente del 10 %?",
      a: "Que por cada 100 m recorridos en horizontal se sube (o baja) 10 m. No es lo mismo que 10°: equivale a unos 5,7°.",
    },
    {
      q: "¿Qué pendientes tienen los puertos de montaña?",
      a: "Los puertos de la Vuelta a España suelen tener pendientes medias del 6-10 % con rampas mucho más duras: el Angliru, en Asturias, tiene tramos de más del 20 %.",
    },
    {
      q: "¿Qué pendiente máxima puede tener una rampa accesible?",
      a: "El Código Técnico de la Edificación limita las rampas de los itinerarios accesibles al 10 % en tramos de menos de 3 m, al 8 % en tramos de 3 a 6 m y al 6 % en los demás. En garajes, las rampas pueden ser más pronunciadas.",
    },
    {
      q: "¿Qué pendiente tiene un tejado?",
      a: "En España, los tejados de teja suelen tener pendientes del 30-45 %; en zonas de mucha lluvia o nieve son mayores. Las cubiertas planas tienen pendientes del 1-5 % para evacuar el agua.",
    },
    {
      q: "¿Cómo se calcula a partir del desnivel?",
      a: "Pendiente (%) = desnivel ÷ distancia horizontal × 100. Una ruta que sube 300 m en 3 km de distancia horizontal tiene una pendiente media del 10 %.",
    },
  ]}
>
  <ConversorPendienteTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import PrecioOriginalDescuentoTool from '@/components/tools/PrecioOriginalDescuentoTool';
---

<CalcLayout slug="precio-original-descuento"
  answer={"El precio original antes de un descuento es el precio final dividido entre (1 − descuento/100): si pagas 63 € con un 30 % de descuento, el precio original era 63 / 0,70 = 90 € y has ahorrado 27 €. Restar el 30 % al precio final no da el precio original."}
  howTo={[
    "Introduce el precio que has pagado o el precio rebajado.",
    "Escribe el porcentaje de descuento aplicado.",
    "Pulsa calcular para ver el precio original y el ahorro."
  ]}
  whatIs={"La calculadora del precio original obtiene el precio que tenía un producto antes de aplicarle un descuento, a partir del precio rebajado y el porcentaje, y el dinero que realmente has ahorrado."}
  whyUse={"Te ayuda a comprobar si una oferta es real, saber cuánto has ahorrado en las rebajas o en el Black Friday y calcular el precio de lista en tu negocio a partir de un precio promocional."}
  faqs={[
    {
      q: "¿Cómo se calcula el precio antes del descuento?",
      a: "Precio original = precio rebajado ÷ (1 − descuento ÷ 100). Ejemplo: 45 € con un 25 % de descuento → 45 / 0,75 = 60 €. El error común es sumar el 25 % al precio rebajado: 45 × 1,25 = 56,25 €, que no es el precio original.",
    },
    {
      q: "¿Cómo sé si una rebaja es real?",
      a: "En España, el precio anterior que se anuncia en una rebaja debe ser el más bajo que el producto haya tenido en los 30 días previos. Si sospechas de una subida previa a la rebaja, puedes comprobar el historial de precios con extensiones de navegador o webs comparadoras y denunciarlo ante la oficina de consumo de tu comunidad.",
    },
    {
      q: "¿Cómo calculo el porcentaje de descuento que me han hecho?",
      a: "Descuento (%) = (precio original − precio pagado) ÷ precio original × 100. Si un producto de 80 € te ha costado 56 €, el descuento ha sido del 30 %.",
    },
    {
      q: "¿Qué pasa con el IVA en un producto rebajado?",
      a: "El precio rebajado incluye el IVA, que se calcula sobre el precio final de venta. Si necesitas la base imponible, divide el precio entre 1,21 (o 1,10 o 1,04 según el tipo).",
    },
    {
      q: "¿Puedo reclamar si el precio en caja es distinto al anunciado?",
      a: "Sí. El comercio está obligado a respetar el precio anunciado en la etiqueta o el cartel, incluidos los descuentos publicitados. Si en caja te cobran más, pide que te apliquen el precio anunciado y, si se niegan, solicita la hoja de reclamaciones.",
    },
    {
      q: "¿Sirve para precios con varios descuentos encadenados?",
      a: "Si se han aplicado varios descuentos seguidos, primero calcula el descuento equivalente (por ejemplo, un 20 % y un 10 % equivalen a un 28 %) con la calculadora de descuentos sucesivos y después usa ese porcentaje aquí.",
    },
  ]}
>
  <PrecioOriginalDescuentoTool client:load />
</CalcLayout>

---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import RiegoJardinTool from '@/components/tools/RiegoJardinTool';
---

<CalcLayout slug="riego-jardin"
  answer={"Un césped en verano en el centro de España necesita unos 4-5 litros por metro cuadrado en cada riego, tres veces por semana: un jardín de 100 m² gasta unos 1.200 litros semanales y casi 5.000 al mes. Los arbustos y plantas mediterráneas necesitan la mitad o menos."}
  howTo={[
    "Elige el tipo de planta: césped, arbustos, hortalizas, flores o árboles.",
    "Introduce el área del jardín en m² y los riegos por semana.",
    "Pulsa calcular para ver los litros por riego, por semana y por mes."
  ]}
  whatIs={"La calculadora de riego del jardín estima los litros de agua que necesita tu jardín en cada riego, a la semana y al mes según el tipo de plantas, la superficie y la frecuencia de riego."}
  whyUse={"Te ayuda a regar lo justo, calcular el coste del agua de riego, dimensionar un depósito de pluviales y adaptar el jardín al clima español y a las restricciones por sequía."}
  faqs={[
    {
      q: "¿Cuánta agua necesita el césped en España?",
      a: "En verano, un césped de clima frío (festuca, ray-grass) necesita entre 25 y 40 litros por metro cuadrado a la semana en el interior y el sur peninsular, repartidos en 3-4 riegos. Las variedades de clima cálido (grama, Zoysia, Paspalum) necesitan un 30-40 % menos. En primavera y otoño basta con la mitad, y en invierno, en muchas zonas, no hace falta regar.",
    },
    {
      q: "¿A qué hora es mejor regar?",
      a: "Al amanecer o al anochecer, cuando la evaporación es menor. Regar en las horas centrales del día en verano puede hacer que se evapore hasta un tercio del agua. Muchos ayuntamientos prohíben el riego en las horas de más calor durante las épocas de sequía.",
    },
    {
      q: "¿Qué es la xerojardinería?",
      a: "Es el diseño de jardines con plantas adaptadas al clima seco y técnicas de ahorro de agua: especies mediterráneas y autóctonas (lavanda, romero, tomillo, olivo, adelfa, gramíneas ornamentales), acolchado o mulch para reducir la evaporación, agrupación de plantas según sus necesidades de agua, poco césped y riego por goteo. Puede reducir el consumo de agua del jardín entre un 50 % y un 75 %.",
    },
    {
      q: "¿Riego por goteo o aspersión?",
      a: "El goteo lleva el agua directamente a las raíces y tiene una eficiencia del 90-95 %, ideal para arbustos, setos, huertos y macetas. La aspersión es necesaria para el césped, pero pierde más agua por evaporación y viento (eficiencia del 65-75 %). Un programador con sensor de lluvia evita regar cuando no hace falta.",
    },
    {
      q: "¿Cuánto cuesta regar el jardín?",
      a: "Con el precio medio del agua en España (alrededor de 2 €/m³, más caro en los tramos altos de consumo), regar 100 m² de césped en verano (unos 15 m³ al mes) cuesta unos 30-45 € al mes. Un jardín mediterráneo con goteo puede costar un tercio. Recoger agua de lluvia o reutilizar aguas grises reduce el gasto.",
    },
    {
      q: "¿Hay restricciones de riego en España?",
      a: "En las sequías, los planes especiales de las confederaciones hidrográficas y los ayuntamientos pueden prohibir el riego de jardines privados con agua de la red, limitarlo a ciertas horas o días, o prohibir llenar piscinas. En los últimos años se han aplicado en Cataluña y en Andalucía. Infórmate de las normas de tu municipio.",
    },
  ]}
>
  <RiegoJardinTool client:load />
</CalcLayout>

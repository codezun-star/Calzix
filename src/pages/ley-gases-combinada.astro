---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import LeyGasesCombinadaTool from '@/components/tools/LeyGasesCombinadaTool';
---

<CalcLayout slug="ley-gases-combinada"
  answer={"La ley combinada de los gases relaciona presión, volumen y temperatura de una misma cantidad de gas: P₁·V₁/T₁ = P₂·V₂/T₂, con la temperatura en kelvin. Si 2 L de gas a 1 atm y 300 K pasan a 2 atm y 330 K, el nuevo volumen es 1,1 L."}
  howTo={[
    "Elige la variable que quieres calcular.",
    "Introduce la presión, el volumen y la temperatura del estado inicial y los dos datos conocidos del final (temperatura en kelvin).",
    "Pulsa calcular incógnita para obtener el resultado."
  ]}
  whatIs={"La calculadora de la ley combinada de los gases calcula la presión, el volumen o la temperatura de un gas cuando cambian sus condiciones, combinando las leyes de Boyle, Charles y Gay-Lussac."}
  whyUse={"Sirve para los problemas de gases de Física y Química de 4.º de ESO y 1.º de Bachillerato y para entender fenómenos como el cambio de presión de los neumáticos o de una bombona con la temperatura."}
  faqs={[
    {
      q: "¿Qué leyes combina?",
      a: "La de Boyle (a temperatura constante, P·V = constante), la de Charles (a presión constante, V/T = constante) y la de Gay-Lussac (a volumen constante, P/T = constante). Se estudia en Física y Química de la ESO y del Bachillerato (currículos de la LOMLOE).",
    },
    {
      q: "¿Por qué la temperatura va en kelvin?",
      a: "Porque las leyes de los gases se basan en la temperatura absoluta. Para convertir, suma 273,15 a los grados Celsius: 27 °C = 300,15 K.",
    },
    {
      q: "¿Se pueden usar atmósferas y litros?",
      a: "Sí, siempre que uses las mismas unidades en los dos estados, porque se cancelan. Solo la temperatura debe estar obligatoriamente en kelvin.",
    },
    {
      q: "¿Qué pasa con los neumáticos en verano?",
      a: "A volumen casi constante, la presión aumenta con la temperatura absoluta. Si inflas las ruedas a 2,2 bar a 15 °C y el asfalto las calienta a 45 °C, la presión sube alrededor de un 10 %. Por eso hay que medirla en frío.",
    },
    {
      q: "¿Y si cambia la cantidad de gas?",
      a: "Entonces hay que usar la ecuación de los gases ideales, P·V = n·R·T, que incluye el número de moles. Usa la calculadora de gas ideal.",
    },
  ]}
>
  <LeyGasesCombinadaTool client:load />
</CalcLayout>

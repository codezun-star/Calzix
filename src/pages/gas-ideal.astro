---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import GasIdealTool from '@/components/tools/GasIdealTool';
---

<CalcLayout slug="gas-ideal"
  answer={"La ecuación de los gases ideales es P · V = n · R · T, con R = 8,314 J/(mol·K) o 0,082 atm·L/(mol·K). Un mol de gas a 0 °C (273,15 K) y 1 atm ocupa 22,4 litros. La temperatura debe ir siempre en kelvin."}
  howTo={[
    "Elige la variable que quieres calcular: presión, volumen, moles o temperatura.",
    "Introduce las otras tres en unidades del Sistema Internacional (Pa, m³, mol, K).",
    "Pulsa calcular para obtener el resultado."
  ]}
  whatIs={"La calculadora de la ley de los gases ideales despeja la presión, el volumen, los moles o la temperatura de un gas con la ecuación P · V = n · R · T."}
  whyUse={"Sirve para los problemas de gases de Física y Química de 4.º de ESO y 1.º de Bachillerato y para entender fenómenos cotidianos, como por qué sube la presión de los neumáticos con el calor."}
  faqs={[
    {
      q: "¿Qué valor de R uso?",
      a: "Depende de las unidades: R = 8,314 J/(mol·K) con presión en pascales y volumen en m³, y R = 0,082 atm·L/(mol·K) con atmósferas y litros. Esta calculadora trabaja en unidades del Sistema Internacional. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Por qué la temperatura va en kelvin?",
      a: "Porque la ecuación se basa en la temperatura absoluta. Con grados Celsius saldrían resultados absurdos, como volúmenes negativos por debajo de 0 °C. Para convertir, suma 273,15 a los grados Celsius.",
    },
    {
      q: "¿Por qué sube la presión de las ruedas en verano?",
      a: "Porque a volumen constante la presión es proporcional a la temperatura absoluta (ley de Gay-Lussac). Al pasar de 15 °C a 45 °C (de 288 a 318 K), la presión absoluta aumenta un 10 %. Por eso hay que medir la presión con los neumáticos fríos.",
    },
    {
      q: "¿Qué son las condiciones normales?",
      a: "Tradicionalmente, 0 °C y 1 atm, en las que 1 mol de gas ideal ocupa 22,4 L. La IUPAC usa desde 1982 como condiciones estándar 0 °C y 1 bar (22,7 L/mol). En muchos problemas de clase se siguen usando 0 °C y 1 atm.",
    },
    {
      q: "¿Cuándo no se comporta un gas como ideal?",
      a: "A presiones muy altas o temperaturas muy bajas, cuando las moléculas están muy próximas y sus fuerzas de atracción y su volumen importan. En esos casos se usan ecuaciones como la de Van der Waals.",
    },
  ]}
>
  <GasIdealTool client:load />
</CalcLayout>

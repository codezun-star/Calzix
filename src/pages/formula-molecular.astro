---
import CalcLayout from '@/components/layout/CalcLayout.astro';
import FormulaMolecularTool from '@/components/tools/FormulaMolecularTool';
---

<CalcLayout slug="formula-molecular"
  answer={"La fórmula molecular se obtiene multiplicando la fórmula empírica por n = masa molecular ÷ masa de la fórmula empírica: la glucosa tiene fórmula empírica CH₂O (30,03 g/mol) y masa molecular 180 g/mol, así que n = 6 y su fórmula molecular es C₆H₁₂O₆."}
  howTo={[
    "Escribe la fórmula empírica del compuesto (por ejemplo, CH2O).",
    "Introduce su masa molecular en g/mol.",
    "Pulsa calcular para obtener el factor n y la fórmula molecular."
  ]}
  whatIs={"La calculadora de fórmula molecular obtiene la fórmula real de un compuesto a partir de su fórmula empírica y su masa molecular, calculando la masa de la fórmula empírica con las masas atómicas de los elementos."}
  whyUse={"Sirve para resolver los problemas de determinación de fórmulas de Química de 1.º y 2.º de Bachillerato y comprobar los resultados de un análisis elemental."}
  faqs={[
    {
      q: "¿Qué diferencia hay entre fórmula empírica y molecular?",
      a: "La empírica indica la proporción más simple entre los átomos de un compuesto; la molecular, el número real de átomos de cada elemento en una molécula. El benceno tiene fórmula empírica CH y molecular C₆H₆. Se estudia en Física y Química de la ESO y del Bachillerato, según los currículos de la LOMLOE, y es habitual en los exámenes de Física o de Química de la PAU.",
    },
    {
      q: "¿Cómo se calcula la fórmula empírica?",
      a: "A partir de la composición centesimal: divide el porcentaje de cada elemento entre su masa atómica, divide todos los resultados entre el menor y redondea (o multiplica por un número pequeño) hasta obtener números enteros.",
    },
    {
      q: "¿Y si n no sale entero?",
      a: "Si el resultado se aleja mucho de un número entero, revisa la fórmula empírica o la masa molecular: pequeñas diferencias se deben al redondeo de las masas atómicas, pero un valor como 2,5 indica un error en los datos.",
    },
    {
      q: "¿Qué masas atómicas usa la calculadora?",
      a: "Las masas atómicas estándar de la IUPAC redondeadas, las mismas que aparecen en las tablas periódicas que se usan en clase y en la PAU, como H = 1,008, C = 12,011, N = 14,007 y O = 15,999.",
    },
    {
      q: "¿Cómo se escriben las fórmulas?",
      a: "Con el símbolo de cada elemento, respetando mayúsculas y minúsculas (Co es cobalto y CO, monóxido de carbono), seguido del número de átomos. Por ejemplo: C6H12O6, H2SO4 o NaCl.",
    },
  ]}
>
  <FormulaMolecularTool client:load />
</CalcLayout>
